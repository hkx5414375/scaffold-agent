<script setup lang="ts">
import { ElMessage } from "element-plus";
import { computed, onMounted, reactive, ref } from "vue";

import { request } from "../api/client";
import type {
  InventoryBalance,
  InventoryItem,
  InventoryPage,
  InventoryPurchaseOrder,
  InventoryReservation,
  InventoryWarehouse,
} from "../types";

const loading = ref(false);
const items = ref<InventoryItem[]>([]);
const warehouses = ref<InventoryWarehouse[]>([]);
const balances = ref<InventoryBalance[]>([]);
const reservations = ref<InventoryReservation[]>([]);
const purchaseOrders = ref<InventoryPurchaseOrder[]>([]);
const itemForm = reactive({ sku: "", name: "", unit: "EA" });
const warehouseForm = reactive({ code: "", name: "" });
const adjustmentForm = reactive({
  item_id: "",
  warehouse_id: "",
  quantity_delta: "",
  reason: "",
  idempotency_key: "",
});
const reservationForm = reactive({
  external_reference: "",
  item_id: "",
  warehouse_id: "",
  quantity: "",
  idempotency_key: "",
});
const purchaseForm = reactive({ number: "", supplier_name: "", item_id: "", ordered_quantity: "" });
const receiptForm = reactive({
  purchase_id: "",
  line_id: "",
  warehouse_id: "",
  quantity: "",
  idempotency_key: "",
});
const selectedPurchase = computed(() =>
  purchaseOrders.value.find((value) => value.id === receiptForm.purchase_id),
);

async function load(): Promise<void> {
  loading.value = true;
  try {
    const [itemPage, warehousePage, balancePage, reservationPage, purchasePage] = await Promise.all(
      [
        request<InventoryPage<InventoryItem>>("/api/v1/inventory/items?limit=100"),
        request<InventoryPage<InventoryWarehouse>>("/api/v1/inventory/warehouses?limit=100"),
        request<InventoryPage<InventoryBalance>>("/api/v1/inventory/balances?limit=100"),
        request<InventoryPage<InventoryReservation>>("/api/v1/inventory/reservations?limit=100"),
        request<InventoryPage<InventoryPurchaseOrder>>(
          "/api/v1/inventory/purchase-orders?limit=100",
        ),
      ],
    );
    items.value = itemPage.items;
    warehouses.value = warehousePage.items;
    balances.value = balancePage.items;
    reservations.value = reservationPage.items;
    purchaseOrders.value = purchasePage.items;
  } catch {
    ElMessage.error("Inventory data could not be loaded");
  } finally {
    loading.value = false;
  }
}

async function createItem(): Promise<void> {
  try {
    await request("/api/v1/inventory/items", { method: "POST", body: JSON.stringify(itemForm) });
    Object.assign(itemForm, { sku: "", name: "", unit: "EA" });
    await load();
    ElMessage.success("Inventory item created");
  } catch {
    ElMessage.error("Inventory item could not be created");
  }
}

async function createWarehouse(): Promise<void> {
  try {
    await request("/api/v1/inventory/warehouses", {
      method: "POST",
      body: JSON.stringify(warehouseForm),
    });
    Object.assign(warehouseForm, { code: "", name: "" });
    await load();
    ElMessage.success("Warehouse created");
  } catch {
    ElMessage.error("Warehouse could not be created");
  }
}

async function transitionCatalogRecord(
  kind: "items" | "warehouses",
  value: InventoryItem | InventoryWarehouse,
): Promise<void> {
  const action = value.status === "active" ? "archive" : "reactivate";
  try {
    await request(`/api/v1/inventory/${kind}/${value.id}/${action}`, {
      method: "POST",
      body: JSON.stringify({ version: value.version }),
    });
    await load();
    ElMessage.success(`Inventory record ${action}d`);
  } catch {
    ElMessage.error("Inventory record transition was rejected");
  }
}

async function adjustStock(): Promise<void> {
  try {
    await request("/api/v1/inventory/adjustments", {
      method: "POST",
      body: JSON.stringify(adjustmentForm),
    });
    Object.assign(adjustmentForm, {
      item_id: "",
      warehouse_id: "",
      quantity_delta: "",
      reason: "",
      idempotency_key: "",
    });
    await load();
    ElMessage.success("Stock adjusted");
  } catch {
    ElMessage.error("Stock adjustment was rejected");
  }
}

async function reserveStock(): Promise<void> {
  try {
    await request("/api/v1/inventory/reservations", {
      method: "POST",
      body: JSON.stringify(reservationForm),
    });
    Object.assign(reservationForm, {
      external_reference: "",
      item_id: "",
      warehouse_id: "",
      quantity: "",
      idempotency_key: "",
    });
    await load();
    ElMessage.success("Stock reserved");
  } catch {
    ElMessage.error("Stock reservation was rejected");
  }
}

async function closeReservation(
  value: InventoryReservation,
  action: "release" | "consume",
): Promise<void> {
  try {
    await request(`/api/v1/inventory/reservations/${value.id}/${action}`, {
      method: "POST",
      body: JSON.stringify({
        version: value.version,
        idempotency_key: `${action}-${value.id}-${value.version}`,
      }),
    });
    await load();
    ElMessage.success(`Reservation ${action}d`);
  } catch {
    ElMessage.error("Reservation transition was rejected");
  }
}

async function createPurchaseOrder(): Promise<void> {
  try {
    await request("/api/v1/inventory/purchase-orders", {
      method: "POST",
      body: JSON.stringify({
        number: purchaseForm.number,
        supplier_name: purchaseForm.supplier_name,
        lines: [{ item_id: purchaseForm.item_id, ordered_quantity: purchaseForm.ordered_quantity }],
      }),
    });
    Object.assign(purchaseForm, {
      number: "",
      supplier_name: "",
      item_id: "",
      ordered_quantity: "",
    });
    await load();
    ElMessage.success("Purchase order created");
  } catch {
    ElMessage.error("Purchase order could not be created");
  }
}

async function transitionPurchase(
  value: InventoryPurchaseOrder,
  action: "submit" | "cancel",
): Promise<void> {
  try {
    await request(`/api/v1/inventory/purchase-orders/${value.id}/${action}`, {
      method: "POST",
      body: JSON.stringify({ version: value.version }),
    });
    await load();
  } catch {
    ElMessage.error("Purchase order transition was rejected");
  }
}

async function receivePurchase(): Promise<void> {
  const purchase = selectedPurchase.value;
  if (!purchase) return;
  try {
    await request(`/api/v1/inventory/purchase-orders/${purchase.id}/receive`, {
      method: "POST",
      body: JSON.stringify({
        line_id: receiptForm.line_id,
        warehouse_id: receiptForm.warehouse_id,
        quantity: receiptForm.quantity,
        idempotency_key: receiptForm.idempotency_key,
        version: purchase.version,
      }),
    });
    Object.assign(receiptForm, {
      purchase_id: "",
      line_id: "",
      warehouse_id: "",
      quantity: "",
      idempotency_key: "",
    });
    await load();
    ElMessage.success("Purchase stock received");
  } catch {
    ElMessage.error("Purchase receipt was rejected");
  }
}

onMounted(load);
</script>

<template>
  <section v-loading="loading" class="page-stack">
    <div>
      <p class="eyebrow">ERP core</p>
      <h1>Inventory and procurement</h1>
      <p class="muted">
        Integer stock, atomic reservations, immutable movements, and controlled receiving.
      </p>
    </div>

    <el-tabs>
      <el-tab-pane label="Balances" name="balances">
        <el-table :data="balances" stripe>
          <el-table-column prop="item_id" label="Item" min-width="180" />
          <el-table-column prop="warehouse_id" label="Warehouse" min-width="180" />
          <el-table-column prop="on_hand" label="On hand" />
          <el-table-column prop="reserved" label="Reserved" />
          <el-table-column prop="available" label="Available" />
        </el-table>

        <el-form :inline="true" @submit.prevent="adjustStock">
          <el-form-item label="Item">
            <el-select v-model="adjustmentForm.item_id" filterable>
              <el-option
                v-for="item in items"
                :key="item.id"
                :label="item.sku + ' — ' + item.name"
                :value="item.id"
              />
            </el-select>
          </el-form-item>
          <el-form-item label="Warehouse">
            <el-select v-model="adjustmentForm.warehouse_id" filterable>
              <el-option
                v-for="warehouse in warehouses"
                :key="warehouse.id"
                :label="warehouse.code + ' — ' + warehouse.name"
                :value="warehouse.id"
              />
            </el-select>
          </el-form-item>
          <el-form-item label="Delta">
            <el-input v-model="adjustmentForm.quantity_delta" />
          </el-form-item>
          <el-form-item label="Reason">
            <el-input v-model="adjustmentForm.reason" />
          </el-form-item>
          <el-form-item label="Idempotency key">
            <el-input v-model="adjustmentForm.idempotency_key" />
          </el-form-item>
          <el-form-item>
            <el-button native-type="submit" type="primary">Adjust</el-button>
          </el-form-item>
        </el-form>
      </el-tab-pane>

      <el-tab-pane label="Items" name="items">
        <el-table :data="items" stripe>
          <el-table-column prop="sku" label="SKU" />
          <el-table-column prop="name" label="Name" />
          <el-table-column prop="unit" label="Unit" />
          <el-table-column prop="status" label="Status" />
          <el-table-column label="Actions">
            <template #default="scope">
              <el-button size="small" @click="transitionCatalogRecord('items', scope.row)">
                <span v-text="scope.row.status === 'active' ? 'Archive' : 'Reactivate'" />
              </el-button>
            </template>
          </el-table-column>
        </el-table>

        <el-form :inline="true" @submit.prevent="createItem">
          <el-form-item label="SKU">
            <el-input v-model="itemForm.sku" />
          </el-form-item>
          <el-form-item label="Name">
            <el-input v-model="itemForm.name" />
          </el-form-item>
          <el-form-item label="Unit">
            <el-input v-model="itemForm.unit" />
          </el-form-item>
          <el-form-item>
            <el-button native-type="submit" type="primary">Create item</el-button>
          </el-form-item>
        </el-form>
      </el-tab-pane>

      <el-tab-pane label="Warehouses" name="warehouses">
        <el-table :data="warehouses" stripe>
          <el-table-column prop="code" label="Code" />
          <el-table-column prop="name" label="Name" />
          <el-table-column prop="status" label="Status" />
          <el-table-column label="Actions">
            <template #default="scope">
              <el-button size="small" @click="transitionCatalogRecord('warehouses', scope.row)">
                <span v-text="scope.row.status === 'active' ? 'Archive' : 'Reactivate'" />
              </el-button>
            </template>
          </el-table-column>
        </el-table>

        <el-form :inline="true" @submit.prevent="createWarehouse">
          <el-form-item label="Code">
            <el-input v-model="warehouseForm.code" />
          </el-form-item>
          <el-form-item label="Name">
            <el-input v-model="warehouseForm.name" />
          </el-form-item>
          <el-form-item>
            <el-button native-type="submit" type="primary">Create warehouse</el-button>
          </el-form-item>
        </el-form>
      </el-tab-pane>

      <el-tab-pane label="Reservations" name="reservations">
        <el-table :data="reservations" stripe>
          <el-table-column prop="external_reference" label="Reference" />
          <el-table-column prop="quantity" label="Quantity" />
          <el-table-column prop="status" label="Status" />
          <el-table-column label="Actions">
            <template #default="scope">
              <el-button
                v-if="scope.row.status === 'active'"
                size="small"
                @click="closeReservation(scope.row, 'release')"
              >
                Release
              </el-button>
              <el-button
                v-if="scope.row.status === 'active'"
                size="small"
                type="primary"
                @click="closeReservation(scope.row, 'consume')"
              >
                Consume
              </el-button>
            </template>
          </el-table-column>
        </el-table>

        <el-form :inline="true" @submit.prevent="reserveStock">
          <el-form-item label="Reference">
            <el-input v-model="reservationForm.external_reference" />
          </el-form-item>
          <el-form-item label="Item">
            <el-select v-model="reservationForm.item_id">
              <el-option v-for="item in items" :key="item.id" :label="item.sku" :value="item.id" />
            </el-select>
          </el-form-item>
          <el-form-item label="Warehouse">
            <el-select v-model="reservationForm.warehouse_id">
              <el-option
                v-for="warehouse in warehouses"
                :key="warehouse.id"
                :label="warehouse.code"
                :value="warehouse.id"
              />
            </el-select>
          </el-form-item>
          <el-form-item label="Quantity">
            <el-input v-model="reservationForm.quantity" />
          </el-form-item>
          <el-form-item label="Idempotency key">
            <el-input v-model="reservationForm.idempotency_key" />
          </el-form-item>
          <el-form-item>
            <el-button native-type="submit" type="primary">Reserve</el-button>
          </el-form-item>
        </el-form>
      </el-tab-pane>

      <el-tab-pane label="Procurement" name="procurement">
        <el-table :data="purchaseOrders" stripe>
          <el-table-column prop="number" label="Number" />
          <el-table-column prop="supplier_name" label="Supplier" />
          <el-table-column prop="status" label="Status" />
          <el-table-column label="Actions">
            <template #default="scope">
              <el-button
                v-if="scope.row.status === 'draft'"
                size="small"
                type="primary"
                @click="transitionPurchase(scope.row, 'submit')"
              >
                Submit
              </el-button>
              <el-button
                v-if="scope.row.status === 'draft' || scope.row.status === 'submitted'"
                size="small"
                @click="transitionPurchase(scope.row, 'cancel')"
              >
                Cancel
              </el-button>
            </template>
          </el-table-column>
        </el-table>

        <el-form :inline="true" @submit.prevent="createPurchaseOrder">
          <el-form-item label="Number">
            <el-input v-model="purchaseForm.number" />
          </el-form-item>
          <el-form-item label="Supplier">
            <el-input v-model="purchaseForm.supplier_name" />
          </el-form-item>
          <el-form-item label="Item">
            <el-select v-model="purchaseForm.item_id">
              <el-option v-for="item in items" :key="item.id" :label="item.sku" :value="item.id" />
            </el-select>
          </el-form-item>
          <el-form-item label="Quantity">
            <el-input v-model="purchaseForm.ordered_quantity" />
          </el-form-item>
          <el-form-item>
            <el-button native-type="submit" type="primary">Create purchase order</el-button>
          </el-form-item>
        </el-form>

        <el-form :inline="true" @submit.prevent="receivePurchase">
          <el-form-item label="Purchase order">
            <el-select v-model="receiptForm.purchase_id" @change="receiptForm.line_id = ''">
              <el-option
                v-for="purchase in purchaseOrders.filter((value) =>
                  ['submitted', 'partially_received'].includes(value.status),
                )"
                :key="purchase.id"
                :label="purchase.number"
                :value="purchase.id"
              />
            </el-select>
          </el-form-item>
          <el-form-item label="Line">
            <el-select v-model="receiptForm.line_id">
              <el-option
                v-for="line in selectedPurchase?.lines ?? []"
                :key="line.id"
                :label="
                  line.item_id + ' (' + line.received_quantity + '/' + line.ordered_quantity + ')'
                "
                :value="line.id"
              />
            </el-select>
          </el-form-item>
          <el-form-item label="Warehouse">
            <el-select v-model="receiptForm.warehouse_id">
              <el-option
                v-for="warehouse in warehouses"
                :key="warehouse.id"
                :label="warehouse.code"
                :value="warehouse.id"
              />
            </el-select>
          </el-form-item>
          <el-form-item label="Quantity">
            <el-input v-model="receiptForm.quantity" />
          </el-form-item>
          <el-form-item label="Idempotency key">
            <el-input v-model="receiptForm.idempotency_key" />
          </el-form-item>
          <el-form-item>
            <el-button native-type="submit" type="primary">Receive stock</el-button>
          </el-form-item>
        </el-form>
      </el-tab-pane>
    </el-tabs>
  </section>
</template>
