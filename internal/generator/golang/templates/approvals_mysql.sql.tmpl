insert into identity_permissions (code, description) values
    ('approvals:submit', 'Submit approval requests'),
    ('approvals:mine', 'Read and cancel own approval requests'),
    ('approvals:read', 'Read all approval requests and immutable events'),
    ('approvals:decide', 'Approve or reject pending requests')
on duplicate key update code = code;

insert into identity_role_permissions (role_code, permission_code) values
    ('admin', 'approvals:submit'),
    ('admin', 'approvals:mine'),
    ('admin', 'approvals:read'),
    ('admin', 'approvals:decide'),
    ('user', 'approvals:submit'),
    ('user', 'approvals:mine')
on duplicate key update role_code = role_code;

create table approval_requests (
    id varchar(191) primary key,
{{- if .Tenancy}}
    organization_id varchar(191) not null,
{{- else}}
    organization_id varchar(191) null,
{{- end}}
    subject_type varchar(191) not null,
    subject_id varchar(191) not null,
    requester_user_id varchar(191) not null,
    summary varchar(255) not null,
    details text not null,
    status varchar(32) not null,
    version bigint not null,
    resolution_comment text null,
    resolved_by_user_id varchar(191) null,
    resolved_at datetime(6) null,
    created_at datetime(6) not null,
    updated_at datetime(6) not null,
    approval_scope varchar(191) generated always as (coalesce(organization_id, '')) stored,
    pending_subject_id varchar(191) generated always as (case when status = 'pending' then subject_id else null end) stored,
    constraint approval_subject_type_check check (subject_type = '{{.Business.ModuleName}}.{{.Business.EntityName}}'),
    constraint approval_status_check check (status in ('pending', 'approved', 'rejected', 'cancelled')),
    constraint approval_version_check check (version > 0),
    constraint approval_resolution_check check (
        (status = 'pending' and resolved_by_user_id is null and resolved_at is null)
        or (status <> 'pending' and resolved_by_user_id is not null and resolved_at is not null)
    ),
    constraint approval_requester_fk foreign key (requester_user_id) references identity_users (id),
    constraint approval_resolver_fk foreign key (resolved_by_user_id) references identity_users (id),
{{- if .Tenancy}}
    constraint approval_organization_fk foreign key (organization_id) references organizations (id),
{{- end}}
    unique key approval_pending_subject_unique (approval_scope, pending_subject_id),
    index approval_scope_status_idx (approval_scope, status, id),
    index approval_scope_requester_idx (approval_scope, requester_user_id, id)
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table approval_events (
    id varchar(191) primary key,
    request_id varchar(191) not null,
    actor_user_id varchar(191) not null,
    status varchar(32) not null,
    comment text null,
    created_at datetime(6) not null,
    constraint approval_event_status_check check (status in ('pending', 'approved', 'rejected', 'cancelled')),
    constraint approval_event_request_fk foreign key (request_id) references approval_requests (id) on delete cascade,
    constraint approval_event_actor_fk foreign key (actor_user_id) references identity_users (id),
    index approval_events_request_idx (request_id, created_at, id)
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;
