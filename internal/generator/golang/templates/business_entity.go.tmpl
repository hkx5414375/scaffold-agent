// Create validates and persists one {{.Business.EntityName}} with an audit event.
func (service *Service) Create(ctx context.Context, input WriteInput, actor identity.Principal) ({{.Business.EntityType}}, error) {
	if actor.UserID == ""{{if .Tenancy}} || actor.OrganizationID == ""{{end}} {
		return {{.Business.EntityType}}{}, identity.ErrInvalidCredentials
	}
	if err := validateWrite(input); err != nil {
		return {{.Business.EntityType}}{}, err
	}
	now := service.now().UTC()
	value := {{.Business.EntityType}}{ID: rand.Text(), OrganizationID: actor.OrganizationID, Version: 1, CreatedAt: now, UpdatedAt: now}
	assign(&value, input)
	audit := newAudit(actor, "{{.Business.PermissionPrefix}}:create", value.ID, now)
	if err := service.store.Create(ctx, value, audit); err != nil {
		return {{.Business.EntityType}}{}, fmt.Errorf("create {{.Business.EntityName}}: %w", err)
	}
	return value, nil
}

// Get returns one {{.Business.EntityName}} by identifier.
func (service *Service) Get(ctx context.Context, id string, actor identity.Principal) ({{.Business.EntityType}}, error) {
	id = strings.TrimSpace(id)
	if id == "" || actor.UserID == ""{{if .Tenancy}} || actor.OrganizationID == ""{{end}} {
		return {{.Business.EntityType}}{}, ErrInvalidInput
	}
	value, err := service.store.Get(ctx, actor.OrganizationID, id)
	if err != nil {
		return {{.Business.EntityType}}{}, fmt.Errorf("get {{.Business.EntityName}}: %w", err)
	}
	return value, nil
}

// List returns a bounded keyset page.
func (service *Service) List(ctx context.Context, cursor string, limit int, actor identity.Principal) (Page, error) {
	if limit < 1 || limit > 100 || actor.UserID == ""{{if .Tenancy}} || actor.OrganizationID == ""{{end}} {
		return Page{}, ErrInvalidInput
	}
	items, nextCursor, err := service.store.List(ctx, actor.OrganizationID, cursor, limit)
	if err != nil {
		return Page{}, fmt.Errorf("list {{.Business.EntityName}}: %w", err)
	}
	return Page{Items: items, NextCursor: nextCursor}, nil
}

// Update replaces mutable fields when the caller's version matches.
func (service *Service) Update(ctx context.Context, id string, input UpdateInput, actor identity.Principal) ({{.Business.EntityType}}, error) {
	if actor.UserID == ""{{if .Tenancy}} || actor.OrganizationID == ""{{end}} {
		return {{.Business.EntityType}}{}, identity.ErrInvalidCredentials
	}
	id = strings.TrimSpace(id)
	if id == "" || input.Version < 1 {
		return {{.Business.EntityType}}{}, ErrInvalidInput
	}
	if err := validateWrite(input.WriteInput); err != nil {
		return {{.Business.EntityType}}{}, err
	}
	value := {{.Business.EntityType}}{ID: id, OrganizationID: actor.OrganizationID, Version: input.Version, UpdatedAt: service.now().UTC()}
	assign(&value, input.WriteInput)
	audit := newAudit(actor, "{{.Business.PermissionPrefix}}:update", id, value.UpdatedAt)
	updated, err := service.store.Update(ctx, value, audit)
	if err != nil {
		return {{.Business.EntityType}}{}, fmt.Errorf("update {{.Business.EntityName}}: %w", err)
	}
	return updated, nil
}

// Delete removes one {{.Business.EntityName}} when the caller's version matches.
func (service *Service) Delete(ctx context.Context, id string, version int64, actor identity.Principal) error {
	if actor.UserID == ""{{if .Tenancy}} || actor.OrganizationID == ""{{end}} {
		return identity.ErrInvalidCredentials
	}
	id = strings.TrimSpace(id)
	if id == "" || version < 1{{if .Tenancy}} || actor.OrganizationID == ""{{end}} {
		return ErrInvalidInput
	}
	audit := newAudit(actor, "{{.Business.PermissionPrefix}}:delete", id, service.now().UTC())
	if err := service.store.Delete(ctx, actor.OrganizationID, id, version, audit); err != nil {
		return fmt.Errorf("delete {{.Business.EntityName}}: %w", err)
	}
	return nil
}

