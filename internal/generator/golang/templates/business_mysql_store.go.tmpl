// Package mysql persists {{.Business.EntityName}} aggregates in MySQL.
package mysql

import (
	"context"
	"database/sql"
	"errors"
	"fmt"

	mysqldriver "github.com/go-sql-driver/mysql"

	"{{.ModulePath}}/internal/identity"
	"{{.ModulePath}}/internal/{{.Business.ModuleName}}"
)

// Store is the MySQL {{.Business.EntityName}} repository.
type Store struct {
	database *sql.DB
}

// New returns a MySQL {{.Business.EntityName}} store.
func New(database *sql.DB) *Store {
	return &Store{database: database}
}

func (store *Store) Create(ctx context.Context, value {{.Business.PackageName}}.{{.Business.EntityType}}, audit identity.AuditEvent) error {
	return store.mutate(ctx, func(transaction *sql.Tx) error {
		_, err := transaction.ExecContext(ctx, `
			insert into {{goSQL .Business.TableName}} (id{{range .Business.Fields}}, {{goSQL .Name}}{{end}}, version, created_at, updated_at)
			values (?{{range .Business.Fields}}, ?{{end}}, ?, ?, ?)`,
			value.ID,
{{- range .Business.Fields}}
			value.{{.GoName}},
{{- end}}
			value.Version, value.CreatedAt, value.UpdatedAt,
		)
		if err != nil {
			return persistenceError(err)
		}
		return appendAudit(ctx, transaction, audit)
	})
}

func (store *Store) Get(ctx context.Context, id string) ({{.Business.PackageName}}.{{.Business.EntityType}}, error) {
	return scan{{.Business.EntityType}}(store.database.QueryRowContext(ctx, `
		select id{{range .Business.Fields}}, {{goSQL .Name}}{{end}}, version, created_at, updated_at
		from {{goSQL .Business.TableName}} where id = ?`, id))
}

func (store *Store) List(ctx context.Context, cursor string, limit int) ([]{{.Business.PackageName}}.{{.Business.EntityType}}, string, error) {
	rows, err := store.database.QueryContext(ctx, `
		select id{{range .Business.Fields}}, {{goSQL .Name}}{{end}}, version, created_at, updated_at
		from {{goSQL .Business.TableName}}
		where (? = '' or id > ?)
		order by id
		limit ?`, cursor, cursor, limit+1)
	if err != nil {
		return nil, "", fmt.Errorf("query {{.Business.EntityName}} page: %w", err)
	}
	defer rows.Close()
	items := make([]{{.Business.PackageName}}.{{.Business.EntityType}}, 0, limit)
	for rows.Next() {
		value, err := scan{{.Business.EntityType}}(rows)
		if err != nil {
			return nil, "", err
		}
		items = append(items, value)
	}
	if err := rows.Err(); err != nil {
		return nil, "", fmt.Errorf("read {{.Business.EntityName}} page: %w", err)
	}
	var nextCursor string
	if len(items) > limit {
		nextCursor = items[limit-1].ID
		items = items[:limit]
	}
	return items, nextCursor, nil
}

func (store *Store) Update(ctx context.Context, value {{.Business.PackageName}}.{{.Business.EntityType}}, audit identity.AuditEvent) ({{.Business.PackageName}}.{{.Business.EntityType}}, error) {
	var updated {{.Business.PackageName}}.{{.Business.EntityType}}
	err := store.mutate(ctx, func(transaction *sql.Tx) error {
		command, err := transaction.ExecContext(ctx, `
			update {{goSQL .Business.TableName}}
			set {{range $index, $field := .Business.Fields}}{{if $index}}, {{end}}{{goSQL $field.Name}} = ?{{end}},
				version = version + 1, updated_at = ?
			where id = ? and version = ?`,
{{- range .Business.Fields}}
			value.{{.GoName}},
{{- end}}
			value.UpdatedAt, value.ID, value.Version,
		)
		if err != nil {
			return persistenceError(err)
		}
		rowsAffected, err := command.RowsAffected()
		if err != nil {
			return fmt.Errorf("inspect {{.Business.EntityName}} update: %w", err)
		}
		if rowsAffected != 1 {
			return {{.Business.PackageName}}.ErrConflict
		}
		updated, err = scan{{.Business.EntityType}}(transaction.QueryRowContext(ctx, `
			select id{{range .Business.Fields}}, {{goSQL .Name}}{{end}}, version, created_at, updated_at
			from {{goSQL .Business.TableName}} where id = ?`, value.ID))
		if err != nil {
			return err
		}
		return appendAudit(ctx, transaction, audit)
	})
	if err != nil {
		return {{.Business.PackageName}}.{{.Business.EntityType}}{}, err
	}
	return updated, nil
}

func (store *Store) Delete(ctx context.Context, id string, version int64, audit identity.AuditEvent) error {
	return store.mutate(ctx, func(transaction *sql.Tx) error {
		command, err := transaction.ExecContext(ctx, `
			delete from {{goSQL .Business.TableName}} where id = ? and version = ?`, id, version)
		if err != nil {
			return persistenceError(err)
		}
		rowsAffected, err := command.RowsAffected()
		if err != nil {
			return fmt.Errorf("inspect {{.Business.EntityName}} delete: %w", err)
		}
		if rowsAffected != 1 {
			return {{.Business.PackageName}}.ErrConflict
		}
		return appendAudit(ctx, transaction, audit)
	})
}

func (store *Store) mutate(ctx context.Context, operation func(*sql.Tx) error) error {
	transaction, err := store.database.BeginTx(ctx, nil)
	if err != nil {
		return fmt.Errorf("begin {{.Business.EntityName}} mutation: %w", err)
	}
	if err := operation(transaction); err != nil {
		return rollback(transaction, err)
	}
	if err := transaction.Commit(); err != nil {
		return fmt.Errorf("commit {{.Business.EntityName}} mutation: %w", err)
	}
	return nil
}

func appendAudit(ctx context.Context, transaction *sql.Tx, event identity.AuditEvent) error {
	_, err := transaction.ExecContext(ctx, `
		insert into audit_events (id, user_id, action, outcome, target, ip_address, user_agent, created_at)
		values (?, nullif(?, ''), ?, ?, nullif(?, ''), nullif(?, ''), nullif(?, ''), ?)`,
		event.ID, event.UserID, event.Action, event.Outcome, event.Target, event.IPAddress, event.UserAgent, event.CreatedAt,
	)
	if err != nil {
		return fmt.Errorf("append mutation audit event: %w", err)
	}
	return nil
}

func rollback(transaction *sql.Tx, cause error) error {
	if err := transaction.Rollback(); err != nil && !errors.Is(err, sql.ErrTxDone) {
		return errors.Join(cause, fmt.Errorf("roll back {{.Business.EntityName}} mutation: %w", err))
	}
	return cause
}

type rowScanner interface {
	Scan(...any) error
}

func scan{{.Business.EntityType}}(row rowScanner) ({{.Business.PackageName}}.{{.Business.EntityType}}, error) {
	var value {{.Business.PackageName}}.{{.Business.EntityType}}
	if err := row.Scan(&value.ID{{range .Business.Fields}}, &value.{{.GoName}}{{end}}, &value.Version, &value.CreatedAt, &value.UpdatedAt); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return {{.Business.PackageName}}.{{.Business.EntityType}}{}, {{.Business.PackageName}}.ErrNotFound
		}
		return {{.Business.PackageName}}.{{.Business.EntityType}}{}, fmt.Errorf("scan {{.Business.EntityName}}: %w", err)
	}
	return value, nil
}

func persistenceError(err error) error {
	var databaseError *mysqldriver.MySQLError
	if errors.As(err, &databaseError) && databaseError.Number == 1062 {
		return {{.Business.PackageName}}.ErrConflict
	}
	return err
}

var _ {{.Business.PackageName}}.Store = (*Store)(nil)
