// Package mysql persists commerce catalog products in MySQL.
package mysql

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"time"

	mysqldriver "github.com/go-sql-driver/mysql"

	"{{.ModulePath}}/internal/catalog"
	"{{.ModulePath}}/internal/identity"
)

// Store is the MySQL catalog repository.
type Store struct {
	database *sql.DB
}

// New returns a MySQL catalog store.
func New(database *sql.DB) *Store {
	return &Store{database: database}
}

// Create atomically inserts a draft product and its audit event.
func (store *Store) Create(ctx context.Context, value catalog.Product, audit identity.AuditEvent) error {
	transaction, err := store.database.BeginTx(ctx, nil)
	if err != nil {
		return fmt.Errorf("begin catalog creation: %w", err)
	}
	_, err = transaction.ExecContext(ctx, `
		insert into catalog_products (
			id, organization_id, sku, name, description, price_minor,
			currency, status, version, created_at, updated_at
		) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
		value.ID, nullableOrganization(value.OrganizationID), value.SKU, value.Name,
		value.Description, value.PriceMinor, value.Currency, value.Status,
		value.Version, value.CreatedAt, value.UpdatedAt,
	)
	if err != nil {
		return rollback(transaction, persistenceError(err))
	}
	if err := appendAudit(ctx, transaction, audit); err != nil {
		return rollback(transaction, err)
	}
	if err := transaction.Commit(); err != nil {
		return fmt.Errorf("commit catalog creation: %w", err)
	}
	return nil
}

// Get returns one product inside the selected organization scope.
func (store *Store) Get(ctx context.Context, organizationID, id string) (catalog.Product, error) {
	return scanProduct(store.database.QueryRowContext(ctx, `
		select id, coalesce(organization_id, ''), sku, name, description, price_minor,
			currency, status, version, created_at, updated_at
		from catalog_products
		where id = ? and coalesce(organization_id, '') = ?`, id, organizationID))
}

// GetPublic returns one active product and hides products of inactive organizations.
func (store *Store) GetPublic(ctx context.Context, organizationID, id string) (catalog.Product, error) {
	return scanProduct(store.database.QueryRowContext(ctx, `
		select product.id, coalesce(product.organization_id, ''), product.sku,
			product.name, product.description, product.price_minor, product.currency,
			product.status, product.version, product.created_at, product.updated_at
		from catalog_products product
{{- if .Tenancy}}
		join organizations organization on organization.id = product.organization_id
{{- end}}
		where product.id = ? and coalesce(product.organization_id, '') = ?
			and product.status = 'active'
{{- if .Tenancy}}
			and organization.status = 'active'
{{- end}}`, id, organizationID))
}

// List returns one bounded administration or public page.
func (store *Store) List(
	ctx context.Context,
	organizationID string,
	status catalog.Status,
	cursor string,
	limit int,
	public bool,
) ([]catalog.Product, string, error) {
	rows, err := store.database.QueryContext(ctx, `
		select product.id, coalesce(product.organization_id, ''), product.sku,
			product.name, product.description, product.price_minor, product.currency,
			product.status, product.version, product.created_at, product.updated_at
		from catalog_products product
{{- if .Tenancy}}
		join organizations organization on organization.id = product.organization_id
{{- end}}
		where coalesce(product.organization_id, '') = ?
			and (? = '' or product.status = ?)
			and (not ? or product.status = 'active')
{{- if .Tenancy}}
			and (not ? or organization.status = 'active')
{{- end}}
			and (? = '' or product.id > ?)
		order by product.id
		limit ?`, organizationID, status, status, public,
{{- if .Tenancy}}
		public,
{{- end}}
		cursor, cursor, limit+1)
	if err != nil {
		return nil, "", fmt.Errorf("query catalog product page: %w", err)
	}
	defer rows.Close()
	items := make([]catalog.Product, 0, limit)
	for rows.Next() {
		value, err := scanProduct(rows)
		if err != nil {
			return nil, "", err
		}
		items = append(items, value)
	}
	if err := rows.Err(); err != nil {
		return nil, "", fmt.Errorf("read catalog product page: %w", err)
	}
	nextCursor := ""
	if len(items) > limit {
		nextCursor = items[limit-1].ID
		items = items[:limit]
	}
	return items, nextCursor, nil
}

// Update atomically replaces mutable values and retains the current state.
func (store *Store) Update(ctx context.Context, value catalog.Product, audit identity.AuditEvent) (catalog.Product, error) {
	transaction, err := store.database.BeginTx(ctx, nil)
	if err != nil {
		return catalog.Product{}, fmt.Errorf("begin catalog update: %w", err)
	}
	result, err := transaction.ExecContext(ctx, `
		update catalog_products set
			sku = ?, name = ?, description = ?, price_minor = ?, currency = ?,
			version = version + 1, updated_at = ?
		where id = ? and coalesce(organization_id, '') = ?
			and version = ? and status <> 'archived'`,
		value.SKU, value.Name, value.Description, value.PriceMinor, value.Currency,
		value.UpdatedAt, value.ID, value.OrganizationID, value.Version,
	)
	if err != nil {
		return catalog.Product{}, rollback(transaction, persistenceError(err))
	}
	if err := requireMutation(result); err != nil {
		return catalog.Product{}, rollback(transaction, err)
	}
	updated, err := getTransaction(ctx, transaction, value.OrganizationID, value.ID)
	if err != nil {
		return catalog.Product{}, rollback(transaction, err)
	}
	if err := appendAudit(ctx, transaction, audit); err != nil {
		return catalog.Product{}, rollback(transaction, err)
	}
	if err := transaction.Commit(); err != nil {
		return catalog.Product{}, fmt.Errorf("commit catalog update: %w", err)
	}
	return updated, nil
}

// Transition atomically applies one exact publication state transition.
func (store *Store) Transition(
	ctx context.Context,
	organizationID string,
	id string,
	version int64,
	from catalog.Status,
	to catalog.Status,
	now time.Time,
	audit identity.AuditEvent,
) (catalog.Product, error) {
	transaction, err := store.database.BeginTx(ctx, nil)
	if err != nil {
		return catalog.Product{}, fmt.Errorf("begin catalog transition: %w", err)
	}
	result, err := transaction.ExecContext(ctx, `
		update catalog_products set status = ?, version = version + 1, updated_at = ?
		where id = ? and coalesce(organization_id, '') = ? and version = ? and status = ?`,
		to, now, id, organizationID, version, from,
	)
	if err != nil {
		return catalog.Product{}, rollback(transaction, persistenceError(err))
	}
	if err := requireMutation(result); err != nil {
		return catalog.Product{}, rollback(transaction, err)
	}
	updated, err := getTransaction(ctx, transaction, organizationID, id)
	if err != nil {
		return catalog.Product{}, rollback(transaction, err)
	}
	if err := appendAudit(ctx, transaction, audit); err != nil {
		return catalog.Product{}, rollback(transaction, err)
	}
	if err := transaction.Commit(); err != nil {
		return catalog.Product{}, fmt.Errorf("commit catalog transition: %w", err)
	}
	return updated, nil
}

func getTransaction(ctx context.Context, transaction *sql.Tx, organizationID, id string) (catalog.Product, error) {
	return scanProduct(transaction.QueryRowContext(ctx, `
		select id, coalesce(organization_id, ''), sku, name, description, price_minor,
			currency, status, version, created_at, updated_at
		from catalog_products
		where id = ? and coalesce(organization_id, '') = ?`, id, organizationID))
}

func requireMutation(result sql.Result) error {
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return fmt.Errorf("inspect catalog mutation: %w", err)
	}
	if rowsAffected != 1 {
		return catalog.ErrConflict
	}
	return nil
}

type rowScanner interface {
	Scan(...any) error
}

func scanProduct(row rowScanner) (catalog.Product, error) {
	var value catalog.Product
	if err := row.Scan(
		&value.ID, &value.OrganizationID, &value.SKU, &value.Name, &value.Description,
		&value.PriceMinor, &value.Currency, &value.Status, &value.Version,
		&value.CreatedAt, &value.UpdatedAt,
	); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return catalog.Product{}, catalog.ErrNotFound
		}
		return catalog.Product{}, fmt.Errorf("scan catalog product: %w", err)
	}
	return value, nil
}

func appendAudit(ctx context.Context, transaction *sql.Tx, event identity.AuditEvent) error {
	_, err := transaction.ExecContext(ctx, `
		insert into audit_events (id, user_id, action, outcome, target, ip_address, user_agent, created_at)
		values (?, nullif(?, ''), ?, ?, nullif(?, ''), nullif(?, ''), nullif(?, ''), ?)`,
		event.ID, event.UserID, event.Action, event.Outcome, event.Target,
		event.IPAddress, event.UserAgent, event.CreatedAt,
	)
	if err != nil {
		return fmt.Errorf("append catalog audit event: %w", err)
	}
	return nil
}

func persistenceError(err error) error {
	var databaseError *mysqldriver.MySQLError
	if errors.As(err, &databaseError) && databaseError.Number == 1062 {
		return catalog.ErrConflict
	}
	return err
}

func rollback(transaction *sql.Tx, cause error) error {
	if err := transaction.Rollback(); err != nil && !errors.Is(err, sql.ErrTxDone) {
		return errors.Join(cause, fmt.Errorf("roll back catalog mutation: %w", err))
	}
	return cause
}

func nullableOrganization(value string) any {
	if value == "" {
		return nil
	}
	return value
}

var _ catalog.Store = (*Store)(nil)
