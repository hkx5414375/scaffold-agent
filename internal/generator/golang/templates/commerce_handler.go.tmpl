	var input commerce.RefundInput
	if !decode(response, request, &input) { return }
	value, err := handler.service.Refund(request.Context(), request.PathValue("id"), input, actor); writeCommerce(response, http.StatusOK, value, err, "refund order")
}

func (handler *Handler) reconcile(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	value, err := handler.service.Reconcile(request.Context(), request.PathValue("id"), actor); writeCommerce(response, http.StatusOK, value, err, "reconcile order")
}

func (handler *Handler) campaigns(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	limit, ok := pageLimit(response, request); if !ok { return }
	value, err := handler.service.Campaigns(request.Context(), request.URL.Query().Get("cursor"), limit, actor); writeCommerce(response, http.StatusOK, value, err, "list campaigns")
