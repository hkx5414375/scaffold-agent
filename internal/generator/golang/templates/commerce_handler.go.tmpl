	var input commerce.CouponInput
	if !decode(response, request, &input) { return }
	value, err := handler.service.CreateCoupon(request.Context(), input, actor); writeCommerce(response, http.StatusCreated, value, err, "create coupon")
}

func decode(response http.ResponseWriter, request *http.Request, target any) bool {
	if err := httpjson.Decode(response, request, target); err != nil { httpjson.WriteError(response, http.StatusBadRequest, "request.invalid", err.Error()); return false }; return true
}

func pageLimit(response http.ResponseWriter, request *http.Request) (int, bool) {
	limit := defaultLimit
	if raw := request.URL.Query().Get("limit"); raw != "" { parsed, err := strconv.Atoi(raw); if err != nil { httpjson.WriteError(response, http.StatusBadRequest, "request.invalid", "limit must be an integer"); return 0, false }; limit = parsed }
	return limit, true
}

func writeCommerce(response http.ResponseWriter, status int, value any, err error, operation string) {
	if err != nil { handleError(response, operation, err); return }; httpjson.Write(response, status, value)
}

func handleError(response http.ResponseWriter, operation string, err error) {
	switch {
	case errors.Is(err, commerce.ErrInvalidInput): httpjson.WriteError(response, http.StatusBadRequest, "commerce.invalid", "commerce input is invalid")
	case errors.Is(err, commerce.ErrNotFound), errors.Is(err, catalog.ErrNotFound): httpjson.WriteError(response, http.StatusNotFound, "commerce.not_found", "commerce record was not found")
	case errors.Is(err, commerce.ErrConflict): httpjson.WriteError(response, http.StatusConflict, "commerce.conflict", "commerce state or idempotency key conflicts")
	default: slog.Error(operation, "error", err); httpjson.WriteError(response, http.StatusInternalServerError, "internal.error", "the request could not be completed")
	}
}
