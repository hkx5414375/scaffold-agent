func (handler *Handler) createCampaign(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	var input commerce.CampaignInput
	if !decode(response, request, &input) { return }
	value, err := handler.service.CreateCampaign(request.Context(), input, actor); writeCommerce(response, http.StatusCreated, value, err, "create campaign")
}

func (handler *Handler) activateCampaign(response http.ResponseWriter, request *http.Request, actor identity.Principal) { handler.campaignTransition(response, request, actor, handler.service.ActivateCampaign, "activate campaign") }
func (handler *Handler) archiveCampaign(response http.ResponseWriter, request *http.Request, actor identity.Principal) { handler.campaignTransition(response, request, actor, handler.service.ArchiveCampaign, "archive campaign") }

func (handler *Handler) campaignTransition(response http.ResponseWriter, request *http.Request, actor identity.Principal, operation func(context.Context, string, commerce.TransitionInput, identity.Principal) (commerce.Campaign, error), name string) {
	var input commerce.TransitionInput
	if !decode(response, request, &input) { return }
	value, err := operation(request.Context(), request.PathValue("id"), input, actor); writeCommerce(response, http.StatusOK, value, err, name)
