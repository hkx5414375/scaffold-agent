type Store struct { database *sql.DB }
func New(database *sql.DB) *Store { return &Store{database: database} }

func (store *Store) Cart(ctx context.Context, organizationID, customerID, currency string) (commerce.Cart,error){return loadCart(ctx,store.database,organizationID,customerID,currency)}

func (store *Store) PutLine(ctx context.Context, command commerce.CartLineCommand)(commerce.Cart,error){
	tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return commerce.Cart{},fmt.Errorf("begin cart mutation: %w",err)};cartID:=command.CartID
	if command.Version==0{_,err=tx.ExecContext(ctx,`insert into commerce_carts (id,organization_id,customer_id,currency,status,version,created_at,updated_at) values (?,?,?,?,'active',1,?,?)`,cartID,nullableOrganization(command.OrganizationID),command.CustomerID,command.Currency,command.Now,command.Now)}else{
		result,updateErr:=tx.ExecContext(ctx,`update commerce_carts set version=version+1,updated_at=? where coalesce(organization_id,'')=? and customer_id=? and currency=? and status='active' and version=?`,command.Now,command.OrganizationID,command.CustomerID,command.Currency,command.Version);err=updateErr;if err==nil{if requireOne(result)!=nil{err=commerce.ErrConflict}else{err=tx.QueryRowContext(ctx,`select id from commerce_carts where coalesce(organization_id,'')=? and customer_id=? and currency=? and status='active'`,command.OrganizationID,command.CustomerID,command.Currency).Scan(&cartID)}}}
	if err!=nil{return commerce.Cart{},rollback(tx,persistenceError(err))}
	_,err=tx.ExecContext(ctx,`insert into commerce_cart_lines (cart_id,product_id,sku,name,unit_minor,quantity) values (?,?,?,?,?,?) on duplicate key update sku=values(sku),name=values(name),unit_minor=values(unit_minor),quantity=values(quantity)`,cartID,command.Line.ProductID,command.Line.SKU,command.Line.Name,command.Line.UnitMinor,command.Line.Quantity);if err!=nil{return commerce.Cart{},rollback(tx,persistenceError(err))}
	value,err:=loadCart(ctx,tx,command.OrganizationID,command.CustomerID,command.Currency);if err!=nil{return commerce.Cart{},rollback(tx,err)};if err:=tx.Commit();err!=nil{return commerce.Cart{},err};return value,nil
}

func (store *Store) RemoveLine(ctx context.Context,organizationID,customerID,currency,productID string,version int64,now time.Time)(commerce.Cart,error){
	tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return commerce.Cart{},err};result,err:=tx.ExecContext(ctx,`update commerce_carts set version=version+1,updated_at=? where coalesce(organization_id,'')=? and customer_id=? and currency=? and status='active' and version=?`,now,organizationID,customerID,currency,version);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Cart{},rollback(tx,err)}
	var cartID string;if err:=tx.QueryRowContext(ctx,`select id from commerce_carts where coalesce(organization_id,'')=? and customer_id=? and currency=? and status='active'`,organizationID,customerID,currency).Scan(&cartID);err!=nil{return commerce.Cart{},rollback(tx,notFound(err))};result,err=tx.ExecContext(ctx,`delete from commerce_cart_lines where cart_id=? and product_id=?`,cartID,productID);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Cart{},rollback(tx,err)}
	value,err:=loadCart(ctx,tx,organizationID,customerID,currency);if err!=nil{return commerce.Cart{},rollback(tx,err)};if err:=tx.Commit();err!=nil{return commerce.Cart{},err};return value,nil
}

func(store *Store)Promotion(ctx context.Context,organizationID,currency,couponCode string,subtotal int64,now time.Time)(commerce.Campaign,commerce.Coupon,error){
	if couponCode!=""{var campaign commerce.Campaign;var coupon commerce.Coupon;err:=store.database.QueryRowContext(ctx,`select campaign.id,coalesce(campaign.organization_id,''),campaign.name,campaign.kind,campaign.value,campaign.minimum_minor,campaign.currency,campaign.priority,campaign.coupon_required,campaign.status,campaign.starts_at,campaign.ends_at,campaign.version,campaign.created_at,campaign.updated_at,coupon.id,coalesce(coupon.organization_id,''),coupon.campaign_id,coupon.code,coupon.maximum_uses,coupon.redeemed_uses,coupon.created_at from commerce_campaigns campaign join commerce_coupons coupon on coupon.campaign_id=campaign.id and coalesce(coupon.organization_id,'')=coalesce(campaign.organization_id,'') where coalesce(campaign.organization_id,'')=? and campaign.currency=? and campaign.status='active' and campaign.starts_at<=? and campaign.ends_at>? and campaign.minimum_minor<=? and coupon.code=? and coupon.redeemed_uses<coupon.maximum_uses order by campaign.priority desc,campaign.id limit 1`,organizationID,currency,now,now,subtotal,couponCode).Scan(&campaign.ID,&campaign.OrganizationID,&campaign.Name,&campaign.Kind,&campaign.Value,&campaign.MinimumMinor,&campaign.Currency,&campaign.Priority,&campaign.CouponRequired,&campaign.Status,&campaign.StartsAt,&campaign.EndsAt,&campaign.Version,&campaign.CreatedAt,&campaign.UpdatedAt,&coupon.ID,&coupon.OrganizationID,&coupon.CampaignID,&coupon.Code,&coupon.MaximumUses,&coupon.RedeemedUses,&coupon.CreatedAt);if err!=nil{return commerce.Campaign{},commerce.Coupon{},notFound(err)};return campaign,coupon,nil}
	var campaign commerce.Campaign;err:=scanCampaign(store.database.QueryRowContext(ctx,`select id,coalesce(organization_id,''),name,kind,value,minimum_minor,currency,priority,coupon_required,status,starts_at,ends_at,version,created_at,updated_at from commerce_campaigns where coalesce(organization_id,'')=? and currency=? and status='active' and coupon_required=false and starts_at<=? and ends_at>? and minimum_minor<=? order by priority desc,id limit 1`,organizationID,currency,now,now,subtotal),&campaign);if err!=nil{return commerce.Campaign{},commerce.Coupon{},err};return campaign,commerce.Coupon{},nil
}

func(store *Store)ReplayCheckout(ctx context.Context,organizationID,customerID,key,currency,couponCode string,cartVersion int64)(commerce.Order,error){var orderID,storedCurrency,storedCoupon string;var storedVersion int64;err:=store.database.QueryRowContext(ctx,`select idempotency.order_id,order_value.currency,idempotency.coupon_code,idempotency.cart_version from commerce_checkout_idempotency idempotency join commerce_orders order_value on order_value.id=idempotency.order_id where idempotency.organization_scope=? and idempotency.customer_id=? and idempotency.idempotency_key=?`,organizationID,customerID,key).Scan(&orderID,&storedCurrency,&storedCoupon,&storedVersion);if err!=nil{return commerce.Order{},notFound(err)};if storedCurrency!=currency||storedCoupon!=couponCode||storedVersion!=cartVersion{return commerce.Order{},commerce.ErrConflict};return loadOrder(ctx,store.database,organizationID,customerID,orderID)}

func(store *Store)Checkout(ctx context.Context,command commerce.CheckoutCommand)(commerce.Order,error){
	tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return commerce.Order{},err};var existingOrder,existingCart,existingCoupon string;var existingVersion int64
	err=tx.QueryRowContext(ctx,`select order_id,cart_id,cart_version,coupon_code from commerce_checkout_idempotency where organization_scope=? and customer_id=? and idempotency_key=?`,command.Order.OrganizationID,command.Order.CustomerID,command.IdempotencyKey).Scan(&existingOrder,&existingCart,&existingVersion,&existingCoupon)
	if err==nil{if existingCart!=command.CartID||existingVersion!=command.CartVersion||existingCoupon!=command.Coupon.Code{return commerce.Order{},rollback(tx,commerce.ErrConflict)};value,loadErr:=loadOrder(ctx,tx,command.Order.OrganizationID,command.Order.CustomerID,existingOrder);if loadErr!=nil{return commerce.Order{},rollback(tx,loadErr)};if err:=tx.Commit();err!=nil{return commerce.Order{},err};return value,nil};if !errors.Is(err,sql.ErrNoRows){return commerce.Order{},rollback(tx,err)}
	result,err:=tx.ExecContext(ctx,`update commerce_carts set status='checked_out',version=version+1,updated_at=? where id=? and coalesce(organization_id,'')=? and customer_id=? and status='active' and version=?`,command.Order.UpdatedAt,command.CartID,command.Order.OrganizationID,command.Order.CustomerID,command.CartVersion);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Order{},rollback(tx,err)}
	if command.Campaign.ID!=""{var lockedCampaign string;err=tx.QueryRowContext(ctx,`select id from commerce_campaigns where id=? and coalesce(organization_id,'')=? and status='active' and starts_at<=? and ends_at>? and minimum_minor<=? for update`,command.Campaign.ID,command.Order.OrganizationID,command.Order.CreatedAt,command.Order.CreatedAt,command.Order.SubtotalMinor).Scan(&lockedCampaign);if err!=nil{return commerce.Order{},rollback(tx,conflictNotFound(err))}}
	if command.Coupon.ID!=""{result,err=tx.ExecContext(ctx,`update commerce_coupons set redeemed_uses=redeemed_uses+1 where id=? and campaign_id=? and coalesce(organization_id,'')=? and code=? and redeemed_uses<maximum_uses`,command.Coupon.ID,command.Campaign.ID,command.Order.OrganizationID,command.Coupon.Code);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Order{},rollback(tx,err)}}
	_,err=tx.ExecContext(ctx,`insert into commerce_orders (id,organization_id,customer_id,status,currency,subtotal_minor,discount_minor,total_minor,campaign_id,coupon_code,fulfillment_ref,return_reason,version,created_at,updated_at) values (?,?,?,?,?,?,?,?,nullif(?,''),nullif(?,''),'','',1,?,?)`,command.Order.ID,nullableOrganization(command.Order.OrganizationID),command.Order.CustomerID,command.Order.Status,command.Order.Currency,command.Order.SubtotalMinor,command.Order.DiscountMinor,command.Order.TotalMinor,command.Order.CampaignID,command.Order.CouponCode,command.Order.CreatedAt,command.Order.UpdatedAt);if err!=nil{return commerce.Order{},rollback(tx,persistenceError(err))}
	for _,line:=range command.Order.Lines{_,err=tx.ExecContext(ctx,`insert into commerce_order_lines (order_id,product_id,sku,name,unit_minor,quantity,line_minor) values (?,?,?,?,?,?,?)`,command.Order.ID,line.ProductID,line.SKU,line.Name,line.UnitMinor,line.Quantity,line.LineMinor);if err!=nil{return commerce.Order{},rollback(tx,err)}}
	_,err=tx.ExecContext(ctx,`insert into commerce_payment_intents (id,order_id,provider,provider_ref,status,amount_minor,refunded_minor,currency,updated_at) values (?,?,?,?,?,?,0,?,?)`,command.Order.Payment.ID,command.Order.ID,command.Order.Payment.Provider,command.Order.Payment.ProviderRef,command.Order.Payment.Status,command.Order.Payment.AmountMinor,command.Order.Payment.Currency,command.Order.Payment.UpdatedAt);if err!=nil{return commerce.Order{},rollback(tx,persistenceError(err))}
	_,err=tx.ExecContext(ctx,`insert into commerce_checkout_idempotency (organization_scope,customer_id,idempotency_key,cart_id,cart_version,coupon_code,order_id) values (?,?,?,?,?,?,?)`,command.Order.OrganizationID,command.Order.CustomerID,command.IdempotencyKey,command.CartID,command.CartVersion,command.Coupon.Code,command.Order.ID);if err!=nil{return commerce.Order{},rollback(tx,persistenceError(err))};if err:=appendOrderEvent(ctx,tx,command.Order.ID,"",string(command.Order.Status),"",command.Order.CreatedAt);err!=nil{return commerce.Order{},rollback(tx,err)};if err:=appendAudit(ctx,tx,command.Audit);err!=nil{return commerce.Order{},rollback(tx,err)};value,err:=loadOrder(ctx,tx,command.Order.OrganizationID,command.Order.CustomerID,command.Order.ID);if err!=nil{return commerce.Order{},rollback(tx,err)};if err:=tx.Commit();err!=nil{return commerce.Order{},err};return value,nil
}

func(store *Store)GetOrder(ctx context.Context,organizationID,customerID,id string)(commerce.Order,error){return loadOrder(ctx,store.database,organizationID,customerID,id)}
func(store *Store)ListOrders(ctx context.Context,organizationID,customerID,cursor string,limit int)([]commerce.Order,string,error){rows,err:=store.database.QueryContext(ctx,`select id from commerce_orders where coalesce(organization_id,'')=? and (?='' or customer_id=?) and (?='' or id>?) order by id limit ?`,organizationID,customerID,customerID,cursor,cursor,limit+1);if err!=nil{return nil,"",err};defer rows.Close();ids:=[]string{};for rows.Next(){var id string;if err:=rows.Scan(&id);err!=nil{return nil,"",err};ids=append(ids,id)};next:="";if len(ids)>limit{next=ids[limit-1];ids=ids[:limit]};items:=make([]commerce.Order,0,len(ids));for _,id:=range ids{value,err:=loadOrder(ctx,store.database,organizationID,customerID,id);if err!=nil{return nil,"",err};items=append(items,value)};return items,next,rows.Err()}

func(store *Store)ApplyPayment(ctx context.Context,providerRef,eventID string,status commerce.PaymentStatus,now time.Time)(commerce.Order,error){
	tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return commerce.Order{},err};var existingRef,existingStatus,existingOrder string;err=tx.QueryRowContext(ctx,`select provider_ref,status,order_id from commerce_payment_events where provider='sandbox' and event_id=?`,eventID).Scan(&existingRef,&existingStatus,&existingOrder)
	if err==nil{if existingRef!=providerRef||existingStatus!=string(status){return commerce.Order{},rollback(tx,commerce.ErrConflict)};value,loadErr:=loadOrder(ctx,tx,"","",existingOrder);if loadErr!=nil{return commerce.Order{},rollback(tx,loadErr)};if err:=tx.Commit();err!=nil{return commerce.Order{},err};return value,nil};if !errors.Is(err,sql.ErrNoRows){return commerce.Order{},rollback(tx,err)}
	var orderID,organizationID string;var current commerce.PaymentStatus;err=tx.QueryRowContext(ctx,`select payment.order_id,coalesce(order_value.organization_id,''),payment.status from commerce_payment_intents payment join commerce_orders order_value on order_value.id=payment.order_id where payment.provider_ref=? for update`,providerRef).Scan(&orderID,&organizationID,&current);if err!=nil{return commerce.Order{},rollback(tx,notFound(err))};if current!=commerce.PaymentRequiresAction&&current!=status{return commerce.Order{},rollback(tx,commerce.ErrConflict)}
	if current==commerce.PaymentRequiresAction{result,err:=tx.ExecContext(ctx,`update commerce_payment_intents set status=?,updated_at=? where provider_ref=? and status='requires_action'`,status,now,providerRef);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Order{},rollback(tx,err)};to:=commerce.OrderCancelled;if status==commerce.PaymentSucceeded{to=commerce.OrderConfirmed};result,err=tx.ExecContext(ctx,`update commerce_orders set status=?,version=version+1,updated_at=? where id=? and status='pending_payment'`,to,now,orderID);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Order{},rollback(tx,err)};if err:=appendOrderEvent(ctx,tx,orderID,string(commerce.OrderPendingPayment),string(to),providerRef,now);err!=nil{return commerce.Order{},rollback(tx,err)}}
	_,err=tx.ExecContext(ctx,`insert into commerce_payment_events (provider,event_id,provider_ref,status,order_id,created_at) values ('sandbox',?,?,?,?,?)`,eventID,providerRef,status,orderID,now);if err!=nil{return commerce.Order{},rollback(tx,persistenceError(err))};value,err:=loadOrder(ctx,tx,organizationID,"",orderID);if err!=nil{return commerce.Order{},rollback(tx,err)};if err:=tx.Commit();err!=nil{return commerce.Order{},err};return value,nil
}

func(store *Store)TransitionOrder(ctx context.Context,organizationID,id string,version int64,from,to commerce.OrderStatus,reference string,now time.Time,audit identity.AuditEvent)(commerce.Order,error){tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return commerce.Order{},err};fulfillment,reason:="","";if to==commerce.OrderFulfilled{fulfillment=reference};if to==commerce.OrderReturnRequested{reason=reference};result,err:=tx.ExecContext(ctx,`update commerce_orders set status=?,fulfillment_ref=case when ?<>'' then ? else fulfillment_ref end,return_reason=case when ?<>'' then ? else return_reason end,version=version+1,updated_at=? where id=? and coalesce(organization_id,'')=? and version=? and status=?`,to,fulfillment,fulfillment,reason,reason,now,id,organizationID,version,from);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Order{},rollback(tx,err)};if err:=appendOrderEvent(ctx,tx,id,string(from),string(to),reference,now);err!=nil{return commerce.Order{},rollback(tx,err)};if err:=appendAudit(ctx,tx,audit);err!=nil{return commerce.Order{},rollback(tx,err)};value,err:=loadOrder(ctx,tx,organizationID,"",id);if err!=nil{return commerce.Order{},rollback(tx,err)};if err:=tx.Commit();err!=nil{return commerce.Order{},err};return value,nil}

func(store *Store)Refund(ctx context.Context,organizationID,orderID string,amount int64,key,providerRefundRef string,now time.Time,audit identity.AuditEvent)(commerce.Order,error){tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return commerce.Order{},err};var existingPayment,existingProvider string;var existingAmount int64;err=tx.QueryRowContext(ctx,`select payment_id,provider_ref,amount_minor from commerce_refunds where organization_scope=? and idempotency_key=?`,organizationID,key).Scan(&existingPayment,&existingProvider,&existingAmount);if err==nil{var paymentID string;queryErr:=tx.QueryRowContext(ctx,`select id from commerce_payment_intents where order_id=?`,orderID).Scan(&paymentID);if queryErr!=nil||paymentID!=existingPayment||existingProvider!=providerRefundRef||existingAmount!=amount{return commerce.Order{},rollback(tx,commerce.ErrConflict)};value,loadErr:=loadOrder(ctx,tx,organizationID,"",orderID);if loadErr!=nil{return commerce.Order{},rollback(tx,loadErr)};if err:=tx.Commit();err!=nil{return commerce.Order{},err};return value,nil};if !errors.Is(err,sql.ErrNoRows){return commerce.Order{},rollback(tx,err)};var paymentID string;err=tx.QueryRowContext(ctx,`select payment.id from commerce_payment_intents payment join commerce_orders order_value on order_value.id=payment.order_id where order_value.id=? and coalesce(order_value.organization_id,'')=? and payment.status='succeeded' and payment.refunded_minor+?<=payment.amount_minor for update`,orderID,organizationID,amount).Scan(&paymentID);if err!=nil{return commerce.Order{},rollback(tx,conflictNotFound(err))};result,err:=tx.ExecContext(ctx,`update commerce_payment_intents set refunded_minor=refunded_minor+?,updated_at=? where id=?`,amount,now,paymentID);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Order{},rollback(tx,err)};_,err=tx.ExecContext(ctx,`insert into commerce_refunds (organization_scope,payment_id,idempotency_key,provider_ref,amount_minor,created_at) values (?,?,?,?,?,?)`,organizationID,paymentID,key,providerRefundRef,amount,now);if err!=nil{return commerce.Order{},rollback(tx,persistenceError(err))};if err:=appendAudit(ctx,tx,audit);err!=nil{return commerce.Order{},rollback(tx,err)};value,err:=loadOrder(ctx,tx,organizationID,"",orderID);if err!=nil{return commerce.Order{},rollback(tx,err)};if err:=tx.Commit();err!=nil{return commerce.Order{},err};return value,nil}

func(store *Store)CreateCampaign(ctx context.Context,value commerce.Campaign,audit identity.AuditEvent)error{tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return err};_,err=tx.ExecContext(ctx,`insert into commerce_campaigns (id,organization_id,name,kind,value,minimum_minor,currency,priority,coupon_required,status,starts_at,ends_at,version,created_at,updated_at) values (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,value.ID,nullableOrganization(value.OrganizationID),value.Name,value.Kind,value.Value,value.MinimumMinor,value.Currency,value.Priority,value.CouponRequired,value.Status,value.StartsAt,value.EndsAt,value.Version,value.CreatedAt,value.UpdatedAt);if err!=nil{return rollback(tx,persistenceError(err))};if err:=appendAudit(ctx,tx,audit);err!=nil{return rollback(tx,err)};return tx.Commit()}
func(store *Store)TransitionCampaign(ctx context.Context,organizationID,id string,version int64,from,to commerce.CampaignStatus,now time.Time,audit identity.AuditEvent)(commerce.Campaign,error){tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return commerce.Campaign{},err};result,err:=tx.ExecContext(ctx,`update commerce_campaigns set status=?,version=version+1,updated_at=? where id=? and coalesce(organization_id,'')=? and version=? and status=?`,to,now,id,organizationID,version,from);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return commerce.Campaign{},rollback(tx,err)};var value commerce.Campaign;err=scanCampaign(tx.QueryRowContext(ctx,`select id,coalesce(organization_id,''),name,kind,value,minimum_minor,currency,priority,coupon_required,status,starts_at,ends_at,version,created_at,updated_at from commerce_campaigns where id=?`,id),&value);if err!=nil{return commerce.Campaign{},rollback(tx,err)};if err:=appendAudit(ctx,tx,audit);err!=nil{return commerce.Campaign{},rollback(tx,err)};if err:=tx.Commit();err!=nil{return commerce.Campaign{},err};return value,nil}
func(store *Store)CreateCoupon(ctx context.Context,value commerce.Coupon,audit identity.AuditEvent)error{tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return err};result,err:=tx.ExecContext(ctx,`insert into commerce_coupons (id,organization_id,campaign_id,code,maximum_uses,redeemed_uses,created_at) select ?,?,?,?, ?,0,? from commerce_campaigns where id=? and coalesce(organization_id,'')=? and coupon_required=true and status<>'archived'`,value.ID,nullableOrganization(value.OrganizationID),value.CampaignID,value.Code,value.MaximumUses,value.CreatedAt,value.CampaignID,value.OrganizationID);if err!=nil||requireOne(result)!=nil{if err==nil{err=commerce.ErrConflict};return rollback(tx,persistenceError(err))};if err:=appendAudit(ctx,tx,audit);err!=nil{return rollback(tx,err)};return tx.Commit()}
func(store *Store)ListCampaigns(ctx context.Context,organizationID,cursor string,limit int)([]commerce.Campaign,string,error){rows,err:=store.database.QueryContext(ctx,`select id,coalesce(organization_id,''),name,kind,value,minimum_minor,currency,priority,coupon_required,status,starts_at,ends_at,version,created_at,updated_at from commerce_campaigns where coalesce(organization_id,'')=? and (?='' or id>?) order by id limit ?`,organizationID,cursor,cursor,limit+1);if err!=nil{return nil,"",err};defer rows.Close();items:=[]commerce.Campaign{};for rows.Next(){var value commerce.Campaign;if err:=scanCampaign(rows,&value);err!=nil{return nil,"",err};items=append(items,value)};next:="";if len(items)>limit{next=items[limit-1].ID;items=items[:limit]};return items,next,rows.Err()}

type queryer interface{QueryContext(context.Context,string,...any)(*sql.Rows,error);QueryRowContext(context.Context,string,...any)*sql.Row}
func loadCart(ctx context.Context,database queryer,organizationID,customerID,currency string)(commerce.Cart,error){var value commerce.Cart;err:=database.QueryRowContext(ctx,`select cart.id,coalesce(cart.organization_id,''),cart.customer_id,cart.currency,cart.status,cart.version,cart.created_at,cart.updated_at from commerce_carts cart{{if .Tenancy}} join organizations organization on organization.id=cart.organization_id and organization.status='active'{{end}} where coalesce(cart.organization_id,'')=? and cart.customer_id=? and cart.currency=? and cart.status='active'`,organizationID,customerID,currency).Scan(&value.ID,&value.OrganizationID,&value.CustomerID,&value.Currency,&value.Status,&value.Version,&value.CreatedAt,&value.UpdatedAt);if err!=nil{return commerce.Cart{},notFound(err)};rows,err:=database.QueryContext(ctx,`select product_id,sku,name,unit_minor,quantity,unit_minor*quantity from commerce_cart_lines where cart_id=? order by product_id`,value.ID);if err!=nil{return commerce.Cart{},err};defer rows.Close();value.Lines=[]commerce.CartLine{};for rows.Next(){var line commerce.CartLine;if err:=rows.Scan(&line.ProductID,&line.SKU,&line.Name,&line.UnitMinor,&line.Quantity,&line.LineMinor);err!=nil{return commerce.Cart{},err};if line.LineMinor>0&&value.SubtotalMinor>math.MaxInt64-line.LineMinor{return commerce.Cart{},commerce.ErrConflict};value.SubtotalMinor+=line.LineMinor;value.Lines=append(value.Lines,line)};return value,rows.Err()}
func loadOrder(ctx context.Context,database queryer,organizationID,customerID,id string)(commerce.Order,error){var value commerce.Order;err:=database.QueryRowContext(ctx,`select order_value.id,coalesce(order_value.organization_id,''),order_value.customer_id,order_value.status,order_value.currency,order_value.subtotal_minor,order_value.discount_minor,order_value.total_minor,coalesce(order_value.campaign_id,''),coalesce(order_value.coupon_code,''),order_value.fulfillment_ref,order_value.return_reason,order_value.version,order_value.created_at,order_value.updated_at,payment.id,payment.provider,payment.provider_ref,payment.status,payment.amount_minor,payment.refunded_minor,payment.currency,payment.updated_at from commerce_orders order_value join commerce_payment_intents payment on payment.order_id=order_value.id where order_value.id=? and (?='' or coalesce(order_value.organization_id,'')=?) and (?='' or order_value.customer_id=?)`,id,organizationID,organizationID,customerID,customerID).Scan(&value.ID,&value.OrganizationID,&value.CustomerID,&value.Status,&value.Currency,&value.SubtotalMinor,&value.DiscountMinor,&value.TotalMinor,&value.CampaignID,&value.CouponCode,&value.FulfillmentRef,&value.ReturnReason,&value.Version,&value.CreatedAt,&value.UpdatedAt,&value.Payment.ID,&value.Payment.Provider,&value.Payment.ProviderRef,&value.Payment.Status,&value.Payment.AmountMinor,&value.Payment.RefundedMinor,&value.Payment.Currency,&value.Payment.UpdatedAt);if err!=nil{return commerce.Order{},notFound(err)};rows,err:=database.QueryContext(ctx,`select product_id,sku,name,unit_minor,quantity,line_minor from commerce_order_lines where order_id=? order by product_id`,id);if err!=nil{return commerce.Order{},err};defer rows.Close();value.Lines=[]commerce.OrderLine{};for rows.Next(){var line commerce.OrderLine;if err:=rows.Scan(&line.ProductID,&line.SKU,&line.Name,&line.UnitMinor,&line.Quantity,&line.LineMinor);err!=nil{return commerce.Order{},err};value.Lines=append(value.Lines,line)};return value,rows.Err()}
type rowScanner interface{Scan(...any)error}
func scanCampaign(row rowScanner,value *commerce.Campaign)error{if err:=row.Scan(&value.ID,&value.OrganizationID,&value.Name,&value.Kind,&value.Value,&value.MinimumMinor,&value.Currency,&value.Priority,&value.CouponRequired,&value.Status,&value.StartsAt,&value.EndsAt,&value.Version,&value.CreatedAt,&value.UpdatedAt);err!=nil{return notFound(err)};return nil}
func requireOne(result sql.Result)error{if result==nil{return commerce.ErrConflict};count,err:=result.RowsAffected();if err!=nil{return err};if count!=1{return commerce.ErrConflict};return nil}
func appendOrderEvent(ctx context.Context,tx *sql.Tx,orderID,from,to,reference string,now time.Time)error{_,err:=tx.ExecContext(ctx,`insert into commerce_order_events (id,order_id,from_status,to_status,reference,created_at) values (?,?,?,?,?,?)`,fmt.Sprintf("%s:%d",orderID,now.UnixNano()),orderID,from,to,reference,now);return err}
func appendAudit(ctx context.Context,tx *sql.Tx,event identity.AuditEvent)error{_,err:=tx.ExecContext(ctx,`insert into audit_events (id,user_id,action,outcome,target,ip_address,user_agent,created_at) values (?,nullif(?,''),?,?,nullif(?,''),nullif(?,''),nullif(?,''),?)`,event.ID,event.UserID,event.Action,event.Outcome,event.Target,event.IPAddress,event.UserAgent,event.CreatedAt);return err}
func nullableOrganization(value string)any{if value==""{return nil};return value}
func notFound(err error)error{if errors.Is(err,sql.ErrNoRows){return commerce.ErrNotFound};return err}
func conflictNotFound(err error)error{if errors.Is(err,sql.ErrNoRows){return commerce.ErrConflict};return err}
func persistenceError(err error)error{var databaseError *mysqldriver.MySQLError;if errors.As(err,&databaseError)&&databaseError.Number==1062{return commerce.ErrConflict};return err}
func rollback(tx *sql.Tx,cause error)error{if err:=tx.Rollback();err!=nil&&!errors.Is(err,sql.ErrTxDone){return errors.Join(cause,err)};return cause}
var _ commerce.Repository=(*Store)(nil)
