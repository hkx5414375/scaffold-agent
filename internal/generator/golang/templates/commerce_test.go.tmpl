func TestCalculateDiscountUsesIntegerFloorAndSubtotalCap(t *testing.T) {
	t.Parallel()
	percentage, err := calculateDiscount(999, Campaign{ID: "campaign", Kind: DiscountPercent, Value: 1250})
	if err != nil || percentage != 124 { t.Fatalf("percentage discount = %d, %v", percentage, err) }
	fixed, err := calculateDiscount(999, Campaign{ID: "campaign", Kind: DiscountFixed, Value: 2000})
	if err != nil || fixed != 999 { t.Fatalf("fixed discount = %d, %v", fixed, err) }
}

func TestCheckoutFreezesCartAndPromotionSnapshots(t *testing.T) {
	t.Parallel()
	now := time.Date(2026, 9, 2, 10, 0, 0, 0, time.UTC)
	repository := &fakeRepository{
		cart: Cart{ID: "cart-1", CustomerID: "customer-1", Currency: "USD", Status: CartActive, Version: 3, SubtotalMinor: 2500, Lines: []CartLine{CartLine{ProductID: "product-1", SKU: "SKU-1", Name: "Widget", UnitMinor: 1250, Quantity: 2, LineMinor: 2500}}},
		campaign: Campaign{ID: "campaign-1", Kind: DiscountPercent, Value: 1000, MinimumMinor: 2000},
		coupon: Coupon{ID: "coupon-1", Code: "SAVE10"},
	}
	gateway := &fakeGateway{}
	service := NewService(repository, fakeCatalog{}, gateway); service.now = func() time.Time { return now }
	value, err := service.Checkout(context.Background(), customeraccounts.Account{ID: "customer-1"}, CheckoutInput{Currency: "usd", CouponCode: "save10", IdempotencyKey: "checkout-1", Version: 3})
	if err != nil { t.Fatalf("Checkout() error = %v", err) }
	if value.SubtotalMinor != 2500 || value.DiscountMinor != 250 || value.TotalMinor != 2250 || value.Lines[0].Name != "Widget" || value.Payment.ProviderRef == "" { t.Fatalf("Checkout() = %#v", value) }
	if repository.checkout.CartVersion != 3 || repository.checkout.IdempotencyKey != "checkout-1" || repository.checkout.Coupon.Code != "SAVE10" { t.Fatalf("checkout command = %#v", repository.checkout) }
}

func TestPutLineRejectsCurrencyMismatchBeforePersistence(t *testing.T) {
	t.Parallel()
	repository := &fakeRepository{}
	service := NewService(repository, fakeCatalog{product: catalog.Product{ID: "product-1", SKU: "SKU", Name: "Widget", Currency: "EUR", PriceMinor: 10}}, &fakeGateway{})
	_, err := service.PutLine(context.Background(), customeraccounts.Account{ID: "customer-1"}, "product-1", LineInput{Currency: "USD", Quantity: 1})
	if !errors.Is(err, ErrConflict) || repository.putCalled { t.Fatalf("PutLine() error = %v, putCalled = %v", err, repository.putCalled) }
}

