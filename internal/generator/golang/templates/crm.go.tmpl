func (service *Service) CreateActivity(ctx context.Context, input ActivityWrite, actor identity.Principal) (Activity, error) {
	scope, err := actorScope(actor)
	if err != nil || !validSubject(input.SubjectType) || !validActivityType(input.Type) {
		return Activity{}, ErrInvalidInput
	}
	subjectID, err := identifier(input.SubjectID)
	if err != nil || input.OccurredAt.IsZero() {
		return Activity{}, ErrInvalidInput
	}
	summary, err := requiredText(input.Summary, maximumSummaryLength)
	if err != nil {
		return Activity{}, err
	}
	now := service.now().UTC()
	value := Activity{ID: newID(), OrganizationID: scope, SubjectType: input.SubjectType, SubjectID: subjectID, Type: input.Type, Summary: summary, OccurredAt: input.OccurredAt.UTC(), CreatedBy: actor.UserID, CreatedAt: now}
	if err := service.store.CreateActivity(ctx, value, audit(actor, "crm:activities:create", value.ID, now)); err != nil {
		return Activity{}, wrap("create CRM activity", err)
	}
	return value, nil
}

func (service *Service) ListActivities(ctx context.Context, subjectType SubjectType, subjectID, cursor string, limit int, actor identity.Principal) (ActivityPage, error) {
	scope, err := actorScope(actor)
	if err != nil || !validPage(cursor, limit) || (subjectType != "" && !validSubject(subjectType)) {
		return ActivityPage{}, ErrInvalidInput
	}
	if subjectType == "" && strings.TrimSpace(subjectID) != "" || subjectType != "" && strings.TrimSpace(subjectID) == "" {
		return ActivityPage{}, ErrInvalidInput
	}
	if subjectID != "" {
		subjectID, err = identifier(subjectID)
		if err != nil {
			return ActivityPage{}, err
		}
	}
	items, next, err := service.store.ListActivities(ctx, scope, subjectType, subjectID, strings.TrimSpace(cursor), limit)
	return ActivityPage{Items: items, NextCursor: next}, wrap("list CRM activities", err)
}

