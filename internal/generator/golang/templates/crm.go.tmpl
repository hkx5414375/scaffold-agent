// Package crm owns portable customer relationship management use cases.
package crm

import (
	"context"
	"crypto/rand"
	"errors"
	"net/mail"
	"strconv"
	"strings"
	"time"
	"unicode"
	"unicode/utf8"

	"{{.ModulePath}}/internal/identity"
)

const (
	maximumIdentifierLength = 191
	maximumNameLength       = 160
	maximumSummaryLength    = 4000
	maximumPhoneLength      = 64
)

var (
	// ErrNotFound hides missing and cross-organization CRM records.
	ErrNotFound = errors.New("CRM record not found")
	// ErrConflict represents an optimistic version or lifecycle conflict.
	ErrConflict = errors.New("CRM record conflicts with current state")
	// ErrInvalidInput represents malformed portable CRM input.
	ErrInvalidInput = errors.New("CRM input is invalid")
)

// RecordStatus is the reversible active/archive lifecycle.
type RecordStatus string

const (
	StatusActive   RecordStatus = "active"
	StatusArchived RecordStatus = "archived"
)

// OpportunityStage is the forward-only sales pipeline state.
type OpportunityStage string

const (
	StageLead      OpportunityStage = "lead"
	StageQualified OpportunityStage = "qualified"
	StageProposal  OpportunityStage = "proposal"
	StageWon       OpportunityStage = "won"
	StageLost      OpportunityStage = "lost"
)

// ActivityType is an immutable CRM interaction category.
type ActivityType string

const (
	ActivityNote    ActivityType = "note"
	ActivityCall    ActivityType = "call"
	ActivityEmail   ActivityType = "email"
	ActivityMeeting ActivityType = "meeting"
)

// SubjectType identifies the record referenced by an activity.
type SubjectType string

const (
	SubjectAccount     SubjectType = "account"
	SubjectContact     SubjectType = "contact"
	SubjectOpportunity SubjectType = "opportunity"
)

// Account is a business customer company, not a tenancy organization.
type Account struct {
	ID             string       `json:"id"`
	OrganizationID string       `json:"organization_id,omitempty"`
	Name           string       `json:"name"`
	Status         RecordStatus `json:"status"`
	Version        int64        `json:"version,string"`
	CreatedAt      time.Time    `json:"created_at"`
	UpdatedAt      time.Time    `json:"updated_at"`
}

// Contact is a natural person optionally associated with one CRM account.
type Contact struct {
	ID             string       `json:"id"`
	OrganizationID string       `json:"organization_id,omitempty"`
	AccountID      string       `json:"account_id,omitempty"`
	Name           string       `json:"name"`
	Email          string       `json:"email,omitempty"`
	Phone          string       `json:"phone,omitempty"`
	Status         RecordStatus `json:"status"`
	Version        int64        `json:"version,string"`
	CreatedAt      time.Time    `json:"created_at"`
	UpdatedAt      time.Time    `json:"updated_at"`
}

// Activity is an immutable CRM interaction.
type Activity struct {
	ID             string       `json:"id"`
	OrganizationID string       `json:"organization_id,omitempty"`
	SubjectType    SubjectType  `json:"subject_type"`
	SubjectID      string       `json:"subject_id"`
	Type           ActivityType `json:"type"`
	Summary        string       `json:"summary"`
	OccurredAt     time.Time    `json:"occurred_at"`
	CreatedBy      string       `json:"created_by"`
	CreatedAt      time.Time    `json:"created_at"`
}

// Opportunity is a forward-only sales pipeline record.
type Opportunity struct {
	ID             string           `json:"id"`
	OrganizationID string           `json:"organization_id,omitempty"`
	AccountID      string           `json:"account_id"`
	Name           string           `json:"name"`
	AmountMinor    int64            `json:"amount_minor,string"`
	Currency       string           `json:"currency"`
	Stage          OpportunityStage `json:"stage"`
	Version        int64            `json:"version,string"`
	CreatedAt      time.Time        `json:"created_at"`
	UpdatedAt      time.Time        `json:"updated_at"`
}

type AccountWrite struct {
	Name string `json:"name"`
}

type AccountUpdate struct {
	Name    string `json:"name"`
	Version int64  `json:"version,string"`
}

type ContactWrite struct {
	AccountID string `json:"account_id,omitempty"`
	Name      string `json:"name"`
	Email     string `json:"email,omitempty"`
	Phone     string `json:"phone,omitempty"`
}

type ContactUpdate struct {
	AccountID string `json:"account_id,omitempty"`
	Name      string `json:"name"`
	Email     string `json:"email,omitempty"`
	Phone     string `json:"phone,omitempty"`
	Version   int64  `json:"version,string"`
}

type ActivityWrite struct {
	SubjectType SubjectType  `json:"subject_type"`
	SubjectID   string       `json:"subject_id"`
	Type        ActivityType `json:"type"`
	Summary     string       `json:"summary"`
	OccurredAt  time.Time    `json:"occurred_at"`
}

type OpportunityWrite struct {
	AccountID   string `json:"account_id"`
	Name        string `json:"name"`
	AmountMinor string `json:"amount_minor"`
	Currency    string `json:"currency"`
}

type OpportunityUpdate struct {
	AccountID   string `json:"account_id"`
	Name        string `json:"name"`
	AmountMinor string `json:"amount_minor"`
	Currency    string `json:"currency"`
	Version     int64  `json:"version,string"`
}

type TransitionInput struct {
	Version int64 `json:"version,string"`
}

type StageInput struct {
	Stage   OpportunityStage `json:"stage"`
	Version int64            `json:"version,string"`
}

type AccountPage struct {
	Items      []Account `json:"items"`
	NextCursor string    `json:"next_cursor,omitempty"`
}

type ContactPage struct {
	Items      []Contact `json:"items"`
	NextCursor string    `json:"next_cursor,omitempty"`
}

type ActivityPage struct {
	Items      []Activity `json:"items"`
	NextCursor string     `json:"next_cursor,omitempty"`
}

type OpportunityPage struct {
	Items      []Opportunity `json:"items"`
	NextCursor string        `json:"next_cursor,omitempty"`
}

// Store is the atomic CRM persistence boundary.
type Store interface {
	CreateAccount(context.Context, Account, identity.AuditEvent) error
	GetAccount(context.Context, string, string) (Account, error)
	ListAccounts(context.Context, string, RecordStatus, string, int) ([]Account, string, error)
	UpdateAccount(context.Context, string, string, string, int64, time.Time, identity.AuditEvent) (Account, error)
	TransitionAccount(context.Context, string, string, int64, RecordStatus, RecordStatus, time.Time, identity.AuditEvent) (Account, error)
	CreateContact(context.Context, Contact, identity.AuditEvent) error
	GetContact(context.Context, string, string) (Contact, error)
	ListContacts(context.Context, string, RecordStatus, string, int) ([]Contact, string, error)
	UpdateContact(context.Context, string, Contact, int64, time.Time, identity.AuditEvent) (Contact, error)
	TransitionContact(context.Context, string, string, int64, RecordStatus, RecordStatus, time.Time, identity.AuditEvent) (Contact, error)
	CreateActivity(context.Context, Activity, identity.AuditEvent) error
	ListActivities(context.Context, string, SubjectType, string, string, int) ([]Activity, string, error)
	CreateOpportunity(context.Context, Opportunity, identity.AuditEvent) error
	GetOpportunity(context.Context, string, string) (Opportunity, error)
	ListOpportunities(context.Context, string, OpportunityStage, string, int) ([]Opportunity, string, error)
	UpdateOpportunity(context.Context, string, Opportunity, int64, time.Time, identity.AuditEvent) (Opportunity, error)
	AdvanceOpportunity(context.Context, string, string, int64, OpportunityStage, OpportunityStage, time.Time, identity.AuditEvent) (Opportunity, error)
}

// Service enforces CRM domain rules independently from HTTP and SQL.
type Service struct {
	store Store
	now   func() time.Time
}

func NewService(store Store) *Service { return &Service{store: store, now: time.Now} }

func (service *Service) CreateAccount(ctx context.Context, input AccountWrite, actor identity.Principal) (Account, error) {
	scope, err := actorScope(actor)
	if err != nil {
		return Account{}, err
	}
	name, err := requiredText(input.Name, maximumNameLength)
	if err != nil {
		return Account{}, err
	}
	now := service.now().UTC()
	value := Account{ID: newID(), OrganizationID: scope, Name: name, Status: StatusActive, Version: 1, CreatedAt: now, UpdatedAt: now}
	if err := service.store.CreateAccount(ctx, value, audit(actor, "crm:accounts:create", value.ID, now)); err != nil {
		return Account{}, wrap("create CRM account", err)
	}
	return value, nil
}

func (service *Service) GetAccount(ctx context.Context, id string, actor identity.Principal) (Account, error) {
	scope, id, err := scopeAndID(actor, id)
	if err != nil {
		return Account{}, err
	}
	value, err := service.store.GetAccount(ctx, scope, id)
	return value, wrap("get CRM account", err)
}

func (service *Service) ListAccounts(ctx context.Context, status RecordStatus, cursor string, limit int, actor identity.Principal) (AccountPage, error) {
	scope, err := actorScope(actor)
	if err != nil || !validStatusFilter(status) || !validPage(cursor, limit) {
		return AccountPage{}, ErrInvalidInput
	}
	items, next, err := service.store.ListAccounts(ctx, scope, status, strings.TrimSpace(cursor), limit)
	return AccountPage{Items: items, NextCursor: next}, wrap("list CRM accounts", err)
}

func (service *Service) UpdateAccount(ctx context.Context, id string, input AccountUpdate, actor identity.Principal) (Account, error) {
	scope, id, err := scopeAndID(actor, id)
	if err != nil || input.Version < 1 {
		return Account{}, ErrInvalidInput
	}
	name, err := requiredText(input.Name, maximumNameLength)
	if err != nil {
		return Account{}, err
	}
	now := service.now().UTC()
	value, err := service.store.UpdateAccount(ctx, scope, id, name, input.Version, now, audit(actor, "crm:accounts:update", id, now))
	return value, wrap("update CRM account", err)
}

func (service *Service) ArchiveAccount(ctx context.Context, id string, input TransitionInput, actor identity.Principal) (Account, error) {
	return service.transitionAccount(ctx, id, input.Version, StatusActive, StatusArchived, "crm:accounts:archive", actor)
}

func (service *Service) ReactivateAccount(ctx context.Context, id string, input TransitionInput, actor identity.Principal) (Account, error) {
	return service.transitionAccount(ctx, id, input.Version, StatusArchived, StatusActive, "crm:accounts:reactivate", actor)
}

func (service *Service) transitionAccount(ctx context.Context, id string, version int64, from, to RecordStatus, action string, actor identity.Principal) (Account, error) {
	scope, id, err := scopeAndID(actor, id)
	if err != nil || version < 1 {
		return Account{}, ErrInvalidInput
	}
	now := service.now().UTC()
	value, err := service.store.TransitionAccount(ctx, scope, id, version, from, to, now, audit(actor, action, id, now))
	return value, wrap("transition CRM account", err)
}

