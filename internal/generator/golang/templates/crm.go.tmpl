	now := service.now().UTC()
	value := Opportunity{ID: newID(), OrganizationID: scope, AccountID: accountID, Name: name, AmountMinor: amount, Currency: currency, Stage: StageLead, Version: 1, CreatedAt: now, UpdatedAt: now}
	if err := service.store.CreateOpportunity(ctx, value, audit(actor, "crm:opportunities:create", value.ID, now)); err != nil {
		return Opportunity{}, wrap("create CRM opportunity", err)
	}
	return value, nil
}

