func (service *Service) UpdateOpportunity(ctx context.Context, id string, input OpportunityUpdate, actor identity.Principal) (Opportunity, error) {
	scope, id, err := scopeAndID(actor, id)
	if err != nil || input.Version < 1 {
		return Opportunity{}, ErrInvalidInput
	}
	accountID, name, amount, currency, err := normalizeOpportunity(OpportunityWrite{AccountID: input.AccountID, Name: input.Name, AmountMinor: input.AmountMinor, Currency: input.Currency})
	if err != nil {
		return Opportunity{}, err
	}
	now := service.now().UTC()
	value := Opportunity{ID: id, OrganizationID: scope, AccountID: accountID, Name: name, AmountMinor: amount, Currency: currency}
	value, err = service.store.UpdateOpportunity(ctx, scope, value, input.Version, now, audit(actor, "crm:opportunities:update", id, now))
	return value, wrap("update CRM opportunity", err)
}

func (service *Service) AdvanceOpportunity(ctx context.Context, id string, input StageInput, actor identity.Principal) (Opportunity, error) {
	scope, id, err := scopeAndID(actor, id)
	if err != nil || input.Version < 1 {
		return Opportunity{}, ErrInvalidInput
	}
	current, err := service.store.GetOpportunity(ctx, scope, id)
	if err != nil {
		return Opportunity{}, wrap("get CRM opportunity for transition", err)
	}
	if !validStageTransition(current.Stage, input.Stage) {
		return Opportunity{}, ErrConflict
	}
	now := service.now().UTC()
	value, err := service.store.AdvanceOpportunity(ctx, scope, id, input.Version, current.Stage, input.Stage, now, audit(actor, "crm:opportunities:advance", id, now))
	return value, wrap("advance CRM opportunity", err)
}

func normalizeContact(input ContactWrite) (ContactWrite, error) {
	name, err := requiredText(input.Name, maximumNameLength)
	if err != nil {
		return ContactWrite{}, err
	}
	accountID := strings.TrimSpace(input.AccountID)
	if accountID != "" {
		accountID, err = identifier(accountID)
		if err != nil {
			return ContactWrite{}, err
		}
	}
	email := strings.ToLower(strings.TrimSpace(input.Email))
	if email != "" {
		address, parseErr := mail.ParseAddress(email)
		if parseErr != nil || address.Address != email || len(email) > 254 || !printable(email) {
			return ContactWrite{}, ErrInvalidInput
		}
	}
	phone := strings.TrimSpace(input.Phone)
	if len(phone) > maximumPhoneLength || !printable(phone) {
		return ContactWrite{}, ErrInvalidInput
	}
	return ContactWrite{AccountID: accountID, Name: name, Email: email, Phone: phone}, nil
}

func normalizeOpportunity(input OpportunityWrite) (string, string, int64, string, error) {
	accountID, err := identifier(input.AccountID)
	if err != nil {
		return "", "", 0, "", err
	}
	name, err := requiredText(input.Name, maximumNameLength)
	if err != nil {
		return "", "", 0, "", err
	}
	amount, err := strconv.ParseInt(input.AmountMinor, 10, 64)
	if err != nil || amount < 0 || strconv.FormatInt(amount, 10) != input.AmountMinor {
		return "", "", 0, "", ErrInvalidInput
	}
	currency := strings.ToUpper(strings.TrimSpace(input.Currency))
	if len(currency) != 3 || strings.IndexFunc(currency, func(character rune) bool { return character < 'A' || character > 'Z' }) >= 0 {
		return "", "", 0, "", ErrInvalidInput
	}
	return accountID, name, amount, currency, nil
}

func actorScope(actor identity.Principal) (string, error) {
	if actor.UserID == "" || len(actor.UserID) > maximumIdentifierLength || !printable(actor.UserID) {
		return "", ErrInvalidInput
	}
{{- if .Tenancy}}
	scope := strings.TrimSpace(actor.OrganizationID)
	if scope == "" || len(scope) > maximumIdentifierLength || !printable(scope) {
		return "", ErrInvalidInput
	}
	return scope, nil
{{- else}}
	return "", nil
{{- end}}
}

func scopeAndID(actor identity.Principal, value string) (string, string, error) {
	scope, err := actorScope(actor)
	if err != nil {
		return "", "", err
	}
	id, err := identifier(value)
	return scope, id, err
}

func identifier(value string) (string, error) {
	value = strings.TrimSpace(value)
	if value == "" || len(value) > maximumIdentifierLength || !printable(value) {
		return "", ErrInvalidInput
	}
	return value, nil
}

func requiredText(value string, maximum int) (string, error) {
	value = strings.TrimSpace(value)
	if value == "" || utf8.RuneCountInString(value) > maximum || !printable(value) {
		return "", ErrInvalidInput
	}
	return value, nil
}

func validPage(cursor string, limit int) bool {
	cursor = strings.TrimSpace(cursor)
	return limit >= 1 && limit <= 100 && len(cursor) <= maximumIdentifierLength && printable(cursor)
}

func validStatusFilter(value RecordStatus) bool { return value == "" || value == StatusActive || value == StatusArchived }
func validStageFilter(value OpportunityStage) bool {
	return value == "" || value == StageLead || value == StageQualified || value == StageProposal || value == StageWon || value == StageLost
}
func validActivityType(value ActivityType) bool {
	return value == ActivityNote || value == ActivityCall || value == ActivityEmail || value == ActivityMeeting
}
func validSubject(value SubjectType) bool {
	return value == SubjectAccount || value == SubjectContact || value == SubjectOpportunity
}
func validStageTransition(from, to OpportunityStage) bool {
	return to == StageLost && (from == StageLead || from == StageQualified || from == StageProposal) ||
		from == StageLead && to == StageQualified || from == StageQualified && to == StageProposal || from == StageProposal && to == StageWon
}

func printable(value string) bool {
	return strings.IndexFunc(value, func(character rune) bool { return !unicode.IsGraphic(character) }) < 0
}

func audit(actor identity.Principal, action, target string, now time.Time) identity.AuditEvent {
	return identity.AuditEvent{ID: newID(), UserID: actor.UserID, Action: action, Outcome: "succeeded", Target: target, CreatedAt: now}
}

func wrap(operation string, err error) error {
	if err == nil {
		return nil
	}
	return errors.Join(errors.New(operation), err)
}

func newID() string { return rand.Text() }
