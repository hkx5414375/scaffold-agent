}

func (handler *Handler) archiveAccount(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	handler.transitionAccount(response, request, actor, handler.service.ArchiveAccount, "archive CRM account")
}

func (handler *Handler) reactivateAccount(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	handler.transitionAccount(response, request, actor, handler.service.ReactivateAccount, "reactivate CRM account")
}

func (handler *Handler) transitionAccount(response http.ResponseWriter, request *http.Request, actor identity.Principal, operation func(context.Context, string, crm.TransitionInput, identity.Principal) (crm.Account, error), name string) {
	var input crm.TransitionInput
	if !decode(response, request, &input) {
		return
	}
	value, err := operation(request.Context(), request.PathValue("id"), input, actor)
	writeResult(response, http.StatusOK, value, name, err)
}

