func decode(response http.ResponseWriter, request *http.Request, target any) bool {
	if err := httpjson.Decode(response, request, target); err != nil {
		httpjson.WriteError(response, http.StatusBadRequest, "request.invalid", err.Error())
		return false
	}
	return true
}

func pageLimit(response http.ResponseWriter, request *http.Request) (int, bool) {
	limit := defaultPageLimit
	if raw := request.URL.Query().Get("limit"); raw != "" {
		value, err := strconv.Atoi(raw)
		if err != nil {
			httpjson.WriteError(response, http.StatusBadRequest, "request.invalid", "limit must be an integer")
			return 0, false
		}
		limit = value
	}
	return limit, true
}

func writeResult(response http.ResponseWriter, status int, value any, operation string, err error) {
	if err != nil {
		handleError(response, operation, err)
		return
	}
	httpjson.Write(response, status, value)
}

func handleError(response http.ResponseWriter, operation string, err error) {
	switch {
	case errors.Is(err, crm.ErrInvalidInput):
		httpjson.WriteError(response, http.StatusBadRequest, "crm.invalid", "CRM data is invalid")
	case errors.Is(err, crm.ErrNotFound):
		httpjson.WriteError(response, http.StatusNotFound, "crm.not_found", "CRM record was not found")
	case errors.Is(err, crm.ErrConflict):
		httpjson.WriteError(response, http.StatusConflict, "crm.conflict", "CRM record changed or conflicts with current state")
	default:
		slog.Error(operation, "error", err)
		httpjson.WriteError(response, http.StatusInternalServerError, "internal.error", "the request could not be completed")
	}
}
