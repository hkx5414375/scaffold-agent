// Package httpapi exposes permission-protected CRM routes.
package httpapi

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"strconv"

	"{{.ModulePath}}/internal/crm"
	"{{.ModulePath}}/internal/identity"
	identityhttp "{{.ModulePath}}/internal/identity/httpapi"
	"{{.ModulePath}}/internal/platform/httpjson"
)

const defaultPageLimit = 20

// Handler maps CRM use cases to HTTP.
type Handler struct{ service *crm.Service }

// New returns a CRM HTTP adapter.
func New(service *crm.Service) *Handler { return &Handler{service: service} }

// Register adds all CRM routes with their least-privilege permissions.
func (handler *Handler) Register(mux *http.ServeMux, security *identityhttp.Handler) {
	mux.HandleFunc("POST /api/v1/crm/accounts", security.Authorized("crm:write", handler.createAccount))
	mux.HandleFunc("GET /api/v1/crm/accounts", security.Authorized("crm:read", handler.listAccounts))
	mux.HandleFunc("GET /api/v1/crm/accounts/{id}", security.Authorized("crm:read", handler.getAccount))
	mux.HandleFunc("PUT /api/v1/crm/accounts/{id}", security.Authorized("crm:write", handler.updateAccount))
	mux.HandleFunc("POST /api/v1/crm/accounts/{id}/archive", security.Authorized("crm:write", handler.archiveAccount))
	mux.HandleFunc("POST /api/v1/crm/accounts/{id}/reactivate", security.Authorized("crm:write", handler.reactivateAccount))
	mux.HandleFunc("POST /api/v1/crm/contacts", security.Authorized("crm:write", handler.createContact))
	mux.HandleFunc("GET /api/v1/crm/contacts", security.Authorized("crm:read", handler.listContacts))
	mux.HandleFunc("GET /api/v1/crm/contacts/{id}", security.Authorized("crm:read", handler.getContact))
	mux.HandleFunc("PUT /api/v1/crm/contacts/{id}", security.Authorized("crm:write", handler.updateContact))
	mux.HandleFunc("POST /api/v1/crm/contacts/{id}/archive", security.Authorized("crm:write", handler.archiveContact))
	mux.HandleFunc("POST /api/v1/crm/contacts/{id}/reactivate", security.Authorized("crm:write", handler.reactivateContact))
	mux.HandleFunc("POST /api/v1/crm/activities", security.Authorized("crm:write", handler.createActivity))
	mux.HandleFunc("GET /api/v1/crm/activities", security.Authorized("crm:read", handler.listActivities))
	mux.HandleFunc("POST /api/v1/crm/opportunities", security.Authorized("crm:write", handler.createOpportunity))
	mux.HandleFunc("GET /api/v1/crm/opportunities", security.Authorized("crm:read", handler.listOpportunities))
	mux.HandleFunc("GET /api/v1/crm/opportunities/{id}", security.Authorized("crm:read", handler.getOpportunity))
	mux.HandleFunc("PUT /api/v1/crm/opportunities/{id}", security.Authorized("crm:write", handler.updateOpportunity))
	mux.HandleFunc("POST /api/v1/crm/opportunities/{id}/advance", security.Authorized("crm:pipeline:manage", handler.advanceOpportunity))
}

func (handler *Handler) createAccount(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	var input crm.AccountWrite
	if !decode(response, request, &input) {
		return
	}
	value, err := handler.service.CreateAccount(request.Context(), input, actor)
	writeResult(response, http.StatusCreated, value, "create CRM account", err)
}

func (handler *Handler) getAccount(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	value, err := handler.service.GetAccount(request.Context(), request.PathValue("id"), actor)
	writeResult(response, http.StatusOK, value, "get CRM account", err)
}

func (handler *Handler) listAccounts(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	limit, ok := pageLimit(response, request)
	if !ok {
		return
	}
	value, err := handler.service.ListAccounts(request.Context(), crm.RecordStatus(request.URL.Query().Get("status")), request.URL.Query().Get("cursor"), limit, actor)
	writeResult(response, http.StatusOK, value, "list CRM accounts", err)
}

func (handler *Handler) updateAccount(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	var input crm.AccountUpdate
	if !decode(response, request, &input) {
		return
	}
	value, err := handler.service.UpdateAccount(request.Context(), request.PathValue("id"), input, actor)
