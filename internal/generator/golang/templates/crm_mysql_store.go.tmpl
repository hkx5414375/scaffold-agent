func nullable(value string) any {
	if value == "" {
		return nil
	}
	return value
}

func persistenceError(err error) error {
	var databaseError *mysqldriver.MySQLError
	if errors.As(err, &databaseError) && databaseError.Number == 1062 {
		return crm.ErrConflict
	}
	return err
}

func rollback(tx *sql.Tx, cause error) error {
	if err := tx.Rollback(); err != nil && !errors.Is(err, sql.ErrTxDone) {
		return errors.Join(cause, fmt.Errorf("roll back CRM mutation: %w", err))
	}
	return cause
}

var _ crm.Store = (*Store)(nil)
