func scanOpportunity(row rowScanner) (crm.Opportunity, error) {
	var value crm.Opportunity
	if err := row.Scan(&value.ID, &value.OrganizationID, &value.AccountID, &value.Name, &value.AmountMinor, &value.Currency, &value.Stage, &value.Version, &value.CreatedAt, &value.UpdatedAt); err != nil {
