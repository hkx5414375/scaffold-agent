// Store is the MySQL CRM repository.
type Store struct{ database *sql.DB }

// New returns a MySQL CRM store.
func New(database *sql.DB) *Store { return &Store{database: database} }

func (store *Store) CreateAccount(ctx context.Context, value crm.Account, audit identity.AuditEvent) error {
	return store.mutate(ctx, func(tx *sql.Tx) error {
		if err := requireActiveScope(ctx, tx, value.OrganizationID); err != nil {
			return err
		}
		_, err := tx.ExecContext(ctx, `insert into crm_accounts
			(id, organization_id, name, status, version, created_at, updated_at)
			values (?, ?, ?, ?, ?, ?, ?)`, value.ID, nullable(value.OrganizationID), value.Name,
			value.Status, value.Version, value.CreatedAt, value.UpdatedAt)
		if err != nil {
			return persistenceError(err)
		}
		return appendAudit(ctx, tx, audit)
	})
}

func (store *Store) GetAccount(ctx context.Context, scope, id string) (crm.Account, error) {
	return scanAccount(store.database.QueryRowContext(ctx, accountSelect+`
		where account.id = ? and coalesce(account.organization_id, '') = ?`+activeScopePredicate("account"), id, scope))
}

func (store *Store) ListAccounts(ctx context.Context, scope string, status crm.RecordStatus, cursor string, limit int) ([]crm.Account, string, error) {
	rows, err := store.database.QueryContext(ctx, accountSelect+`
		where coalesce(account.organization_id, '') = ? and (? = '' or account.status = ?)
			and (? = '' or account.id > ?)`+activeScopePredicate("account")+`
		order by account.id limit ?`, scope, status, status, cursor, cursor, limit+1)
	if err != nil {
		return nil, "", fmt.Errorf("query CRM accounts: %w", err)
	}
	defer rows.Close()
	items := make([]crm.Account, 0, limit+1)
	for rows.Next() {
		value, scanErr := scanAccount(rows)
		if scanErr != nil {
			return nil, "", scanErr
		}
		items = append(items, value)
	}
	if err := rows.Err(); err != nil {
		return nil, "", fmt.Errorf("iterate CRM accounts: %w", err)
	}
	return accountPage(items, limit)
}

func (store *Store) UpdateAccount(ctx context.Context, scope, id, name string, version int64, now time.Time, audit identity.AuditEvent) (crm.Account, error) {
	var value crm.Account
	err := store.mutate(ctx, func(tx *sql.Tx) error {
		if err := requireActiveScope(ctx, tx, scope); err != nil {
			return err
		}
		result, err := tx.ExecContext(ctx, `update crm_accounts set name=?, version=version+1, updated_at=?
			where id=? and coalesce(organization_id, '')=? and version=? and status='active'`, name, now, id, scope, version)
		if err != nil {
			return persistenceError(err)
		}
		if err := requireMutation(result); err != nil {
			return err
		}
		value, err = getAccount(ctx, tx, scope, id)
		if err != nil {
			return err
		}
		return appendAudit(ctx, tx, audit)
	})
	return value, err
}

