	var value crm.Contact
	if err := row.Scan(&value.ID, &value.OrganizationID, &value.AccountID, &value.Name, &value.Email, &value.Phone, &value.Status, &value.Version, &value.CreatedAt, &value.UpdatedAt); err != nil {
		return crm.Contact{}, scanError("contact", err)
