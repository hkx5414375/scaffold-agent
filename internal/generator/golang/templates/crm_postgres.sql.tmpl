insert into identity_permissions (code, description) values
    ('crm:read', 'Read CRM accounts, contacts, activities, and opportunities'),
    ('crm:write', 'Create and update CRM accounts, contacts, activities, and opportunities'),
    ('crm:pipeline:manage', 'Advance CRM opportunity stages')
on conflict (code) do nothing;

insert into identity_role_permissions (role_code, permission_code) values
    ('admin', 'crm:read'), ('admin', 'crm:write'), ('admin', 'crm:pipeline:manage')
on conflict (role_code, permission_code) do nothing;

create table if not exists crm_accounts (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    name varchar(160) not null,
    status varchar(16) not null check (status in ('active', 'archived')),
    version bigint not null check (version > 0),
    created_at timestamptz not null,
    updated_at timestamptz not null
);
create index if not exists crm_accounts_scope_status_id_idx on crm_accounts ({{if .Tenancy}}organization_id, {{end}}status, id);

create table if not exists crm_contacts (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    account_id varchar(191) references crm_accounts(id),
    name varchar(160) not null,
    email varchar(254),
    phone varchar(64),
    status varchar(16) not null check (status in ('active', 'archived')),
    version bigint not null check (version > 0),
    created_at timestamptz not null,
    updated_at timestamptz not null,
    unique ({{if .Tenancy}}organization_id, {{end}}email)
);
create index if not exists crm_contacts_scope_status_id_idx on crm_contacts ({{if .Tenancy}}organization_id, {{end}}status, id);
create index if not exists crm_contacts_account_id_idx on crm_contacts (account_id, id);

create table if not exists crm_opportunities (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    account_id varchar(191) not null references crm_accounts(id),
    name varchar(160) not null,
    amount_minor bigint not null check (amount_minor >= 0),
    currency char(3) not null,
    stage varchar(16) not null check (stage in ('lead', 'qualified', 'proposal', 'won', 'lost')),
    version bigint not null check (version > 0),
    created_at timestamptz not null,
    updated_at timestamptz not null
);
create index if not exists crm_opportunities_scope_stage_id_idx on crm_opportunities ({{if .Tenancy}}organization_id, {{end}}stage, id);
create index if not exists crm_opportunities_account_id_idx on crm_opportunities (account_id, id);

create table if not exists crm_activities (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    subject_type varchar(16) not null check (subject_type in ('account', 'contact', 'opportunity')),
    subject_id varchar(191) not null,
    activity_type varchar(16) not null check (activity_type in ('note', 'call', 'email', 'meeting')),
    summary text not null,
    occurred_at timestamptz not null,
    created_by varchar(191) not null references identity_users(id),
    created_at timestamptz not null
);
create index if not exists crm_activities_scope_subject_id_idx on crm_activities ({{if .Tenancy}}organization_id, {{end}}subject_type, subject_id, id);
