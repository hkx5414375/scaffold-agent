func scanError(kind string, err error) error {
	if errors.Is(err, pgx.ErrNoRows) {
		return crm.ErrNotFound
	}
	return fmt.Errorf("scan CRM %s: %w", kind, err)
}

func accountPage(items []crm.Account, limit int) ([]crm.Account, string, error) {
	if len(items) <= limit {
		return items, "", nil
	}
	return items[:limit], items[limit-1].ID, nil
}
func contactPage(items []crm.Contact, limit int) ([]crm.Contact, string, error) {
	if len(items) <= limit {
		return items, "", nil
	}
	return items[:limit], items[limit-1].ID, nil
}
