}

func scanActivity(row rowScanner) (crm.Activity, error) {
	var value crm.Activity
	if err := row.Scan(&value.ID, &value.OrganizationID, &value.SubjectType, &value.SubjectID, &value.Type, &value.Summary, &value.OccurredAt, &value.CreatedBy, &value.CreatedAt); err != nil {
