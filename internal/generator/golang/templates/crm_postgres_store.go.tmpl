const accountSelect = `select account.id, coalesce(account.organization_id, ''), account.name,
	account.status, account.version, account.created_at, account.updated_at from crm_accounts account`
const contactSelect = `select contact.id, coalesce(contact.organization_id, ''), coalesce(contact.account_id, ''),
	contact.name, coalesce(contact.email, ''), coalesce(contact.phone, ''), contact.status, contact.version,
	contact.created_at, contact.updated_at from crm_contacts contact`
const activitySelect = `select activity.id, coalesce(activity.organization_id, ''), activity.subject_type,
	activity.subject_id, activity.activity_type, activity.summary, activity.occurred_at, activity.created_by,
	activity.created_at from crm_activities activity`
const opportunitySelect = `select opportunity.id, coalesce(opportunity.organization_id, ''), opportunity.account_id,
	opportunity.name, opportunity.amount_minor, opportunity.currency, opportunity.stage, opportunity.version,
	opportunity.created_at, opportunity.updated_at from crm_opportunities opportunity`

func activeScopePredicate(alias string) string {
{{- if .Tenancy}}
	return ` and exists (select 1 from organizations organization where organization.id=` + alias + `.organization_id and organization.status='active')`
{{- else}}
	return ""
{{- end}}
}

func requireActiveScope(ctx context.Context, tx pgx.Tx, scope string) error {
{{- if .Tenancy}}
	var id string
	if err := tx.QueryRow(ctx, `select id from organizations where id=$1 and status='active' for update`, scope).Scan(&id); err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return crm.ErrNotFound
		}
		return fmt.Errorf("lock CRM organization scope: %w", err)
	}
{{- end}}
	return nil
}

func requireActiveAccount(ctx context.Context, tx pgx.Tx, scope, id string) error {
	if id == "" {
		return nil
	}
	var found string
	if err := tx.QueryRow(ctx, `select id from crm_accounts where id=$1 and coalesce(organization_id, '')=$2 and status='active' for update`, id, scope).Scan(&found); err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return crm.ErrNotFound
		}
		return fmt.Errorf("lock CRM account: %w", err)
	}
	return nil
}

func requireSubject(ctx context.Context, tx pgx.Tx, scope string, subjectType crm.SubjectType, id string) error {
	table := map[crm.SubjectType]string{crm.SubjectAccount: "crm_accounts", crm.SubjectContact: "crm_contacts", crm.SubjectOpportunity: "crm_opportunities"}[subjectType]
	var found string
	query := `select id from ` + table + ` where id=$1 and coalesce(organization_id, '')=$2 for update`
	if err := tx.QueryRow(ctx, query, id, scope).Scan(&found); err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return crm.ErrNotFound
		}
		return fmt.Errorf("lock CRM activity subject: %w", err)
	}
	return nil
}

func (store *Store) mutate(ctx context.Context, operation func(pgx.Tx) error) error {
	tx, err := store.pool.Begin(ctx)
	if err != nil {
		return fmt.Errorf("begin CRM mutation: %w", err)
	}
	if err := operation(tx); err != nil {
		return rollback(tx, err)
	}
	if err := tx.Commit(ctx); err != nil {
		return fmt.Errorf("commit CRM mutation: %w", err)
	}
	return nil
}

func appendAudit(ctx context.Context, tx pgx.Tx, event identity.AuditEvent) error {
	_, err := tx.Exec(ctx, `insert into audit_events
		(id,user_id,action,outcome,target,ip_address,user_agent,created_at)
		values ($1,nullif($2,''),$3,$4,nullif($5,''),nullif($6,''),nullif($7,''),$8)`,
		event.ID, event.UserID, event.Action, event.Outcome, event.Target, event.IPAddress, event.UserAgent, event.CreatedAt)
	if err != nil {
		return fmt.Errorf("append CRM audit event: %w", err)
	}
	return nil
}

func rollback(tx pgx.Tx, cause error) error {
	ctx, cancel := context.WithTimeout(context.Background(), cleanupTimeout)
	defer cancel()
	if err := tx.Rollback(ctx); err != nil && !errors.Is(err, pgx.ErrTxClosed) {
		return errors.Join(cause, fmt.Errorf("roll back CRM mutation: %w", err))
	}
	return cause
}

type rowScanner interface{ Scan(...any) error }

func scanAccount(row rowScanner) (crm.Account, error) {
	var value crm.Account
	if err := row.Scan(&value.ID, &value.OrganizationID, &value.Name, &value.Status, &value.Version, &value.CreatedAt, &value.UpdatedAt); err != nil {
		return crm.Account{}, scanError("account", err)
	}
	return value, nil
}

func scanContact(row rowScanner) (crm.Contact, error) {
	var value crm.Contact
	if err := row.Scan(&value.ID, &value.OrganizationID, &value.AccountID, &value.Name, &value.Email, &value.Phone, &value.Status, &value.Version, &value.CreatedAt, &value.UpdatedAt); err != nil {
		return crm.Contact{}, scanError("contact", err)
