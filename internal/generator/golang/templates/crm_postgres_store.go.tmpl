const cleanupTimeout = 5 * time.Second

// Store is the PostgreSQL CRM repository.
type Store struct{ pool *pgxpool.Pool }

func New(pool *pgxpool.Pool) *Store { return &Store{pool: pool} }

func (store *Store) CreateAccount(ctx context.Context, value crm.Account, audit identity.AuditEvent) error {
	return store.mutate(ctx, func(tx pgx.Tx) error {
		if err := requireActiveScope(ctx, tx, value.OrganizationID); err != nil {
			return err
		}
		_, err := tx.Exec(ctx, `insert into crm_accounts
			(id, organization_id, name, status, version, created_at, updated_at)
			values ($1, $2, $3, $4, $5, $6, $7)`, value.ID,
			nullable(value.OrganizationID), value.Name, value.Status, value.Version, value.CreatedAt, value.UpdatedAt)
		if err != nil {
			return persistenceError(err)
		}
		return appendAudit(ctx, tx, audit)
	})
}

func (store *Store) GetAccount(ctx context.Context, scope, id string) (crm.Account, error) {
	return scanAccount(store.pool.QueryRow(ctx, accountSelect+`
		where account.id = $1 and coalesce(account.organization_id, '') = $2`+activeScopePredicate("account"), id, scope))
}

func (store *Store) ListAccounts(ctx context.Context, scope string, status crm.RecordStatus, cursor string, limit int) ([]crm.Account, string, error) {
	rows, err := store.pool.Query(ctx, accountSelect+`
		where coalesce(account.organization_id, '') = $1 and ($2 = '' or account.status = $2)
			and ($3 = '' or account.id > $3)`+activeScopePredicate("account")+`
		order by account.id limit $4`, scope, status, cursor, limit+1)
	if err != nil {
		return nil, "", fmt.Errorf("query CRM accounts: %w", err)
	}
	defer rows.Close()
	items := make([]crm.Account, 0, limit+1)
	for rows.Next() {
		value, scanErr := scanAccount(rows)
		if scanErr != nil {
			return nil, "", scanErr
		}
		items = append(items, value)
	}
	if err := rows.Err(); err != nil {
		return nil, "", fmt.Errorf("iterate CRM accounts: %w", err)
	}
	return accountPage(items, limit)
}

func (store *Store) UpdateAccount(ctx context.Context, scope, id, name string, version int64, now time.Time, audit identity.AuditEvent) (crm.Account, error) {
	var value crm.Account
	err := store.mutate(ctx, func(tx pgx.Tx) error {
		if err := requireActiveScope(ctx, tx, scope); err != nil {
			return err
		}
		var scanErr error
		value, scanErr = scanAccount(tx.QueryRow(ctx, `update crm_accounts set name=$1, version=version+1, updated_at=$2
			where id=$3 and coalesce(organization_id, '')=$4 and version=$5 and status='active'
			returning id, coalesce(organization_id, ''), name, status, version, created_at, updated_at`, name, now, id, scope, version))
		if errors.Is(scanErr, crm.ErrNotFound) {
			return crm.ErrConflict
		}
		if scanErr != nil {
			return scanErr
		}
		return appendAudit(ctx, tx, audit)
	})
	return value, err
}

