	if len(items) <= limit {
		return items, "", nil
	}
	return items[:limit], items[limit-1].ID, nil
}
func opportunityPage(items []crm.Opportunity, limit int) ([]crm.Opportunity, string, error) {
	if len(items) <= limit {
