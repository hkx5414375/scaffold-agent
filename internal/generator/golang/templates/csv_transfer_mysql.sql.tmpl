insert into identity_permissions (code, description) values
    ('{{.Business.PermissionPrefix}}:import', 'Import {{.Business.EntityName}} records from bounded CSV'),
    ('{{.Business.PermissionPrefix}}:export', 'Export {{.Business.EntityName}} records to bounded CSV')
on duplicate key update code = code;

insert into identity_role_permissions (role_code, permission_code) values
