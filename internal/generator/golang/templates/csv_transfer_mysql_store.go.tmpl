// Package mysql persists atomic CSV transfers in MySQL.
package mysql

import (
	"context"
	"database/sql"
	"errors"
	"fmt"

	mysqldriver "github.com/go-sql-driver/mysql"

	"{{.ModulePath}}/internal/identity"
	business "{{.ModulePath}}/internal/{{.Business.ModuleName}}"
	"{{.ModulePath}}/internal/{{.Business.ModuleName}}/transfer"
)

// Store implements atomic import and audited export.
type Store struct {
	database *sql.DB
}

// New returns a MySQL CSV transfer store.
func New(database *sql.DB) *Store {
	return &Store{database: database}
}

// Import inserts every validated row and one audit event in the same transaction.
func (store *Store) Import(ctx context.Context, values []business.{{.Business.EntityType}}, audit identity.AuditEvent) error {
	if len(values) == 0 || len(values) > transfer.MaximumRows {
		return transfer.ErrInvalidCSV
	}
	transaction, err := store.database.BeginTx(ctx, nil)
	if err != nil {
		return fmt.Errorf("begin CSV import: %w", err)
	}
	for _, value := range values {
		_, err := transaction.ExecContext(ctx, `
			insert into {{goSQL .Business.TableName}} (id{{if .Tenancy}}, organization_id{{end}}{{range .Business.Fields}}, {{goSQL .Name}}{{end}}, version, created_at, updated_at)
			values (?{{if .Tenancy}}, ?{{end}}{{range .Business.Fields}}, ?{{end}}, ?, ?, ?)`,
			value.ID,
{{- if .Tenancy}}
			value.OrganizationID,
{{- end}}
{{- range .Business.Fields}}
			value.{{.GoName}},
{{- end}}
			value.Version, value.CreatedAt, value.UpdatedAt,
		)
		if err != nil {
			return rollback(transaction, persistenceError(err))
		}
	}
	if err := appendAudit(ctx, transaction, audit); err != nil {
		return rollback(transaction, err)
	}
	if err := transaction.Commit(); err != nil {
		return fmt.Errorf("commit CSV import: %w", err)
	}
	return nil
}

// Export reads one bounded statement snapshot and appends its audit event transactionally.
func (store *Store) Export(ctx context.Context, organizationID string, maximumRows int, audit identity.AuditEvent) ([]business.{{.Business.EntityType}}, error) {
	if maximumRows < 1 || maximumRows > transfer.MaximumRows {
		return nil, transfer.ErrInvalidCSV
	}
	transaction, err := store.database.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelRepeatableRead})
	if err != nil {
		return nil, fmt.Errorf("begin CSV export: %w", err)
	}
	var rowCount, rawBytes int64
	err = transaction.QueryRowContext(ctx, `
		select count(*), coalesce(sum(0{{range .Business.Fields}} + octet_length(coalesce(cast({{goSQL .Name}} as char), '')){{end}}), 0)
		from {{goSQL .Business.TableName}}{{if .Tenancy}} where organization_id = ?{{end}}`{{if .Tenancy}}, organizationID{{end}}).Scan(&rowCount, &rawBytes)
	if err != nil {
		return nil, rollback(transaction, fmt.Errorf("measure CSV export: %w", err))
	}
	if rowCount > int64(maximumRows) {
		return nil, rollback(transaction, transfer.ErrTooManyRows)
	}
	if rawBytes+transfer.CSVHeaderSize() > transfer.MaximumBytes {
		return nil, rollback(transaction, transfer.ErrTooLarge)
	}
	rows, err := transaction.QueryContext(ctx, `
		select id{{if .Tenancy}}, organization_id{{end}}{{range .Business.Fields}}, {{goSQL .Name}}{{end}}, version, created_at, updated_at
		from {{goSQL .Business.TableName}}{{if .Tenancy}} where organization_id = ?{{end}}
		order by id
		limit ?`, {{if .Tenancy}}organizationID, {{end}}maximumRows)
	if err != nil {
		return nil, rollback(transaction, fmt.Errorf("query CSV export: %w", err))
	}
	values := make([]business.{{.Business.EntityType}}, 0, maximumRows)
	documentBytes := transfer.CSVHeaderSize()
	for rows.Next() {
		value, err := scan{{.Business.EntityType}}(rows)
		if err != nil {
			_ = rows.Close()
			return nil, rollback(transaction, err)
		}
		recordBytes, err := transfer.CSVRecordSize(value)
		if err != nil {
			_ = rows.Close()
			return nil, rollback(transaction, fmt.Errorf("measure CSV export row: %w", err))
		}
		if recordBytes > transfer.MaximumBytes-documentBytes {
			_ = rows.Close()
			return nil, rollback(transaction, transfer.ErrTooLarge)
		}
		documentBytes += recordBytes
		values = append(values, value)
	}
	iterationErr := rows.Err()
	closeErr := rows.Close()
	if iterationErr != nil || closeErr != nil {
		return nil, rollback(transaction, errors.Join(iterationErr, closeErr))
	}
	if err := appendAudit(ctx, transaction, audit); err != nil {
		return nil, rollback(transaction, err)
	}
	if err := transaction.Commit(); err != nil {
		return nil, fmt.Errorf("commit CSV export audit: %w", err)
	}
	return values, nil
}

func appendAudit(ctx context.Context, transaction *sql.Tx, event identity.AuditEvent) error {
	_, err := transaction.ExecContext(ctx, `
		insert into audit_events (id, user_id, action, outcome, target, ip_address, user_agent, created_at)
		values (?, nullif(?, ''), ?, ?, nullif(?, ''), nullif(?, ''), nullif(?, ''), ?)`,
		event.ID, event.UserID, event.Action, event.Outcome, event.Target, event.IPAddress, event.UserAgent, event.CreatedAt,
	)
	if err != nil {
		return fmt.Errorf("append CSV audit event: %w", err)
	}
	return nil
}

func rollback(transaction *sql.Tx, cause error) error {
	if err := transaction.Rollback(); err != nil && !errors.Is(err, sql.ErrTxDone) {
		return errors.Join(cause, fmt.Errorf("roll back CSV transfer: %w", err))
	}
	return cause
}

type rowScanner interface {
	Scan(...any) error
}

func scan{{.Business.EntityType}}(row rowScanner) (business.{{.Business.EntityType}}, error) {
	var value business.{{.Business.EntityType}}
	if err := row.Scan(&value.ID{{if .Tenancy}}, &value.OrganizationID{{end}}{{range .Business.Fields}}, &value.{{.GoName}}{{end}}, &value.Version, &value.CreatedAt, &value.UpdatedAt); err != nil {
		return business.{{.Business.EntityType}}{}, fmt.Errorf("scan CSV export row: %w", err)
	}
	return value, nil
}

func persistenceError(err error) error {
	var databaseError *mysqldriver.MySQLError
	if errors.As(err, &databaseError) && databaseError.Number == 1062 {
		return business.ErrConflict
	}
	return err
}

var _ transfer.Store = (*Store)(nil)
