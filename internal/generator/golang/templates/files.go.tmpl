func validateUpload(input UploadInput) (string, string, error) {
	name := strings.TrimSpace(input.Name)
	if input.Content == nil || name == "" || len(name) > 255 || strings.ContainsAny(name, `/\\`) {
		return "", "", ErrInvalidInput
	}
	for _, character := range name {
		if unicode.IsControl(character) {
			return "", "", ErrInvalidInput
		}
	}
	mediaType := strings.TrimSpace(input.MediaType)
	if mediaType == "" {
		mediaType = "application/octet-stream"
	} else {
		parsed, _, err := mime.ParseMediaType(mediaType)
		if err != nil {
			return "", "", ErrInvalidInput
		}
		mediaType = parsed
	}
	return name, mediaType, nil
}

func newAudit(actor identity.Principal, action, target string, now time.Time) identity.AuditEvent {
	return identity.AuditEvent{
		ID: rand.Text(), UserID: actor.UserID, Action: action, Outcome: "allowed", Target: target, CreatedAt: now,
	}
}
