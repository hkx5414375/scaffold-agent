// Package mysql persists file asset metadata in MySQL.
package mysql

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"time"

	"{{.ModulePath}}/internal/files"
	"{{.ModulePath}}/internal/identity"
)

// Store implements the file metadata persistence boundary.
type Store struct {
	database *sql.DB
}

// New returns a MySQL file metadata store.
func New(database *sql.DB) *Store {
	return &Store{database: database}
}

// Create inserts metadata and its audit event in one transaction.
func (store *Store) Create(ctx context.Context, asset files.Asset, audit identity.AuditEvent) error {
	return store.mutate(ctx, func(transaction *sql.Tx) error {
		_, err := transaction.ExecContext(ctx, `
			insert into file_assets (id, organization_id, name, media_type, size_bytes, sha256, storage_key, created_at)
			values (?, nullif(?, ''), ?, ?, ?, ?, ?, ?)`,
			asset.ID, asset.OrganizationID, asset.Name, asset.MediaType,
			asset.Size, asset.SHA256, asset.StorageKey, asset.CreatedAt,
		)
		if err != nil {
			return fmt.Errorf("insert file metadata: %w", err)
		}
		return appendAudit(ctx, transaction, audit)
	})
}

// Get returns active metadata in one scope.
func (store *Store) Get(ctx context.Context, organizationID, id string) (files.Asset, error) {
	return scanAsset(store.database.QueryRowContext(ctx, `
		select id, organization_id, name, media_type, size_bytes, sha256, storage_key, created_at
		from file_assets where id = ?{{if .Tenancy}} and organization_id = ?{{end}} and deleted_at is null`,
		id{{if .Tenancy}}, organizationID{{end}}))
}

// List returns one active metadata page ordered by stable identifier.
func (store *Store) List(ctx context.Context, organizationID, cursor string, limit int) ([]files.Asset, string, error) {
	rows, err := store.database.QueryContext(ctx, `
		select id, organization_id, name, media_type, size_bytes, sha256, storage_key, created_at
		from file_assets
		where deleted_at is null{{if .Tenancy}} and organization_id = ?{{end}} and (? = '' or id > ?)
		order by id limit ?`, {{if .Tenancy}}organizationID, {{end}}cursor, cursor, limit+1)
	if err != nil {
		return nil, "", fmt.Errorf("query file metadata: %w", err)
	}
	defer rows.Close()
	items := make([]files.Asset, 0, limit)
	for rows.Next() {
		asset, err := scanAsset(rows)
		if err != nil {
			return nil, "", err
		}
		items = append(items, asset)
	}
	if err := rows.Err(); err != nil {
		return nil, "", fmt.Errorf("iterate file metadata: %w", err)
	}
	nextCursor := ""
	if len(items) > limit {
		nextCursor = items[limit-1].ID
		items = items[:limit]
	}
	return items, nextCursor, nil
}

// MarkDeleted soft-deletes metadata and appends its audit event atomically.
func (store *Store) MarkDeleted(ctx context.Context, organizationID, id string, now time.Time, audit identity.AuditEvent) (files.Asset, error) {
	var asset files.Asset
	err := store.mutate(ctx, func(transaction *sql.Tx) error {
		command, err := transaction.ExecContext(ctx, `
			update file_assets set deleted_at = ?
			where id = ?{{if .Tenancy}} and organization_id = ?{{end}} and deleted_at is null`,
			now, id{{if .Tenancy}}, organizationID{{end}})
		if err != nil {
			return fmt.Errorf("mark file metadata deleted: %w", err)
		}
		rowsAffected, err := command.RowsAffected()
		if err != nil {
			return fmt.Errorf("inspect file deletion: %w", err)
		}
		if rowsAffected != 1 {
			return files.ErrNotFound
		}
		asset, err = scanAsset(transaction.QueryRowContext(ctx, `
			select id, organization_id, name, media_type, size_bytes, sha256, storage_key, created_at
			from file_assets where id = ?{{if .Tenancy}} and organization_id = ?{{end}}`,
			id{{if .Tenancy}}, organizationID{{end}}))
		if err != nil {
			return err
		}
		return appendAudit(ctx, transaction, audit)
	})
	return asset, err
}

// Restore makes metadata active again after a failed object deletion.
func (store *Store) Restore(ctx context.Context, organizationID, id string) error {
	command, err := store.database.ExecContext(ctx, `
		update file_assets set deleted_at = null
		where id = ?{{if .Tenancy}} and organization_id = ?{{end}} and deleted_at is not null`,
		id{{if .Tenancy}}, organizationID{{end}})
	if err != nil {
		return fmt.Errorf("restore file metadata: %w", err)
	}
	rowsAffected, err := command.RowsAffected()
	if err != nil {
		return fmt.Errorf("inspect file restoration: %w", err)
	}
	if rowsAffected != 1 {
		return files.ErrNotFound
	}
	return nil
}

type scanner interface {
	Scan(...any) error
}

func scanAsset(row scanner) (files.Asset, error) {
	var asset files.Asset
	var organizationID sql.NullString
	err := row.Scan(
		&asset.ID, &organizationID, &asset.Name, &asset.MediaType, &asset.Size,
		&asset.SHA256, &asset.StorageKey, &asset.CreatedAt,
	)
	if errors.Is(err, sql.ErrNoRows) {
		return files.Asset{}, files.ErrNotFound
	}
	if err != nil {
		return files.Asset{}, fmt.Errorf("scan file metadata: %w", err)
	}
	if organizationID.Valid {
		asset.OrganizationID = organizationID.String
	}
	return asset, nil
}

func (store *Store) mutate(ctx context.Context, operation func(*sql.Tx) error) error {
	transaction, err := store.database.BeginTx(ctx, nil)
	if err != nil {
		return fmt.Errorf("begin file metadata mutation: %w", err)
	}
	if err := operation(transaction); err != nil {
		return rollback(transaction, err)
	}
	if err := transaction.Commit(); err != nil {
		return fmt.Errorf("commit file metadata mutation: %w", err)
	}
	return nil
}

func appendAudit(ctx context.Context, transaction *sql.Tx, audit identity.AuditEvent) error {
	_, err := transaction.ExecContext(ctx, `
		insert into audit_events (id, user_id, action, outcome, target, ip_address, user_agent, created_at)
		values (?, nullif(?, ''), ?, ?, nullif(?, ''), nullif(?, ''), nullif(?, ''), ?)`,
		audit.ID, audit.UserID, audit.Action, audit.Outcome, audit.Target,
		audit.IPAddress, audit.UserAgent, audit.CreatedAt,
	)
	if err != nil {
		return fmt.Errorf("append file audit: %w", err)
	}
	return nil
}

func rollback(transaction *sql.Tx, operationErr error) error {
	if err := transaction.Rollback(); err != nil {
		return errors.Join(operationErr, fmt.Errorf("roll back file metadata mutation: %w", err))
	}
	return operationErr
}
