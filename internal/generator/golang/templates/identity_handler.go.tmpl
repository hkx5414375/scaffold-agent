// Package httpapi exposes identity use cases over a small, versioned HTTP API.
package httpapi

import (
	"context"
	"errors"
	"log/slog"
	"net"
	"net/http"
	"strings"

	"{{.ModulePath}}/internal/identity"
	"{{.ModulePath}}/internal/platform/httpjson"
)

const (
	sessionCookieName     = "scaffold_session"
	sessionMaxAge         = 24 * 60 * 60
	createTokenPermission = "identity:token:create"
	organizationHeader    = "X-Organization-ID"
)

// Authorizer can replace global role checks with a capability-specific scope check.
type Authorizer interface {
	Authorize(context.Context, identity.Principal, string, string, string, string) (identity.Principal, error)
}

// Option configures optional identity transport integrations.
type Option func(*Handler)

// Handler maps HTTP requests to the identity application service.
type Handler struct {
	service       *identity.Service
	secureCookies bool
	authorizer    Authorizer
}

// New returns an identity HTTP adapter.
func New(service *identity.Service, secureCookies bool, options ...Option) *Handler {
	handler := &Handler{
		service: service, secureCookies: secureCookies,
		authorizer: globalAuthorizer{service: service},
	}
	for _, option := range options {
		option(handler)
	}
	return handler
}

// WithAuthorizer installs a scoped permission checker for protected business routes.
func WithAuthorizer(authorizer Authorizer) Option {
	return func(handler *Handler) {
		if authorizer != nil {
			handler.authorizer = authorizer
		}
	}
}

// Register adds all identity routes to one application mux.
func (handler *Handler) Register(mux *http.ServeMux) {
	mux.HandleFunc("POST /api/v1/auth/login", handler.login)
	mux.HandleFunc("POST /api/v1/auth/logout", handler.logout)
	mux.HandleFunc("GET /api/v1/auth/me", handler.Authenticated(handler.me))
	mux.HandleFunc("POST /api/v1/auth/tokens", handler.AuthorizedGlobal(createTokenPermission, handler.createAPIToken))
}

func (handler *Handler) login(response http.ResponseWriter, request *http.Request) {
	var input struct {
		Email    string `json:"email"`
		Password string `json:"password"`
	}
	if err := decodeJSON(response, request, &input); err != nil {
		writeError(response, http.StatusBadRequest, "request.invalid", err.Error())
		return
	}
	token, principal, err := handler.service.Login(
		request.Context(), input.Email, input.Password, clientIP(request), request.UserAgent(),
	)
	if errors.Is(err, identity.ErrInvalidCredentials) {
		writeError(response, http.StatusUnauthorized, "identity.invalid_credentials", "email or password is incorrect")
		return
	}
	if err != nil {
		slog.Error("log in", "error", err)
		writeError(response, http.StatusInternalServerError, "internal.error", "the request could not be completed")
		return
	}
	http.SetCookie(response, &http.Cookie{
		Name: sessionCookieName, Value: token, Path: "/", MaxAge: sessionMaxAge,
		HttpOnly: true, Secure: handler.secureCookies, SameSite: http.SameSiteLaxMode,
	})
	writeJSON(response, http.StatusOK, map[string]any{"principal": principal})
}

func (handler *Handler) logout(response http.ResponseWriter, request *http.Request) {
	cookie, err := request.Cookie(sessionCookieName)
	if err != nil && !errors.Is(err, http.ErrNoCookie) {
		writeError(response, http.StatusBadRequest, "request.invalid", "session cookie is invalid")
		return
	}
	if err == nil {
		if err := handler.service.Logout(request.Context(), cookie.Value); err != nil {
			slog.Error("log out", "error", err)
			writeError(response, http.StatusInternalServerError, "internal.error", "the request could not be completed")
			return
		}
	}
	http.SetCookie(response, &http.Cookie{
		Name: sessionCookieName, Value: "", Path: "/", MaxAge: -1,
		HttpOnly: true, Secure: handler.secureCookies, SameSite: http.SameSiteLaxMode,
	})
	response.WriteHeader(http.StatusNoContent)
}

func (handler *Handler) me(response http.ResponseWriter, _ *http.Request, principal identity.Principal) {
	writeJSON(response, http.StatusOK, map[string]any{"principal": principal})
}

func (handler *Handler) createAPIToken(response http.ResponseWriter, request *http.Request, principal identity.Principal) {
	var input struct {
		Name string `json:"name"`
	}
	if err := decodeJSON(response, request, &input); err != nil {
		writeError(response, http.StatusBadRequest, "request.invalid", err.Error())
		return
	}
	token, err := handler.service.CreateAPIToken(request.Context(), principal, input.Name)
	if errors.Is(err, identity.ErrInvalidTokenName) {
		writeError(response, http.StatusBadRequest, "identity.token_invalid", err.Error())
		return
	}
	if err != nil {
		slog.Error("create API token", "error", err)
		writeError(response, http.StatusInternalServerError, "internal.error", "the request could not be completed")
		return
	}
	writeJSON(response, http.StatusCreated, map[string]string{"token": token})
}

// PrincipalHandler is an authenticated HTTP endpoint.
type PrincipalHandler func(http.ResponseWriter, *http.Request, identity.Principal)

// Authenticated requires a valid session or bearer token.
func (handler *Handler) Authenticated(next PrincipalHandler) http.HandlerFunc {
	return func(response http.ResponseWriter, request *http.Request) {
		principal, ok := handler.authenticate(response, request)
		if !ok {
			return
		}
		next(response, request, principal)
	}
}

// Authorized requires authentication and one explicit permission assignment.
func (handler *Handler) Authorized(permission string, next PrincipalHandler) http.HandlerFunc {
	return handler.authorized(handler.authorizer, permission, next)
}

// AuthorizedGlobal applies the identity role assignment without an organization scope.
func (handler *Handler) AuthorizedGlobal(permission string, next PrincipalHandler) http.HandlerFunc {
	return handler.authorized(globalAuthorizer{service: handler.service}, permission, next)
}

func (handler *Handler) authorized(authorizer Authorizer, permission string, next PrincipalHandler) http.HandlerFunc {
	return handler.Authenticated(func(response http.ResponseWriter, request *http.Request, principal identity.Principal) {
		authorizedPrincipal, err := authorizer.Authorize(
			request.Context(), principal, strings.TrimSpace(request.Header.Get(organizationHeader)),
			permission, clientIP(request), request.UserAgent(),
		)
		if errors.Is(err, identity.ErrForbidden) {
			writeError(response, http.StatusForbidden, "identity.forbidden", "permission is required")
			return
		}
		if err != nil {
			slog.Error("authorize request", "permission", permission, "error", err)
			writeError(response, http.StatusInternalServerError, "internal.error", "the request could not be completed")
			return
		}
		next(response, request, authorizedPrincipal)
	})
}

type globalAuthorizer struct {
	service *identity.Service
}

func (authorizer globalAuthorizer) Authorize(ctx context.Context, actor identity.Principal, _ string, permission, ipAddress, userAgent string) (identity.Principal, error) {
	if err := authorizer.service.Authorize(ctx, actor, permission, ipAddress, userAgent); err != nil {
		return identity.Principal{}, err
	}
	return actor, nil
}

func (handler *Handler) authenticate(response http.ResponseWriter, request *http.Request) (identity.Principal, bool) {
	var sessionToken string
	if cookie, err := request.Cookie(sessionCookieName); err == nil {
		sessionToken = cookie.Value
	} else if !errors.Is(err, http.ErrNoCookie) {
		writeError(response, http.StatusBadRequest, "request.invalid", "session cookie is invalid")
		return identity.Principal{}, false
	}
	bearerToken := bearer(request.Header.Get("Authorization"))
	principal, err := handler.service.Authenticate(request.Context(), sessionToken, bearerToken)
	if errors.Is(err, identity.ErrInvalidCredentials) {
		writeError(response, http.StatusUnauthorized, "identity.unauthenticated", "authentication is required")
		return identity.Principal{}, false
	}
	if err != nil {
		slog.Error("authenticate request", "error", err)
		writeError(response, http.StatusInternalServerError, "internal.error", "the request could not be completed")
		return identity.Principal{}, false
	}
	return principal, true
}

func decodeJSON(response http.ResponseWriter, request *http.Request, destination any) error {
	return httpjson.Decode(response, request, destination)
}

func bearer(value string) string {
	parts := strings.Fields(value)
	if len(parts) != 2 || !strings.EqualFold(parts[0], "Bearer") {
		return ""
	}
	return parts[1]
}

func clientIP(request *http.Request) string {
	host, _, err := net.SplitHostPort(request.RemoteAddr)
	if err == nil {
		return host
	}
	if net.ParseIP(request.RemoteAddr) != nil {
		return request.RemoteAddr
	}
	return ""
}

func writeError(response http.ResponseWriter, status int, code, message string) {
	httpjson.WriteError(response, status, code, message)
}

func writeJSON(response http.ResponseWriter, status int, value any) {
	httpjson.Write(response, status, value)
}
