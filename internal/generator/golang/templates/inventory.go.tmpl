func (service *Service) ListBalances(ctx context.Context, itemID, cursor string, limit int, actor identity.Principal) (BalancePage, error) {
	scope, err := actorScope(actor); if err != nil || !validPage(cursor, limit) { return BalancePage{}, ErrInvalidInput }
	if strings.TrimSpace(itemID) != "" { itemID, err = identifier(itemID); if err != nil { return BalancePage{}, err } }
	items, next, err := service.store.ListBalances(ctx, scope, itemID, strings.TrimSpace(cursor), limit)
	for index := range items { items[index].Available = items[index].OnHand - items[index].Reserved }
	return BalancePage{Items:items, NextCursor:next}, wrap("list inventory balances", err)
}

func (service *Service) AdjustStock(ctx context.Context, input AdjustmentInput, actor identity.Principal) (StockResult, error) {
	scope, err := actorScope(actor); if err != nil { return StockResult{}, err }
	itemID, err := identifier(input.ItemID); if err != nil { return StockResult{}, err }
	warehouseID, err := identifier(input.WarehouseID); if err != nil { return StockResult{}, err }
	delta, err := canonicalInt64(input.QuantityDelta, false); if err != nil || delta == 0 { return StockResult{}, ErrInvalidInput }
	reason, err := requiredText(input.Reason, maximumReasonLength); if err != nil { return StockResult{}, err }
	key, err := idempotencyKey(input.IdempotencyKey); if err != nil { return StockResult{}, err }
	now := service.now().UTC(); movement := Movement{ID:newID(), OrganizationID:scope, ItemID:itemID, WarehouseID:warehouseID, Kind:MovementAdjustment, QuantityDelta:delta, ReferenceType:"adjustment", ReferenceID:key, Reason:reason, IdempotencyKey:key, CreatedBy:actor.UserID, CreatedAt:now}
	command := StockCommand{Scope:scope, IdempotencyKey:key, Fingerprint:fingerprint("adjust", itemID, warehouseID, strconv.FormatInt(delta,10), reason), Movement:movement, Audit:audit(actor,"inventory:stock:adjust",movement.ID,now)}
	result, err := service.store.ApplyStock(ctx, command); result.Balance.Available = result.Balance.OnHand-result.Balance.Reserved
	return result, wrap("adjust inventory stock", err)
}

func (service *Service) CreateReservation(ctx context.Context, input ReservationWrite, actor identity.Principal) (ReservationResult, error) {
	scope, err := actorScope(actor); if err != nil { return ReservationResult{}, err }
	reference, err := identifier(input.ExternalReference); if err != nil { return ReservationResult{}, err }
	itemID, err := identifier(input.ItemID); if err != nil { return ReservationResult{}, err }
	warehouseID, err := identifier(input.WarehouseID); if err != nil { return ReservationResult{}, err }
	quantity, err := canonicalInt64(input.Quantity, true); if err != nil { return ReservationResult{}, err }
	key, err := idempotencyKey(input.IdempotencyKey); if err != nil { return ReservationResult{}, err }
	now := service.now().UTC(); value := Reservation{ID:newID(),OrganizationID:scope,ExternalReference:reference,ItemID:itemID,WarehouseID:warehouseID,Quantity:quantity,Status:ReservationActive,Version:1,CreatedAt:now,UpdatedAt:now}
	movement := Movement{ID:newID(),OrganizationID:scope,ItemID:itemID,WarehouseID:warehouseID,Kind:MovementReservationCreated,ReservedDelta:quantity,ReferenceType:"reservation",ReferenceID:value.ID,Reason:"stock reserved",IdempotencyKey:key,CreatedBy:actor.UserID,CreatedAt:now}
	command := ReservationCommand{Scope:scope,IdempotencyKey:key,Fingerprint:fingerprint("reserve",reference,itemID,warehouseID,strconv.FormatInt(quantity,10)),Reservation:value,Movement:movement,Audit:audit(actor,"inventory:reservation:create",value.ID,now)}
	result, err := service.store.CreateReservation(ctx, command); result.Balance.Available=result.Balance.OnHand-result.Balance.Reserved
	return result, wrap("create inventory reservation", err)
}

func (service *Service) GetReservation(ctx context.Context, id string, actor identity.Principal) (Reservation, error) {
	scope,id,err:=scopeAndID(actor,id); if err!=nil{return Reservation{},err}; value,err:=service.store.GetReservation(ctx,scope,id); return value,wrap("get inventory reservation",err)
}

func (service *Service) ListReservations(ctx context.Context, status ReservationStatus, cursor string, limit int, actor identity.Principal) (ReservationPage,error) {
	scope,err:=actorScope(actor); if err!=nil||!validReservationStatusFilter(status)||!validPage(cursor,limit){return ReservationPage{},ErrInvalidInput}
	items,next,err:=service.store.ListReservations(ctx,scope,status,strings.TrimSpace(cursor),limit); return ReservationPage{Items:items,NextCursor:next},wrap("list inventory reservations",err)
}

func (service *Service) TransitionReservation(ctx context.Context,id string,input ReservationTransition,target ReservationStatus,actor identity.Principal)(ReservationResult,error){
	scope,id,err:=scopeAndID(actor,id); if err!=nil||input.Version<1||(target!=ReservationReleased&&target!=ReservationConsumed){return ReservationResult{},ErrInvalidInput}
	key,err:=idempotencyKey(input.IdempotencyKey);if err!=nil{return ReservationResult{},err};now:=service.now().UTC()
	command:=ReservationTransitionCommand{Scope:scope,ReservationID:id,IdempotencyKey:key,Fingerprint:fingerprint("reservation",id,string(target),strconv.FormatInt(input.Version,10)),Version:input.Version,Target:target,MovementID:newID(),ActorID:actor.UserID,OccurredAt:now,Audit:audit(actor,"inventory:reservation:"+string(target),id,now)}
	result,err:=service.store.TransitionReservation(ctx,command);result.Balance.Available=result.Balance.OnHand-result.Balance.Reserved;return result,wrap("transition inventory reservation",err)
}

func(service *Service)ReleaseReservation(ctx context.Context,id string,input ReservationTransition,actor identity.Principal)(ReservationResult,error){return service.TransitionReservation(ctx,id,input,ReservationReleased,actor)}
func(service *Service)ConsumeReservation(ctx context.Context,id string,input ReservationTransition,actor identity.Principal)(ReservationResult,error){return service.TransitionReservation(ctx,id,input,ReservationConsumed,actor)}

func (service *Service) CreatePurchaseOrder(ctx context.Context,input PurchaseOrderWrite,actor identity.Principal)(PurchaseOrder,error){
	scope,err:=actorScope(actor);if err!=nil{return PurchaseOrder{},err};number,err:=normalizedCode(input.Number);if err!=nil{return PurchaseOrder{},err};supplier,err:=requiredText(input.SupplierName,maximumNameLength);if err!=nil||len(input.Lines)<1||len(input.Lines)>100{return PurchaseOrder{},ErrInvalidInput}
	lines:=make([]PurchaseOrderLine,0,len(input.Lines));seen:=make(map[string]struct{},len(input.Lines));for _,entry:=range input.Lines{itemID,e:=identifier(entry.ItemID);if e!=nil{return PurchaseOrder{},e};if _,exists:=seen[itemID];exists{return PurchaseOrder{},ErrInvalidInput};seen[itemID]=struct{}{};quantity,e:=canonicalInt64(entry.OrderedQuantity,true);if e!=nil{return PurchaseOrder{},e};lines=append(lines,PurchaseOrderLine{ID:newID(),ItemID:itemID,OrderedQuantity:quantity})}
	now:=service.now().UTC();value:=PurchaseOrder{ID:newID(),OrganizationID:scope,Number:number,SupplierName:supplier,Status:PurchaseDraft,Version:1,Lines:lines,CreatedAt:now,UpdatedAt:now};if err:=service.store.CreatePurchaseOrder(ctx,value,audit(actor,"inventory:purchase:create",value.ID,now));err!=nil{return PurchaseOrder{},wrap("create inventory purchase order",err)};return value,nil
}

func(service *Service)GetPurchaseOrder(ctx context.Context,id string,actor identity.Principal)(PurchaseOrder,error){scope,id,err:=scopeAndID(actor,id);if err!=nil{return PurchaseOrder{},err};value,err:=service.store.GetPurchaseOrder(ctx,scope,id);return value,wrap("get inventory purchase order",err)}
func(service *Service)ListPurchaseOrders(ctx context.Context,status PurchaseOrderStatus,cursor string,limit int,actor identity.Principal)(PurchaseOrderPage,error){scope,err:=actorScope(actor);if err!=nil||!validPurchaseStatusFilter(status)||!validPage(cursor,limit){return PurchaseOrderPage{},ErrInvalidInput};items,next,err:=service.store.ListPurchaseOrders(ctx,scope,status,strings.TrimSpace(cursor),limit);return PurchaseOrderPage{Items:items,NextCursor:next},wrap("list inventory purchase orders",err)}

func(service *Service)TransitionPurchaseOrder(ctx context.Context,id string,input TransitionInput,target PurchaseOrderStatus,actor identity.Principal)(PurchaseOrder,error){scope,id,err:=scopeAndID(actor,id);if err!=nil||input.Version<1||(target!=PurchaseSubmitted&&target!=PurchaseCancelled){return PurchaseOrder{},ErrInvalidInput};now:=service.now().UTC();value,err:=service.store.TransitionPurchaseOrder(ctx,scope,id,input.Version,target,now,audit(actor,"inventory:purchase:"+string(target),id,now));return value,wrap("transition inventory purchase order",err)}

func(service *Service)SubmitPurchaseOrder(ctx context.Context,id string,input TransitionInput,actor identity.Principal)(PurchaseOrder,error){return service.TransitionPurchaseOrder(ctx,id,input,PurchaseSubmitted,actor)}
func(service *Service)CancelPurchaseOrder(ctx context.Context,id string,input TransitionInput,actor identity.Principal)(PurchaseOrder,error){return service.TransitionPurchaseOrder(ctx,id,input,PurchaseCancelled,actor)}

func(service *Service)ReceivePurchaseOrder(ctx context.Context,id string,input ReceiptInput,actor identity.Principal)(ReceiptResult,error){scope,id,err:=scopeAndID(actor,id);if err!=nil||input.Version<1{return ReceiptResult{},ErrInvalidInput};lineID,err:=identifier(input.LineID);if err!=nil{return ReceiptResult{},err};warehouseID,err:=identifier(input.WarehouseID);if err!=nil{return ReceiptResult{},err};quantity,err:=canonicalInt64(input.Quantity,true);if err!=nil{return ReceiptResult{},err};key,err:=idempotencyKey(input.IdempotencyKey);if err!=nil{return ReceiptResult{},err};now:=service.now().UTC();command:=ReceiptCommand{Scope:scope,PurchaseOrderID:id,LineID:lineID,WarehouseID:warehouseID,IdempotencyKey:key,Fingerprint:fingerprint("receive",id,lineID,warehouseID,strconv.FormatInt(quantity,10),strconv.FormatInt(input.Version,10)),Quantity:quantity,Version:input.Version,MovementID:newID(),ActorID:actor.UserID,OccurredAt:now,Audit:audit(actor,"inventory:purchase:receive",id,now)};result,err:=service.store.ReceivePurchaseOrder(ctx,command);result.Balance.Available=result.Balance.OnHand-result.Balance.Reserved;return result,wrap("receive inventory purchase order",err)}

func(service *Service)ListMovements(ctx context.Context,itemID,warehouseID,cursor string,limit int,actor identity.Principal)(MovementPage,error){scope,err:=actorScope(actor);if err!=nil||!validPage(cursor,limit){return MovementPage{},ErrInvalidInput};if strings.TrimSpace(itemID)!=""{itemID,err=identifier(itemID);if err!=nil{return MovementPage{},err}};if strings.TrimSpace(warehouseID)!=""{warehouseID,err=identifier(warehouseID);if err!=nil{return MovementPage{},err}};items,next,err:=service.store.ListMovements(ctx,scope,itemID,warehouseID,strings.TrimSpace(cursor),limit);return MovementPage{Items:items,NextCursor:next},wrap("list inventory movements",err)}

func actorScope(actor identity.Principal)(string,error){if actor.UserID==""||len(actor.UserID)>maximumIdentifierLength||!printable(actor.UserID){return "",ErrInvalidInput}{{if .Tenancy}};scope:=strings.TrimSpace(actor.OrganizationID);if scope==""||len(scope)>maximumIdentifierLength||!printable(scope){return "",ErrInvalidInput};return scope,nil{{else}};return "",nil{{end}}}
func scopeAndID(actor identity.Principal,value string)(string,string,error){scope,err:=actorScope(actor);if err!=nil{return "","",err};id,err:=identifier(value);return scope,id,err}
func identifier(value string)(string,error){value=strings.TrimSpace(value);if value==""||len(value)>maximumIdentifierLength||!printable(value){return "",ErrInvalidInput};return value,nil}
func requiredText(value string,maximum int)(string,error){value=strings.TrimSpace(value);if value==""||utf8.RuneCountInString(value)>maximum||!printable(value){return "",ErrInvalidInput};return value,nil}
func normalizedCode(value string)(string,error){value=strings.ToUpper(strings.TrimSpace(value));if value==""||len(value)>maximumCodeLength||strings.IndexFunc(value,func(r rune)bool{return !(r>='A'&&r<='Z'||r>='0'&&r<='9'||r=='.'||r=='_'||r=='-')})>=0{return "",ErrInvalidInput};return value,nil}
func normalizedUnit(value string)(string,error){value=strings.ToUpper(strings.TrimSpace(value));if value==""||len(value)>maximumUnitLength||!printable(value){return "",ErrInvalidInput};return value,nil}
func canonicalInt64(value string,positive bool)(int64,error){parsed,err:=strconv.ParseInt(value,10,64);if err!=nil||strconv.FormatInt(parsed,10)!=value||(positive&&parsed<=0){return 0,ErrInvalidInput};return parsed,nil}
func idempotencyKey(value string)(string,error){return identifier(value)}
func validPage(cursor string,limit int)bool{cursor=strings.TrimSpace(cursor);return limit>=1&&limit<=100&&len(cursor)<=maximumIdentifierLength&&printable(cursor)}
func validRecordStatus(value RecordStatus)bool{return value==StatusActive||value==StatusArchived}
func validRecordStatusFilter(value RecordStatus)bool{return value==""||validRecordStatus(value)}
func validReservationStatusFilter(value ReservationStatus)bool{return value==""||value==ReservationActive||value==ReservationReleased||value==ReservationConsumed}
func validPurchaseStatusFilter(value PurchaseOrderStatus)bool{return value==""||value==PurchaseDraft||value==PurchaseSubmitted||value==PurchasePartiallyReceived||value==PurchaseReceived||value==PurchaseCancelled}
func printable(value string)bool{return strings.IndexFunc(value,func(character rune)bool{return !unicode.IsGraphic(character)})<0}
func fingerprint(parts ...string)string{sum:=sha256.Sum256([]byte(strings.Join(parts,"\x00")));return fmt.Sprintf("%x",sum[:])}
func audit(actor identity.Principal,action,target string,now time.Time)identity.AuditEvent{return identity.AuditEvent{ID:newID(),UserID:actor.UserID,Action:action,Outcome:"succeeded",Target:target,CreatedAt:now}}
func wrap(operation string,err error)error{if err==nil{return nil};return errors.Join(errors.New(operation),err)}
func newID()string{return rand.Text()}
