// Package inventory owns portable inventory and procurement use cases.
package inventory

import (
	"context"
	"crypto/rand"
	"crypto/sha256"
	"errors"
	"fmt"
	"strconv"
	"strings"
	"time"
	"unicode"
	"unicode/utf8"

	"{{.ModulePath}}/internal/identity"
)

const (
	maximumIdentifierLength = 191
	maximumCodeLength       = 64
	maximumNameLength       = 160
	maximumUnitLength       = 32
	maximumReasonLength     = 500
)

var (
	// ErrNotFound hides missing and cross-organization inventory records.
	ErrNotFound = errors.New("inventory record not found")
	// ErrConflict represents an optimistic version, idempotency, or stock conflict.
	ErrConflict = errors.New("inventory record conflicts with current state")
	// ErrInvalidInput represents malformed portable inventory input.
	ErrInvalidInput = errors.New("inventory input is invalid")
)

// RecordStatus is the reversible master-data lifecycle.
type RecordStatus string

const (
	StatusActive   RecordStatus = "active"
	StatusArchived RecordStatus = "archived"
)

// ReservationStatus is the one-way reservation lifecycle.
type ReservationStatus string

const (
	ReservationActive   ReservationStatus = "active"
	ReservationReleased ReservationStatus = "released"
	ReservationConsumed ReservationStatus = "consumed"
)

// PurchaseOrderStatus is the procurement state machine.
type PurchaseOrderStatus string

const (
	PurchaseDraft             PurchaseOrderStatus = "draft"
	PurchaseSubmitted         PurchaseOrderStatus = "submitted"
	PurchasePartiallyReceived PurchaseOrderStatus = "partially_received"
	PurchaseReceived          PurchaseOrderStatus = "received"
	PurchaseCancelled         PurchaseOrderStatus = "cancelled"
)

// MovementKind identifies an immutable inventory reason.
type MovementKind string

const (
	MovementAdjustment         MovementKind = "adjustment"
	MovementReservationCreated MovementKind = "reservation_created"
	MovementReservationReleased MovementKind = "reservation_released"
	MovementReservationConsumed MovementKind = "reservation_consumed"
	MovementPurchaseReceived    MovementKind = "purchase_received"
)

// Item is independent inventory master data. It does not require a commerce product.
type Item struct {
	ID             string       `json:"id"`
	OrganizationID string       `json:"organization_id,omitempty"`
	SKU            string       `json:"sku"`
	Name           string       `json:"name"`
	Unit           string       `json:"unit"`
	Status         RecordStatus `json:"status"`
	Version        int64        `json:"version,string"`
	CreatedAt      time.Time    `json:"created_at"`
	UpdatedAt      time.Time    `json:"updated_at"`
}

// Warehouse is a physical or logical stock location.
type Warehouse struct {
	ID             string       `json:"id"`
	OrganizationID string       `json:"organization_id,omitempty"`
	Code           string       `json:"code"`
	Name           string       `json:"name"`
	Status         RecordStatus `json:"status"`
	Version        int64        `json:"version,string"`
	CreatedAt      time.Time    `json:"created_at"`
	UpdatedAt      time.Time    `json:"updated_at"`
}

// Balance is the single stock projection for one item and warehouse.
type Balance struct {
	ItemID      string `json:"item_id"`
	WarehouseID string `json:"warehouse_id"`
	OnHand      int64  `json:"on_hand,string"`
	Reserved    int64  `json:"reserved,string"`
	Available   int64  `json:"available,string"`
	Version     int64  `json:"version,string"`
	UpdatedAt   time.Time `json:"updated_at"`
}

// Movement is append-only evidence for every stock projection change.
type Movement struct {
	ID               string       `json:"id"`
	OrganizationID   string       `json:"organization_id,omitempty"`
	ItemID            string       `json:"item_id"`
	WarehouseID       string       `json:"warehouse_id"`
	Kind              MovementKind `json:"kind"`
	QuantityDelta     int64        `json:"quantity_delta,string"`
	ReservedDelta     int64        `json:"reserved_delta,string"`
	ReferenceType     string       `json:"reference_type"`
	ReferenceID       string       `json:"reference_id"`
	Reason            string       `json:"reason"`
	IdempotencyKey    string       `json:"idempotency_key"`
	CreatedBy         string       `json:"created_by"`
	CreatedAt         time.Time    `json:"created_at"`
}

// Reservation protects stock for an external business operation.
type Reservation struct {
	ID                string            `json:"id"`
	OrganizationID    string            `json:"organization_id,omitempty"`
	ExternalReference string            `json:"external_reference"`
	ItemID             string            `json:"item_id"`
	WarehouseID        string            `json:"warehouse_id"`
	Quantity           int64             `json:"quantity,string"`
	Status             ReservationStatus `json:"status"`
	Version            int64             `json:"version,string"`
	CreatedAt          time.Time          `json:"created_at"`
	UpdatedAt          time.Time          `json:"updated_at"`
}

// PurchaseOrderLine tracks ordered and cumulative received quantities.
type PurchaseOrderLine struct {
	ID               string `json:"id"`
	ItemID           string `json:"item_id"`
	OrderedQuantity  int64  `json:"ordered_quantity,string"`
	ReceivedQuantity int64  `json:"received_quantity,string"`
}

// PurchaseOrder is the aggregate root for procurement receiving.
type PurchaseOrder struct {
	ID             string              `json:"id"`
	OrganizationID string              `json:"organization_id,omitempty"`
	Number         string              `json:"number"`
	SupplierName   string              `json:"supplier_name"`
	Status         PurchaseOrderStatus `json:"status"`
	Version        int64               `json:"version,string"`
	Lines          []PurchaseOrderLine `json:"lines"`
	CreatedAt      time.Time           `json:"created_at"`
	UpdatedAt      time.Time           `json:"updated_at"`
}

type ItemWrite struct { SKU string `json:"sku"`; Name string `json:"name"`; Unit string `json:"unit"` }
type ItemUpdate struct { SKU string `json:"sku"`; Name string `json:"name"`; Unit string `json:"unit"`; Version int64 `json:"version,string"` }
type WarehouseWrite struct { Code string `json:"code"`; Name string `json:"name"` }
type WarehouseUpdate struct { Code string `json:"code"`; Name string `json:"name"`; Version int64 `json:"version,string"` }
type TransitionInput struct { Version int64 `json:"version,string"` }
type AdjustmentInput struct {
	ItemID string `json:"item_id"`
	WarehouseID string `json:"warehouse_id"`
	QuantityDelta string `json:"quantity_delta"`
	Reason string `json:"reason"`
	IdempotencyKey string `json:"idempotency_key"`
}
type ReservationWrite struct {
	ExternalReference string `json:"external_reference"`
	ItemID string `json:"item_id"`
	WarehouseID string `json:"warehouse_id"`
	Quantity string `json:"quantity"`
	IdempotencyKey string `json:"idempotency_key"`
}
type ReservationTransition struct { Version int64 `json:"version,string"`; IdempotencyKey string `json:"idempotency_key"` }
type PurchaseOrderLineWrite struct { ItemID string `json:"item_id"`; OrderedQuantity string `json:"ordered_quantity"` }
type PurchaseOrderWrite struct { Number string `json:"number"`; SupplierName string `json:"supplier_name"`; Lines []PurchaseOrderLineWrite `json:"lines"` }
type ReceiptInput struct {
	LineID string `json:"line_id"`
	WarehouseID string `json:"warehouse_id"`
	Quantity string `json:"quantity"`
	IdempotencyKey string `json:"idempotency_key"`
	Version int64 `json:"version,string"`
}

type ItemPage struct { Items []Item `json:"items"`; NextCursor string `json:"next_cursor,omitempty"` }
type WarehousePage struct { Items []Warehouse `json:"items"`; NextCursor string `json:"next_cursor,omitempty"` }
type BalancePage struct { Items []Balance `json:"items"`; NextCursor string `json:"next_cursor,omitempty"` }
type MovementPage struct { Items []Movement `json:"items"`; NextCursor string `json:"next_cursor,omitempty"` }
type ReservationPage struct { Items []Reservation `json:"items"`; NextCursor string `json:"next_cursor,omitempty"` }
type PurchaseOrderPage struct { Items []PurchaseOrder `json:"items"`; NextCursor string `json:"next_cursor,omitempty"` }
type StockResult struct { Balance Balance `json:"balance"`; Movement Movement `json:"movement"` }
type ReservationResult struct { Reservation Reservation `json:"reservation"`; Balance Balance `json:"balance"`; Movement Movement `json:"movement"` }
type ReceiptResult struct { PurchaseOrder PurchaseOrder `json:"purchase_order"`; Balance Balance `json:"balance"`; Movement Movement `json:"movement"` }

// StockCommand is an atomic, idempotent balance and movement mutation.
type StockCommand struct {
	Scope, IdempotencyKey, Fingerprint string
	Movement Movement
	Audit identity.AuditEvent
}

// ReservationCommand creates an active reservation atomically.
type ReservationCommand struct {
	Scope, IdempotencyKey, Fingerprint string
	Reservation Reservation
	Movement Movement
	Audit identity.AuditEvent
}

// ReservationTransitionCommand closes a reservation atomically.
type ReservationTransitionCommand struct {
	Scope, ReservationID, IdempotencyKey, Fingerprint string
	Version int64
	Target ReservationStatus
	MovementID, ActorID string
	OccurredAt time.Time
	Audit identity.AuditEvent
}

// ReceiptCommand receives one purchase line atomically and idempotently.
type ReceiptCommand struct {
	Scope, PurchaseOrderID, LineID, WarehouseID, IdempotencyKey, Fingerprint string
	Quantity, Version int64
	MovementID, ActorID string
	OccurredAt time.Time
	Audit identity.AuditEvent
}

// Store is the atomic inventory persistence boundary.
type Store interface {
	CreateItem(context.Context, Item, identity.AuditEvent) error
	GetItem(context.Context, string, string) (Item, error)
	ListItems(context.Context, string, RecordStatus, string, int) ([]Item, string, error)
	UpdateItem(context.Context, string, Item, int64, identity.AuditEvent) (Item, error)
	TransitionItem(context.Context, string, string, int64, RecordStatus, time.Time, identity.AuditEvent) (Item, error)
	CreateWarehouse(context.Context, Warehouse, identity.AuditEvent) error
	GetWarehouse(context.Context, string, string) (Warehouse, error)
	ListWarehouses(context.Context, string, RecordStatus, string, int) ([]Warehouse, string, error)
	UpdateWarehouse(context.Context, string, Warehouse, int64, identity.AuditEvent) (Warehouse, error)
	TransitionWarehouse(context.Context, string, string, int64, RecordStatus, time.Time, identity.AuditEvent) (Warehouse, error)
	ListBalances(context.Context, string, string, string, int) ([]Balance, string, error)
	ApplyStock(context.Context, StockCommand) (StockResult, error)
	CreateReservation(context.Context, ReservationCommand) (ReservationResult, error)
	GetReservation(context.Context, string, string) (Reservation, error)
	ListReservations(context.Context, string, ReservationStatus, string, int) ([]Reservation, string, error)
	TransitionReservation(context.Context, ReservationTransitionCommand) (ReservationResult, error)
	CreatePurchaseOrder(context.Context, PurchaseOrder, identity.AuditEvent) error
	GetPurchaseOrder(context.Context, string, string) (PurchaseOrder, error)
	ListPurchaseOrders(context.Context, string, PurchaseOrderStatus, string, int) ([]PurchaseOrder, string, error)
	TransitionPurchaseOrder(context.Context, string, string, int64, PurchaseOrderStatus, time.Time, identity.AuditEvent) (PurchaseOrder, error)
	ReceivePurchaseOrder(context.Context, ReceiptCommand) (ReceiptResult, error)
	ListMovements(context.Context, string, string, string, string, int) ([]Movement, string, error)
}

// Service enforces inventory rules independently from HTTP and SQL.
type Service struct { store Store; now func() time.Time }

func NewService(store Store) *Service { return &Service{store: store, now: time.Now} }

func (service *Service) CreateItem(ctx context.Context, input ItemWrite, actor identity.Principal) (Item, error) {
	scope, err := actorScope(actor); if err != nil { return Item{}, err }
	sku, err := normalizedCode(input.SKU); if err != nil { return Item{}, err }
	name, err := requiredText(input.Name, maximumNameLength); if err != nil { return Item{}, err }
	unit, err := normalizedUnit(input.Unit); if err != nil { return Item{}, err }
	now := service.now().UTC()
	value := Item{ID:newID(), OrganizationID:scope, SKU:sku, Name:name, Unit:unit, Status:StatusActive, Version:1, CreatedAt:now, UpdatedAt:now}
	if err := service.store.CreateItem(ctx, value, audit(actor, "inventory:item:create", value.ID, now)); err != nil { return Item{}, wrap("create inventory item", err) }
	return value, nil
}

func (service *Service) GetItem(ctx context.Context, id string, actor identity.Principal) (Item, error) {
	scope, id, err := scopeAndID(actor, id); if err != nil { return Item{}, err }
	value, err := service.store.GetItem(ctx, scope, id); return value, wrap("get inventory item", err)
}

func (service *Service) ListItems(ctx context.Context, status RecordStatus, cursor string, limit int, actor identity.Principal) (ItemPage, error) {
	scope, err := actorScope(actor); if err != nil || !validRecordStatusFilter(status) || !validPage(cursor, limit) { return ItemPage{}, ErrInvalidInput }
	items, next, err := service.store.ListItems(ctx, scope, status, strings.TrimSpace(cursor), limit)
	return ItemPage{Items:items, NextCursor:next}, wrap("list inventory items", err)
}

func (service *Service) UpdateItem(ctx context.Context, id string, input ItemUpdate, actor identity.Principal) (Item, error) {
	scope, id, err := scopeAndID(actor, id); if err != nil || input.Version < 1 { return Item{}, ErrInvalidInput }
	sku, err := normalizedCode(input.SKU); if err != nil { return Item{}, err }
	name, err := requiredText(input.Name, maximumNameLength); if err != nil { return Item{}, err }
	unit, err := normalizedUnit(input.Unit); if err != nil { return Item{}, err }
	now := service.now().UTC(); value := Item{ID:id, OrganizationID:scope, SKU:sku, Name:name, Unit:unit, UpdatedAt:now}
	updated, err := service.store.UpdateItem(ctx, scope, value, input.Version, audit(actor, "inventory:item:update", id, now))
	return updated, wrap("update inventory item", err)
}

func (service *Service) TransitionItem(ctx context.Context, id string, input TransitionInput, target RecordStatus, actor identity.Principal) (Item, error) {
	scope, id, err := scopeAndID(actor, id); if err != nil || input.Version < 1 || !validRecordStatus(target) { return Item{}, ErrInvalidInput }
	now := service.now().UTC(); value, err := service.store.TransitionItem(ctx, scope, id, input.Version, target, now, audit(actor, "inventory:item:"+string(target), id, now))
	return value, wrap("transition inventory item", err)
}

func (service *Service) ArchiveItem(ctx context.Context,id string,input TransitionInput,actor identity.Principal)(Item,error){return service.TransitionItem(ctx,id,input,StatusArchived,actor)}
func (service *Service) ReactivateItem(ctx context.Context,id string,input TransitionInput,actor identity.Principal)(Item,error){return service.TransitionItem(ctx,id,input,StatusActive,actor)}

