// Package httpapi exposes permission-protected inventory routes.
package httpapi

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"strconv"

	"{{.ModulePath}}/internal/identity"
	identityhttp "{{.ModulePath}}/internal/identity/httpapi"
	"{{.ModulePath}}/internal/inventory"
	"{{.ModulePath}}/internal/platform/httpjson"
)

const defaultPageLimit = 20

// Handler maps inventory use cases to HTTP.
type Handler struct{ service *inventory.Service }

// New returns an inventory HTTP adapter.
func New(service *inventory.Service) *Handler { return &Handler{service: service} }

// Register adds inventory routes with least-privilege permissions.
func (handler *Handler) Register(mux *http.ServeMux, security *identityhttp.Handler) {
	mux.HandleFunc("POST /api/v1/inventory/items", security.Authorized("inventory:catalog:write", handler.createItem))
	mux.HandleFunc("GET /api/v1/inventory/items", security.Authorized("inventory:read", handler.listItems))
	mux.HandleFunc("GET /api/v1/inventory/items/{id}", security.Authorized("inventory:read", handler.getItem))
	mux.HandleFunc("PUT /api/v1/inventory/items/{id}", security.Authorized("inventory:catalog:write", handler.updateItem))
	mux.HandleFunc("POST /api/v1/inventory/items/{id}/archive", security.Authorized("inventory:catalog:write", handler.archiveItem))
	mux.HandleFunc("POST /api/v1/inventory/items/{id}/reactivate", security.Authorized("inventory:catalog:write", handler.reactivateItem))
	mux.HandleFunc("POST /api/v1/inventory/warehouses", security.Authorized("inventory:catalog:write", handler.createWarehouse))
	mux.HandleFunc("GET /api/v1/inventory/warehouses", security.Authorized("inventory:read", handler.listWarehouses))
	mux.HandleFunc("GET /api/v1/inventory/warehouses/{id}", security.Authorized("inventory:read", handler.getWarehouse))
	mux.HandleFunc("PUT /api/v1/inventory/warehouses/{id}", security.Authorized("inventory:catalog:write", handler.updateWarehouse))
	mux.HandleFunc("POST /api/v1/inventory/warehouses/{id}/archive", security.Authorized("inventory:catalog:write", handler.archiveWarehouse))
	mux.HandleFunc("POST /api/v1/inventory/warehouses/{id}/reactivate", security.Authorized("inventory:catalog:write", handler.reactivateWarehouse))
	mux.HandleFunc("GET /api/v1/inventory/balances", security.Authorized("inventory:read", handler.listBalances))
	mux.HandleFunc("POST /api/v1/inventory/adjustments", security.Authorized("inventory:stock:manage", handler.adjustStock))
	mux.HandleFunc("GET /api/v1/inventory/movements", security.Authorized("inventory:read", handler.listMovements))
	mux.HandleFunc("POST /api/v1/inventory/reservations", security.Authorized("inventory:stock:manage", handler.createReservation))
	mux.HandleFunc("GET /api/v1/inventory/reservations", security.Authorized("inventory:read", handler.listReservations))
	mux.HandleFunc("GET /api/v1/inventory/reservations/{id}", security.Authorized("inventory:read", handler.getReservation))
	mux.HandleFunc("POST /api/v1/inventory/reservations/{id}/release", security.Authorized("inventory:stock:manage", handler.releaseReservation))
	mux.HandleFunc("POST /api/v1/inventory/reservations/{id}/consume", security.Authorized("inventory:stock:manage", handler.consumeReservation))
	mux.HandleFunc("POST /api/v1/inventory/purchase-orders", security.Authorized("inventory:procurement:manage", handler.createPurchaseOrder))
	mux.HandleFunc("GET /api/v1/inventory/purchase-orders", security.Authorized("inventory:read", handler.listPurchaseOrders))
	mux.HandleFunc("GET /api/v1/inventory/purchase-orders/{id}", security.Authorized("inventory:read", handler.getPurchaseOrder))
	mux.HandleFunc("POST /api/v1/inventory/purchase-orders/{id}/submit", security.Authorized("inventory:procurement:manage", handler.submitPurchaseOrder))
	mux.HandleFunc("POST /api/v1/inventory/purchase-orders/{id}/cancel", security.Authorized("inventory:procurement:manage", handler.cancelPurchaseOrder))
	mux.HandleFunc("POST /api/v1/inventory/purchase-orders/{id}/receive", security.Authorized("inventory:procurement:manage", handler.receivePurchaseOrder))
}

func (handler *Handler) createItem(response http.ResponseWriter, request *http.Request, actor identity.Principal) {
	var input inventory.ItemWrite; if !decode(response,request,&input){return}; value,err:=handler.service.CreateItem(request.Context(),input,actor); writeResult(response,http.StatusCreated,value,"create inventory item",err)
}
func (handler *Handler) getItem(response http.ResponseWriter,request *http.Request,actor identity.Principal){value,err:=handler.service.GetItem(request.Context(),request.PathValue("id"),actor);writeResult(response,http.StatusOK,value,"get inventory item",err)}
func (handler *Handler) listItems(response http.ResponseWriter,request *http.Request,actor identity.Principal){limit,ok:=pageLimit(response,request);if !ok{return};value,err:=handler.service.ListItems(request.Context(),inventory.RecordStatus(request.URL.Query().Get("status")),request.URL.Query().Get("cursor"),limit,actor);writeResult(response,http.StatusOK,value,"list inventory items",err)}
func (handler *Handler) updateItem(response http.ResponseWriter,request *http.Request,actor identity.Principal){var input inventory.ItemUpdate;if !decode(response,request,&input){return};value,err:=handler.service.UpdateItem(request.Context(),request.PathValue("id"),input,actor);writeResult(response,http.StatusOK,value,"update inventory item",err)}
func (handler *Handler) archiveItem(response http.ResponseWriter,request *http.Request,actor identity.Principal){handler.itemTransition(response,request,actor,handler.service.ArchiveItem,"archive inventory item")}
func (handler *Handler) reactivateItem(response http.ResponseWriter,request *http.Request,actor identity.Principal){handler.itemTransition(response,request,actor,handler.service.ReactivateItem,"reactivate inventory item")}
func (handler *Handler) itemTransition(response http.ResponseWriter,request *http.Request,actor identity.Principal,operation func(context.Context,string,inventory.TransitionInput,identity.Principal)(inventory.Item,error),name string){var input inventory.TransitionInput;if !decode(response,request,&input){return};value,err:=operation(request.Context(),request.PathValue("id"),input,actor);writeResult(response,http.StatusOK,value,name,err)}

