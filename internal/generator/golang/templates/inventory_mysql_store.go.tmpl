// Store is the MySQL inventory repository.
type Store struct{ database *sql.DB }

func New(database *sql.DB) *Store { return &Store{database: database} }

func (store *Store) CreateItem(ctx context.Context, value inventory.Item, audit identity.AuditEvent) error {
	return store.mutate(ctx, func(tx *sql.Tx) error {
		if err := requireActiveScope(ctx, tx, value.OrganizationID); err != nil { return err }
		_, err := tx.ExecContext(ctx, `insert into inventory_items
			(id,organization_id,sku,name,unit,status,version,created_at,updated_at)
			values (?,?,?,?,?,?,?,?,?)`, value.ID,value.OrganizationID,value.SKU,value.Name,value.Unit,value.Status,value.Version,value.CreatedAt,value.UpdatedAt)
		if err != nil { return persistenceError(err) }
		return appendAudit(ctx,tx,audit)
	})
}

func (store *Store) GetItem(ctx context.Context, scope,id string)(inventory.Item,error){return scanItem(store.database.QueryRowContext(ctx,itemSelect+` where item.id=? and item.organization_id=?`+activeScopePredicate("item"),id,scope))}

func (store *Store) ListItems(ctx context.Context,scope string,status inventory.RecordStatus,cursor string,limit int)([]inventory.Item,string,error){
	rows,err:=store.database.QueryContext(ctx,itemSelect+` where item.organization_id=? and (?='' or item.status=?) and (?='' or item.id>?)`+activeScopePredicate("item")+` order by item.id limit ?`,scope,status,status,cursor,cursor,limit+1)
	if err!=nil{return nil,"",fmt.Errorf("query inventory items: %w",err)};defer rows.Close();items:=make([]inventory.Item,0,limit+1)
	for rows.Next(){value,scanErr:=scanItem(rows);if scanErr!=nil{return nil,"",scanErr};items=append(items,value)};if err:=rows.Err();err!=nil{return nil,"",fmt.Errorf("iterate inventory items: %w",err)};return itemPage(items,limit)
}

func (store *Store) UpdateItem(ctx context.Context,scope string,value inventory.Item,version int64,audit identity.AuditEvent)(inventory.Item,error){
	err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,scope);err!=nil{return err};result,err:=tx.ExecContext(ctx,`update inventory_items set sku=?,name=?,unit=?,version=version+1,updated_at=? where id=? and organization_id=? and version=? and status='active'`,value.SKU,value.Name,value.Unit,value.UpdatedAt,value.ID,scope,version);if err!=nil{return persistenceError(err)};if err:=requireMutation(result);err!=nil{return err};value,err=getItemTx(ctx,tx,scope,value.ID);if err!=nil{return err};return appendAudit(ctx,tx,audit)});return value,err
}

func (store *Store) TransitionItem(ctx context.Context,scope,id string,version int64,target inventory.RecordStatus,now time.Time,audit identity.AuditEvent)(inventory.Item,error){
	var value inventory.Item;err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,scope);err!=nil{return err};result,err:=tx.ExecContext(ctx,`update inventory_items set status=?,version=version+1,updated_at=? where id=? and organization_id=? and version=? and status<>?`,target,now,id,scope,version,target);if err!=nil{return persistenceError(err)};if err:=requireMutation(result);err!=nil{return err};value,err=getItemTx(ctx,tx,scope,id);if err!=nil{return err};return appendAudit(ctx,tx,audit)});return value,err
}

func (store *Store) CreateWarehouse(ctx context.Context,value inventory.Warehouse,audit identity.AuditEvent)error{return store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,value.OrganizationID);err!=nil{return err};_,err:=tx.ExecContext(ctx,`insert into inventory_warehouses (id,organization_id,code,name,status,version,created_at,updated_at) values (?,?,?,?,?,?,?,?)`,value.ID,value.OrganizationID,value.Code,value.Name,value.Status,value.Version,value.CreatedAt,value.UpdatedAt);if err!=nil{return persistenceError(err)};return appendAudit(ctx,tx,audit)})}
func (store *Store) GetWarehouse(ctx context.Context,scope,id string)(inventory.Warehouse,error){return scanWarehouse(store.database.QueryRowContext(ctx,warehouseSelect+` where warehouse.id=? and warehouse.organization_id=?`+activeScopePredicate("warehouse"),id,scope))}
func (store *Store) ListWarehouses(ctx context.Context,scope string,status inventory.RecordStatus,cursor string,limit int)([]inventory.Warehouse,string,error){rows,err:=store.database.QueryContext(ctx,warehouseSelect+` where warehouse.organization_id=? and (?='' or warehouse.status=?) and (?='' or warehouse.id>?)`+activeScopePredicate("warehouse")+` order by warehouse.id limit ?`,scope,status,status,cursor,cursor,limit+1);if err!=nil{return nil,"",fmt.Errorf("query inventory warehouses: %w",err)};defer rows.Close();items:=make([]inventory.Warehouse,0,limit+1);for rows.Next(){value,scanErr:=scanWarehouse(rows);if scanErr!=nil{return nil,"",scanErr};items=append(items,value)};if err:=rows.Err();err!=nil{return nil,"",fmt.Errorf("iterate inventory warehouses: %w",err)};return warehousePage(items,limit)}
func (store *Store) UpdateWarehouse(ctx context.Context,scope string,value inventory.Warehouse,version int64,audit identity.AuditEvent)(inventory.Warehouse,error){err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,scope);err!=nil{return err};result,err:=tx.ExecContext(ctx,`update inventory_warehouses set code=?,name=?,version=version+1,updated_at=? where id=? and organization_id=? and version=? and status='active'`,value.Code,value.Name,value.UpdatedAt,value.ID,scope,version);if err!=nil{return persistenceError(err)};if err:=requireMutation(result);err!=nil{return err};value,err=getWarehouseTx(ctx,tx,scope,value.ID);if err!=nil{return err};return appendAudit(ctx,tx,audit)});return value,err}
func (store *Store) TransitionWarehouse(ctx context.Context,scope,id string,version int64,target inventory.RecordStatus,now time.Time,audit identity.AuditEvent)(inventory.Warehouse,error){var value inventory.Warehouse;err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,scope);err!=nil{return err};result,err:=tx.ExecContext(ctx,`update inventory_warehouses set status=?,version=version+1,updated_at=? where id=? and organization_id=? and version=? and status<>?`,target,now,id,scope,version,target);if err!=nil{return persistenceError(err)};if err:=requireMutation(result);err!=nil{return err};value,err=getWarehouseTx(ctx,tx,scope,id);if err!=nil{return err};return appendAudit(ctx,tx,audit)});return value,err}

func(store *Store)ListBalances(ctx context.Context,scope,itemID,cursor string,limit int)([]inventory.Balance,string,error){rows,err:=store.database.QueryContext(ctx,balanceSelect+` where balance.organization_id=? and (?='' or balance.item_id=?) and (?='' or concat(balance.item_id,':',balance.warehouse_id)>?)`+activeScopePredicate("balance")+` order by balance.item_id,balance.warehouse_id limit ?`,scope,itemID,itemID,cursor,cursor,limit+1);if err!=nil{return nil,"",fmt.Errorf("query inventory balances: %w",err)};defer rows.Close();items:=make([]inventory.Balance,0,limit+1);for rows.Next(){value,scanErr:=scanBalance(rows);if scanErr!=nil{return nil,"",scanErr};items=append(items,value)};if err:=rows.Err();err!=nil{return nil,"",fmt.Errorf("iterate inventory balances: %w",err)};if len(items)<=limit{return items,"",nil};next:=items[limit-1].ItemID+":"+items[limit-1].WarehouseID;return items[:limit],next,nil}

func(store *Store)ApplyStock(ctx context.Context,command inventory.StockCommand)(inventory.StockResult,error){var result inventory.StockResult;err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,command.Scope);err!=nil{return err};replay,found,err:=claim(ctx,tx,command.Scope,command.IdempotencyKey,command.Fingerprint,"stock",command.Movement.CreatedAt);if err!=nil{return err};if found{err=decodeReplay(replay.Payload,&result);return err};if err:=requireActiveScope(ctx,tx,command.Scope);err!=nil{return err};if err:=requireActiveStock(ctx,tx,command.Scope,command.Movement.ItemID,command.Movement.WarehouseID);err!=nil{return err};balance,err:=lockBalance(ctx,tx,command.Scope,command.Movement.ItemID,command.Movement.WarehouseID,command.Movement.CreatedAt);if err!=nil{return err};nextOnHand:=balance.OnHand+command.Movement.QuantityDelta;nextReserved:=balance.Reserved+command.Movement.ReservedDelta;if nextOnHand<0||nextReserved<0||nextReserved>nextOnHand{return inventory.ErrConflict};result.Balance,err=updateBalance(ctx,tx,balance,nextOnHand,nextReserved,command.Movement.CreatedAt);if err!=nil{return err};if err:=insertMovement(ctx,tx,command.Movement);err!=nil{return err};result.Movement=command.Movement;if err:=completeClaim(ctx,tx,command.Scope,command.IdempotencyKey,command.Movement.ReferenceID,command.Movement.ID,result);err!=nil{return err};return appendAudit(ctx,tx,command.Audit)});return result,err}

func(store *Store)CreateReservation(ctx context.Context,command inventory.ReservationCommand)(inventory.ReservationResult,error){var result inventory.ReservationResult;err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,command.Scope);err!=nil{return err};replay,found,err:=claim(ctx,tx,command.Scope,command.IdempotencyKey,command.Fingerprint,"reservation",command.Reservation.CreatedAt);if err!=nil{return err};if found{err=decodeReplay(replay.Payload,&result);return err};if err:=requireActiveScope(ctx,tx,command.Scope);err!=nil{return err};if err:=requireActiveStock(ctx,tx,command.Scope,command.Reservation.ItemID,command.Reservation.WarehouseID);err!=nil{return err};balance,err:=lockBalance(ctx,tx,command.Scope,command.Reservation.ItemID,command.Reservation.WarehouseID,command.Reservation.CreatedAt);if err!=nil{return err};if balance.OnHand-balance.Reserved<command.Reservation.Quantity{return inventory.ErrConflict};_,err=tx.ExecContext(ctx,`insert into inventory_reservations (id,organization_id,external_reference,item_id,warehouse_id,quantity,status,version,created_at,updated_at) values (?,?,?,?,?,?,?,?,?,?)`,command.Reservation.ID,command.Scope,command.Reservation.ExternalReference,command.Reservation.ItemID,command.Reservation.WarehouseID,command.Reservation.Quantity,command.Reservation.Status,command.Reservation.Version,command.Reservation.CreatedAt,command.Reservation.UpdatedAt);if err!=nil{return persistenceError(err)};result.Balance,err=updateBalance(ctx,tx,balance,balance.OnHand,balance.Reserved+command.Reservation.Quantity,command.Reservation.UpdatedAt);if err!=nil{return err};if err:=insertMovement(ctx,tx,command.Movement);err!=nil{return err};result.Reservation=command.Reservation;result.Movement=command.Movement;if err:=completeClaim(ctx,tx,command.Scope,command.IdempotencyKey,command.Reservation.ID,command.Movement.ID,result);err!=nil{return err};return appendAudit(ctx,tx,command.Audit)});return result,err}

func(store *Store)GetReservation(ctx context.Context,scope,id string)(inventory.Reservation,error){return scanReservation(store.database.QueryRowContext(ctx,reservationSelect+` where reservation.id=? and reservation.organization_id=?`+activeScopePredicate("reservation"),id,scope))}
func(store *Store)ListReservations(ctx context.Context,scope string,status inventory.ReservationStatus,cursor string,limit int)([]inventory.Reservation,string,error){rows,err:=store.database.QueryContext(ctx,reservationSelect+` where reservation.organization_id=? and (?='' or reservation.status=?) and (?='' or reservation.id>?)`+activeScopePredicate("reservation")+` order by reservation.id limit ?`,scope,status,status,cursor,cursor,limit+1);if err!=nil{return nil,"",fmt.Errorf("query inventory reservations: %w",err)};defer rows.Close();items:=make([]inventory.Reservation,0,limit+1);for rows.Next(){value,scanErr:=scanReservation(rows);if scanErr!=nil{return nil,"",scanErr};items=append(items,value)};if err:=rows.Err();err!=nil{return nil,"",fmt.Errorf("iterate inventory reservations: %w",err)};return reservationPage(items,limit)}

func(store *Store)TransitionReservation(ctx context.Context,command inventory.ReservationTransitionCommand)(inventory.ReservationResult,error){var result inventory.ReservationResult;err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,command.Scope);err!=nil{return err};replay,found,err:=claim(ctx,tx,command.Scope,command.IdempotencyKey,command.Fingerprint,"reservation",command.OccurredAt);if err!=nil{return err};if found{err=decodeReplay(replay.Payload,&result);return err};if err:=requireActiveScope(ctx,tx,command.Scope);err!=nil{return err};value,err:=scanReservation(tx.QueryRowContext(ctx,reservationSelect+` where reservation.id=? and reservation.organization_id=? for update`,command.ReservationID,command.Scope));if err!=nil{return err};if value.Status!=inventory.ReservationActive||value.Version!=command.Version{return inventory.ErrConflict};balance,err:=lockBalance(ctx,tx,command.Scope,value.ItemID,value.WarehouseID,command.OccurredAt);if err!=nil{return err};quantityDelta:=int64(0);kind:=inventory.MovementReservationReleased;reason:="stock reservation released";if command.Target==inventory.ReservationConsumed{quantityDelta=-value.Quantity;kind=inventory.MovementReservationConsumed;reason="stock reservation consumed"};nextOnHand:=balance.OnHand+quantityDelta;nextReserved:=balance.Reserved-value.Quantity;if nextOnHand<0||nextReserved<0||nextReserved>nextOnHand{return inventory.ErrConflict};mutation,err:=tx.ExecContext(ctx,`update inventory_reservations set status=?,version=version+1,updated_at=? where id=? and version=? and status='active'`,command.Target,command.OccurredAt,value.ID,command.Version);if err!=nil{return persistenceError(err)};if err:=requireMutation(mutation);err!=nil{return err};value,err=getReservationTx(ctx,tx,command.Scope,value.ID);if err!=nil{return err};result.Balance,err=updateBalance(ctx,tx,balance,nextOnHand,nextReserved,command.OccurredAt);if err!=nil{return err};movement:=inventory.Movement{ID:command.MovementID,OrganizationID:command.Scope,ItemID:value.ItemID,WarehouseID:value.WarehouseID,Kind:kind,QuantityDelta:quantityDelta,ReservedDelta:-value.Quantity,ReferenceType:"reservation",ReferenceID:value.ID,Reason:reason,IdempotencyKey:command.IdempotencyKey,CreatedBy:command.ActorID,CreatedAt:command.OccurredAt};if err:=insertMovement(ctx,tx,movement);err!=nil{return err};result.Reservation=value;result.Movement=movement;if err:=completeClaim(ctx,tx,command.Scope,command.IdempotencyKey,value.ID,movement.ID,result);err!=nil{return err};return appendAudit(ctx,tx,command.Audit)});return result,err}

func(store *Store)CreatePurchaseOrder(ctx context.Context,value inventory.PurchaseOrder,audit identity.AuditEvent)error{return store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,value.OrganizationID);err!=nil{return err};for _,line:=range value.Lines{if err:=requireActiveItem(ctx,tx,value.OrganizationID,line.ItemID);err!=nil{return err}};_,err:=tx.ExecContext(ctx,`insert into inventory_purchase_orders (id,organization_id,order_number,supplier_name,status,version,created_at,updated_at) values (?,?,?,?,?,?,?,?)`,value.ID,value.OrganizationID,value.Number,value.SupplierName,value.Status,value.Version,value.CreatedAt,value.UpdatedAt);if err!=nil{return persistenceError(err)};for _,line:=range value.Lines{if _,err:=tx.ExecContext(ctx,`insert into inventory_purchase_order_lines (id,purchase_order_id,item_id,ordered_quantity,received_quantity) values (?,?,?,?,?)`,line.ID,value.ID,line.ItemID,line.OrderedQuantity,line.ReceivedQuantity);err!=nil{return persistenceError(err)}};return appendAudit(ctx,tx,audit)})}

func(store *Store)GetPurchaseOrder(ctx context.Context,scope,id string)(inventory.PurchaseOrder,error){value,err:=scanPurchaseOrder(store.database.QueryRowContext(ctx,purchaseSelect+` where purchase.id=? and purchase.organization_id=?`+activeScopePredicate("purchase"),id,scope));if err!=nil{return inventory.PurchaseOrder{},err};value.Lines,err=store.purchaseLines(ctx,id);return value,err}
func(store *Store)ListPurchaseOrders(ctx context.Context,scope string,status inventory.PurchaseOrderStatus,cursor string,limit int)([]inventory.PurchaseOrder,string,error){rows,err:=store.database.QueryContext(ctx,purchaseSelect+` where purchase.organization_id=? and (?='' or purchase.status=?) and (?='' or purchase.id>?)`+activeScopePredicate("purchase")+` order by purchase.id limit ?`,scope,status,status,cursor,cursor,limit+1);if err!=nil{return nil,"",fmt.Errorf("query inventory purchase orders: %w",err)};items:=make([]inventory.PurchaseOrder,0,limit+1);for rows.Next(){value,scanErr:=scanPurchaseOrder(rows);if scanErr!=nil{rows.Close();return nil,"",scanErr};items=append(items,value)};if err:=rows.Err();err!=nil{rows.Close();return nil,"",fmt.Errorf("iterate inventory purchase orders: %w",err)};rows.Close();for index:=range items{items[index].Lines,err=store.purchaseLines(ctx,items[index].ID);if err!=nil{return nil,"",err}};return purchasePage(items,limit)}

func(store *Store)TransitionPurchaseOrder(ctx context.Context,scope,id string,version int64,target inventory.PurchaseOrderStatus,now time.Time,audit identity.AuditEvent)(inventory.PurchaseOrder,error){var value inventory.PurchaseOrder;err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,scope);err!=nil{return err};condition:=`status='draft'`;if target==inventory.PurchaseCancelled{condition=`status in ('draft','submitted') and not exists (select 1 from inventory_purchase_order_lines line where line.purchase_order_id=inventory_purchase_orders.id and line.received_quantity>0)`};mutation,err:=tx.ExecContext(ctx,`update inventory_purchase_orders set status=?,version=version+1,updated_at=? where id=? and organization_id=? and version=? and `+condition,target,now,id,scope,version);if err!=nil{return persistenceError(err)};if err:=requireMutation(mutation);err!=nil{return err};value,err=getPurchaseOrderTx(ctx,tx,scope,id);if err!=nil{return err};value.Lines,err=purchaseLinesTx(ctx,tx,id);if err!=nil{return err};return appendAudit(ctx,tx,audit)});return value,err}

func(store *Store)ReceivePurchaseOrder(ctx context.Context,command inventory.ReceiptCommand)(inventory.ReceiptResult,error){var result inventory.ReceiptResult;err:=store.mutate(ctx,func(tx *sql.Tx)error{if err:=requireActiveScope(ctx,tx,command.Scope);err!=nil{return err};replay,found,err:=claim(ctx,tx,command.Scope,command.IdempotencyKey,command.Fingerprint,"receipt",command.OccurredAt);if err!=nil{return err};if found{err=decodeReplay(replay.Payload,&result);return err};if err:=requireActiveScope(ctx,tx,command.Scope);err!=nil{return err};purchase,err:=scanPurchaseOrder(tx.QueryRowContext(ctx,purchaseSelect+` where purchase.id=? and purchase.organization_id=? for update`,command.PurchaseOrderID,command.Scope));if err!=nil{return err};if purchase.Version!=command.Version||(purchase.Status!=inventory.PurchaseSubmitted&&purchase.Status!=inventory.PurchasePartiallyReceived){return inventory.ErrConflict};line,err:=scanPurchaseLine(tx.QueryRowContext(ctx,lineSelect+` where line.id=? and line.purchase_order_id=? for update`,command.LineID,purchase.ID));if err!=nil{return err};if line.ReceivedQuantity+command.Quantity>line.OrderedQuantity{return inventory.ErrConflict};if err:=requireActiveStock(ctx,tx,command.Scope,line.ItemID,command.WarehouseID);err!=nil{return err};balance,err:=lockBalance(ctx,tx,command.Scope,line.ItemID,command.WarehouseID,command.OccurredAt);if err!=nil{return err};line.ReceivedQuantity+=command.Quantity;if _,err:=tx.ExecContext(ctx,`update inventory_purchase_order_lines set received_quantity=? where id=?`,line.ReceivedQuantity,line.ID);err!=nil{return err};var remaining bool;if err:=tx.QueryRowContext(ctx,`select exists(select 1 from inventory_purchase_order_lines where purchase_order_id=? and received_quantity<ordered_quantity)`,purchase.ID).Scan(&remaining);err!=nil{return fmt.Errorf("check purchase receipt completion: %w",err)};target:=inventory.PurchaseReceived;if remaining{target=inventory.PurchasePartiallyReceived};mutation,err:=tx.ExecContext(ctx,`update inventory_purchase_orders set status=?,version=version+1,updated_at=? where id=? and version=?`,target,command.OccurredAt,purchase.ID,command.Version);if err!=nil{return persistenceError(err)};if err:=requireMutation(mutation);err!=nil{return err};purchase,err=getPurchaseOrderTx(ctx,tx,command.Scope,purchase.ID);if err!=nil{return err};purchase.Lines,err=purchaseLinesTx(ctx,tx,purchase.ID);if err!=nil{return err};result.Balance,err=updateBalance(ctx,tx,balance,balance.OnHand+command.Quantity,balance.Reserved,command.OccurredAt);if err!=nil{return err};movement:=inventory.Movement{ID:command.MovementID,OrganizationID:command.Scope,ItemID:line.ItemID,WarehouseID:command.WarehouseID,Kind:inventory.MovementPurchaseReceived,QuantityDelta:command.Quantity,ReferenceType:"purchase_order",ReferenceID:purchase.ID,Reason:"purchase order received",IdempotencyKey:command.IdempotencyKey,CreatedBy:command.ActorID,CreatedAt:command.OccurredAt};if err:=insertMovement(ctx,tx,movement);err!=nil{return err};result.PurchaseOrder=purchase;result.Movement=movement;if err:=completeClaim(ctx,tx,command.Scope,command.IdempotencyKey,purchase.ID,movement.ID,result);err!=nil{return err};return appendAudit(ctx,tx,command.Audit)});return result,err}

func(store *Store)ListMovements(ctx context.Context,scope,itemID,warehouseID,cursor string,limit int)([]inventory.Movement,string,error){rows,err:=store.database.QueryContext(ctx,movementSelect+` where movement.organization_id=? and (?='' or movement.item_id=?) and (?='' or movement.warehouse_id=?) and (?='' or movement.id>?)`+activeScopePredicate("movement")+` order by movement.id limit ?`,scope,itemID,itemID,warehouseID,warehouseID,cursor,cursor,limit+1);if err!=nil{return nil,"",fmt.Errorf("query inventory movements: %w",err)};defer rows.Close();items:=make([]inventory.Movement,0,limit+1);for rows.Next(){value,scanErr:=scanMovement(rows);if scanErr!=nil{return nil,"",scanErr};items=append(items,value)};if err:=rows.Err();err!=nil{return nil,"",fmt.Errorf("iterate inventory movements: %w",err)};return movementPage(items,limit)}

type idempotencyRecord struct{Fingerprint,ResultType,ResultID,MovementID,Payload string}
func claim(ctx context.Context,tx *sql.Tx,scope,key,fingerprint,resultType string,now time.Time)(idempotencyRecord,bool,error){tag,err:=tx.ExecContext(ctx,`insert ignore into inventory_idempotency (organization_id,idempotency_key,fingerprint,result_type,created_at) values (?,?,?,?,?)`,scope,key,fingerprint,resultType,now);if err!=nil{return idempotencyRecord{},false,fmt.Errorf("claim inventory idempotency key: %w",err)};count,err:=tag.RowsAffected();if err!=nil{return idempotencyRecord{},false,fmt.Errorf("inspect inventory idempotency claim: %w",err)};if count==1{return idempotencyRecord{},false,nil};var value idempotencyRecord;if err:=tx.QueryRowContext(ctx,`select fingerprint,result_type,coalesce(result_id,''),coalesce(movement_id,''),coalesce(result_payload,'') from inventory_idempotency where organization_id=? and idempotency_key=?`,scope,key).Scan(&value.Fingerprint,&value.ResultType,&value.ResultID,&value.MovementID,&value.Payload);err!=nil{return idempotencyRecord{},false,fmt.Errorf("read inventory idempotency key: %w",err)};if value.Fingerprint!=fingerprint||value.ResultType!=resultType||value.ResultID==""||value.MovementID==""||value.Payload==""{return idempotencyRecord{},false,inventory.ErrConflict};return value,true,nil}
func completeClaim(ctx context.Context,tx *sql.Tx,scope,key,resultID,movementID string,result any)error{payload,err:=json.Marshal(result);if err!=nil{return fmt.Errorf("encode inventory idempotency result: %w",err)};tag,err:=tx.ExecContext(ctx,`update inventory_idempotency set result_id=?,movement_id=?,result_payload=? where organization_id=? and idempotency_key=? and result_id is null and movement_id is null`,resultID,movementID,string(payload),scope,key);if err!=nil{return fmt.Errorf("complete inventory idempotency key: %w",err)};count,err:=tag.RowsAffected();if err!=nil{return fmt.Errorf("inspect inventory idempotency completion: %w",err)};if count!=1{return inventory.ErrConflict};return nil}
func decodeReplay(payload string,target any)error{if err:=json.Unmarshal([]byte(payload),target);err!=nil{return fmt.Errorf("decode inventory idempotency result: %w",err)};return nil}

func requireActiveScope(ctx context.Context,tx *sql.Tx,scope string)error{ {{if .Tenancy}}var id string;if err:=tx.QueryRowContext(ctx,`select id from organizations where id=? and status='active' for update`,scope).Scan(&id);err!=nil{if errors.Is(err,sql.ErrNoRows){return inventory.ErrNotFound};return fmt.Errorf("lock inventory organization scope: %w",err)}{{end}};return nil }
func activeScopePredicate(alias string)string{ {{if .Tenancy}}return ` and exists (select 1 from organizations organization where organization.id=`+alias+`.organization_id and organization.status='active')`{{else}}return ""{{end}} }
func requireActiveItem(ctx context.Context,tx *sql.Tx,scope,id string)error{var found string;if err:=tx.QueryRowContext(ctx,`select id from inventory_items where id=? and organization_id=? and status='active' for update`,id,scope).Scan(&found);err!=nil{if errors.Is(err,sql.ErrNoRows){return inventory.ErrNotFound};return fmt.Errorf("lock inventory item: %w",err)};return nil}
func requireActiveStock(ctx context.Context,tx *sql.Tx,scope,itemID,warehouseID string)error{if err:=requireActiveItem(ctx,tx,scope,itemID);err!=nil{return err};var found string;if err:=tx.QueryRowContext(ctx,`select id from inventory_warehouses where id=? and organization_id=? and status='active' for update`,warehouseID,scope).Scan(&found);err!=nil{if errors.Is(err,sql.ErrNoRows){return inventory.ErrNotFound};return fmt.Errorf("lock inventory warehouse: %w",err)};return nil}
func lockBalance(ctx context.Context,tx *sql.Tx,scope,itemID,warehouseID string,now time.Time)(inventory.Balance,error){_,err:=tx.ExecContext(ctx,`insert ignore into inventory_balances (organization_id,item_id,warehouse_id,on_hand,reserved,version,updated_at) values (?,?,?,0,0,1,?)`,scope,itemID,warehouseID,now);if err!=nil{return inventory.Balance{},persistenceError(err)};return scanBalance(tx.QueryRowContext(ctx,balanceSelect+` where balance.organization_id=? and balance.item_id=? and balance.warehouse_id=? for update`,scope,itemID,warehouseID))}
func updateBalance(ctx context.Context,tx *sql.Tx,current inventory.Balance,onHand,reserved int64,now time.Time)(inventory.Balance,error){result,err:=tx.ExecContext(ctx,`update inventory_balances set on_hand=?,reserved=?,version=version+1,updated_at=? where item_id=? and warehouse_id=? and version=?`,onHand,reserved,now,current.ItemID,current.WarehouseID,current.Version);if err!=nil{return inventory.Balance{},persistenceError(err)};if err:=requireMutation(result);err!=nil{return inventory.Balance{},err};return scanBalance(tx.QueryRowContext(ctx,balanceSelect+` where balance.item_id=? and balance.warehouse_id=?`,current.ItemID,current.WarehouseID))}
func insertMovement(ctx context.Context,tx *sql.Tx,value inventory.Movement)error{_,err:=tx.ExecContext(ctx,`insert into inventory_movements (id,organization_id,item_id,warehouse_id,movement_kind,quantity_delta,reserved_delta,reference_type,reference_id,reason,idempotency_key,created_by,created_at) values (?,?,?,?,?,?,?,?,?,?,?,?,?)`,value.ID,value.OrganizationID,value.ItemID,value.WarehouseID,value.Kind,value.QuantityDelta,value.ReservedDelta,value.ReferenceType,value.ReferenceID,value.Reason,value.IdempotencyKey,value.CreatedBy,value.CreatedAt);if err!=nil{return persistenceError(err)};return nil}

func loadStockResult(ctx context.Context,tx *sql.Tx,scope,movementID string)(inventory.StockResult,error){movement,err:=scanMovement(tx.QueryRowContext(ctx,movementSelect+` where movement.id=? and movement.organization_id=?`,movementID,scope));if err!=nil{return inventory.StockResult{},err};balance,err:=scanBalance(tx.QueryRowContext(ctx,balanceSelect+` where balance.organization_id=? and balance.item_id=? and balance.warehouse_id=?`,scope,movement.ItemID,movement.WarehouseID));return inventory.StockResult{Balance:balance,Movement:movement},err}
func loadReservationResult(ctx context.Context,tx *sql.Tx,scope,reservationID,movementID string)(inventory.ReservationResult,error){reservation,err:=scanReservation(tx.QueryRowContext(ctx,reservationSelect+` where reservation.id=? and reservation.organization_id=?`,reservationID,scope));if err!=nil{return inventory.ReservationResult{},err};stock,err:=loadStockResult(ctx,tx,scope,movementID);return inventory.ReservationResult{Reservation:reservation,Balance:stock.Balance,Movement:stock.Movement},err}
func loadReceiptResult(ctx context.Context,tx *sql.Tx,scope,purchaseID,movementID string)(inventory.ReceiptResult,error){purchase,err:=scanPurchaseOrder(tx.QueryRowContext(ctx,purchaseSelect+` where purchase.id=? and purchase.organization_id=?`,purchaseID,scope));if err!=nil{return inventory.ReceiptResult{},err};purchase.Lines,err=purchaseLinesTx(ctx,tx,purchaseID);if err!=nil{return inventory.ReceiptResult{},err};stock,err:=loadStockResult(ctx,tx,scope,movementID);return inventory.ReceiptResult{PurchaseOrder:purchase,Balance:stock.Balance,Movement:stock.Movement},err}

const itemSelect=`select item.id,item.organization_id,item.sku,item.name,item.unit,item.status,item.version,item.created_at,item.updated_at from inventory_items item`
const warehouseSelect=`select warehouse.id,warehouse.organization_id,warehouse.code,warehouse.name,warehouse.status,warehouse.version,warehouse.created_at,warehouse.updated_at from inventory_warehouses warehouse`
const balanceSelect=`select balance.item_id,balance.warehouse_id,balance.on_hand,balance.reserved,balance.on_hand-balance.reserved,balance.version,balance.updated_at from inventory_balances balance`
const movementSelect=`select movement.id,movement.organization_id,movement.item_id,movement.warehouse_id,movement.movement_kind,movement.quantity_delta,movement.reserved_delta,movement.reference_type,movement.reference_id,movement.reason,movement.idempotency_key,movement.created_by,movement.created_at from inventory_movements movement`
const reservationSelect=`select reservation.id,reservation.organization_id,reservation.external_reference,reservation.item_id,reservation.warehouse_id,reservation.quantity,reservation.status,reservation.version,reservation.created_at,reservation.updated_at from inventory_reservations reservation`
const purchaseSelect=`select purchase.id,purchase.organization_id,purchase.order_number,purchase.supplier_name,purchase.status,purchase.version,purchase.created_at,purchase.updated_at from inventory_purchase_orders purchase`
const lineSelect=`select line.id,line.item_id,line.ordered_quantity,line.received_quantity from inventory_purchase_order_lines line`

type rowScanner interface{Scan(...any)error}
func scanItem(row rowScanner)(inventory.Item,error){var value inventory.Item;if err:=row.Scan(&value.ID,&value.OrganizationID,&value.SKU,&value.Name,&value.Unit,&value.Status,&value.Version,&value.CreatedAt,&value.UpdatedAt);err!=nil{return inventory.Item{},scanError("item",err)};return value,nil}
func scanWarehouse(row rowScanner)(inventory.Warehouse,error){var value inventory.Warehouse;if err:=row.Scan(&value.ID,&value.OrganizationID,&value.Code,&value.Name,&value.Status,&value.Version,&value.CreatedAt,&value.UpdatedAt);err!=nil{return inventory.Warehouse{},scanError("warehouse",err)};return value,nil}
func scanBalance(row rowScanner)(inventory.Balance,error){var value inventory.Balance;if err:=row.Scan(&value.ItemID,&value.WarehouseID,&value.OnHand,&value.Reserved,&value.Available,&value.Version,&value.UpdatedAt);err!=nil{return inventory.Balance{},scanError("balance",err)};return value,nil}
func scanMovement(row rowScanner)(inventory.Movement,error){var value inventory.Movement;if err:=row.Scan(&value.ID,&value.OrganizationID,&value.ItemID,&value.WarehouseID,&value.Kind,&value.QuantityDelta,&value.ReservedDelta,&value.ReferenceType,&value.ReferenceID,&value.Reason,&value.IdempotencyKey,&value.CreatedBy,&value.CreatedAt);err!=nil{return inventory.Movement{},scanError("movement",err)};return value,nil}
func scanReservation(row rowScanner)(inventory.Reservation,error){var value inventory.Reservation;if err:=row.Scan(&value.ID,&value.OrganizationID,&value.ExternalReference,&value.ItemID,&value.WarehouseID,&value.Quantity,&value.Status,&value.Version,&value.CreatedAt,&value.UpdatedAt);err!=nil{return inventory.Reservation{},scanError("reservation",err)};return value,nil}
func scanPurchaseOrder(row rowScanner)(inventory.PurchaseOrder,error){var value inventory.PurchaseOrder;if err:=row.Scan(&value.ID,&value.OrganizationID,&value.Number,&value.SupplierName,&value.Status,&value.Version,&value.CreatedAt,&value.UpdatedAt);err!=nil{return inventory.PurchaseOrder{},scanError("purchase order",err)};return value,nil}
func scanPurchaseLine(row rowScanner)(inventory.PurchaseOrderLine,error){var value inventory.PurchaseOrderLine;if err:=row.Scan(&value.ID,&value.ItemID,&value.OrderedQuantity,&value.ReceivedQuantity);err!=nil{return inventory.PurchaseOrderLine{},scanError("purchase order line",err)};return value,nil}
func scanError(kind string,err error)error{if errors.Is(err,sql.ErrNoRows){return inventory.ErrNotFound};return fmt.Errorf("scan inventory %s: %w",kind,err)}

func getItemTx(ctx context.Context,tx *sql.Tx,scope,id string)(inventory.Item,error){return scanItem(tx.QueryRowContext(ctx,itemSelect+` where item.id=? and item.organization_id=?`,id,scope))}
func getWarehouseTx(ctx context.Context,tx *sql.Tx,scope,id string)(inventory.Warehouse,error){return scanWarehouse(tx.QueryRowContext(ctx,warehouseSelect+` where warehouse.id=? and warehouse.organization_id=?`,id,scope))}
func getReservationTx(ctx context.Context,tx *sql.Tx,scope,id string)(inventory.Reservation,error){return scanReservation(tx.QueryRowContext(ctx,reservationSelect+` where reservation.id=? and reservation.organization_id=?`,id,scope))}
func getPurchaseOrderTx(ctx context.Context,tx *sql.Tx,scope,id string)(inventory.PurchaseOrder,error){return scanPurchaseOrder(tx.QueryRowContext(ctx,purchaseSelect+` where purchase.id=? and purchase.organization_id=?`,id,scope))}

func(store *Store)purchaseLines(ctx context.Context,id string)([]inventory.PurchaseOrderLine,error){rows,err:=store.database.QueryContext(ctx,lineSelect+` where line.purchase_order_id=? order by line.id`,id);if err!=nil{return nil,fmt.Errorf("query purchase order lines: %w",err)};defer rows.Close();return collectLines(rows)}
func purchaseLinesTx(ctx context.Context,tx *sql.Tx,id string)([]inventory.PurchaseOrderLine,error){rows,err:=tx.QueryContext(ctx,lineSelect+` where line.purchase_order_id=? order by line.id`,id);if err!=nil{return nil,fmt.Errorf("query purchase order lines: %w",err)};defer rows.Close();return collectLines(rows)}
func collectLines(rows *sql.Rows)([]inventory.PurchaseOrderLine,error){items:=make([]inventory.PurchaseOrderLine,0);for rows.Next(){value,err:=scanPurchaseLine(rows);if err!=nil{return nil,err};items=append(items,value)};if err:=rows.Err();err!=nil{return nil,fmt.Errorf("iterate purchase order lines: %w",err)};return items,nil}

func itemPage(items []inventory.Item,limit int)([]inventory.Item,string,error){if len(items)<=limit{return items,"",nil};return items[:limit],items[limit-1].ID,nil}
func warehousePage(items []inventory.Warehouse,limit int)([]inventory.Warehouse,string,error){if len(items)<=limit{return items,"",nil};return items[:limit],items[limit-1].ID,nil}
func reservationPage(items []inventory.Reservation,limit int)([]inventory.Reservation,string,error){if len(items)<=limit{return items,"",nil};return items[:limit],items[limit-1].ID,nil}
func movementPage(items []inventory.Movement,limit int)([]inventory.Movement,string,error){if len(items)<=limit{return items,"",nil};return items[:limit],items[limit-1].ID,nil}
func purchasePage(items []inventory.PurchaseOrder,limit int)([]inventory.PurchaseOrder,string,error){if len(items)<=limit{return items,"",nil};return items[:limit],items[limit-1].ID,nil}

func(store *Store)mutate(ctx context.Context,operation func(*sql.Tx)error)error{tx,err:=store.database.BeginTx(ctx,nil);if err!=nil{return fmt.Errorf("begin inventory mutation: %w",err)};if err:=operation(tx);err!=nil{return rollback(tx,err)};if err:=tx.Commit();err!=nil{return fmt.Errorf("commit inventory mutation: %w",err)};return nil}
func appendAudit(ctx context.Context,tx *sql.Tx,event identity.AuditEvent)error{_,err:=tx.ExecContext(ctx,`insert into audit_events (id,user_id,action,outcome,target,ip_address,user_agent,created_at) values (?,nullif(?,''),?,?,nullif(?,''),nullif(?,''),nullif(?,''),?)`,event.ID,event.UserID,event.Action,event.Outcome,event.Target,event.IPAddress,event.UserAgent,event.CreatedAt);if err!=nil{return fmt.Errorf("append inventory audit event: %w",err)};return nil}
func requireMutation(result sql.Result)error{count,err:=result.RowsAffected();if err!=nil{return fmt.Errorf("inspect inventory mutation: %w",err)};if count!=1{return inventory.ErrConflict};return nil}
func rollback(tx *sql.Tx,cause error)error{if err:=tx.Rollback();err!=nil&&!errors.Is(err,sql.ErrTxDone){return errors.Join(cause,fmt.Errorf("roll back inventory mutation: %w",err))};return cause}
func persistenceError(err error)error{var databaseError *mysqldriver.MySQLError;if errors.As(err,&databaseError)&&databaseError.Number==1062{return inventory.ErrConflict};return err}

var _ inventory.Store=(*Store)(nil)
