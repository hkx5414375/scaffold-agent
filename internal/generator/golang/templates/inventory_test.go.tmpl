func TestServiceNormalizesMasterDataAndStockCommands(t *testing.T) {
	store := &recordingStore{}
	service := NewService(store)
	service.now = func() time.Time { return time.Unix(1_700_000_000, 0).UTC() }
	actor := identity.Principal{UserID: "user-1"{{if .Tenancy}}, OrganizationID: "org-1"{{end}}}

	item, err := service.CreateItem(context.Background(), ItemWrite{SKU: " sku-1 ", Name: " Widget ", Unit: " ea "}, actor)
	if err != nil { t.Fatalf("CreateItem() error = %v", err) }
	if item.SKU != "SKU-1" || item.Unit != "EA" || item.Version != 1 || store.audit.Action != "inventory:item:create" { t.Fatalf("CreateItem() = %#v, audit = %#v", item, store.audit) }

	result, err := service.AdjustStock(context.Background(), AdjustmentInput{ItemID:item.ID,WarehouseID:"warehouse-1",QuantityDelta:"12",Reason:"opening stock",IdempotencyKey:"adjust-1"}, actor)
	if err != nil { t.Fatalf("AdjustStock() error = %v", err) }
	if store.stock.Movement.QuantityDelta != 12 || store.stock.Fingerprint == "" || result.Balance.Available != 12 { t.Fatalf("AdjustStock() = %#v, command = %#v", result, store.stock) }
}

func TestServiceRejectsNonCanonicalQuantityAndDuplicatePurchaseLines(t *testing.T) {
	service := NewService(&recordingStore{})
	actor := identity.Principal{UserID:"user-1"{{if .Tenancy}},OrganizationID:"org-1"{{end}}}
	if _,err:=service.AdjustStock(context.Background(),AdjustmentInput{ItemID:"item-1",WarehouseID:"warehouse-1",QuantityDelta:"01",Reason:"bad",IdempotencyKey:"key"},actor);!errors.Is(err,ErrInvalidInput){t.Fatalf("AdjustStock() error = %v, want invalid",err)}
	_,err:=service.CreatePurchaseOrder(context.Background(),PurchaseOrderWrite{Number:"po-1",SupplierName:"Supplier",Lines:[]PurchaseOrderLineWrite{ {ItemID:"item-1",OrderedQuantity:"2"}, {ItemID:"item-1",OrderedQuantity:"3"} }},actor)
	if !errors.Is(err,ErrInvalidInput){t.Fatalf("CreatePurchaseOrder() error = %v, want invalid",err)}
}

