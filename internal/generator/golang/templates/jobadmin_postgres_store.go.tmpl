// ListAdmin returns a stable metadata page in one organization scope.
func (store *Store) ListAdmin(ctx context.Context, organizationID, status, cursor string, limit int) ([]jobs.Job, string, error) {
	rows, err := store.pool.Query(ctx, `
		select id, organization_id, scope_key, type, payload, dedupe_key, status, priority,
			attempts, max_attempts, available_at, lease_owner, lease_until, last_error,
			created_at, updated_at, completed_at
		from background_jobs
		where {{if .Tenancy}}organization_id = $1 and ($2 = '' or status = $2) and ($3 = '' or id < $3){{else}}($1 = '' or status = $1) and ($2 = '' or id < $2){{end}}
		order by id desc limit {{if .Tenancy}}$4{{else}}$3{{end}}`, {{if .Tenancy}}organizationID, {{end}}status, cursor, limit+1)
	if err != nil {
		return nil, "", fmt.Errorf("query job administration page: %w", err)
	}
	defer rows.Close()
	items := make([]jobs.Job, 0, limit)
	for rows.Next() {
		item, err := scanJob(rows)
		if err != nil {
			return nil, "", err
		}
		items = append(items, item)
	}
	if err := rows.Err(); err != nil {
		return nil, "", fmt.Errorf("iterate job administration page: %w", err)
	}
	nextCursor := ""
	if len(items) > limit {
		nextCursor = items[limit-1].ID
		items = items[:limit]
	}
	return items, nextCursor, nil
}

// RetryDead atomically checks state, resets the job, and appends an audit event.
func (store *Store) RetryDead(ctx context.Context, organizationID, id string, now time.Time, audit identity.AuditEvent) (jobs.Job, error) {
	tx, err := store.pool.Begin(ctx)
	if err != nil {
		return jobs.Job{}, fmt.Errorf("begin dead job retry: %w", err)
	}
	defer tx.Rollback(ctx)
	var status string
	err = tx.QueryRow(ctx, `select status from background_jobs where id = $1{{if .Tenancy}} and organization_id = $2{{end}} for update`, id{{if .Tenancy}}, organizationID{{end}}).Scan(&status)
	if errors.Is(err, pgx.ErrNoRows) {
		return jobs.Job{}, jobadmin.ErrNotFound
	}
	if err != nil {
		return jobs.Job{}, fmt.Errorf("lock dead job: %w", err)
	}
	if status != jobs.StatusDead {
		return jobs.Job{}, jobadmin.ErrConflict
	}
	job, err := scanJob(tx.QueryRow(ctx, `
		update background_jobs set status = $1, attempts = 0, available_at = $2,
			lease_owner = null, lease_until = null, last_error = null,
			completed_at = null, updated_at = $2
		where id = $3{{if .Tenancy}} and organization_id = $4{{end}}
		returning id, organization_id, scope_key, type, payload, dedupe_key, status, priority,
			attempts, max_attempts, available_at, lease_owner, lease_until, last_error,
			created_at, updated_at, completed_at`, jobs.StatusQueued, now, id{{if .Tenancy}}, organizationID{{end}}))
	if err != nil {
		return jobs.Job{}, err
	}
	if _, err := tx.Exec(ctx, `
		insert into audit_events (id, user_id, action, outcome, target, ip_address, user_agent, created_at)
		values ($1, $2, $3, $4, $5, $6, $7, $8)`,
		audit.ID, audit.UserID, audit.Action, audit.Outcome, audit.Target, audit.IPAddress, audit.UserAgent, audit.CreatedAt,
	); err != nil {
		return jobs.Job{}, fmt.Errorf("append dead job retry audit: %w", err)
	}
	if err := tx.Commit(ctx); err != nil {
		return jobs.Job{}, fmt.Errorf("commit dead job retry: %w", err)
	}
	return job, nil
}
