create table if not exists background_jobs (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null{{end}},
    scope_key varchar(191) not null,
    type varchar(128) not null,
    payload json not null,
    dedupe_key varchar(191) not null,
    status varchar(16) not null,
    priority integer not null,
    attempts integer not null,
    max_attempts integer not null,
    available_at datetime(6) not null,
    lease_owner varchar(128),
    lease_until datetime(6),
    last_error text,
    created_at datetime(6) not null,
    updated_at datetime(6) not null,
    completed_at datetime(6),
    unique key background_jobs_dedupe_unique (scope_key, type, dedupe_key),
    index background_jobs_claim_idx (status, priority desc, available_at, created_at, id),
    index background_jobs_expired_lease_idx (status, lease_until){{if .Tenancy}},
    index background_jobs_organization_idx (organization_id, created_at desc),
    constraint background_jobs_organization_fk foreign key (organization_id) references organizations (id) on delete cascade{{end}},
    constraint background_jobs_status_check check (status in ('queued', 'running', 'succeeded', 'retry', 'dead')),
    constraint background_jobs_attempts_check check (attempts >= 0 and max_attempts > 0)
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;
