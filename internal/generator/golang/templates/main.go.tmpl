package main

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"strconv"
	"strings"
	"syscall"
	"time"

	"{{.ModulePath}}/internal/identity"
	"{{.ModulePath}}/internal/identity/httpapi"
	identitydatabase "{{.ModulePath}}/internal/identity/{{.Database.PackageName}}"
	"{{.ModulePath}}/internal/platform/httpserver"
	"{{.ModulePath}}/internal/platform/migrate"
	platformdatabase "{{.ModulePath}}/internal/platform/{{.Database.PackageName}}"
{{- if .Approvals}}
	"{{.ModulePath}}/internal/approvals"
	approvalshttp "{{.ModulePath}}/internal/approvals/httpapi"
	approvalsdatabase "{{.ModulePath}}/internal/approvals/{{.Database.PackageName}}"
{{- end}}
{{- if .Catalog}}
	"{{.ModulePath}}/internal/catalog"
	cataloghttp "{{.ModulePath}}/internal/catalog/httpapi"
	catalogdatabase "{{.ModulePath}}/internal/catalog/{{.Database.PackageName}}"
{{- end}}
{{- if .CustomerAccounts}}
	"{{.ModulePath}}/internal/customeraccounts"
	customerhttp "{{.ModulePath}}/internal/customeraccounts/httpapi"
	customerdatabase "{{.ModulePath}}/internal/customeraccounts/{{.Database.PackageName}}"
{{- end}}
{{- if .CRM}}
	"{{.ModulePath}}/internal/crm"
	crmhttp "{{.ModulePath}}/internal/crm/httpapi"
	crmdatabase "{{.ModulePath}}/internal/crm/{{.Database.PackageName}}"
{{- end}}
{{- if .Inventory}}
	"{{.ModulePath}}/internal/inventory"
	inventoryhttp "{{.ModulePath}}/internal/inventory/httpapi"
	inventorydatabase "{{.ModulePath}}/internal/inventory/{{.Database.PackageName}}"
{{- end}}
{{- if .Files}}
	"{{.ModulePath}}/internal/files"
	fileshttp "{{.ModulePath}}/internal/files/httpapi"
	"{{.ModulePath}}/internal/files/local"
	filesdatabase "{{.ModulePath}}/internal/files/{{.Database.PackageName}}"
{{- end}}
{{- if .Observability}}
	"{{.ModulePath}}/internal/platform/observability"
{{- end}}
{{- if .JobAdmin}}
	"{{.ModulePath}}/internal/jobadmin"
	jobadminhttp "{{.ModulePath}}/internal/jobadmin/httpapi"
	jobsdatabase "{{.ModulePath}}/internal/jobs/{{.Database.PackageName}}"
{{- end}}
{{- if .Tenancy}}
	"{{.ModulePath}}/internal/tenancy"
	tenancyhttp "{{.ModulePath}}/internal/tenancy/httpapi"
	tenancydatabase "{{.ModulePath}}/internal/tenancy/{{.Database.PackageName}}"
{{- end}}
{{- if .Business}}
	"{{.ModulePath}}/internal/{{.Business.ModuleName}}"
	{{.Business.PackageName}}http "{{.ModulePath}}/internal/{{.Business.ModuleName}}/httpapi"
	{{.Business.PackageName}}database "{{.ModulePath}}/internal/{{.Business.ModuleName}}/{{.Database.PackageName}}"
{{- if .CSVTransfer}}
	{{.Business.PackageName}}transfer "{{.ModulePath}}/internal/{{.Business.ModuleName}}/transfer"
	{{.Business.PackageName}}transferhttp "{{.ModulePath}}/internal/{{.Business.ModuleName}}/transfer/httpapi"
	{{.Business.PackageName}}transferdatabase "{{.ModulePath}}/internal/{{.Business.ModuleName}}/transfer/{{.Database.PackageName}}"
{{- end}}
{{- end}}
)

const (
	shutdownTimeout = 10 * time.Second
	startupTimeout  = 30 * time.Second
)

func main() {
	if err := run(); err != nil {
		slog.Error("application stopped", "error", err)
		os.Exit(1)
	}
}

func run() error {
	applicationContext, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	startupContext, cancelStartup := context.WithTimeout(applicationContext, startupTimeout)
	defer cancelStartup()
	pool, err := platformdatabase.Open(startupContext, os.Getenv("DATABASE_URL"))
	if err != nil {
		return err
	}
	defer pool.Close()
	if err := migrate.Run(startupContext, pool); err != nil {
		return fmt.Errorf("migrate database: %w", err)
	}

	identityService := identity.NewService(identitydatabase.New(pool))
	if err := bootstrapAdmin(startupContext, identityService); err != nil {
		return err
	}
	secureCookies, err := secureCookieSetting(os.Getenv("COOKIE_SECURE"))
	if err != nil {
		return err
	}
{{- if .Files}}
	fileStorageRoot := strings.TrimSpace(os.Getenv("FILE_STORAGE_ROOT"))
	if fileStorageRoot == "" {
		fileStorageRoot = "var/files"
	}
	fileBlobs, err := local.New(fileStorageRoot)
	if err != nil {
		return fmt.Errorf("open file storage: %w", err)
	}
	fileService := files.NewService(filesdatabase.New(pool), fileBlobs)
	fileAPI := fileshttp.New(fileService)
{{- end}}
{{- if .JobAdmin}}
	jobAdminService := jobadmin.NewService(jobsdatabase.New(pool))
	jobAdminAPI := jobadminhttp.New(jobAdminService)
{{- end}}
{{- if .Observability}}
	observer := observability.New()
	readiness := observability.Ready(func(ctx context.Context) error {
{{- if eq .Database.Engine "postgresql"}}
		return pool.Ping(ctx)
{{- else}}
		return pool.PingContext(ctx)
{{- end}}
	})
{{- end}}
{{- if .Approvals}}
	approvalService := approvals.NewService(approvalsdatabase.New(pool))
	approvalAPI := approvalshttp.New(approvalService)
{{- end}}
{{- if .Catalog}}
	catalogService := catalog.NewService(catalogdatabase.New(pool))
	catalogAPI := cataloghttp.New(catalogService)
{{- end}}
{{- if .CustomerAccounts}}
	customerService := customeraccounts.NewService(customerdatabase.New(pool))
	customerAPI := customerhttp.New(customerService, secureCookies)
{{- end}}
{{- if .CRM}}
	crmService := crm.NewService(crmdatabase.New(pool))
	crmAPI := crmhttp.New(crmService)
{{- end}}
{{- if .Inventory}}
	inventoryService := inventory.NewService(inventorydatabase.New(pool))
	inventoryAPI := inventoryhttp.New(inventoryService)
{{- end}}
{{- if .Tenancy}}
	tenancyStore := tenancydatabase.New(pool)
	tenancyService := tenancy.NewService(tenancyStore)
	{{- if .TenancyMembers}}
	tenancyMembers := tenancy.NewMemberService(tenancyStore)
	{{- end}}
	{{- if .TenancyLifecycle}}
	tenancyLifecycle := tenancy.NewLifecycleService(tenancyStore)
	{{- end}}
	identityAPI := httpapi.New(identityService, secureCookies, httpapi.WithAuthorizer(tenancyService))
	tenancyAPI := tenancyhttp.New(tenancyService)
{{- else}}
	identityAPI := httpapi.New(identityService, secureCookies)
{{- end}}
{{- if .Business}}
	{{.Business.PackageName}}Service := {{.Business.PackageName}}.NewService({{.Business.PackageName}}database.New(pool))
	{{.Business.PackageName}}API := {{.Business.PackageName}}http.New({{.Business.PackageName}}Service)
	{{- if .CSVTransfer}}
	{{.Business.PackageName}}TransferService := {{.Business.PackageName}}transfer.NewService({{.Business.PackageName}}transferdatabase.New(pool))
	{{.Business.PackageName}}TransferAPI := {{.Business.PackageName}}transferhttp.New({{.Business.PackageName}}TransferService)
	{{- end}}
	{{- end}}
	registerRoutes := func(mux *http.ServeMux) {
		identityAPI.Register(mux)
{{- if .Observability}}
		mux.HandleFunc("GET /metrics", observer.Metrics)
		mux.HandleFunc("GET /readyz", readiness)
{{- end}}
{{- if .Files}}
		fileAPI.Register(mux, identityAPI)
{{- end}}
{{- if .Catalog}}
		catalogAPI.Register(mux, identityAPI)
{{- end}}
{{- if .CustomerAccounts}}
		customerAPI.Register(mux, identityAPI)
{{- end}}
{{- if .CRM}}
		crmAPI.Register(mux, identityAPI)
{{- end}}
{{- if .Inventory}}
		inventoryAPI.Register(mux, identityAPI)
{{- end}}
{{- if .JobAdmin}}
		jobAdminAPI.Register(mux, identityAPI)
{{- end}}
{{- if .Approvals}}
		approvalAPI.Register(mux, identityAPI)
{{- end}}
{{- if .Tenancy}}
		tenancyAPI.Register(mux, identityAPI)
	{{- if .TenancyMembers}}
		tenancyhttp.RegisterMembers(mux, identityAPI, tenancyMembers)
	{{- end}}
	{{- if .TenancyLifecycle}}
		tenancyhttp.RegisterLifecycle(mux, identityAPI, tenancyLifecycle)
	{{- end}}
{{- end}}
{{- if .Business}}
		{{.Business.PackageName}}API.Register(mux, identityAPI)
	{{- if .CSVTransfer}}
		{{.Business.PackageName}}TransferAPI.Register(mux, identityAPI)
	{{- end}}
{{- end}}
	}
	address := strings.TrimSpace(os.Getenv("HTTP_ADDRESS"))
	if address == "" {
		address = ":8080"
	}
	server := httpserver.New(address, registerRoutes{{if .Observability}}, observer.Middleware{{end}})
	serveError := make(chan error, 1)
	go func() {
		slog.Info("start HTTP server", "address", address)
		serveError <- server.ListenAndServe()
	}()

	select {
	case err := <-serveError:
		if errors.Is(err, http.ErrServerClosed) {
			return nil
		}
		return fmt.Errorf("serve HTTP: %w", err)
	case <-applicationContext.Done():
		shutdownContext, cancelShutdown := context.WithTimeout(context.Background(), shutdownTimeout)
		defer cancelShutdown()
		if err := server.Shutdown(shutdownContext); err != nil {
			return fmt.Errorf("shut down HTTP server: %w", err)
		}
		return nil
	}
}

func bootstrapAdmin(ctx context.Context, service *identity.Service) error {
	email := strings.TrimSpace(os.Getenv("BOOTSTRAP_ADMIN_EMAIL"))
	password := os.Getenv("BOOTSTRAP_ADMIN_PASSWORD")
	if (email == "") != (password == "") {
		return errors.New("BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD must be set together")
	}
	if email == "" {
		return nil
	}
	if err := service.EnsureAdmin(ctx, email, password); err != nil {
		return fmt.Errorf("bootstrap administrator: %w", err)
	}
	return nil
}

func secureCookieSetting(value string) (bool, error) {
	value = strings.TrimSpace(value)
	if value == "" {
		return true, nil
	}
	secure, err := strconv.ParseBool(value)
	if err != nil {
		return false, errors.New("COOKIE_SECURE must be true or false")
	}
	return secure, nil
}
