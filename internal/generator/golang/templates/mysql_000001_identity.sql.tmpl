create table if not exists identity_roles (
    code varchar(63) primary key,
    display_name varchar(255) not null
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table if not exists identity_permissions (
    code varchar(191) primary key,
    description varchar(512) not null
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table if not exists identity_role_permissions (
    role_code varchar(63) not null,
    permission_code varchar(191) not null,
    primary key (role_code, permission_code),
    constraint identity_role_permissions_role_fk foreign key (role_code) references identity_roles (code) on delete cascade,
    constraint identity_role_permissions_permission_fk foreign key (permission_code) references identity_permissions (code) on delete cascade
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

insert into identity_roles (code, display_name) values
    ('admin', 'Administrator'),
    ('user', 'User')
on duplicate key update code = code;

insert into identity_permissions (code, description) values
    ('identity:token:create', 'Create a personal API token')
on duplicate key update code = code;

insert into identity_role_permissions (role_code, permission_code) values
    ('admin', 'identity:token:create'),
    ('user', 'identity:token:create')
on duplicate key update role_code = role_code;

create table if not exists identity_users (
    id varchar(191) primary key,
    email varchar(320) not null unique,
    password_hash text not null,
    role varchar(63) not null,
    disabled boolean not null default false,
    created_at datetime(6) not null default current_timestamp(6),
    updated_at datetime(6) not null default current_timestamp(6),
    constraint identity_users_role_fk foreign key (role) references identity_roles (code)
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table if not exists identity_sessions (
    token_hash binary(32) primary key,
    user_id varchar(191) not null,
    expires_at datetime(6) not null,
    created_at datetime(6) not null default current_timestamp(6),
    index identity_sessions_expiry_idx (expires_at),
    constraint identity_sessions_user_fk foreign key (user_id) references identity_users (id) on delete cascade
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table if not exists identity_api_tokens (
    id varchar(191) primary key,
    token_hash binary(32) not null unique,
    user_id varchar(191) not null,
    name varchar(80) not null,
    expires_at datetime(6) not null,
    created_at datetime(6) not null default current_timestamp(6),
    index identity_api_tokens_user_idx (user_id),
    index identity_api_tokens_expiry_idx (expires_at),
    constraint identity_api_tokens_user_fk foreign key (user_id) references identity_users (id) on delete cascade
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table if not exists audit_events (
    id varchar(191) primary key,
    user_id varchar(191),
    action varchar(191) not null,
    outcome varchar(63) not null,
    target varchar(191),
    ip_address varchar(45),
    user_agent text,
    created_at datetime(6) not null,
    index audit_events_user_time_idx (user_id, created_at desc),
    index audit_events_action_time_idx (action, created_at desc),
    constraint audit_events_user_fk foreign key (user_id) references identity_users (id) on delete set null
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;
