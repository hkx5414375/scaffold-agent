func TestMySQLMigrationsAndStores(t *testing.T) {
	database := isolatedMySQL(t)
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	if err := migrate.Run(ctx, database); err != nil {
		t.Fatalf("Run(first) error = %v", err)
	}
	if err := migrate.Run(ctx, database); err != nil {
		t.Fatalf("Run(second) error = %v", err)
	}
	var migrationCount int
	if err := database.QueryRowContext(ctx, `select count(*) from scaffold_schema_migrations`).Scan(&migrationCount); err != nil {
		t.Fatalf("count migrations: %v", err)
	}
	if migrationCount != {{.MigrationCount}} {
		t.Fatalf("migration count = %d, want {{.MigrationCount}}", migrationCount)
	}

	identityStore := identitymysql.New(database)
	now := time.Now().UTC().Truncate(time.Microsecond)
	user := identity.User{
		ID: "integration-user", Email: "integration@example.com",
		PasswordHash: "integration-only-hash", Role: "admin",
	}
	if err := identityStore.CreateUser(ctx, user); err != nil {
		t.Fatalf("CreateUser() error = %v", err)
	}
	loadedUser, err := identityStore.UserByEmail(ctx, user.Email)
	if err != nil || loadedUser.ID != user.ID || loadedUser.Role != "admin" {
		t.Fatalf("UserByEmail() = %#v, %v", loadedUser, err)
	}

	sessionHash := []byte("integration-session-digest-00000")
	if err := identityStore.CreateSession(ctx, identity.Session{TokenHash: sessionHash, UserID: user.ID, ExpiresAt: now.Add(time.Hour)}); err != nil {
		t.Fatalf("CreateSession() error = %v", err)
	}
	if loadedUser, err = identityStore.UserBySession(ctx, sessionHash, now); err != nil || loadedUser.ID != user.ID {
		t.Fatalf("UserBySession() = %#v, %v", loadedUser, err)
	}
	if err := identityStore.DeleteSession(ctx, sessionHash); err != nil {
		t.Fatalf("DeleteSession() error = %v", err)
	}
	if _, err := identityStore.UserBySession(ctx, sessionHash, now); !errors.Is(err, identity.ErrNotFound) {
		t.Fatalf("UserBySession(deleted) error = %v, want ErrNotFound", err)
	}

	apiTokenHash := []byte("integration-api-token-digest0000")
	if err := identityStore.CreateAPIToken(ctx, identity.APIToken{
		ID: "integration-token", TokenHash: apiTokenHash, UserID: user.ID,
		Name: "integration", ExpiresAt: now.Add(time.Hour),
	}); err != nil {
		t.Fatalf("CreateAPIToken() error = %v", err)
	}
	if loadedUser, err = identityStore.UserByAPIToken(ctx, apiTokenHash, now); err != nil || loadedUser.ID != user.ID {
		t.Fatalf("UserByAPIToken() = %#v, %v", loadedUser, err)
	}
	if err := identityStore.DeleteAPIToken(ctx, "integration-token"); err != nil {
		t.Fatalf("DeleteAPIToken() error = %v", err)
	}
	if _, err := identityStore.UserByAPIToken(ctx, apiTokenHash, now); !errors.Is(err, identity.ErrNotFound) {
		t.Fatalf("UserByAPIToken(deleted) error = %v, want ErrNotFound", err)
	}

	allowed, err := identityStore.HasPermission(ctx, "admin", "{{.Business.PermissionPrefix}}:create")
	if err != nil || !allowed {
		t.Fatalf("HasPermission() = %t, %v", allowed, err)
	}
	allowed, err = identityStore.HasPermission(ctx, "user", "{{.Business.PermissionPrefix}}:create")
	if err != nil || allowed {
		t.Fatalf("HasPermission(user) = %t, %v, want denied", allowed, err)
	}
{{- if .CSVTransfer}}
	for _, code := range []string{"{{.Business.PermissionPrefix}}:import", "{{.Business.PermissionPrefix}}:export"} {
		allowed, err = identityStore.HasPermission(ctx, "admin", code)
		if err != nil || !allowed {
			t.Fatalf("HasPermission(admin, %s) = %t, %v", code, allowed, err)
		}
	}
	allowed, err = identityStore.HasPermission(ctx, "user", "{{.Business.PermissionPrefix}}:import")
	if err != nil || allowed {
		t.Fatalf("HasPermission(user, import) = %t, %v, want denied", allowed, err)
	}
{{- end}}
{{- if .Approvals}}
	for _, permission := range []struct {
		role    string
		code    string
		allowed bool
	}{
		{role: "admin", code: "approvals:submit", allowed: true},
		{role: "admin", code: "approvals:mine", allowed: true},
		{role: "admin", code: "approvals:read", allowed: true},
		{role: "admin", code: "approvals:decide", allowed: true},
		{role: "user", code: "approvals:submit", allowed: true},
		{role: "user", code: "approvals:mine", allowed: true},
		{role: "user", code: "approvals:read", allowed: false},
		{role: "user", code: "approvals:decide", allowed: false},
	} {
		allowed, err = identityStore.HasPermission(ctx, permission.role, permission.code)
		if err != nil || allowed != permission.allowed {
			t.Fatalf("HasPermission(%s, %s) = %t, %v, want %t", permission.role, permission.code, allowed, err, permission.allowed)
		}
	}
{{- end}}

	duplicateAudit := identity.AuditEvent{
		ID: "duplicate-audit", UserID: user.ID, Action: "integration:seed",
		Outcome: "succeeded", Target: "seed", CreatedAt: now,
	}
	if err := identityStore.AppendAudit(ctx, duplicateAudit); err != nil {
		t.Fatalf("AppendAudit() error = %v", err)
	}
	organizationID := ""
{{- if .Tenancy}}
	organizationID = "integration-organization"
	tenancyStore := tenancymysql.New(database)
	organization := tenancy.Organization{ID: organizationID, Name: "Integration", Role: "admin", CreatedAt: now}
	membership := tenancy.Membership{OrganizationID: organizationID, UserID: user.ID, Role: "admin", CreatedAt: now}
	if err := tenancyStore.CreateOrganization(ctx, organization, membership, audit(user.ID, "tenancy.organization:create", organizationID, now)); err != nil {
		t.Fatalf("CreateOrganization() error = %v", err)
	}
{{- if .TenancyMembers}}
	memberUser := identity.User{ID: "integration-member", Email: "member@example.com", PasswordHash: user.PasswordHash, Role: "user"}
	if err := identityStore.CreateUser(ctx, memberUser); err != nil {
		t.Fatalf("CreateUser(member) error = %v", err)
	}
	members := tenancy.NewMemberService(tenancyStore)
	invitation, err := members.Invite(ctx, memberUser.Email, "user", identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID})
	if err != nil {
		t.Fatalf("Invite() error = %v", err)
	}
	accepted, err := members.Accept(ctx, invitation.AcceptanceToken, identity.Principal{UserID: memberUser.ID, Email: memberUser.Email, Role: "user"})
	if err != nil || accepted.OrganizationID != organizationID {
		t.Fatalf("Accept() = %#v, %v", accepted, err)
	}
	listedMembers, err := tenancyStore.ListMembers(ctx, organizationID)
	if err != nil || len(listedMembers) != 2 {
		t.Fatalf("ListMembers() = %#v, %v", listedMembers, err)
	}
	adminPrincipal := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	if _, err := members.ChangeRole(ctx, memberUser.ID, "admin", adminPrincipal); err != nil {
		t.Fatalf("ChangeRole() error = %v", err)
	}
{{- if .TenancyLifecycle}}
	lifecycle := tenancy.NewLifecycleService(tenancyStore)
	renamed, err := lifecycle.Rename(ctx, organizationID, "Renamed Integration", adminPrincipal)
	if err != nil || renamed.Name != "Renamed Integration" || !renamed.IsOwner {
		t.Fatalf("Rename() = %#v, %v", renamed, err)
	}
	transferred, err := lifecycle.TransferOwnership(ctx, organizationID, memberUser.ID, adminPrincipal)
	if err != nil || transferred.OwnerUserID != memberUser.ID || transferred.IsOwner {
		t.Fatalf("TransferOwnership() = %#v, %v", transferred, err)
	}
	if err := members.Remove(ctx, memberUser.ID, adminPrincipal); !errors.Is(err, tenancy.ErrOwnerProtected) {
		t.Fatalf("Remove(owner) error = %v, want ErrOwnerProtected", err)
	}
	if _, err := lifecycle.Deactivate(ctx, organizationID, adminPrincipal); !errors.Is(err, tenancy.ErrLifecycleForbidden) {
		t.Fatalf("Deactivate(previous owner) error = %v, want ErrLifecycleForbidden", err)
	}
	ownerPrincipal := identity.Principal{UserID: memberUser.ID, Email: memberUser.Email, Role: "admin", OrganizationID: organizationID}
	inactive, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal)
	if err != nil || inactive.Status != tenancy.OrganizationInactive {
		t.Fatalf("Deactivate() = %#v, %v", inactive, err)
	}
	if _, err := tenancyStore.MembershipRole(ctx, organizationID, user.ID); !errors.Is(err, tenancy.ErrNotFound) {
		t.Fatalf("MembershipRole(inactive) error = %v, want ErrNotFound", err)
	}
	active, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal)
	if err != nil || active.Status != tenancy.OrganizationActive {
		t.Fatalf("Reactivate() = %#v, %v", active, err)
	}
{{- else}}
	if err := members.Remove(ctx, memberUser.ID, adminPrincipal); err != nil {
		t.Fatalf("Remove() error = %v", err)
	}
	if err := members.Remove(ctx, user.ID, adminPrincipal); !errors.Is(err, tenancy.ErrLastAdministrator) {
		t.Fatalf("Remove(last administrator) error = %v, want ErrLastAdministrator", err)
	}
{{- end}}
	var deniedMemberAudit int
	if err := database.QueryRowContext(ctx, `
		select count(*) from audit_events
		where action = 'tenancy.member.remove' and outcome = 'denied' and target = ?`, organizationID+":"+{{if .TenancyLifecycle}}memberUser.ID{{else}}user.ID{{end}}).Scan(&deniedMemberAudit); err != nil || deniedMemberAudit != 1 {
		t.Fatalf("denied member audit count = %d, %v, want 1", deniedMemberAudit, err)
	}
{{- end}}
{{- end}}

{{- if .Catalog}}
	for _, permission := range []string{"catalog:products:read", "catalog:products:write"} {
		allowed, err := identityStore.HasPermission(ctx, "admin", permission)
		if err != nil || !allowed {
			t.Fatalf("HasPermission(admin, %s) = %t, %v", permission, allowed, err)
		}
		allowed, err = identityStore.HasPermission(ctx, "user", permission)
		if err != nil || allowed {
			t.Fatalf("HasPermission(user, %s) = %t, %v, want denied", permission, allowed, err)
		}
	}
	catalogStore := catalogmysql.New(database)
	rolledBackProduct := catalog.Product{
		ID: "catalog-rolled-back", OrganizationID: organizationID, SKU: "ROLLBACK-1",
		Name: "Rolled back", PriceMinor: 1, Currency: "USD", Status: catalog.StatusDraft,
		Version: 1, CreatedAt: now, UpdatedAt: now,
	}
	if err := catalogStore.Create(ctx, rolledBackProduct, duplicateAudit); err == nil {
		t.Fatal("catalog Create(duplicate audit) error = nil, want transaction failure")
	}
	if _, err := catalogStore.Get(ctx, organizationID, rolledBackProduct.ID); !errors.Is(err, catalog.ErrNotFound) {
		t.Fatalf("catalog Get(rolled-back) error = %v, want ErrNotFound", err)
	}
	catalogService := catalog.NewService(catalogStore)
	catalogActor := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	product, err := catalogService.Create(ctx, catalog.WriteInput{
		SKU: " sku-100 ", Name: " Field notebook ", Description: " Recycled paper ",
		PriceMinor: 1299, Currency: " usd ",
	}, catalogActor)
	if err != nil || product.SKU != "SKU-100" || product.Status != catalog.StatusDraft {
		t.Fatalf("catalog Create() = %#v, %v", product, err)
	}
	if _, err := catalogService.Create(ctx, catalog.WriteInput{
		SKU: "SKU-100", Name: "Duplicate", PriceMinor: 1, Currency: "USD",
	}, catalogActor); !errors.Is(err, catalog.ErrConflict) {
		t.Fatalf("catalog Create(duplicate SKU) error = %v, want ErrConflict", err)
	}
	product, err = catalogService.Publish(ctx, product.ID, catalog.TransitionInput{Version: product.Version}, catalogActor)
	if err != nil || product.Status != catalog.StatusActive || product.Version != 2 {
		t.Fatalf("catalog Publish() = %#v, %v", product, err)
	}
	if publicProduct, err := catalogService.GetPublic(ctx, organizationID, product.ID); err != nil || publicProduct.ID != product.ID {
		t.Fatalf("catalog GetPublic() = %#v, %v", publicProduct, err)
	}
{{- if .TenancyLifecycle}}
	if _, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("catalog Deactivate() error = %v", err)
	}
	if _, err := catalogService.GetPublic(ctx, organizationID, product.ID); !errors.Is(err, catalog.ErrNotFound) {
		t.Fatalf("catalog GetPublic(inactive organization) error = %v, want ErrNotFound", err)
	}
	if _, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("catalog Reactivate() error = %v", err)
	}
{{- end}}
	product, err = catalogService.Update(ctx, product.ID, catalog.UpdateInput{
		WriteInput: catalog.WriteInput{SKU: product.SKU, Name: product.Name, Description: product.Description, PriceMinor: 1399, Currency: product.Currency},
		Version: product.Version,
	}, catalogActor)
	if err != nil || product.PriceMinor != 1399 || product.Version != 3 {
		t.Fatalf("catalog Update() = %#v, %v", product, err)
	}
	if _, err := catalogService.Update(ctx, product.ID, catalog.UpdateInput{
		WriteInput: catalog.WriteInput{SKU: product.SKU, Name: product.Name, PriceMinor: 1, Currency: product.Currency}, Version: 2,
	}, catalogActor); !errors.Is(err, catalog.ErrConflict) {
		t.Fatalf("catalog Update(stale) error = %v, want ErrConflict", err)
	}
	product, err = catalogService.Archive(ctx, product.ID, catalog.TransitionInput{Version: product.Version}, catalogActor)
	if err != nil || product.Status != catalog.StatusArchived || product.Version != 4 {
		t.Fatalf("catalog Archive() = %#v, %v", product, err)
	}
	if _, err := catalogService.GetPublic(ctx, organizationID, product.ID); !errors.Is(err, catalog.ErrNotFound) {
		t.Fatalf("catalog GetPublic(archived) error = %v, want ErrNotFound", err)
	}
{{- end}}

{{- if .CustomerAccounts}}
	for _, permission := range []string{"customers:accounts:read", "customers:accounts:manage"} {
		allowed, err := identityStore.HasPermission(ctx, "admin", permission)
		if err != nil || !allowed {
			t.Fatalf("HasPermission(admin, %s) = %t, %v", permission, allowed, err)
		}
		allowed, err = identityStore.HasPermission(ctx, "user", permission)
		if err != nil || allowed {
			t.Fatalf("HasPermission(user, %s) = %t, %v, want denied", permission, allowed, err)
		}
	}
	customerStore := customermysql.New(database)
	rolledBackDigest := sha256.Sum256([]byte("rolled-back-customer-session"))
	rolledBackCustomer := customeraccounts.Account{
		ID: "customer-rolled-back", OrganizationID: organizationID,
		Email: "rolled-back@example.com", PasswordHash: "integration-only-hash",
		DisplayName: "Rolled Back", Status: customeraccounts.StatusActive,
		Version: 1, CreatedAt: now, UpdatedAt: now,
	}
	if err := customerStore.Register(ctx, rolledBackCustomer, customeraccounts.Session{
		TokenHash: rolledBackDigest[:], CustomerID: rolledBackCustomer.ID, ExpiresAt: now.Add(time.Hour),
	}, duplicateAudit); err == nil {
		t.Fatal("customer Register(duplicate audit) error = nil, want transaction failure")
	}
	if _, err := customerStore.Get(ctx, organizationID, rolledBackCustomer.ID); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer Get(rolled-back) error = %v, want ErrNotFound", err)
	}

	customerDigest := sha256.Sum256([]byte("active-customer-session"))
	customer := customeraccounts.Account{
		ID: "integration-customer", OrganizationID: organizationID,
		Email: "customer@example.com", PasswordHash: "integration-only-hash",
		DisplayName: "Integration Customer", Status: customeraccounts.StatusActive,
		Version: 1, CreatedAt: now, UpdatedAt: now,
	}
	if err := customerStore.Register(ctx, customer, customeraccounts.Session{
		TokenHash: customerDigest[:], CustomerID: customer.ID, ExpiresAt: now.Add(time.Hour),
	}, audit("", "customer.register", customer.ID, now)); err != nil {
		t.Fatalf("customer Register() error = %v", err)
	}
	loadedCustomer, err := customerStore.AccountByEmail(ctx, organizationID, customer.Email)
	if err != nil || loadedCustomer.ID != customer.ID || loadedCustomer.Status != customeraccounts.StatusActive {
		t.Fatalf("customer AccountByEmail() = %#v, %v", loadedCustomer, err)
	}
	if authenticated, err := customerStore.AccountBySession(ctx, organizationID, customerDigest[:], now); err != nil || authenticated.ID != customer.ID {
		t.Fatalf("customer AccountBySession() = %#v, %v", authenticated, err)
	}
{{- if .Tenancy}}
	if _, err := customerStore.Get(ctx, "different-organization", customer.ID); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer Get(cross-organization) error = %v, want ErrNotFound", err)
	}
{{- end}}
{{- if .TenancyLifecycle}}
	if _, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("customer Deactivate() error = %v", err)
	}
	if _, err := customerStore.AccountBySession(ctx, organizationID, customerDigest[:], now); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer AccountBySession(inactive organization) error = %v, want ErrNotFound", err)
	}
	if _, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("customer Reactivate organization() error = %v", err)
	}
{{- end}}
	updatedCustomer, err := customerStore.UpdateProfile(
		ctx, organizationID, customer.ID, "Updated Customer", customer.Version, now.Add(time.Second),
		audit("", "customer.profile.update", customer.ID, now.Add(time.Second)),
	)
	if err != nil || updatedCustomer.DisplayName != "Updated Customer" || updatedCustomer.Version != 2 {
		t.Fatalf("customer UpdateProfile() = %#v, %v", updatedCustomer, err)
	}
	if _, err := customerStore.UpdateProfile(
		ctx, organizationID, customer.ID, "Stale", customer.Version, now.Add(2*time.Second),
		audit("", "customer.profile.update", customer.ID, now.Add(2*time.Second)),
	); !errors.Is(err, customeraccounts.ErrConflict) {
		t.Fatalf("customer UpdateProfile(stale) error = %v, want ErrConflict", err)
	}
	staffActor := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	customerService := customeraccounts.NewService(customerStore)
	suspendedCustomer, err := customerService.Suspend(
		ctx, customer.ID, customeraccounts.TransitionInput{Version: updatedCustomer.Version}, staffActor,
	)
	if err != nil || suspendedCustomer.Status != customeraccounts.StatusSuspended || suspendedCustomer.Version != 3 {
		t.Fatalf("customer Suspend() = %#v, %v", suspendedCustomer, err)
	}
	if _, err := customerStore.AccountBySession(ctx, organizationID, customerDigest[:], now); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer AccountBySession(suspended) error = %v, want ErrNotFound", err)
	}
	reactivatedCustomer, err := customerService.Reactivate(
		ctx, customer.ID, customeraccounts.TransitionInput{Version: suspendedCustomer.Version}, staffActor,
	)
	if err != nil || reactivatedCustomer.Status != customeraccounts.StatusActive || reactivatedCustomer.Version != 4 {
		t.Fatalf("customer Reactivate() = %#v, %v", reactivatedCustomer, err)
	}
	passwordDigest := sha256.Sum256([]byte("password-change-session"))
	if err := customerStore.CreateSession(ctx, customeraccounts.Session{
		TokenHash: passwordDigest[:], CustomerID: customer.ID, ExpiresAt: now.Add(time.Hour),
	}, audit("", "customer.login", customer.ID, now)); err != nil {
		t.Fatalf("customer CreateSession() error = %v", err)
	}
	passwordChanged, err := customerStore.ChangePassword(
		ctx, organizationID, customer.ID, "changed-integration-hash", reactivatedCustomer.Version,
		now.Add(3*time.Second), audit("", "customer.password.change", customer.ID, now.Add(3*time.Second)),
	)
	if err != nil || passwordChanged.PasswordHash != "changed-integration-hash" || passwordChanged.Version != 5 {
		t.Fatalf("customer ChangePassword() = %#v, %v", passwordChanged, err)
	}
	if _, err := customerStore.AccountBySession(ctx, organizationID, passwordDigest[:], now); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer AccountBySession(password changed) error = %v, want ErrNotFound", err)
	}
	listedCustomers, nextCustomerCursor, err := customerStore.List(ctx, organizationID, customeraccounts.StatusActive, "", 20)
	if err != nil || len(listedCustomers) != 1 || listedCustomers[0].ID != customer.ID || nextCustomerCursor != "" {
		t.Fatalf("customer List() = %#v, %q, %v", listedCustomers, nextCustomerCursor, err)
	}
	var customerAuditCount int
	if err := database.QueryRowContext(ctx, `select count(*) from audit_events where target = ? and action like 'customer%'`, customer.ID).Scan(&customerAuditCount); err != nil || customerAuditCount < 5 {
		t.Fatalf("customer audit count = %d, %v, want at least 5", customerAuditCount, err)
	}
{{- end}}

{{- if .CRM}}
	for _, permission := range []string{"crm:read", "crm:write", "crm:pipeline:manage"} {
		allowed, err := identityStore.HasPermission(ctx, "admin", permission)
		if err != nil || !allowed {
			t.Fatalf("HasPermission(admin, %s) = %t, %v", permission, allowed, err)
		}
		allowed, err = identityStore.HasPermission(ctx, "user", permission)
		if err != nil || allowed {
			t.Fatalf("HasPermission(user, %s) = %t, %v, want denied", permission, allowed, err)
		}
	}
	crmStore := crmmysql.New(database)
	rolledBackAccount := crm.Account{
		ID: "crm-account-rolled-back", OrganizationID: organizationID, Name: "Rolled back",
		Status: crm.StatusActive, Version: 1, CreatedAt: now, UpdatedAt: now,
	}
	if err := crmStore.CreateAccount(ctx, rolledBackAccount, duplicateAudit); err == nil {
		t.Fatal("CRM CreateAccount(duplicate audit) error = nil, want transaction failure")
	}
	if _, err := crmStore.GetAccount(ctx, organizationID, rolledBackAccount.ID); !errors.Is(err, crm.ErrNotFound) {
		t.Fatalf("CRM GetAccount(rolled-back) error = %v, want ErrNotFound", err)
	}
	crmService := crm.NewService(crmStore)
	crmActor := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	account, err := crmService.CreateAccount(ctx, crm.AccountWrite{Name: " Integration Account "}, crmActor)
