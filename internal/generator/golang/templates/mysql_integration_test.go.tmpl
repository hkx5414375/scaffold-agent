		t.Fatalf("CRM CreateAccount() = %#v, %v", account, err)
	}
	contact, err := crmService.CreateContact(ctx, crm.ContactWrite{
		AccountID: account.ID, Name: " Integration Contact ", Email: " CONTACT@EXAMPLE.COM ", Phone: " +1 555 ",
	}, crmActor)
	if err != nil || contact.Email != "contact@example.com" || contact.AccountID != account.ID {
		t.Fatalf("CRM CreateContact() = %#v, %v", contact, err)
	}
	activity, err := crmService.CreateActivity(ctx, crm.ActivityWrite{
		SubjectType: crm.SubjectContact, SubjectID: contact.ID, Type: crm.ActivityMeeting,
		Summary: " Integration meeting ", OccurredAt: now.Add(-time.Hour),
	}, crmActor)
	if err != nil || activity.SubjectID != contact.ID || activity.Summary != "Integration meeting" {
		t.Fatalf("CRM CreateActivity() = %#v, %v", activity, err)
	}
	opportunity, err := crmService.CreateOpportunity(ctx, crm.OpportunityWrite{
		AccountID: account.ID, Name: " Integration Deal ", AmountMinor: "12500", Currency: "usd",
	}, crmActor)
	if err != nil || opportunity.Stage != crm.StageLead || opportunity.AmountMinor != 12500 || opportunity.Currency != "USD" {
		t.Fatalf("CRM CreateOpportunity() = %#v, %v", opportunity, err)
	}
	if _, err := crmService.AdvanceOpportunity(ctx, opportunity.ID, crm.StageInput{Stage: crm.StageWon, Version: opportunity.Version}, crmActor); !errors.Is(err, crm.ErrConflict) {
		t.Fatalf("CRM AdvanceOpportunity(skip) error = %v, want ErrConflict", err)
	}
	for _, stage := range []crm.OpportunityStage{crm.StageQualified, crm.StageProposal, crm.StageWon} {
		opportunity, err = crmService.AdvanceOpportunity(ctx, opportunity.ID, crm.StageInput{Stage: stage, Version: opportunity.Version}, crmActor)
		if err != nil || opportunity.Stage != stage {
			t.Fatalf("CRM AdvanceOpportunity(%s) = %#v, %v", stage, opportunity, err)
		}
	}
	if _, err := crmService.UpdateOpportunity(ctx, opportunity.ID, crm.OpportunityUpdate{
		AccountID: account.ID, Name: opportunity.Name, AmountMinor: "1", Currency: "USD", Version: opportunity.Version,
	}, crmActor); !errors.Is(err, crm.ErrConflict) {
		t.Fatalf("CRM UpdateOpportunity(terminal) error = %v, want ErrConflict", err)
	}
	listedActivities, nextActivityCursor, err := crmStore.ListActivities(ctx, organizationID, crm.SubjectContact, contact.ID, "", 20)
	if err != nil || len(listedActivities) != 1 || listedActivities[0].ID != activity.ID || nextActivityCursor != "" {
		t.Fatalf("CRM ListActivities() = %#v, %q, %v", listedActivities, nextActivityCursor, err)
	}
{{- if .Tenancy}}
	if _, err := crmStore.GetAccount(ctx, "different-organization", account.ID); !errors.Is(err, crm.ErrNotFound) {
		t.Fatalf("CRM GetAccount(cross-organization) error = %v, want ErrNotFound", err)
	}
{{- end}}
{{- if .TenancyLifecycle}}
