components:
  securitySchemes:
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
    bearerToken:
      type: http
      scheme: bearer
{{if .CustomerAccounts}}
    customerSessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_customer_session
{{end}}
  parameters:
    EntityId:
      name: id
      in: path
      required: true
      schema:
        type: string
{{if or .Approvals .Catalog .CustomerAccounts .CRM}}
    ApprovalStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [pending, approved, rejected, cancelled]
    PageCursor:
      name: cursor
      in: query
      schema:
        type: string
    PageLimit:
      name: limit
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 20
{{end}}
{{if .Catalog}}
    CatalogStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [draft, active, archived]
{{end}}
{{if .CustomerAccounts}}
    CustomerStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [active, suspended, closed]
{{end}}
{{if .CRM}}
    CRMRecordStatus:
      name: status
      in: query
      schema: {type: string, enum: [active, archived]}
    CRMOpportunityStage:
      name: stage
      in: query
      schema: {type: string, enum: [lead, qualified, proposal, won, lost]}
{{end}}
{{if .Tenancy}}
    OrganizationId:
      name: X-Organization-ID
      in: header
      required: true
      schema:
        type: string
{{if .TenancyMembers}}
    OrganizationPathId:
      name: organizationID
      in: path
      required: true
      schema:
        type: string
    OrganizationMemberUserId:
      name: userID
      in: path
      required: true
      schema:
        type: string
{{end}}
{{end}}
  responses:
    ErrorResponse:
      description: Stable public error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
  schemas:
    ErrorResponse:
      type: object
      required: [error]
      properties:
        error:
          type: object
          required: [code, message]
          properties:
            code:
              type: string
            message:
              type: string
    Principal:
      type: object
      required: [user_id, email, role, method]
      properties:
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
        method:
          type: string
          enum: [session, token]
        organization_id:
          type: string
    PrincipalResponse:
      type: object
      required: [principal]
      properties:
        principal:
          $ref: "#/components/schemas/Principal"
    LoginRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          format: email
        password:
          type: string
          format: password
    TokenRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
{{if .Tenancy}}
    Organization:
      type: object
      required: [id, name, role, created_at{{if .TenancyLifecycle}}, owner_user_id, is_owner, status, updated_at{{end}}]
      properties:
        id:
          type: string
        name:
          type: string
          minLength: 1
          maxLength: 120
        role:
          type: string
        created_at:
          type: string
          format: date-time
{{if .TenancyLifecycle}}
        owner_user_id:
          type: string
        is_owner:
          type: boolean
        status:
          type: string
          enum: [active, inactive]
        updated_at:
          type: string
          format: date-time
        deactivated_at:
          type: string
          format: date-time
{{end}}
    OrganizationWrite:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    OrganizationPage:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/Organization"
{{if .TenancyMembers}}
    OrganizationMember:
      type: object
      required: [organization_id, user_id, email, role, joined_at{{if .TenancyLifecycle}}, is_owner{{end}}]
      properties:
        organization_id:
          type: string
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        joined_at:
          type: string
          format: date-time
{{if .TenancyLifecycle}}
        is_owner:
          type: boolean
{{end}}
    OrganizationMemberPage:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/OrganizationMember"
    OrganizationInvitation:
      type: object
      required: [id, organization_id, email, role, acceptance_token, expires_at, created_at]
      properties:
        id:
          type: string
        organization_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        acceptance_token:
          type: string
        expires_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    OrganizationInvitationWrite:
      type: object
      additionalProperties: false
      required: [email, role]
      properties:
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
    OrganizationMemberRoleWrite:
      type: object
      additionalProperties: false
      required: [role]
      properties:
        role:
          type: string
          enum: [admin, user]
    OrganizationInvitationAccept:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
          minLength: 1
{{if .TenancyLifecycle}}
    OrganizationOwnershipTransfer:
      type: object
      additionalProperties: false
      required: [target_user_id]
      properties:
        target_user_id:
          type: string
          minLength: 1
{{end}}
{{end}}
{{end}}
{{if .Files}}
    FileAsset:
      type: object
      required: [id, name, media_type, size, sha256, created_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id:
          type: string
{{- if .Tenancy}}
        organization_id:
          type: string
{{- end}}
        name:
          type: string
          maxLength: 255
        media_type:
          type: string
        size:
          type: integer
          format: int64
          minimum: 0
          maximum: 10485760
        sha256:
          type: string
          pattern: "^[a-f0-9]{64}$"
