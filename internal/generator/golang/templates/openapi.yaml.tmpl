          type: string
          format: date-time
    FileAssetPage:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/FileAsset"
        next_cursor:
          type: string
{{end}}
{{if .JobAdmin}}
    JobItem:
      type: object
      required: [id, type, status, priority, attempts, max_attempts, available_at, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id:
          type: string
        organization_id:
          type: string
        type:
          type: string
        status:
          type: string
          enum: [queued, running, succeeded, retry, dead]
        priority:
          type: integer
        attempts:
          type: integer
        max_attempts:
          type: integer
        available_at:
          type: string
          format: date-time
        lease_owner:
          type: string
        lease_until:
          type: string
          format: date-time
        last_error:
          type: string
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
        completed_at:
          type: string
          format: date-time
    JobPage:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/JobItem"
        next_cursor:
          type: string
{{end}}
{{if .Catalog}}
    CatalogProduct:
      type: object
      required: [id, sku, name, price_minor, currency, status, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id:
          type: string
{{- if .Tenancy}}
        organization_id:
          type: string
{{- end}}
        sku:
          type: string
          pattern: "^[A-Z0-9][A-Z0-9._-]{0,63}$"
        name:
          type: string
          minLength: 1
          maxLength: 160
        description:
          type: string
          maxLength: 4000
        price_minor:
          type: string
          pattern: "^(0|[1-9][0-9]{0,18})$"
        currency:
          type: string
          pattern: "^[A-Z]{3}$"
        status:
          type: string
          enum: [draft, active, archived]
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    PublicCatalogProduct:
      allOf:
        - $ref: "#/components/schemas/CatalogProduct"
        - type: object
          properties:
            status:
              const: active
    CatalogProductWrite:
      type: object
      additionalProperties: false
      required: [sku, name, price_minor, currency]
      properties:
        sku:
          type: string
          pattern: "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        name:
          type: string
          minLength: 1
          maxLength: 160
        description:
          type: string
          maxLength: 4000
        price_minor:
          type: string
          pattern: "^(0|[1-9][0-9]{0,18})$"
        currency:
          type: string
          pattern: "^[A-Za-z]{3}$"
    CatalogProductUpdate:
      type: object
      additionalProperties: false
      required: [sku, name, price_minor, currency, version]
      properties:
        sku:
          type: string
          pattern: "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        name:
          type: string
          minLength: 1
          maxLength: 160
        description:
          type: string
          maxLength: 4000
        price_minor:
          type: string
          pattern: "^(0|[1-9][0-9]{0,18})$"
        currency:
          type: string
          pattern: "^[A-Za-z]{3}$"
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
    CatalogTransition:
      type: object
      additionalProperties: false
      required: [version]
      properties:
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
    CatalogProductPage:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/CatalogProduct"
        next_cursor:
