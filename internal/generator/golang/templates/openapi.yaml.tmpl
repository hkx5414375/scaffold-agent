openapi: 3.1.0
info:
  title: {{.ProjectName}}
  version: 0.1.0
  description: Generated by Scaffold Agent. This file is the HTTP contract source of truth.
servers:
  - url: http://localhost:8080
    description: Local development
paths:
  /healthz:
    get:
      operationId: getHealth
      responses:
        "200":
          description: Process is healthy
          content:
            application/json:
              schema:
                type: object
                required: [status]
                properties:
                  status:
                    type: string
                    const: ok
  /api/v1/auth/login:
    post:
      operationId: login
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Login succeeded and the session cookie was set
          headers:
            Set-Cookie:
              schema:
                type: string
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/logout:
    post:
      operationId: logout
      responses:
        "204":
          description: Session was revoked or was already absent
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/me:
    get:
      operationId: getCurrentPrincipal
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Current authenticated principal
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/tokens:
    post:
      operationId: createApiToken
      x-required-permission: identity:token:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TokenRequest"
      responses:
        "201":
          description: Raw API token returned exactly once
          content:
            application/json:
              schema:
                type: object
                required: [token]
                properties:
                  token:
                    type: string
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{if .Tenancy}}
  /api/v1/organizations:
    get:
      operationId: listOrganizations
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organizations visible to the current identity
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationPage"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    post:
      operationId: createOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationWrite"
      responses:
        "201":
          description: Organization created with the current identity as administrator
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{if .TenancyLifecycle}}
  /api/v1/organizations/{organizationID}:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
    patch:
      operationId: renameOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationWrite"
      responses:
        "200":
          description: Renamed organization
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationID}/ownership-transfers:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
    post:
      operationId: transferOrganizationOwnership
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationOwnershipTransfer"
      responses:
        "200":
          description: Organization ownership transferred to an existing member
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationID}/deactivation:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
    post:
      operationId: deactivateOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organization deactivated without deleting its data
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationID}/reactivation:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
    post:
      operationId: reactivateOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organization reactivated by its owner
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{end}}
{{if .TenancyMembers}}
  /api/v1/organizations/{organizationID}/members:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationId"
    get:
      operationId: listOrganizationMembers
      x-required-permission: tenancy:members:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organization members
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMemberPage"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationID}/invitations:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationId"
    post:
      operationId: createOrganizationInvitation
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationWrite"
      responses:
        "201":
          description: Invitation with its acceptance token returned exactly once
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationInvitation"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationID}/members/{userID}:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationMemberUserId"
      - $ref: "#/components/parameters/OrganizationId"
    patch:
      operationId: changeOrganizationMemberRole
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationMemberRoleWrite"
      responses:
        "200":
          description: Updated organization member
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: removeOrganizationMember
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "204":
          description: Organization member removed
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organization-invitations/accept:
    post:
      operationId: acceptOrganizationInvitation
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationAccept"
      responses:
        "200":
          description: Accepted organization membership
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{end}}
{{end}}
{{if .Files}}
  /api/v1/files:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationId"
{{- end}}
    post:
      operationId: uploadFile
      x-required-permission: files:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              required: [file]
              properties:
                file:
                  type: string
                  format: binary
      responses:
        "201":
          description: File asset stored
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAsset"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "413":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: listFiles
      x-required-permission: files:read
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
        - name: cursor
          in: query
          schema:
            type: string
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Bounded file metadata page
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAssetPage"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/files/{id}:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationId"
      - $ref: "#/components/parameters/EntityId"
{{- else}}
    parameters:
      - $ref: "#/components/parameters/EntityId"
{{- end}}
    get:
      operationId: getFile
      x-required-permission: files:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Active file metadata
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAsset"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: deleteFile
      x-required-permission: files:delete
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "204":
          description: File metadata and object deleted
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/files/{id}/content:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationId"
      - $ref: "#/components/parameters/EntityId"
{{- else}}
    parameters:
      - $ref: "#/components/parameters/EntityId"
{{- end}}
    get:
      operationId: downloadFile
      x-required-permission: files:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Streaming file content
          headers:
            Content-Disposition:
              schema:
                type: string
          content:
            application/octet-stream:
              schema:
                type: string
                format: binary
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{end}}
{{if .Business}}
  {{.Business.RoutePath}}:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationId"
{{- end}}
    post:
      operationId: create{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityType}}Write"
      responses:
        "201":
          description: Created {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityType}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: list{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:read
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
        - name: cursor
          in: query
          schema:
            type: string
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Bounded keyset page
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityType}}Page"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  {{.Business.RoutePath}}/{id}:
    parameters:
      - $ref: "#/components/parameters/EntityId"
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationId"
{{- end}}
    get:
      operationId: get{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: One {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityType}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    put:
      operationId: update{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:update
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityType}}Update"
      responses:
        "200":
          description: Updated {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityType}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: delete{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:delete
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
        - name: version
          in: query
          required: true
          schema:
            type: string
            pattern: "^[1-9][0-9]*$"
      responses:
        "204":
          description: Deleted
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{end}}
components:
  securitySchemes:
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
    bearerToken:
      type: http
      scheme: bearer
  parameters:
    EntityId:
      name: id
      in: path
      required: true
      schema:
        type: string
{{if .Tenancy}}
    OrganizationId:
      name: X-Organization-ID
      in: header
      required: true
      schema:
        type: string
{{if .TenancyMembers}}
    OrganizationPathId:
      name: organizationID
      in: path
      required: true
      schema:
        type: string
    OrganizationMemberUserId:
      name: userID
      in: path
      required: true
      schema:
        type: string
{{end}}
{{end}}
  responses:
    ErrorResponse:
      description: Stable public error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
  schemas:
    ErrorResponse:
      type: object
      required: [error]
      properties:
        error:
          type: object
          required: [code, message]
          properties:
            code:
              type: string
            message:
              type: string
    Principal:
      type: object
      required: [user_id, email, role, method]
      properties:
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
        method:
          type: string
          enum: [session, token]
        organization_id:
          type: string
    PrincipalResponse:
      type: object
      required: [principal]
      properties:
        principal:
          $ref: "#/components/schemas/Principal"
    LoginRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          format: email
        password:
          type: string
          format: password
    TokenRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
{{if .Tenancy}}
    Organization:
      type: object
      required: [id, name, role, created_at{{if .TenancyLifecycle}}, owner_user_id, is_owner, status, updated_at{{end}}]
      properties:
        id:
          type: string
        name:
          type: string
          minLength: 1
          maxLength: 120
        role:
          type: string
        created_at:
          type: string
          format: date-time
{{if .TenancyLifecycle}}
        owner_user_id:
          type: string
        is_owner:
          type: boolean
        status:
          type: string
          enum: [active, inactive]
        updated_at:
          type: string
          format: date-time
        deactivated_at:
          type: string
          format: date-time
{{end}}
    OrganizationWrite:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    OrganizationPage:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/Organization"
{{if .TenancyMembers}}
    OrganizationMember:
      type: object
      required: [organization_id, user_id, email, role, joined_at{{if .TenancyLifecycle}}, is_owner{{end}}]
      properties:
        organization_id:
          type: string
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        joined_at:
          type: string
          format: date-time
{{if .TenancyLifecycle}}
        is_owner:
          type: boolean
{{end}}
    OrganizationMemberPage:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/OrganizationMember"
    OrganizationInvitation:
      type: object
      required: [id, organization_id, email, role, acceptance_token, expires_at, created_at]
      properties:
        id:
          type: string
        organization_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        acceptance_token:
          type: string
        expires_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    OrganizationInvitationWrite:
      type: object
      additionalProperties: false
      required: [email, role]
      properties:
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
    OrganizationMemberRoleWrite:
      type: object
      additionalProperties: false
      required: [role]
      properties:
        role:
          type: string
          enum: [admin, user]
    OrganizationInvitationAccept:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
          minLength: 1
{{if .TenancyLifecycle}}
    OrganizationOwnershipTransfer:
      type: object
      additionalProperties: false
      required: [target_user_id]
      properties:
        target_user_id:
          type: string
          minLength: 1
{{end}}
{{end}}
{{end}}
{{if .Files}}
    FileAsset:
      type: object
      required: [id, name, media_type, size, sha256, created_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id:
          type: string
{{- if .Tenancy}}
        organization_id:
          type: string
{{- end}}
        name:
          type: string
          maxLength: 255
        media_type:
          type: string
        size:
          type: integer
          format: int64
          minimum: 0
          maximum: 10485760
        sha256:
          type: string
          pattern: "^[a-f0-9]{64}$"
        created_at:
          type: string
