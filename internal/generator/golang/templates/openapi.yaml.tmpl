openapi: 3.1.0
info:
  title: {{.ProjectName}}
  version: 0.1.0
  description: Generated by Scaffold Agent. This file is the HTTP contract source of truth.
servers:
  - url: http://localhost:8080
    description: Local development
paths:
  /healthz:
    get:
      operationId: getHealth
      responses:
        "200":
          description: Process is healthy
          content:
            application/json:
              schema:
                type: object
                required: [status]
                properties:
                  status:
                    type: string
                    const: ok
  /api/v1/auth/login:
    post:
      operationId: login
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Login succeeded and the session cookie was set
          headers:
            Set-Cookie:
              schema:
                type: string
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/logout:
    post:
      operationId: logout
      responses:
        "204":
          description: Session was revoked or was already absent
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/me:
    get:
      operationId: getCurrentPrincipal
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Current authenticated principal
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/tokens:
    post:
      operationId: createApiToken
      x-required-permission: identity:token:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TokenRequest"
      responses:
        "201":
          description: Raw API token returned exactly once
          content:
            application/json:
              schema:
                type: object
                required: [token]
                properties:
                  token:
                    type: string
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{if .Business}}
  {{.Business.RoutePath}}:
    post:
      operationId: create{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityType}}Write"
      responses:
        "201":
          description: Created {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityType}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: list{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:read
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
        - name: cursor
          in: query
          schema:
            type: string
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Bounded keyset page
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityType}}Page"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  {{.Business.RoutePath}}/{id}:
    parameters:
      - $ref: "#/components/parameters/EntityId"
    get:
      operationId: get{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: One {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityType}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    put:
      operationId: update{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:update
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityType}}Update"
      responses:
        "200":
          description: Updated {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityType}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: delete{{.Business.EntityType}}
      x-required-permission: {{.Business.PermissionPrefix}}:delete
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
        - name: version
          in: query
          required: true
          schema:
            type: string
            pattern: "^[1-9][0-9]*$"
      responses:
        "204":
          description: Deleted
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{end}}
components:
  securitySchemes:
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
    bearerToken:
      type: http
      scheme: bearer
  parameters:
    EntityId:
      name: id
      in: path
      required: true
      schema:
        type: string
  responses:
    ErrorResponse:
      description: Stable public error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
  schemas:
    ErrorResponse:
      type: object
      required: [error]
      properties:
        error:
          type: object
          required: [code, message]
          properties:
            code:
              type: string
            message:
              type: string
    Principal:
      type: object
      required: [user_id, email, role, method]
      properties:
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
        method:
          type: string
          enum: [session, token]
    PrincipalResponse:
      type: object
      required: [principal]
      properties:
        principal:
          $ref: "#/components/schemas/Principal"
    LoginRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          format: email
        password:
          type: string
          format: password
    TokenRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
{{if .Business}}
    {{.Business.EntityType}}:
      type: object
      required:
        - id
{{- range .Business.RequiredFields}}
        - {{.}}
{{- end}}
        - version
        - created_at
        - updated_at
      properties:
        id:
          type: string
{{- range .Business.Fields}}
        {{.Name}}:
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    {{.Business.EntityType}}Write:
      type: object
      additionalProperties: false
{{if .Business.RequiredFields}}
      required:
{{- range .Business.RequiredFields}}
        - {{.}}
{{- end}}
{{end}}
      properties:
{{- range .Business.Fields}}
        {{.Name}}:
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- end}}
    {{.Business.EntityType}}Update:
      type: object
      additionalProperties: false
      required:
        - version
{{- range .Business.RequiredFields}}
        - {{.}}
{{- end}}
      properties:
{{- range .Business.Fields}}
        {{.Name}}:
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
    {{.Business.EntityType}}Page:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/{{.Business.EntityType}}"
        next_cursor:
          type: string
{{end}}
