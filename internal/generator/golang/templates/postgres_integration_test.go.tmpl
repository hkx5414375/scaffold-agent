func TestPostgreSQLMigrationsAndStores(t *testing.T) {
	pool := isolatedPostgreSQL(t)
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	if err := migrate.Run(ctx, pool); err != nil {
		t.Fatalf("Run(first) error = %v", err)
	}
	if err := migrate.Run(ctx, pool); err != nil {
		t.Fatalf("Run(second) error = %v", err)
	}
	var migrationCount int
	if err := pool.QueryRow(ctx, `select count(*) from scaffold_schema_migrations`).Scan(&migrationCount); err != nil {
		t.Fatalf("count migrations: %v", err)
	}
	if migrationCount != {{.MigrationCount}} {
		t.Fatalf("migration count = %d, want {{.MigrationCount}}", migrationCount)
	}

	identityStore := identitypostgres.New(pool)
	now := time.Now().UTC().Truncate(time.Microsecond)
	user := identity.User{
		ID: "integration-user", Email: "integration@example.com",
		PasswordHash: "integration-only-hash", Role: "admin",
	}
	if err := identityStore.CreateUser(ctx, user); err != nil {
		t.Fatalf("CreateUser() error = %v", err)
	}
	loadedUser, err := identityStore.UserByEmail(ctx, user.Email)
	if err != nil || loadedUser.ID != user.ID || loadedUser.Role != "admin" {
		t.Fatalf("UserByEmail() = %#v, %v", loadedUser, err)
	}

	sessionHash := []byte("integration-session-digest")
	if err := identityStore.CreateSession(ctx, identity.Session{TokenHash: sessionHash, UserID: user.ID, ExpiresAt: now.Add(time.Hour)}); err != nil {
		t.Fatalf("CreateSession() error = %v", err)
	}
	if loadedUser, err = identityStore.UserBySession(ctx, sessionHash, now); err != nil || loadedUser.ID != user.ID {
		t.Fatalf("UserBySession() = %#v, %v", loadedUser, err)
	}
	if err := identityStore.DeleteSession(ctx, sessionHash); err != nil {
		t.Fatalf("DeleteSession() error = %v", err)
	}
	if _, err := identityStore.UserBySession(ctx, sessionHash, now); !errors.Is(err, identity.ErrNotFound) {
		t.Fatalf("UserBySession(deleted) error = %v, want ErrNotFound", err)
	}

	apiTokenHash := []byte("integration-api-token-digest")
	if err := identityStore.CreateAPIToken(ctx, identity.APIToken{
		ID: "integration-token", TokenHash: apiTokenHash, UserID: user.ID,
		Name: "integration", ExpiresAt: now.Add(time.Hour),
	}); err != nil {
		t.Fatalf("CreateAPIToken() error = %v", err)
	}
	if loadedUser, err = identityStore.UserByAPIToken(ctx, apiTokenHash, now); err != nil || loadedUser.ID != user.ID {
		t.Fatalf("UserByAPIToken() = %#v, %v", loadedUser, err)
	}
	if err := identityStore.DeleteAPIToken(ctx, "integration-token"); err != nil {
		t.Fatalf("DeleteAPIToken() error = %v", err)
	}
	if _, err := identityStore.UserByAPIToken(ctx, apiTokenHash, now); !errors.Is(err, identity.ErrNotFound) {
		t.Fatalf("UserByAPIToken(deleted) error = %v, want ErrNotFound", err)
	}

	allowed, err := identityStore.HasPermission(ctx, "admin", "{{.Business.PermissionPrefix}}:create")
	if err != nil || !allowed {
		t.Fatalf("HasPermission() = %t, %v", allowed, err)
	}
	allowed, err = identityStore.HasPermission(ctx, "user", "{{.Business.PermissionPrefix}}:create")
	if err != nil || allowed {
		t.Fatalf("HasPermission(user) = %t, %v, want denied", allowed, err)
	}

	duplicateAudit := identity.AuditEvent{
		ID: "duplicate-audit", UserID: user.ID, Action: "integration:seed",
		Outcome: "succeeded", Target: "seed", CreatedAt: now,
	}
	if err := identityStore.AppendAudit(ctx, duplicateAudit); err != nil {
		t.Fatalf("AppendAudit() error = %v", err)
	}
	organizationID := ""
{{- if .Tenancy}}
	organizationID = "integration-organization"
	tenancyStore := tenancypostgres.New(pool)
	organization := tenancy.Organization{ID: organizationID, Name: "Integration", Role: "admin", CreatedAt: now}
	membership := tenancy.Membership{OrganizationID: organizationID, UserID: user.ID, Role: "admin", CreatedAt: now}
	if err := tenancyStore.CreateOrganization(ctx, organization, membership, audit(user.ID, "tenancy.organization:create", organizationID, now)); err != nil {
		t.Fatalf("CreateOrganization() error = %v", err)
	}
{{- if .TenancyMembers}}
	memberUser := identity.User{ID: "integration-member", Email: "member@example.com", PasswordHash: user.PasswordHash, Role: "user"}
	if err := identityStore.CreateUser(ctx, memberUser); err != nil {
		t.Fatalf("CreateUser(member) error = %v", err)
	}
	members := tenancy.NewMemberService(tenancyStore)
	invitation, err := members.Invite(ctx, memberUser.Email, "user", identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID})
	if err != nil {
		t.Fatalf("Invite() error = %v", err)
	}
	accepted, err := members.Accept(ctx, invitation.AcceptanceToken, identity.Principal{UserID: memberUser.ID, Email: memberUser.Email, Role: "user"})
	if err != nil || accepted.OrganizationID != organizationID {
		t.Fatalf("Accept() = %#v, %v", accepted, err)
	}
	listedMembers, err := tenancyStore.ListMembers(ctx, organizationID)
	if err != nil || len(listedMembers) != 2 {
		t.Fatalf("ListMembers() = %#v, %v", listedMembers, err)
	}
	adminPrincipal := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	if _, err := members.ChangeRole(ctx, memberUser.ID, "admin", adminPrincipal); err != nil {
		t.Fatalf("ChangeRole() error = %v", err)
	}
{{- if .TenancyLifecycle}}
	lifecycle := tenancy.NewLifecycleService(tenancyStore)
	renamed, err := lifecycle.Rename(ctx, organizationID, "Renamed Integration", adminPrincipal)
	if err != nil || renamed.Name != "Renamed Integration" || !renamed.IsOwner {
		t.Fatalf("Rename() = %#v, %v", renamed, err)
	}
	transferred, err := lifecycle.TransferOwnership(ctx, organizationID, memberUser.ID, adminPrincipal)
	if err != nil || transferred.OwnerUserID != memberUser.ID || transferred.IsOwner {
		t.Fatalf("TransferOwnership() = %#v, %v", transferred, err)
	}
	if err := members.Remove(ctx, memberUser.ID, adminPrincipal); !errors.Is(err, tenancy.ErrOwnerProtected) {
		t.Fatalf("Remove(owner) error = %v, want ErrOwnerProtected", err)
	}
	if _, err := lifecycle.Deactivate(ctx, organizationID, adminPrincipal); !errors.Is(err, tenancy.ErrLifecycleForbidden) {
		t.Fatalf("Deactivate(previous owner) error = %v, want ErrLifecycleForbidden", err)
	}
	ownerPrincipal := identity.Principal{UserID: memberUser.ID, Email: memberUser.Email, Role: "admin", OrganizationID: organizationID}
	inactive, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal)
	if err != nil || inactive.Status != tenancy.OrganizationInactive {
		t.Fatalf("Deactivate() = %#v, %v", inactive, err)
	}
	if _, err := tenancyStore.MembershipRole(ctx, organizationID, user.ID); !errors.Is(err, tenancy.ErrNotFound) {
		t.Fatalf("MembershipRole(inactive) error = %v, want ErrNotFound", err)
	}
	active, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal)
	if err != nil || active.Status != tenancy.OrganizationActive {
		t.Fatalf("Reactivate() = %#v, %v", active, err)
	}
{{- else}}
	if err := members.Remove(ctx, memberUser.ID, adminPrincipal); err != nil {
		t.Fatalf("Remove() error = %v", err)
	}
	if err := members.Remove(ctx, user.ID, adminPrincipal); !errors.Is(err, tenancy.ErrLastAdministrator) {
		t.Fatalf("Remove(last administrator) error = %v, want ErrLastAdministrator", err)
	}
{{- end}}
	var deniedMemberAudit int
	if err := pool.QueryRow(ctx, `
		select count(*) from audit_events
		where action = 'tenancy.member.remove' and outcome = 'denied' and target = $1`, organizationID+":"+{{if .TenancyLifecycle}}memberUser.ID{{else}}user.ID{{end}}).Scan(&deniedMemberAudit); err != nil || deniedMemberAudit != 1 {
		t.Fatalf("denied member audit count = %d, %v, want 1", deniedMemberAudit, err)
	}
{{- end}}
{{- end}}

{{- if .Files}}
	fileBlobs, err := local.New(t.TempDir())
	if err != nil {
		t.Fatalf("local.New() error = %v", err)
	}
	fileService := files.NewService(filespostgres.New(pool), fileBlobs)
	fileActor := identity.Principal{UserID: user.ID, OrganizationID: organizationID}
	fileAsset, err := fileService.Upload(ctx, files.UploadInput{
		Name: "integration.txt", MediaType: "text/plain", Content: bytes.NewBufferString("file integration"),
	}, fileActor)
	if err != nil {
		t.Fatalf("files.Upload() error = %v", err)
	}
	loadedAsset, fileReader, err := fileService.Open(ctx, fileAsset.ID, fileActor)
	if err != nil {
		t.Fatalf("files.Open() error = %v", err)
	}
	fileContent, readErr := io.ReadAll(fileReader)
	_ = fileReader.Close()
	if readErr != nil || loadedAsset.SHA256 != fileAsset.SHA256 || string(fileContent) != "file integration" {
		t.Fatalf("files.Open() = %#v, %q, %v", loadedAsset, fileContent, readErr)
	}
{{- if .Tenancy}}
	if _, err := fileService.Get(ctx, fileAsset.ID, identity.Principal{UserID: user.ID, OrganizationID: "different-organization"}); !errors.Is(err, files.ErrNotFound) {
		t.Fatalf("files.Get(cross-tenant) error = %v, want ErrNotFound", err)
	}
{{- end}}
	if err := fileService.Delete(ctx, fileAsset.ID, fileActor); err != nil {
		t.Fatalf("files.Delete() error = %v", err)
	}
	if _, err := fileService.Get(ctx, fileAsset.ID, fileActor); !errors.Is(err, files.ErrNotFound) {
		t.Fatalf("files.Get(deleted) error = %v, want ErrNotFound", err)
	}
{{- end}}

{{- if .Cache}}
	cacheStore := cachepostgres.New(pool)
	cacheService := applicationcache.NewService(cacheStore)
	if err := cacheService.Set(ctx, organizationID, "integration:key", map[string]string{"value": "cached"}, time.Hour); err != nil {
		t.Fatalf("cache.Set() error = %v", err)
	}
	var cachedValue map[string]string
	if err := cacheService.Decode(ctx, organizationID, "integration:key", &cachedValue); err != nil || cachedValue["value"] != "cached" {
		t.Fatalf("cache.Decode() = %#v, %v", cachedValue, err)
	}
{{- if .Tenancy}}
	if _, err := cacheService.Get(ctx, "different-organization", "integration:key"); !errors.Is(err, applicationcache.ErrMiss) {
		t.Fatalf("cache.Get(cross-tenant) error = %v, want ErrMiss", err)
	}
{{- end}}
	if err := cacheStore.Set(ctx, applicationcache.Entry{
		ScopeKey: {{if .Tenancy}}organizationID{{else}}"global"{{end}}, Key: "expired", Value: json.RawMessage(`{"expired":true}`), ExpiresAt: now.Add(-time.Minute),
	}); err != nil {
		t.Fatalf("cache.Store.Set(expired) error = %v", err)
	}
	if count, err := cacheService.PurgeExpired(ctx, 100); err != nil || count != 1 {
		t.Fatalf("cache.PurgeExpired() = %d, %v, want 1", count, err)
	}
	if err := cacheService.Delete(ctx, organizationID, "integration:key"); err != nil {
		t.Fatalf("cache.Delete() error = %v", err)
	}
{{- end}}

{{- if .Jobs}}
	jobStore := jobspostgres.New(pool)
	jobService := jobs.NewService(jobStore)
{{- if .Notifications}}
	notificationService := notifications.NewService(jobService)
	queued, err := notificationService.EnqueueEmail(ctx, organizationID, "integration-request", notifications.Email{
		To: "person@example.com", Subject: "Integration", TextBody: "Queued by integration test",
	})
	if err != nil {
		t.Fatalf("EnqueueEmail() error = %v", err)
	}
	duplicate, err := notificationService.EnqueueEmail(ctx, organizationID, "integration-request", notifications.Email{
		To: "person@example.com", Subject: "Integration", TextBody: "Queued by integration test",
	})
{{- else}}
	jobInput := jobs.EnqueueInput{
		Type: "system.noop", Payload: json.RawMessage(`{"source":"integration"}`),
		IdempotencyKey: "integration-request", MaxAttempts: 3,
	}
	queued, err := jobService.Enqueue(ctx, organizationID, jobInput)
	if err != nil {
		t.Fatalf("Enqueue() error = %v", err)
	}
	duplicate, err := jobService.Enqueue(ctx, organizationID, jobInput)
{{- end}}
	if err != nil || duplicate.ID != queued.ID {
		t.Fatalf("Enqueue(duplicate) = %#v, %v, want %s", duplicate, err, queued.ID)
	}
	leased, err := jobService.LeaseNext(ctx, "worker-1", 30*time.Second)
	if err != nil || leased.ID != queued.ID || leased.Attempts != 1 || leased.OrganizationID != organizationID {
		t.Fatalf("LeaseNext() = %#v, %v", leased, err)
	}
	if err := jobService.Fail(ctx, leased, "worker-1", errors.New("retry integration job")); err != nil {
		t.Fatalf("Fail() error = %v", err)
	}
	retryNow := time.Now().UTC().Add(time.Hour)
	retried, err := jobStore.LeaseNext(ctx, "worker-2", retryNow, retryNow.Add(30*time.Second))
	if err != nil || retried.ID != queued.ID || retried.Attempts != 2 {
		t.Fatalf("LeaseNext(retry) = %#v, %v", retried, err)
	}
	if err := jobService.Complete(ctx, retried.ID, "worker-2"); err != nil {
		t.Fatalf("Complete() error = %v", err)
	}
	if err := jobStore.Complete(ctx, retried.ID, "worker-2", time.Now().UTC()); !errors.Is(err, jobs.ErrLeaseLost) {
		t.Fatalf("Complete(after completion) error = %v, want ErrLeaseLost", err)
	}
{{- if .JobAdmin}}
	deadJob, err := jobService.Enqueue(ctx, organizationID, jobs.EnqueueInput{
		Type: "system.dead-test", Payload: json.RawMessage(`{"source":"job-admin-integration"}`),
		IdempotencyKey: "job-admin-dead", MaxAttempts: 1,
	})
	if err != nil {
		t.Fatalf("Enqueue(job admin) error = %v", err)
	}
	deadJob, err = jobService.LeaseNext(ctx, "worker-admin", 30*time.Second)
	if err != nil {
		t.Fatalf("LeaseNext(job admin) error = %v", err)
	}
	if err := jobService.Fail(ctx, deadJob, "worker-admin", errors.New("expected dead job")); err != nil {
		t.Fatalf("Fail(job admin) error = %v", err)
	}
	jobAdminService := jobadmin.NewService(jobStore)
	jobAdminActor := identity.Principal{UserID: user.ID, OrganizationID: organizationID}
	deadPage, err := jobAdminService.List(ctx, jobs.StatusDead, "", 20, jobAdminActor)
	if err != nil || len(deadPage.Items) != 1 || deadPage.Items[0].ID != deadJob.ID {
		t.Fatalf("jobadmin.List() = %#v, %v", deadPage, err)
	}
	requeued, err := jobAdminService.Retry(ctx, deadJob.ID, jobAdminActor)
	if err != nil || requeued.Status != jobs.StatusQueued || requeued.Attempts != 0 {
		t.Fatalf("jobadmin.Retry() = %#v, %v", requeued, err)
	}
{{- end}}
{{- end}}

{{- range .Business.Fields}}
	first{{.GoName}} := {{.SampleOne}}
	second{{.GoName}} := {{.SampleTwo}}
{{- end}}
	rolledBack := business.{{.Business.EntityType}}{
		ID: "rolled-back", OrganizationID: organizationID, Version: 1, CreatedAt: now, UpdatedAt: now,
{{- range .Business.Fields}}
		{{.GoName}}: {{if .Required}}first{{.GoName}}{{else}}&first{{.GoName}}{{end}},
{{- end}}
	}
	businessStore := businesspostgres.New(pool)
	if err := businessStore.Create(ctx, rolledBack, duplicateAudit); err == nil {
		t.Fatal("Create(with duplicate audit) error = nil, want transaction failure")
	}
	if _, err := businessStore.Get(ctx, organizationID, rolledBack.ID); !errors.Is(err, business.ErrNotFound) {
		t.Fatalf("Get(rolled-back) error = %v, want ErrNotFound", err)
	}

	created := rolledBack
	created.ID = "integration-record"
	if err := businessStore.Create(ctx, created, audit(user.ID, "{{.Business.PermissionPrefix}}:create", created.ID, now)); err != nil {
		t.Fatalf("Create() error = %v", err)
	}
	loaded, err := businessStore.Get(ctx, organizationID, created.ID)
	if err != nil {
		t.Fatalf("Get() error = %v", err)
	}
{{- if .Tenancy}}
	if _, err := businessStore.Get(ctx, "different-organization", created.ID); !errors.Is(err, business.ErrNotFound) {
		t.Fatalf("Get(cross-tenant) error = %v, want ErrNotFound", err)
	}
{{- end}}
	if loaded.ID != created.ID || loaded.Version != 1 || !loaded.CreatedAt.Equal(created.CreatedAt) {
		t.Fatalf("Get() = %#v, want created record", loaded)
	}
{{- range .Business.Fields}}
	if !reflect.DeepEqual(loaded.{{.GoName}}, created.{{.GoName}}) {
		t.Fatalf("Get().{{.GoName}} = %#v, want %#v", loaded.{{.GoName}}, created.{{.GoName}})
	}
{{- end}}
	page, cursor, err := businessStore.List(ctx, organizationID, "", 20)
	if err != nil || len(page) != 1 || cursor != "" || page[0].ID != created.ID {
		t.Fatalf("List() = %#v, %q, %v", page, cursor, err)
	}

	replacement := loaded
{{- range .Business.Fields}}
	replacement.{{.GoName}} = {{if .Required}}second{{.GoName}}{{else}}&second{{.GoName}}{{end}}
{{- end}}
	replacement.UpdatedAt = now.Add(time.Minute)
	updated, err := businessStore.Update(ctx, replacement, audit(user.ID, "{{.Business.PermissionPrefix}}:update", created.ID, replacement.UpdatedAt))
	if err != nil || updated.Version != 2 {
		t.Fatalf("Update() = %#v, %v", updated, err)
	}
	if _, err := businessStore.Update(ctx, replacement, audit(user.ID, "{{.Business.PermissionPrefix}}:update", created.ID, now)); !errors.Is(err, business.ErrConflict) {
		t.Fatalf("Update(stale) error = %v, want ErrConflict", err)
	}
	if err := businessStore.Delete(ctx, organizationID, created.ID, updated.Version, audit(user.ID, "{{.Business.PermissionPrefix}}:delete", created.ID, now)); err != nil {
		t.Fatalf("Delete() error = %v", err)
	}
	if _, err := businessStore.Get(ctx, organizationID, created.ID); !errors.Is(err, business.ErrNotFound) {
		t.Fatalf("Get(deleted) error = %v, want ErrNotFound", err)
	}
	var mutationAuditCount int
	if err := pool.QueryRow(ctx, `select count(*) from audit_events where target = $1 and action like $2`, created.ID, "{{.Business.PermissionPrefix}}:%").Scan(&mutationAuditCount); err != nil {
		t.Fatalf("count mutation audit events: %v", err)
	}
	if mutationAuditCount != 3 {
		t.Fatalf("mutation audit count = %d, want 3", mutationAuditCount)
	}
}

func isolatedPostgreSQL(t *testing.T) *pgxpool.Pool {
	t.Helper()
	databaseURL := strings.TrimSpace(os.Getenv("TEST_DATABASE_URL"))
	if databaseURL == "" {
		t.Skip("TEST_DATABASE_URL is not set")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()

	adminConfig, err := pgxpool.ParseConfig(databaseURL)
	if err != nil {
		t.Fatalf("parse TEST_DATABASE_URL: %v", err)
	}
	adminConfig.MaxConns = 2
	adminConfig.MinConns = 0
	adminPool, err := pgxpool.NewWithConfig(ctx, adminConfig)
	if err != nil {
		t.Fatalf("create administration pool: %v", err)
	}
	if err := adminPool.Ping(ctx); err != nil {
		adminPool.Close()
		t.Fatalf("ping PostgreSQL: %v", err)
	}
	t.Cleanup(adminPool.Close)

	schema := "scaffold_test_" + strings.ToLower(rand.Text())
	quotedSchema := pgx.Identifier{schema}.Sanitize()
	if _, err := adminPool.Exec(ctx, "create schema "+quotedSchema); err != nil {
		t.Fatalf("create isolated schema: %v", err)
	}
	t.Cleanup(func() {
		cleanupContext, cleanupCancel := context.WithTimeout(context.Background(), 15*time.Second)
		defer cleanupCancel()
		if _, err := adminPool.Exec(cleanupContext, "drop schema "+quotedSchema+" cascade"); err != nil {
			t.Errorf("drop isolated schema: %v", err)
		}
	})

	testConfig, err := pgxpool.ParseConfig(databaseURL)
	if err != nil {
		t.Fatalf("parse isolated pool configuration: %v", err)
	}
	if testConfig.ConnConfig.RuntimeParams == nil {
		testConfig.ConnConfig.RuntimeParams = make(map[string]string)
	}
	testConfig.ConnConfig.RuntimeParams["search_path"] = schema
	testConfig.MaxConns = 4
	testConfig.MinConns = 0
	pool, err := pgxpool.NewWithConfig(ctx, testConfig)
	if err != nil {
		t.Fatalf("create isolated pool: %v", err)
	}
	if err := pool.Ping(ctx); err != nil {
		pool.Close()
		t.Fatalf("ping isolated schema: %v", err)
	}
	t.Cleanup(pool.Close)
	return pool
}

func audit(userID, action, target string, now time.Time) identity.AuditEvent {
	return identity.AuditEvent{
		ID: rand.Text(), UserID: userID, Action: action,
		Outcome: "succeeded", Target: target, CreatedAt: now,
	}
}
