func TestPostgreSQLMigrationsAndStores(t *testing.T) {
	pool := isolatedPostgreSQL(t)
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	if err := migrate.Run(ctx, pool); err != nil {
		t.Fatalf("Run(first) error = %v", err)
	}
	if err := migrate.Run(ctx, pool); err != nil {
		t.Fatalf("Run(second) error = %v", err)
	}
	var migrationCount int
	if err := pool.QueryRow(ctx, `select count(*) from scaffold_schema_migrations`).Scan(&migrationCount); err != nil {
		t.Fatalf("count migrations: %v", err)
	}
	if migrationCount != {{.MigrationCount}} {
		t.Fatalf("migration count = %d, want {{.MigrationCount}}", migrationCount)
	}

	identityStore := identitypostgres.New(pool)
	now := time.Now().UTC().Truncate(time.Microsecond)
	user := identity.User{
		ID: "integration-user", Email: "integration@example.com",
		PasswordHash: "integration-only-hash", Role: "admin",
	}
	if err := identityStore.CreateUser(ctx, user); err != nil {
		t.Fatalf("CreateUser() error = %v", err)
	}
	loadedUser, err := identityStore.UserByEmail(ctx, user.Email)
	if err != nil || loadedUser.ID != user.ID || loadedUser.Role != "admin" {
		t.Fatalf("UserByEmail() = %#v, %v", loadedUser, err)
	}

	sessionHash := []byte("integration-session-digest")
	if err := identityStore.CreateSession(ctx, identity.Session{TokenHash: sessionHash, UserID: user.ID, ExpiresAt: now.Add(time.Hour)}); err != nil {
		t.Fatalf("CreateSession() error = %v", err)
	}
	if loadedUser, err = identityStore.UserBySession(ctx, sessionHash, now); err != nil || loadedUser.ID != user.ID {
		t.Fatalf("UserBySession() = %#v, %v", loadedUser, err)
	}
	if err := identityStore.DeleteSession(ctx, sessionHash); err != nil {
		t.Fatalf("DeleteSession() error = %v", err)
	}
	if _, err := identityStore.UserBySession(ctx, sessionHash, now); !errors.Is(err, identity.ErrNotFound) {
		t.Fatalf("UserBySession(deleted) error = %v, want ErrNotFound", err)
	}

	apiTokenHash := []byte("integration-api-token-digest")
	if err := identityStore.CreateAPIToken(ctx, identity.APIToken{
		ID: "integration-token", TokenHash: apiTokenHash, UserID: user.ID,
		Name: "integration", ExpiresAt: now.Add(time.Hour),
	}); err != nil {
		t.Fatalf("CreateAPIToken() error = %v", err)
	}
	if loadedUser, err = identityStore.UserByAPIToken(ctx, apiTokenHash, now); err != nil || loadedUser.ID != user.ID {
		t.Fatalf("UserByAPIToken() = %#v, %v", loadedUser, err)
	}
	if err := identityStore.DeleteAPIToken(ctx, "integration-token"); err != nil {
		t.Fatalf("DeleteAPIToken() error = %v", err)
	}
	if _, err := identityStore.UserByAPIToken(ctx, apiTokenHash, now); !errors.Is(err, identity.ErrNotFound) {
		t.Fatalf("UserByAPIToken(deleted) error = %v, want ErrNotFound", err)
	}

	allowed, err := identityStore.HasPermission(ctx, "admin", "{{.Business.PermissionPrefix}}:create")
	if err != nil || !allowed {
		t.Fatalf("HasPermission() = %t, %v", allowed, err)
	}
	allowed, err = identityStore.HasPermission(ctx, "user", "{{.Business.PermissionPrefix}}:create")
	if err != nil || allowed {
		t.Fatalf("HasPermission(user) = %t, %v, want denied", allowed, err)
	}
{{- if .CSVTransfer}}
	for _, code := range []string{"{{.Business.PermissionPrefix}}:import", "{{.Business.PermissionPrefix}}:export"} {
		allowed, err = identityStore.HasPermission(ctx, "admin", code)
		if err != nil || !allowed {
			t.Fatalf("HasPermission(admin, %s) = %t, %v", code, allowed, err)
		}
	}
	allowed, err = identityStore.HasPermission(ctx, "user", "{{.Business.PermissionPrefix}}:import")
	if err != nil || allowed {
		t.Fatalf("HasPermission(user, import) = %t, %v, want denied", allowed, err)
	}
{{- end}}
{{- if .Approvals}}
	for _, permission := range []struct {
		role    string
		code    string
		allowed bool
	}{
		{role: "admin", code: "approvals:submit", allowed: true},
		{role: "admin", code: "approvals:mine", allowed: true},
		{role: "admin", code: "approvals:read", allowed: true},
		{role: "admin", code: "approvals:decide", allowed: true},
		{role: "user", code: "approvals:submit", allowed: true},
		{role: "user", code: "approvals:mine", allowed: true},
		{role: "user", code: "approvals:read", allowed: false},
		{role: "user", code: "approvals:decide", allowed: false},
	} {
		allowed, err = identityStore.HasPermission(ctx, permission.role, permission.code)
		if err != nil || allowed != permission.allowed {
			t.Fatalf("HasPermission(%s, %s) = %t, %v, want %t", permission.role, permission.code, allowed, err, permission.allowed)
		}
	}
{{- end}}

	duplicateAudit := identity.AuditEvent{
		ID: "duplicate-audit", UserID: user.ID, Action: "integration:seed",
		Outcome: "succeeded", Target: "seed", CreatedAt: now,
	}
	if err := identityStore.AppendAudit(ctx, duplicateAudit); err != nil {
		t.Fatalf("AppendAudit() error = %v", err)
	}
	organizationID := ""
{{- if .Tenancy}}
	organizationID = "integration-organization"
	tenancyStore := tenancypostgres.New(pool)
	organization := tenancy.Organization{ID: organizationID, Name: "Integration", Role: "admin", CreatedAt: now}
	membership := tenancy.Membership{OrganizationID: organizationID, UserID: user.ID, Role: "admin", CreatedAt: now}
	if err := tenancyStore.CreateOrganization(ctx, organization, membership, audit(user.ID, "tenancy.organization:create", organizationID, now)); err != nil {
		t.Fatalf("CreateOrganization() error = %v", err)
	}
{{- if .TenancyMembers}}
	memberUser := identity.User{ID: "integration-member", Email: "member@example.com", PasswordHash: user.PasswordHash, Role: "user"}
	if err := identityStore.CreateUser(ctx, memberUser); err != nil {
		t.Fatalf("CreateUser(member) error = %v", err)
	}
	members := tenancy.NewMemberService(tenancyStore)
	invitation, err := members.Invite(ctx, memberUser.Email, "user", identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID})
	if err != nil {
		t.Fatalf("Invite() error = %v", err)
	}
	accepted, err := members.Accept(ctx, invitation.AcceptanceToken, identity.Principal{UserID: memberUser.ID, Email: memberUser.Email, Role: "user"})
	if err != nil || accepted.OrganizationID != organizationID {
		t.Fatalf("Accept() = %#v, %v", accepted, err)
	}
	listedMembers, err := tenancyStore.ListMembers(ctx, organizationID)
	if err != nil || len(listedMembers) != 2 {
		t.Fatalf("ListMembers() = %#v, %v", listedMembers, err)
	}
	adminPrincipal := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	if _, err := members.ChangeRole(ctx, memberUser.ID, "admin", adminPrincipal); err != nil {
		t.Fatalf("ChangeRole() error = %v", err)
	}
{{- if .TenancyLifecycle}}
	lifecycle := tenancy.NewLifecycleService(tenancyStore)
	renamed, err := lifecycle.Rename(ctx, organizationID, "Renamed Integration", adminPrincipal)
	if err != nil || renamed.Name != "Renamed Integration" || !renamed.IsOwner {
		t.Fatalf("Rename() = %#v, %v", renamed, err)
	}
	transferred, err := lifecycle.TransferOwnership(ctx, organizationID, memberUser.ID, adminPrincipal)
	if err != nil || transferred.OwnerUserID != memberUser.ID || transferred.IsOwner {
		t.Fatalf("TransferOwnership() = %#v, %v", transferred, err)
	}
	if err := members.Remove(ctx, memberUser.ID, adminPrincipal); !errors.Is(err, tenancy.ErrOwnerProtected) {
		t.Fatalf("Remove(owner) error = %v, want ErrOwnerProtected", err)
	}
	if _, err := lifecycle.Deactivate(ctx, organizationID, adminPrincipal); !errors.Is(err, tenancy.ErrLifecycleForbidden) {
		t.Fatalf("Deactivate(previous owner) error = %v, want ErrLifecycleForbidden", err)
	}
	ownerPrincipal := identity.Principal{UserID: memberUser.ID, Email: memberUser.Email, Role: "admin", OrganizationID: organizationID}
	inactive, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal)
	if err != nil || inactive.Status != tenancy.OrganizationInactive {
		t.Fatalf("Deactivate() = %#v, %v", inactive, err)
	}
	if _, err := tenancyStore.MembershipRole(ctx, organizationID, user.ID); !errors.Is(err, tenancy.ErrNotFound) {
		t.Fatalf("MembershipRole(inactive) error = %v, want ErrNotFound", err)
	}
	active, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal)
	if err != nil || active.Status != tenancy.OrganizationActive {
		t.Fatalf("Reactivate() = %#v, %v", active, err)
	}
{{- else}}
	if err := members.Remove(ctx, memberUser.ID, adminPrincipal); err != nil {
		t.Fatalf("Remove() error = %v", err)
	}
	if err := members.Remove(ctx, user.ID, adminPrincipal); !errors.Is(err, tenancy.ErrLastAdministrator) {
		t.Fatalf("Remove(last administrator) error = %v, want ErrLastAdministrator", err)
	}
{{- end}}
	var deniedMemberAudit int
	if err := pool.QueryRow(ctx, `
		select count(*) from audit_events
		where action = 'tenancy.member.remove' and outcome = 'denied' and target = $1`, organizationID+":"+{{if .TenancyLifecycle}}memberUser.ID{{else}}user.ID{{end}}).Scan(&deniedMemberAudit); err != nil || deniedMemberAudit != 1 {
		t.Fatalf("denied member audit count = %d, %v, want 1", deniedMemberAudit, err)
	}
{{- end}}
{{- end}}

{{- if .Catalog}}
	for _, permission := range []string{"catalog:products:read", "catalog:products:write"} {
		allowed, err := identityStore.HasPermission(ctx, "admin", permission)
		if err != nil || !allowed {
			t.Fatalf("HasPermission(admin, %s) = %t, %v", permission, allowed, err)
		}
		allowed, err = identityStore.HasPermission(ctx, "user", permission)
		if err != nil || allowed {
			t.Fatalf("HasPermission(user, %s) = %t, %v, want denied", permission, allowed, err)
		}
	}
	catalogStore := catalogpostgres.New(pool)
	rolledBackProduct := catalog.Product{
		ID: "catalog-rolled-back", OrganizationID: organizationID, SKU: "ROLLBACK-1",
		Name: "Rolled back", PriceMinor: 1, Currency: "USD", Status: catalog.StatusDraft,
		Version: 1, CreatedAt: now, UpdatedAt: now,
	}
	if err := catalogStore.Create(ctx, rolledBackProduct, duplicateAudit); err == nil {
		t.Fatal("catalog Create(duplicate audit) error = nil, want transaction failure")
	}
	if _, err := catalogStore.Get(ctx, organizationID, rolledBackProduct.ID); !errors.Is(err, catalog.ErrNotFound) {
		t.Fatalf("catalog Get(rolled-back) error = %v, want ErrNotFound", err)
	}
	catalogService := catalog.NewService(catalogStore)
	catalogActor := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	product, err := catalogService.Create(ctx, catalog.WriteInput{
		SKU: " sku-100 ", Name: " Field notebook ", Description: " Recycled paper ",
		PriceMinor: 1299, Currency: " usd ",
	}, catalogActor)
	if err != nil || product.SKU != "SKU-100" || product.Status != catalog.StatusDraft {
		t.Fatalf("catalog Create() = %#v, %v", product, err)
	}
	if _, err := catalogService.Create(ctx, catalog.WriteInput{
		SKU: "SKU-100", Name: "Duplicate", PriceMinor: 1, Currency: "USD",
	}, catalogActor); !errors.Is(err, catalog.ErrConflict) {
		t.Fatalf("catalog Create(duplicate SKU) error = %v, want ErrConflict", err)
	}
	product, err = catalogService.Publish(ctx, product.ID, catalog.TransitionInput{Version: product.Version}, catalogActor)
	if err != nil || product.Status != catalog.StatusActive || product.Version != 2 {
		t.Fatalf("catalog Publish() = %#v, %v", product, err)
	}
	if publicProduct, err := catalogService.GetPublic(ctx, organizationID, product.ID); err != nil || publicProduct.ID != product.ID {
		t.Fatalf("catalog GetPublic() = %#v, %v", publicProduct, err)
	}
{{- if .TenancyLifecycle}}
	if _, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("catalog Deactivate() error = %v", err)
	}
	if _, err := catalogService.GetPublic(ctx, organizationID, product.ID); !errors.Is(err, catalog.ErrNotFound) {
		t.Fatalf("catalog GetPublic(inactive organization) error = %v, want ErrNotFound", err)
	}
	if _, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("catalog Reactivate() error = %v", err)
	}
{{- end}}
	product, err = catalogService.Update(ctx, product.ID, catalog.UpdateInput{
		WriteInput: catalog.WriteInput{SKU: product.SKU, Name: product.Name, Description: product.Description, PriceMinor: 1399, Currency: product.Currency},
		Version: product.Version,
	}, catalogActor)
	if err != nil || product.PriceMinor != 1399 || product.Version != 3 {
		t.Fatalf("catalog Update() = %#v, %v", product, err)
	}
	if _, err := catalogService.Update(ctx, product.ID, catalog.UpdateInput{
		WriteInput: catalog.WriteInput{SKU: product.SKU, Name: product.Name, PriceMinor: 1, Currency: product.Currency}, Version: 2,
	}, catalogActor); !errors.Is(err, catalog.ErrConflict) {
		t.Fatalf("catalog Update(stale) error = %v, want ErrConflict", err)
	}
	product, err = catalogService.Archive(ctx, product.ID, catalog.TransitionInput{Version: product.Version}, catalogActor)
	if err != nil || product.Status != catalog.StatusArchived || product.Version != 4 {
		t.Fatalf("catalog Archive() = %#v, %v", product, err)
	}
	if _, err := catalogService.GetPublic(ctx, organizationID, product.ID); !errors.Is(err, catalog.ErrNotFound) {
		t.Fatalf("catalog GetPublic(archived) error = %v, want ErrNotFound", err)
	}
{{- end}}

{{- if .CustomerAccounts}}
	for _, permission := range []string{"customers:accounts:read", "customers:accounts:manage"} {
		allowed, err := identityStore.HasPermission(ctx, "admin", permission)
		if err != nil || !allowed {
			t.Fatalf("HasPermission(admin, %s) = %t, %v", permission, allowed, err)
		}
		allowed, err = identityStore.HasPermission(ctx, "user", permission)
		if err != nil || allowed {
			t.Fatalf("HasPermission(user, %s) = %t, %v, want denied", permission, allowed, err)
		}
	}
	customerStore := customerpostgres.New(pool)
	rolledBackDigest := sha256.Sum256([]byte("rolled-back-customer-session"))
	rolledBackCustomer := customeraccounts.Account{
		ID: "customer-rolled-back", OrganizationID: organizationID,
		Email: "rolled-back@example.com", PasswordHash: "integration-only-hash",
		DisplayName: "Rolled Back", Status: customeraccounts.StatusActive,
		Version: 1, CreatedAt: now, UpdatedAt: now,
	}
	if err := customerStore.Register(ctx, rolledBackCustomer, customeraccounts.Session{
		TokenHash: rolledBackDigest[:], CustomerID: rolledBackCustomer.ID, ExpiresAt: now.Add(time.Hour),
	}, duplicateAudit); err == nil {
		t.Fatal("customer Register(duplicate audit) error = nil, want transaction failure")
	}
	if _, err := customerStore.Get(ctx, organizationID, rolledBackCustomer.ID); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer Get(rolled-back) error = %v, want ErrNotFound", err)
	}

	customerDigest := sha256.Sum256([]byte("active-customer-session"))
	customer := customeraccounts.Account{
		ID: "integration-customer", OrganizationID: organizationID,
		Email: "customer@example.com", PasswordHash: "integration-only-hash",
		DisplayName: "Integration Customer", Status: customeraccounts.StatusActive,
		Version: 1, CreatedAt: now, UpdatedAt: now,
	}
	if err := customerStore.Register(ctx, customer, customeraccounts.Session{
		TokenHash: customerDigest[:], CustomerID: customer.ID, ExpiresAt: now.Add(time.Hour),
	}, audit("", "customer.register", customer.ID, now)); err != nil {
		t.Fatalf("customer Register() error = %v", err)
	}
	loadedCustomer, err := customerStore.AccountByEmail(ctx, organizationID, customer.Email)
	if err != nil || loadedCustomer.ID != customer.ID || loadedCustomer.Status != customeraccounts.StatusActive {
		t.Fatalf("customer AccountByEmail() = %#v, %v", loadedCustomer, err)
	}
	if authenticated, err := customerStore.AccountBySession(ctx, organizationID, customerDigest[:], now); err != nil || authenticated.ID != customer.ID {
		t.Fatalf("customer AccountBySession() = %#v, %v", authenticated, err)
	}
{{- if .Tenancy}}
	if _, err := customerStore.Get(ctx, "different-organization", customer.ID); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer Get(cross-organization) error = %v, want ErrNotFound", err)
	}
{{- end}}
{{- if .TenancyLifecycle}}
	if _, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("customer Deactivate() error = %v", err)
	}
	if _, err := customerStore.AccountBySession(ctx, organizationID, customerDigest[:], now); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer AccountBySession(inactive organization) error = %v, want ErrNotFound", err)
	}
	if _, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("customer Reactivate organization() error = %v", err)
	}
{{- end}}
	updatedCustomer, err := customerStore.UpdateProfile(
		ctx, organizationID, customer.ID, "Updated Customer", customer.Version, now.Add(time.Second),
		audit("", "customer.profile.update", customer.ID, now.Add(time.Second)),
	)
	if err != nil || updatedCustomer.DisplayName != "Updated Customer" || updatedCustomer.Version != 2 {
		t.Fatalf("customer UpdateProfile() = %#v, %v", updatedCustomer, err)
	}
	if _, err := customerStore.UpdateProfile(
		ctx, organizationID, customer.ID, "Stale", customer.Version, now.Add(2*time.Second),
		audit("", "customer.profile.update", customer.ID, now.Add(2*time.Second)),
	); !errors.Is(err, customeraccounts.ErrConflict) {
		t.Fatalf("customer UpdateProfile(stale) error = %v, want ErrConflict", err)
	}
	staffActor := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	customerService := customeraccounts.NewService(customerStore)
	suspendedCustomer, err := customerService.Suspend(
		ctx, customer.ID, customeraccounts.TransitionInput{Version: updatedCustomer.Version}, staffActor,
	)
	if err != nil || suspendedCustomer.Status != customeraccounts.StatusSuspended || suspendedCustomer.Version != 3 {
		t.Fatalf("customer Suspend() = %#v, %v", suspendedCustomer, err)
	}
	if _, err := customerStore.AccountBySession(ctx, organizationID, customerDigest[:], now); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer AccountBySession(suspended) error = %v, want ErrNotFound", err)
	}
	reactivatedCustomer, err := customerService.Reactivate(
		ctx, customer.ID, customeraccounts.TransitionInput{Version: suspendedCustomer.Version}, staffActor,
	)
	if err != nil || reactivatedCustomer.Status != customeraccounts.StatusActive || reactivatedCustomer.Version != 4 {
		t.Fatalf("customer Reactivate() = %#v, %v", reactivatedCustomer, err)
	}
	passwordDigest := sha256.Sum256([]byte("password-change-session"))
	if err := customerStore.CreateSession(ctx, customeraccounts.Session{
		TokenHash: passwordDigest[:], CustomerID: customer.ID, ExpiresAt: now.Add(time.Hour),
	}, audit("", "customer.login", customer.ID, now)); err != nil {
		t.Fatalf("customer CreateSession() error = %v", err)
	}
	passwordChanged, err := customerStore.ChangePassword(
		ctx, organizationID, customer.ID, "changed-integration-hash", reactivatedCustomer.Version,
		now.Add(3*time.Second), audit("", "customer.password.change", customer.ID, now.Add(3*time.Second)),
	)
	if err != nil || passwordChanged.PasswordHash != "changed-integration-hash" || passwordChanged.Version != 5 {
		t.Fatalf("customer ChangePassword() = %#v, %v", passwordChanged, err)
	}
	if _, err := customerStore.AccountBySession(ctx, organizationID, passwordDigest[:], now); !errors.Is(err, customeraccounts.ErrNotFound) {
		t.Fatalf("customer AccountBySession(password changed) error = %v, want ErrNotFound", err)
	}
	listedCustomers, nextCustomerCursor, err := customerStore.List(ctx, organizationID, customeraccounts.StatusActive, "", 20)
	if err != nil || len(listedCustomers) != 1 || listedCustomers[0].ID != customer.ID || nextCustomerCursor != "" {
		t.Fatalf("customer List() = %#v, %q, %v", listedCustomers, nextCustomerCursor, err)
	}
	var customerAuditCount int
	if err := pool.QueryRow(ctx, `select count(*) from audit_events where target = $1 and action like 'customer%'`, customer.ID).Scan(&customerAuditCount); err != nil || customerAuditCount < 5 {
		t.Fatalf("customer audit count = %d, %v, want at least 5", customerAuditCount, err)
	}
{{- end}}

{{- if .Commerce}}
	for _, permission := range []string{"commerce:orders:read", "commerce:fulfillment:manage", "commerce:marketing:manage", "commerce:payments:manage"} {
		allowed, err := identityStore.HasPermission(ctx, "admin", permission)
		if err != nil || !allowed { t.Fatalf("HasPermission(admin, %s) = %t, %v", permission, allowed, err) }
		allowed, err = identityStore.HasPermission(ctx, "user", permission)
		if err != nil || allowed { t.Fatalf("HasPermission(user, %s) = %t, %v, want denied", permission, allowed, err) }
	}
	commerceProduct, err := catalogService.Create(ctx, catalog.WriteInput{SKU:"COMMERCE-1",Name:"Commerce product",PriceMinor:1399,Currency:"USD"}, catalogActor)
	if err != nil { t.Fatalf("commerce catalog Create() error = %v", err) }
	commerceProduct, err = catalogService.Publish(ctx, commerceProduct.ID, catalog.TransitionInput{Version:commerceProduct.Version}, catalogActor)
	if err != nil { t.Fatalf("commerce catalog Publish() error = %v", err) }
	commerceStore := commercepostgres.New(pool)
	commerceGateway := sandbox.New()
	commerceService := commerce.NewService(commerceStore, catalogService, commerceGateway)
	commerceActor := identity.Principal{UserID:user.ID,Email:user.Email,Role:"admin",OrganizationID:organizationID}
	campaign, err := commerceService.CreateCampaign(ctx, commerce.CampaignInput{Name:"Integration promotion",Kind:commerce.DiscountPercent,Value:1000,MinimumMinor:1000,Currency:"USD",Priority:10,CouponRequired:true,StartsAt:now.Add(-time.Hour),EndsAt:now.Add(time.Hour)}, commerceActor)
	if err != nil { t.Fatalf("commerce CreateCampaign() error = %v", err) }
	campaign, err = commerceService.ActivateCampaign(ctx, campaign.ID, commerce.TransitionInput{Version:campaign.Version}, commerceActor)
	if err != nil || campaign.Status != commerce.CampaignActive { t.Fatalf("commerce ActivateCampaign() = %#v, %v", campaign, err) }
	if _, err := commerceService.CreateCoupon(ctx, commerce.CouponInput{CampaignID:campaign.ID,Code:"SAVE10",MaximumUses:2}, commerceActor); err != nil { t.Fatalf("commerce CreateCoupon() error = %v", err) }
	cart, err := commerceService.PutLine(ctx, customer, commerceProduct.ID, commerce.LineInput{Currency:"USD",Quantity:2,Version:0})
	if err != nil || cart.SubtotalMinor != 2798 || cart.Version != 1 { t.Fatalf("commerce PutLine() = %#v, %v", cart, err) }
	checkoutInput := commerce.CheckoutInput{Currency:"USD",CouponCode:"SAVE10",IdempotencyKey:"checkout-integration",Version:cart.Version}
	order, err := commerceService.Checkout(ctx, customer, checkoutInput)
	if err != nil || order.DiscountMinor != 279 || order.TotalMinor != 2519 || order.Status != commerce.OrderPendingPayment { t.Fatalf("commerce Checkout() = %#v, %v", order, err) }
	checkoutReplay, err := commerceService.Checkout(ctx, customer, checkoutInput)
	if err != nil || !reflect.DeepEqual(checkoutReplay, order) { t.Fatalf("commerce Checkout(replay) = %#v, %v, want %#v", checkoutReplay, err, order) }
	if err := commerceGateway.Complete(order.Payment.ProviderRef, commerce.PaymentSucceeded); err != nil { t.Fatalf("sandbox Complete() error = %v", err) }
	paid, err := commerceService.CompletePayment(ctx, order.Payment.ProviderRef, commerce.PaymentEventInput{EventID:"payment-event-1",Status:commerce.PaymentSucceeded})
	if err != nil || paid.Status != commerce.OrderConfirmed { t.Fatalf("commerce CompletePayment() = %#v, %v", paid, err) }
	paidReplay, err := commerceService.CompletePayment(ctx, order.Payment.ProviderRef, commerce.PaymentEventInput{EventID:"payment-event-1",Status:commerce.PaymentSucceeded})
	if err != nil || !reflect.DeepEqual(paidReplay, paid) { t.Fatalf("commerce CompletePayment(replay) = %#v, %v", paidReplay, err) }
	refunded, err := commerceService.Refund(ctx, order.ID, commerce.RefundInput{AmountMinor:100,IdempotencyKey:"refund-1"}, commerceActor)
	if err != nil || refunded.Payment.RefundedMinor != 100 { t.Fatalf("commerce Refund() = %#v, %v", refunded, err) }
	refundReplay, err := commerceService.Refund(ctx, order.ID, commerce.RefundInput{AmountMinor:100,IdempotencyKey:"refund-1"}, commerceActor)
	if err != nil || refundReplay.Payment.RefundedMinor != 100 { t.Fatalf("commerce Refund(replay) = %#v, %v", refundReplay, err) }
	fulfilling, err := commerceService.StartFulfillment(ctx, order.ID, commerce.TransitionInput{Version:refunded.Version}, commerceActor)
	if err != nil { t.Fatalf("commerce StartFulfillment() error = %v", err) }
	fulfilled, err := commerceService.CompleteFulfillment(ctx, order.ID, commerce.TransitionInput{Version:fulfilling.Version,Reference:"TRACK-1"}, commerceActor)
	if err != nil || fulfilled.Status != commerce.OrderFulfilled { t.Fatalf("commerce CompleteFulfillment() = %#v, %v", fulfilled, err) }
	returnRequested, err := commerceService.RequestReturn(ctx, customer, order.ID, commerce.ReturnInput{Version:fulfilled.Version,Reason:"Damaged"})
	if err != nil || returnRequested.Status != commerce.OrderReturnRequested { t.Fatalf("commerce RequestReturn() = %#v, %v", returnRequested, err) }
	returned, err := commerceService.CompleteReturn(ctx, order.ID, commerce.TransitionInput{Version:returnRequested.Version}, commerceActor)
	if err != nil || returned.Status != commerce.OrderReturned { t.Fatalf("commerce CompleteReturn() = %#v, %v", returned, err) }
	if _, err := commerceStore.GetOrder(ctx, "different-organization", "", order.ID); !errors.Is(err, commerce.ErrNotFound) { t.Fatalf("commerce GetOrder(cross-tenant) error = %v", err) }
{{- end}}

{{- if .CRM}}
	for _, permission := range []string{"crm:read", "crm:write", "crm:pipeline:manage"} {
		allowed, err := identityStore.HasPermission(ctx, "admin", permission)
		if err != nil || !allowed {
			t.Fatalf("HasPermission(admin, %s) = %t, %v", permission, allowed, err)
		}
		allowed, err = identityStore.HasPermission(ctx, "user", permission)
		if err != nil || allowed {
			t.Fatalf("HasPermission(user, %s) = %t, %v, want denied", permission, allowed, err)
		}
	}
	crmStore := crmpostgres.New(pool)
	rolledBackAccount := crm.Account{
		ID: "crm-account-rolled-back", OrganizationID: organizationID, Name: "Rolled back",
		Status: crm.StatusActive, Version: 1, CreatedAt: now, UpdatedAt: now,
	}
	if err := crmStore.CreateAccount(ctx, rolledBackAccount, duplicateAudit); err == nil {
		t.Fatal("CRM CreateAccount(duplicate audit) error = nil, want transaction failure")
	}
	if _, err := crmStore.GetAccount(ctx, organizationID, rolledBackAccount.ID); !errors.Is(err, crm.ErrNotFound) {
		t.Fatalf("CRM GetAccount(rolled-back) error = %v, want ErrNotFound", err)
	}
	crmService := crm.NewService(crmStore)
	crmActor := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	account, err := crmService.CreateAccount(ctx, crm.AccountWrite{Name: " Integration Account "}, crmActor)
	if err != nil || account.Name != "Integration Account" || account.Status != crm.StatusActive {
		t.Fatalf("CRM CreateAccount() = %#v, %v", account, err)
	}
	contact, err := crmService.CreateContact(ctx, crm.ContactWrite{
		AccountID: account.ID, Name: " Integration Contact ", Email: " CONTACT@EXAMPLE.COM ", Phone: " +1 555 ",
	}, crmActor)
	if err != nil || contact.Email != "contact@example.com" || contact.AccountID != account.ID {
		t.Fatalf("CRM CreateContact() = %#v, %v", contact, err)
	}
	activity, err := crmService.CreateActivity(ctx, crm.ActivityWrite{
		SubjectType: crm.SubjectContact, SubjectID: contact.ID, Type: crm.ActivityMeeting,
		Summary: " Integration meeting ", OccurredAt: now.Add(-time.Hour),
	}, crmActor)
	if err != nil || activity.SubjectID != contact.ID || activity.Summary != "Integration meeting" {
		t.Fatalf("CRM CreateActivity() = %#v, %v", activity, err)
	}
	opportunity, err := crmService.CreateOpportunity(ctx, crm.OpportunityWrite{
		AccountID: account.ID, Name: " Integration Deal ", AmountMinor: "12500", Currency: "usd",
	}, crmActor)
	if err != nil || opportunity.Stage != crm.StageLead || opportunity.AmountMinor != 12500 || opportunity.Currency != "USD" {
		t.Fatalf("CRM CreateOpportunity() = %#v, %v", opportunity, err)
	}
	if _, err := crmService.AdvanceOpportunity(ctx, opportunity.ID, crm.StageInput{Stage: crm.StageWon, Version: opportunity.Version}, crmActor); !errors.Is(err, crm.ErrConflict) {
		t.Fatalf("CRM AdvanceOpportunity(skip) error = %v, want ErrConflict", err)
	}
	for _, stage := range []crm.OpportunityStage{crm.StageQualified, crm.StageProposal, crm.StageWon} {
		opportunity, err = crmService.AdvanceOpportunity(ctx, opportunity.ID, crm.StageInput{Stage: stage, Version: opportunity.Version}, crmActor)
		if err != nil || opportunity.Stage != stage {
			t.Fatalf("CRM AdvanceOpportunity(%s) = %#v, %v", stage, opportunity, err)
		}
	}
	if _, err := crmService.UpdateOpportunity(ctx, opportunity.ID, crm.OpportunityUpdate{
		AccountID: account.ID, Name: opportunity.Name, AmountMinor: "1", Currency: "USD", Version: opportunity.Version,
	}, crmActor); !errors.Is(err, crm.ErrConflict) {
		t.Fatalf("CRM UpdateOpportunity(terminal) error = %v, want ErrConflict", err)
	}
	listedActivities, nextActivityCursor, err := crmStore.ListActivities(ctx, organizationID, crm.SubjectContact, contact.ID, "", 20)
	if err != nil || len(listedActivities) != 1 || listedActivities[0].ID != activity.ID || nextActivityCursor != "" {
		t.Fatalf("CRM ListActivities() = %#v, %q, %v", listedActivities, nextActivityCursor, err)
	}
{{- if .Tenancy}}
	if _, err := crmStore.GetAccount(ctx, "different-organization", account.ID); !errors.Is(err, crm.ErrNotFound) {
		t.Fatalf("CRM GetAccount(cross-organization) error = %v, want ErrNotFound", err)
	}
{{- end}}
{{- if .TenancyLifecycle}}
	if _, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("CRM Deactivate() error = %v", err)
	}
	if _, err := crmService.GetAccount(ctx, account.ID, crmActor); !errors.Is(err, crm.ErrNotFound) {
		t.Fatalf("CRM GetAccount(inactive organization) error = %v, want ErrNotFound", err)
	}
	if _, err := crmService.CreateAccount(ctx, crm.AccountWrite{Name: "Blocked"}, crmActor); !errors.Is(err, crm.ErrNotFound) {
		t.Fatalf("CRM CreateAccount(inactive organization) error = %v, want ErrNotFound", err)
	}
	if _, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal); err != nil {
		t.Fatalf("CRM Reactivate organization() error = %v", err)
	}
{{- end}}
	var crmAuditCount int
	if err := pool.QueryRow(ctx, `select count(*) from audit_events where action like 'crm:%'`).Scan(&crmAuditCount); err != nil || crmAuditCount < 7 {
		t.Fatalf("CRM audit count = %d, %v, want at least 7", crmAuditCount, err)
	}
{{- end}}

{{- if .Inventory}}
	for _, permission := range []string{"inventory:read", "inventory:catalog:write", "inventory:stock:manage", "inventory:procurement:manage"} {
		allowed, err := identityStore.HasPermission(ctx, "admin", permission)
		if err != nil || !allowed { t.Fatalf("HasPermission(admin, %s) = %t, %v", permission, allowed, err) }
		allowed, err = identityStore.HasPermission(ctx, "user", permission)
		if err != nil || allowed { t.Fatalf("HasPermission(user, %s) = %t, %v, want denied", permission, allowed, err) }
	}
	inventoryStore := inventorypostgres.New(pool)
	inventoryService := inventory.NewService(inventoryStore)
	inventoryActor := identity.Principal{UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID}
	rolledBackItem := inventory.Item{ID:"inventory-rolled-back",OrganizationID:organizationID,SKU:"ROLLBACK",Name:"Rolled back",Unit:"EA",Status:inventory.StatusActive,Version:1,CreatedAt:now,UpdatedAt:now}
	if err := inventoryStore.CreateItem(ctx, rolledBackItem, duplicateAudit); err == nil { t.Fatal("inventory CreateItem(duplicate audit) error = nil, want transaction failure") }
	if _, err := inventoryStore.GetItem(ctx, organizationID, rolledBackItem.ID); !errors.Is(err, inventory.ErrNotFound) { t.Fatalf("inventory GetItem(rolled-back) error = %v", err) }
	item, err := inventoryService.CreateItem(ctx, inventory.ItemWrite{SKU:" sku-1 ",Name:" Integration Widget ",Unit:" ea "}, inventoryActor)
	if err != nil || item.SKU != "SKU-1" || item.Unit != "EA" { t.Fatalf("inventory CreateItem() = %#v, %v", item, err) }
	warehouse, err := inventoryService.CreateWarehouse(ctx, inventory.WarehouseWrite{Code:" main ",Name:" Main Warehouse "}, inventoryActor)
	if err != nil || warehouse.Code != "MAIN" { t.Fatalf("inventory CreateWarehouse() = %#v, %v", warehouse, err) }
	adjustmentInput := inventory.AdjustmentInput{ItemID:item.ID,WarehouseID:warehouse.ID,QuantityDelta:"100",Reason:"opening stock",IdempotencyKey:"adjust-opening"}
	adjusted, err := inventoryService.AdjustStock(ctx, adjustmentInput, inventoryActor)
	if err != nil || adjusted.Balance.OnHand != 100 || adjusted.Balance.Available != 100 { t.Fatalf("inventory AdjustStock() = %#v, %v", adjusted, err) }
	adjustedReplay, err := inventoryService.AdjustStock(ctx, adjustmentInput, inventoryActor)
	if err != nil || !reflect.DeepEqual(adjustedReplay, adjusted) { t.Fatalf("inventory AdjustStock(replay) = %#v, %v, want %#v", adjustedReplay, err, adjusted) }
	conflictingAdjustment := adjustmentInput; conflictingAdjustment.QuantityDelta = "1"
	if _, err := inventoryService.AdjustStock(ctx, conflictingAdjustment, inventoryActor); !errors.Is(err, inventory.ErrConflict) { t.Fatalf("inventory AdjustStock(conflicting replay) error = %v", err) }
	reservationInput := inventory.ReservationWrite{ExternalReference:"order-1",ItemID:item.ID,WarehouseID:warehouse.ID,Quantity:"30",IdempotencyKey:"reserve-order-1"}
	reserved, err := inventoryService.CreateReservation(ctx, reservationInput, inventoryActor)
	if err != nil || reserved.Balance.Reserved != 30 || reserved.Balance.Available != 70 { t.Fatalf("inventory CreateReservation() = %#v, %v", reserved, err) }
	reservedReplay, err := inventoryService.CreateReservation(ctx, reservationInput, inventoryActor)
	if err != nil || !reflect.DeepEqual(reservedReplay, reserved) { t.Fatalf("inventory CreateReservation(replay) = %#v, %v", reservedReplay, err) }
	if _, err := inventoryService.CreateReservation(ctx, inventory.ReservationWrite{ExternalReference:"order-too-large",ItemID:item.ID,WarehouseID:warehouse.ID,Quantity:"71",IdempotencyKey:"reserve-too-large"}, inventoryActor); !errors.Is(err, inventory.ErrConflict) { t.Fatalf("inventory CreateReservation(over available) error = %v", err) }
	consumed, err := inventoryService.ConsumeReservation(ctx, reserved.Reservation.ID, inventory.ReservationTransition{Version:reserved.Reservation.Version,IdempotencyKey:"consume-order-1"}, inventoryActor)
	if err != nil || consumed.Balance.OnHand != 70 || consumed.Balance.Reserved != 0 { t.Fatalf("inventory ConsumeReservation() = %#v, %v", consumed, err) }
	purchase, err := inventoryService.CreatePurchaseOrder(ctx, inventory.PurchaseOrderWrite{Number:" po-1 ",SupplierName:" Integration Supplier ",Lines:[]inventory.PurchaseOrderLineWrite{ {ItemID:item.ID,OrderedQuantity:"50"} }}, inventoryActor)
	if err != nil || purchase.Status != inventory.PurchaseDraft { t.Fatalf("inventory CreatePurchaseOrder() = %#v, %v", purchase, err) }
	purchase, err = inventoryService.SubmitPurchaseOrder(ctx, purchase.ID, inventory.TransitionInput{Version:purchase.Version}, inventoryActor)
	if err != nil || purchase.Status != inventory.PurchaseSubmitted { t.Fatalf("inventory SubmitPurchaseOrder() = %#v, %v", purchase, err) }
	firstReceiptInput := inventory.ReceiptInput{LineID:purchase.Lines[0].ID,WarehouseID:warehouse.ID,Quantity:"20",IdempotencyKey:"receive-po-1-a",Version:purchase.Version}
	firstReceipt, err := inventoryService.ReceivePurchaseOrder(ctx, purchase.ID, firstReceiptInput, inventoryActor)
	if err != nil || firstReceipt.PurchaseOrder.Status != inventory.PurchasePartiallyReceived || firstReceipt.Balance.OnHand != 90 { t.Fatalf("inventory ReceivePurchaseOrder(partial) = %#v, %v", firstReceipt, err) }
	firstReceiptReplay, err := inventoryService.ReceivePurchaseOrder(ctx, purchase.ID, firstReceiptInput, inventoryActor)
	if err != nil || !reflect.DeepEqual(firstReceiptReplay, firstReceipt) { t.Fatalf("inventory ReceivePurchaseOrder(replay) = %#v, %v", firstReceiptReplay, err) }
	finalReceipt, err := inventoryService.ReceivePurchaseOrder(ctx, purchase.ID, inventory.ReceiptInput{LineID:purchase.Lines[0].ID,WarehouseID:warehouse.ID,Quantity:"30",IdempotencyKey:"receive-po-1-b",Version:firstReceipt.PurchaseOrder.Version}, inventoryActor)
	if err != nil || finalReceipt.PurchaseOrder.Status != inventory.PurchaseReceived || finalReceipt.Balance.OnHand != 120 { t.Fatalf("inventory ReceivePurchaseOrder(final) = %#v, %v", finalReceipt, err) }
	if _, err := inventoryService.AdjustStock(ctx, inventory.AdjustmentInput{ItemID:item.ID,WarehouseID:warehouse.ID,QuantityDelta:"-121",Reason:"invalid negative",IdempotencyKey:"adjust-invalid"}, inventoryActor); !errors.Is(err, inventory.ErrConflict) { t.Fatalf("inventory AdjustStock(below zero) error = %v", err) }
	movements, _, err := inventoryStore.ListMovements(ctx, organizationID, item.ID, warehouse.ID, "", 20)
	if err != nil || len(movements) != 5 { t.Fatalf("inventory ListMovements() = %d, %v, want 5", len(movements), err) }
{{- if .Tenancy}}
	if _, err := inventoryStore.GetItem(ctx, "different-organization", item.ID); !errors.Is(err, inventory.ErrNotFound) { t.Fatalf("inventory GetItem(cross-organization) error = %v", err) }
{{- end}}
{{- if .TenancyLifecycle}}
	if _, err := lifecycle.Deactivate(ctx, organizationID, ownerPrincipal); err != nil { t.Fatalf("inventory Deactivate() error = %v", err) }
	if _, err := inventoryService.AdjustStock(ctx, adjustmentInput, inventoryActor); !errors.Is(err, inventory.ErrNotFound) { t.Fatalf("inventory AdjustStock(replay inactive organization) error = %v", err) }
	if _, err := lifecycle.Reactivate(ctx, organizationID, ownerPrincipal); err != nil { t.Fatalf("inventory Reactivate organization() error = %v", err) }
{{- end}}
	var inventoryAuditCount int
	if err := pool.QueryRow(ctx, `select count(*) from audit_events where action like 'inventory:%'`).Scan(&inventoryAuditCount); err != nil || inventoryAuditCount < 9 { t.Fatalf("inventory audit count = %d, %v, want at least 9", inventoryAuditCount, err) }
{{- end}}

{{- if .Files}}
	fileBlobs, err := local.New(t.TempDir())
	if err != nil {
		t.Fatalf("local.New() error = %v", err)
	}
	fileService := files.NewService(filespostgres.New(pool), fileBlobs)
	fileActor := identity.Principal{UserID: user.ID, OrganizationID: organizationID}
	fileAsset, err := fileService.Upload(ctx, files.UploadInput{
		Name: "integration.txt", MediaType: "text/plain", Content: bytes.NewBufferString("file integration"),
	}, fileActor)
	if err != nil {
		t.Fatalf("files.Upload() error = %v", err)
	}
	loadedAsset, fileReader, err := fileService.Open(ctx, fileAsset.ID, fileActor)
	if err != nil {
		t.Fatalf("files.Open() error = %v", err)
	}
	fileContent, readErr := io.ReadAll(fileReader)
	_ = fileReader.Close()
	if readErr != nil || loadedAsset.SHA256 != fileAsset.SHA256 || string(fileContent) != "file integration" {
		t.Fatalf("files.Open() = %#v, %q, %v", loadedAsset, fileContent, readErr)
	}
{{- if .Tenancy}}
	if _, err := fileService.Get(ctx, fileAsset.ID, identity.Principal{UserID: user.ID, OrganizationID: "different-organization"}); !errors.Is(err, files.ErrNotFound) {
		t.Fatalf("files.Get(cross-tenant) error = %v, want ErrNotFound", err)
	}
{{- end}}
	if err := fileService.Delete(ctx, fileAsset.ID, fileActor); err != nil {
		t.Fatalf("files.Delete() error = %v", err)
	}
	if _, err := fileService.Get(ctx, fileAsset.ID, fileActor); !errors.Is(err, files.ErrNotFound) {
		t.Fatalf("files.Get(deleted) error = %v, want ErrNotFound", err)
	}
{{- end}}

{{- if .Cache}}
	cacheStore := cachepostgres.New(pool)
	cacheService := applicationcache.NewService(cacheStore)
	if err := cacheService.Set(ctx, organizationID, "integration:key", map[string]string{"value": "cached"}, time.Hour); err != nil {
		t.Fatalf("cache.Set() error = %v", err)
	}
	var cachedValue map[string]string
	if err := cacheService.Decode(ctx, organizationID, "integration:key", &cachedValue); err != nil || cachedValue["value"] != "cached" {
		t.Fatalf("cache.Decode() = %#v, %v", cachedValue, err)
	}
{{- if .Tenancy}}
	if _, err := cacheService.Get(ctx, "different-organization", "integration:key"); !errors.Is(err, applicationcache.ErrMiss) {
		t.Fatalf("cache.Get(cross-tenant) error = %v, want ErrMiss", err)
	}
{{- end}}
	if err := cacheStore.Set(ctx, applicationcache.Entry{
		ScopeKey: {{if .Tenancy}}organizationID{{else}}"global"{{end}}, Key: "expired", Value: json.RawMessage(`{"expired":true}`), ExpiresAt: now.Add(-time.Minute),
	}); err != nil {
		t.Fatalf("cache.Store.Set(expired) error = %v", err)
	}
	if count, err := cacheService.PurgeExpired(ctx, 100); err != nil || count != 1 {
		t.Fatalf("cache.PurgeExpired() = %d, %v, want 1", count, err)
	}
	if err := cacheService.Delete(ctx, organizationID, "integration:key"); err != nil {
		t.Fatalf("cache.Delete() error = %v", err)
	}
{{- end}}

{{- if .Jobs}}
	jobStore := jobspostgres.New(pool)
	jobService := jobs.NewService(jobStore)
{{- if .Notifications}}
	notificationService := notifications.NewService(jobService)
	queued, err := notificationService.EnqueueEmail(ctx, organizationID, "integration-request", notifications.Email{
		To: "person@example.com", Subject: "Integration", TextBody: "Queued by integration test",
	})
	if err != nil {
		t.Fatalf("EnqueueEmail() error = %v", err)
	}
	duplicate, err := notificationService.EnqueueEmail(ctx, organizationID, "integration-request", notifications.Email{
		To: "person@example.com", Subject: "Integration", TextBody: "Queued by integration test",
	})
{{- else}}
	jobInput := jobs.EnqueueInput{
		Type: "system.noop", Payload: json.RawMessage(`{"source":"integration"}`),
		IdempotencyKey: "integration-request", MaxAttempts: 3,
	}
	queued, err := jobService.Enqueue(ctx, organizationID, jobInput)
	if err != nil {
		t.Fatalf("Enqueue() error = %v", err)
	}
	duplicate, err := jobService.Enqueue(ctx, organizationID, jobInput)
{{- end}}
	if err != nil || duplicate.ID != queued.ID {
		t.Fatalf("Enqueue(duplicate) = %#v, %v, want %s", duplicate, err, queued.ID)
	}
	leased, err := jobService.LeaseNext(ctx, "worker-1", 30*time.Second)
	if err != nil || leased.ID != queued.ID || leased.Attempts != 1 || leased.OrganizationID != organizationID {
		t.Fatalf("LeaseNext() = %#v, %v", leased, err)
	}
	if err := jobService.Fail(ctx, leased, "worker-1", errors.New("retry integration job")); err != nil {
		t.Fatalf("Fail() error = %v", err)
	}
	retryNow := time.Now().UTC().Add(time.Hour)
	retried, err := jobStore.LeaseNext(ctx, "worker-2", retryNow, retryNow.Add(30*time.Second))
	if err != nil || retried.ID != queued.ID || retried.Attempts != 2 {
		t.Fatalf("LeaseNext(retry) = %#v, %v", retried, err)
	}
	if err := jobService.Complete(ctx, retried.ID, "worker-2"); err != nil {
		t.Fatalf("Complete() error = %v", err)
	}
	if err := jobStore.Complete(ctx, retried.ID, "worker-2", time.Now().UTC()); !errors.Is(err, jobs.ErrLeaseLost) {
		t.Fatalf("Complete(after completion) error = %v, want ErrLeaseLost", err)
	}
{{- if .JobAdmin}}
	deadJob, err := jobService.Enqueue(ctx, organizationID, jobs.EnqueueInput{
		Type: "system.dead-test", Payload: json.RawMessage(`{"source":"job-admin-integration"}`),
		IdempotencyKey: "job-admin-dead", MaxAttempts: 1,
	})
	if err != nil {
		t.Fatalf("Enqueue(job admin) error = %v", err)
	}
	deadJob, err = jobService.LeaseNext(ctx, "worker-admin", 30*time.Second)
	if err != nil {
		t.Fatalf("LeaseNext(job admin) error = %v", err)
	}
	if err := jobService.Fail(ctx, deadJob, "worker-admin", errors.New("expected dead job")); err != nil {
		t.Fatalf("Fail(job admin) error = %v", err)
	}
	jobAdminService := jobadmin.NewService(jobStore)
	jobAdminActor := identity.Principal{UserID: user.ID, OrganizationID: organizationID}
	deadPage, err := jobAdminService.List(ctx, jobs.StatusDead, "", 20, jobAdminActor)
	if err != nil || len(deadPage.Items) != 1 || deadPage.Items[0].ID != deadJob.ID {
		t.Fatalf("jobadmin.List() = %#v, %v", deadPage, err)
	}
	requeued, err := jobAdminService.Retry(ctx, deadJob.ID, jobAdminActor)
	if err != nil || requeued.Status != jobs.StatusQueued || requeued.Attempts != 0 {
		t.Fatalf("jobadmin.Retry() = %#v, %v", requeued, err)
	}
{{- end}}
{{- end}}

{{- range .Business.Fields}}
	first{{.GoName}} := {{.SampleOne}}
	second{{.GoName}} := {{.SampleTwo}}
{{- end}}
	rolledBack := business.{{.Business.EntityType}}{
		ID: "rolled-back", OrganizationID: organizationID, Version: 1, CreatedAt: now, UpdatedAt: now,
{{- range .Business.Fields}}
		{{.GoName}}: {{if .Required}}first{{.GoName}}{{else}}&first{{.GoName}}{{end}},
{{- end}}
	}
	businessStore := businesspostgres.New(pool)
	if err := businessStore.Create(ctx, rolledBack, duplicateAudit); err == nil {
		t.Fatal("Create(with duplicate audit) error = nil, want transaction failure")
	}
	if _, err := businessStore.Get(ctx, organizationID, rolledBack.ID); !errors.Is(err, business.ErrNotFound) {
		t.Fatalf("Get(rolled-back) error = %v, want ErrNotFound", err)
	}

	created := rolledBack
	created.ID = "integration-record"
	if err := businessStore.Create(ctx, created, audit(user.ID, "{{.Business.PermissionPrefix}}:create", created.ID, now)); err != nil {
		t.Fatalf("Create() error = %v", err)
	}
	loaded, err := businessStore.Get(ctx, organizationID, created.ID)
	if err != nil {
		t.Fatalf("Get() error = %v", err)
	}
{{- if .Tenancy}}
	if _, err := businessStore.Get(ctx, "different-organization", created.ID); !errors.Is(err, business.ErrNotFound) {
		t.Fatalf("Get(cross-tenant) error = %v, want ErrNotFound", err)
	}
{{- end}}
	if loaded.ID != created.ID || loaded.Version != 1 || !loaded.CreatedAt.Equal(created.CreatedAt) {
		t.Fatalf("Get() = %#v, want created record", loaded)
	}
{{- range .Business.Fields}}
	if !reflect.DeepEqual(loaded.{{.GoName}}, created.{{.GoName}}) {
		t.Fatalf("Get().{{.GoName}} = %#v, want %#v", loaded.{{.GoName}}, created.{{.GoName}})
	}
{{- end}}
	page, cursor, err := businessStore.List(ctx, organizationID, "", 20)
	if err != nil || len(page) != 1 || cursor != "" || page[0].ID != created.ID {
		t.Fatalf("List() = %#v, %q, %v", page, cursor, err)
	}
{{- if .Approvals}}

	approvalReviewer := identity.User{
		ID: "approval-reviewer", Email: "approval-reviewer@example.com",
		PasswordHash: user.PasswordHash, Role: "admin",
	}
	if err := identityStore.CreateUser(ctx, approvalReviewer); err != nil {
		t.Fatalf("CreateUser(approval reviewer) error = %v", err)
	}
	approvalRequester := identity.Principal{
		UserID: user.ID, Email: user.Email, Role: "admin", OrganizationID: organizationID,
	}
{{- if .TenancyLifecycle}}
	approvalRequester = ownerPrincipal
{{- end}}
	approvalReviewerPrincipal := identity.Principal{
		UserID: approvalReviewer.ID, Email: approvalReviewer.Email, Role: "admin", OrganizationID: organizationID,
	}
{{- if .TenancyMembers}}
	reviewerInvitation, err := members.Invite(ctx, approvalReviewer.Email, "admin", approvalRequester)
	if err != nil {
		t.Fatalf("Invite(approval reviewer) error = %v", err)
	}
	if _, err := members.Accept(ctx, reviewerInvitation.AcceptanceToken, identity.Principal{
		UserID: approvalReviewer.ID, Email: approvalReviewer.Email, Role: "admin",
	}); err != nil {
		t.Fatalf("Accept(approval reviewer) error = %v", err)
	}
{{- end}}
	approvalService := approvals.NewService(approvalspostgres.New(pool))
	if _, err := approvalService.Submit(ctx, approvals.SubmitInput{
		SubjectID: "missing-subject", Summary: "Missing subject",
	}, approvalRequester); !errors.Is(err, approvals.ErrSubjectNotFound) {
		t.Fatalf("approvals.Submit(missing subject) error = %v, want ErrSubjectNotFound", err)
	}
	approvalRequest, err := approvalService.Submit(ctx, approvals.SubmitInput{
		SubjectID: created.ID, Summary: "Approve integration record", Details: "Portable approval evidence",
	}, approvalRequester)
	if err != nil || approvalRequest.Status != approvals.StatusPending || approvalRequest.Version != 1 {
		t.Fatalf("approvals.Submit() = %#v, %v", approvalRequest, err)
	}
	if _, err := approvalService.Submit(ctx, approvals.SubmitInput{
		SubjectID: created.ID, Summary: "Duplicate pending request",
	}, approvalRequester); !errors.Is(err, approvals.ErrConflict) {
		t.Fatalf("approvals.Submit(duplicate pending) error = %v, want ErrConflict", err)
	}
	if _, err := approvalService.Approve(ctx, approvalRequest.ID, approvals.DecisionInput{
		Version: approvalRequest.Version,
	}, approvalRequester); !errors.Is(err, approvals.ErrSelfDecision) {
		t.Fatalf("approvals.Approve(self) error = %v, want ErrSelfDecision", err)
	}
{{- if .Tenancy}}
	if _, err := approvalService.Get(ctx, approvalRequest.ID, identity.Principal{
		UserID: approvalReviewer.ID, Role: "admin", OrganizationID: "different-organization",
	}); !errors.Is(err, approvals.ErrNotFound) {
		t.Fatalf("approvals.Get(cross-tenant) error = %v, want ErrNotFound", err)
	}
{{- end}}
	mine, err := approvalService.ListMine(ctx, approvals.StatusPending, "", 20, approvalRequester)
	if err != nil || len(mine.Items) != 1 || mine.Items[0].ID != approvalRequest.ID {
		t.Fatalf("approvals.ListMine() = %#v, %v", mine, err)
	}
	approved, err := approvalService.Approve(ctx, approvalRequest.ID, approvals.DecisionInput{
		Version: approvalRequest.Version, Comment: "Approved in integration test",
	}, approvalReviewerPrincipal)
	if err != nil || approved.Status != approvals.StatusApproved || approved.Version != 2 ||
		approved.ResolvedByUserID != approvalReviewer.ID {
		t.Fatalf("approvals.Approve() = %#v, %v", approved, err)
	}
	if _, err := approvalService.Reject(ctx, approvalRequest.ID, approvals.DecisionInput{
		Version: approvalRequest.Version, Comment: "stale",
	}, approvalReviewerPrincipal); !errors.Is(err, approvals.ErrConflict) {
		t.Fatalf("approvals.Reject(stale) error = %v, want ErrConflict", err)
	}
	history, err := approvalService.History(ctx, approvalRequest.ID, approvalReviewerPrincipal)
	if err != nil || len(history.Items) != 2 || history.Items[0].Status != approvals.StatusPending ||
		history.Items[1].Status != approvals.StatusApproved {
		t.Fatalf("approvals.History() = %#v, %v", history, err)
	}
	withdrawal, err := approvalService.Submit(ctx, approvals.SubmitInput{
		SubjectID: created.ID, Summary: "Withdraw integration request",
	}, approvalRequester)
	if err != nil {
		t.Fatalf("approvals.Submit(withdrawal) error = %v", err)
	}
	if _, err := approvalService.Cancel(ctx, withdrawal.ID, approvals.DecisionInput{
		Version: withdrawal.Version,
	}, approvalReviewerPrincipal); !errors.Is(err, identity.ErrForbidden) {
		t.Fatalf("approvals.Cancel(non-requester) error = %v, want ErrForbidden", err)
	}
	cancelled, err := approvalService.Cancel(ctx, withdrawal.ID, approvals.DecisionInput{
		Version: withdrawal.Version, Comment: "No longer needed",
	}, approvalRequester)
	if err != nil || cancelled.Status != approvals.StatusCancelled || cancelled.Version != 2 {
		t.Fatalf("approvals.Cancel() = %#v, %v", cancelled, err)
	}
	var approvalAuditCount int
	if err := pool.QueryRow(ctx, `select count(*) from audit_events where action like 'approvals:%'`).Scan(&approvalAuditCount); err != nil {
		t.Fatalf("count approval audit events: %v", err)
	}
	if approvalAuditCount != 4 {
		t.Fatalf("approval audit count = %d, want 4", approvalAuditCount)
	}
{{- end}}

	replacement := loaded
{{- range .Business.Fields}}
	replacement.{{.GoName}} = {{if .Required}}second{{.GoName}}{{else}}&second{{.GoName}}{{end}}
{{- end}}
	replacement.UpdatedAt = now.Add(time.Minute)
	updated, err := businessStore.Update(ctx, replacement, audit(user.ID, "{{.Business.PermissionPrefix}}:update", created.ID, replacement.UpdatedAt))
	if err != nil || updated.Version != 2 {
		t.Fatalf("Update() = %#v, %v", updated, err)
	}
	if _, err := businessStore.Update(ctx, replacement, audit(user.ID, "{{.Business.PermissionPrefix}}:update", created.ID, now)); !errors.Is(err, business.ErrConflict) {
		t.Fatalf("Update(stale) error = %v, want ErrConflict", err)
	}
	if err := businessStore.Delete(ctx, organizationID, created.ID, updated.Version, audit(user.ID, "{{.Business.PermissionPrefix}}:delete", created.ID, now)); err != nil {
		t.Fatalf("Delete() error = %v", err)
	}
	if _, err := businessStore.Get(ctx, organizationID, created.ID); !errors.Is(err, business.ErrNotFound) {
		t.Fatalf("Get(deleted) error = %v, want ErrNotFound", err)
	}
	var mutationAuditCount int
	if err := pool.QueryRow(ctx, `select count(*) from audit_events where target = $1 and action like $2`, created.ID, "{{.Business.PermissionPrefix}}:%").Scan(&mutationAuditCount); err != nil {
		t.Fatalf("count mutation audit events: %v", err)
	}
	if mutationAuditCount != 3 {
		t.Fatalf("mutation audit count = %d, want 3", mutationAuditCount)
	}
{{- if .CSVTransfer}}

	transferStore := transferpostgres.New(pool)
	firstImported := business.{{.Business.EntityType}}{
		ID: "csv-import-one", OrganizationID: organizationID, Version: 1, CreatedAt: now, UpdatedAt: now,
{{- range .Business.Fields}}
		{{.GoName}}: {{if .Required}}first{{.GoName}}{{else}}&first{{.GoName}}{{end}},
{{- end}}
	}
	secondImported := firstImported
	secondImported.ID = firstImported.ID
	if err := transferStore.Import(ctx, []business.{{.Business.EntityType}}{firstImported, secondImported}, audit(user.ID, "{{.Business.PermissionPrefix}}:import", "2", now)); !errors.Is(err, business.ErrConflict) {
		t.Fatalf("transfer.Import(conflict) error = %v, want ErrConflict", err)
	}
	if _, err := businessStore.Get(ctx, organizationID, firstImported.ID); !errors.Is(err, business.ErrNotFound) {
		t.Fatalf("Get(rolled-back CSV row) error = %v, want ErrNotFound", err)
	}
	if err := transferStore.Import(ctx, []business.{{.Business.EntityType}}{firstImported}, audit(user.ID, "{{.Business.PermissionPrefix}}:import", "1", now)); err != nil {
		t.Fatalf("transfer.Import() error = %v", err)
	}
	exported, err := transferStore.Export(ctx, organizationID, businesstransfer.MaximumRows, audit(user.ID, "{{.Business.PermissionPrefix}}:export", "csv", now))
	if err != nil || len(exported) != 1 || exported[0].ID != firstImported.ID {
		t.Fatalf("transfer.Export() = %#v, %v", exported, err)
	}
{{- if .Tenancy}}
	crossTenant, err := transferStore.Export(ctx, "different-organization", businesstransfer.MaximumRows, audit(user.ID, "{{.Business.PermissionPrefix}}:export", "csv", now))
	if err != nil || len(crossTenant) != 0 {
		t.Fatalf("transfer.Export(cross-tenant) = %#v, %v", crossTenant, err)
	}
{{- end}}
{{- end}}
}

func isolatedPostgreSQL(t *testing.T) *pgxpool.Pool {
	t.Helper()
	databaseURL := strings.TrimSpace(os.Getenv("TEST_DATABASE_URL"))
	if databaseURL == "" {
		t.Skip("TEST_DATABASE_URL is not set")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()

	adminConfig, err := pgxpool.ParseConfig(databaseURL)
	if err != nil {
		t.Fatalf("parse TEST_DATABASE_URL: %v", err)
	}
	adminConfig.MaxConns = 2
	adminConfig.MinConns = 0
	adminPool, err := pgxpool.NewWithConfig(ctx, adminConfig)
	if err != nil {
		t.Fatalf("create administration pool: %v", err)
	}
	if err := adminPool.Ping(ctx); err != nil {
		adminPool.Close()
		t.Fatalf("ping PostgreSQL: %v", err)
	}
	t.Cleanup(adminPool.Close)

	schema := "scaffold_test_" + strings.ToLower(rand.Text())
	quotedSchema := pgx.Identifier{schema}.Sanitize()
	if _, err := adminPool.Exec(ctx, "create schema "+quotedSchema); err != nil {
		t.Fatalf("create isolated schema: %v", err)
	}
	t.Cleanup(func() {
		cleanupContext, cleanupCancel := context.WithTimeout(context.Background(), 15*time.Second)
		defer cleanupCancel()
		if _, err := adminPool.Exec(cleanupContext, "drop schema "+quotedSchema+" cascade"); err != nil {
			t.Errorf("drop isolated schema: %v", err)
		}
	})

	testConfig, err := pgxpool.ParseConfig(databaseURL)
	if err != nil {
		t.Fatalf("parse isolated pool configuration: %v", err)
	}
	if testConfig.ConnConfig.RuntimeParams == nil {
		testConfig.ConnConfig.RuntimeParams = make(map[string]string)
	}
	testConfig.ConnConfig.RuntimeParams["search_path"] = schema
	testConfig.MaxConns = 4
	testConfig.MinConns = 0
	platformpostgres.ConfigureUTC(testConfig)
	pool, err := pgxpool.NewWithConfig(ctx, testConfig)
	if err != nil {
		t.Fatalf("create isolated pool: %v", err)
	}
	if err := pool.Ping(ctx); err != nil {
		pool.Close()
		t.Fatalf("ping isolated schema: %v", err)
	}
	t.Cleanup(pool.Close)
	return pool
}

func audit(userID, action, target string, now time.Time) identity.AuditEvent {
	return identity.AuditEvent{
		ID: rand.Text(), UserID: userID, Action: action,
		Outcome: "succeeded", Target: target, CreatedAt: now,
	}
}
