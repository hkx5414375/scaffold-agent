// Package httpserver owns the generated service's HTTP transport boundary.
package httpserver

import (
	"encoding/json"
	"log/slog"
	"net/http"
	"time"
)

const defaultReadHeaderTimeout = 5 * time.Second

// RegisterRoutes adds one feature's routes to the application mux.
type RegisterRoutes func(*http.ServeMux)

// Middleware wraps the complete routing tree.
type Middleware func(http.Handler) http.Handler

// NewHandler returns the complete HTTP routing tree.
func NewHandler(register RegisterRoutes, middlewares ...Middleware) http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /healthz", health)
	if register != nil {
		register(mux)
	}
	var handler http.Handler = mux
	for index := len(middlewares) - 1; index >= 0; index-- {
		if middlewares[index] != nil {
			handler = middlewares[index](handler)
		}
	}
	return handler
}

// New returns a production-safe HTTP server with bounded header reads.
func New(address string, register RegisterRoutes, middlewares ...Middleware) *http.Server {
	return &http.Server{
		Addr:              address,
		Handler:           NewHandler(register, middlewares...),
		ReadHeaderTimeout: defaultReadHeaderTimeout,
	}
}

func health(response http.ResponseWriter, _ *http.Request) {
	response.Header().Set("Content-Type", "application/json")
	response.WriteHeader(http.StatusOK)
	if err := json.NewEncoder(response).Encode(map[string]string{"status": "ok"}); err != nil {
		slog.Error("encode health response", "error", err)
	}
}
