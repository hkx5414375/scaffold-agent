func TestOrganizationRoutesRequireAuthentication(t *testing.T) {
	t.Parallel()

	security := identityhttp.New(identity.NewService(emptyIdentityStore{}), false)
	mux := http.NewServeMux()
	New(tenancy.NewService(emptyTenancyStore{})).Register(mux, security)
	request := httptest.NewRequest(http.MethodGet, "/api/v1/organizations", nil)
	response := httptest.NewRecorder()
	mux.ServeHTTP(response, request)
	if response.Code != http.StatusUnauthorized {
		t.Fatalf("GET /api/v1/organizations status = %d, want %d", response.Code, http.StatusUnauthorized)
	}
}

