create table if not exists organizations (
    id varchar(191) primary key,
    name varchar(120) not null,
    created_by varchar(191) not null,
    created_at datetime(6) not null,
    updated_at datetime(6) not null,
    constraint organizations_creator_fk foreign key (created_by) references identity_users (id)
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table if not exists organization_memberships (
    organization_id varchar(191) not null,
    user_id varchar(191) not null,
    role_code varchar(63) not null,
    created_at datetime(6) not null,
    primary key (organization_id, user_id),
    index organization_memberships_user_idx (user_id, organization_id),
    constraint organization_memberships_organization_fk foreign key (organization_id) references organizations (id) on delete cascade,
    constraint organization_memberships_user_fk foreign key (user_id) references identity_users (id) on delete cascade,
    constraint organization_memberships_role_fk foreign key (role_code) references identity_roles (code)
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;
