package {{.PackageName}}.http;

import {{.PackageName}}.identity.IdentityException;
{{- if .CRM}}
import {{.PackageName}}.crm.CRMException;
{{- end}}
{{- if .CustomerAccounts}}
import {{.PackageName}}.customeraccounts.CustomerAccountException;
{{- end}}
{{- if .Catalog}}
import {{.PackageName}}.catalog.CatalogException;
{{- end}}
{{- if .Approvals}}
import {{.PackageName}}.approvals.ApprovalException;
{{- end}}
{{- if .Files}}
import {{.PackageName}}.files.FileAssetException;
{{- end}}
{{- if .JobAdmin}}
import {{.PackageName}}.jobadmin.JobAdministrationException;
{{- end}}
{{- if .CSVTransfer}}
import {{.PackageName}}.{{.Business.PackageName}}.transfer.CSVTransferException;
{{- end}}
{{- if .Business}}
import {{.PackageName}}.{{.Business.PackageName}}.{{.Business.EntityClass}}Exception;
{{- end}}
{{- if .Tenancy}}
import {{.PackageName}}.tenancy.TenancyException;
{{- end}}
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.http.converter.HttpMessageNotReadableException;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
{{- if .Files}}
import org.springframework.web.multipart.MaxUploadSizeExceededException;
{{- end}}

@RestControllerAdvice
public final class ApiExceptionHandler {

    private static final Logger LOGGER = LoggerFactory.getLogger(ApiExceptionHandler.class);

{{- if .CRM}}
    @ExceptionHandler(CRMException.class)
    public ResponseEntity<ApiError> crm(CRMException exception) {
        return switch (exception.kind()) {
            case INVALID -> response(HttpStatus.BAD_REQUEST, "crm.invalid", exception.getMessage());
            case NOT_FOUND -> response(HttpStatus.NOT_FOUND, "crm.not_found", exception.getMessage());
            case CONFLICT -> response(HttpStatus.CONFLICT, "crm.conflict", exception.getMessage());
        };
    }
{{- end}}

{{- if .CustomerAccounts}}
    @ExceptionHandler(CustomerAccountException.class)
    public ResponseEntity<ApiError> customerAccounts(CustomerAccountException exception) {
        return switch (exception.kind()) {
            case INVALID ->
                    response(HttpStatus.BAD_REQUEST, "customer.invalid", exception.getMessage());
            case INVALID_CREDENTIALS ->
                    response(
                            HttpStatus.UNAUTHORIZED,
                            "customer.invalid_credentials",
                            exception.getMessage());
            case NOT_FOUND ->
                    response(HttpStatus.NOT_FOUND, "customer.not_found", exception.getMessage());
            case CONFLICT ->
                    response(HttpStatus.CONFLICT, "customer.conflict", exception.getMessage());
        };
    }
{{- end}}

{{- if .Catalog}}
    @ExceptionHandler(CatalogException.class)
    public ResponseEntity<ApiError> catalog(CatalogException exception) {
        return switch (exception.kind()) {
            case INVALID ->
                    response(HttpStatus.BAD_REQUEST, "catalog.invalid", exception.getMessage());
            case NOT_FOUND ->
                    response(HttpStatus.NOT_FOUND, "catalog.not_found", exception.getMessage());
            case CONFLICT ->
                    response(HttpStatus.CONFLICT, "catalog.conflict", exception.getMessage());
        };
    }
{{- end}}

{{- if .Approvals}}
    @ExceptionHandler(ApprovalException.class)
    public ResponseEntity<ApiError> approvals(ApprovalException exception) {
        return switch (exception.kind()) {
            case INVALID ->
                    response(HttpStatus.BAD_REQUEST, "approvals.invalid", exception.getMessage());
            case NOT_FOUND ->
                    response(HttpStatus.NOT_FOUND, "approvals.not_found", exception.getMessage());
            case SUBJECT_NOT_FOUND ->
                    response(
                            HttpStatus.NOT_FOUND,
                            "approvals.subject_not_found",
                            exception.getMessage());
            case CONFLICT ->
                    response(HttpStatus.CONFLICT, "approvals.conflict", exception.getMessage());
            case SELF_DECISION ->
                    response(
                            HttpStatus.CONFLICT,
                            "approvals.self_decision",
                            exception.getMessage());
            case FORBIDDEN ->
                    response(HttpStatus.FORBIDDEN, "identity.forbidden", exception.getMessage());
        };
    }
{{- end}}

    @ExceptionHandler(IdentityException.class)
    public ResponseEntity<ApiError> identity(IdentityException exception) {
        return switch (exception.kind()) {
            case INVALID_CREDENTIALS ->
                    response(
                            HttpStatus.UNAUTHORIZED,
                            "identity.invalid_credentials",
                            exception.getMessage());
            case FORBIDDEN ->
                    response(HttpStatus.FORBIDDEN, "identity.forbidden", exception.getMessage());
            case INVALID_INPUT ->
                    response(HttpStatus.BAD_REQUEST, "request.invalid", exception.getMessage());
        };
    }

{{- if .Business}}
    @ExceptionHandler({{.Business.EntityClass}}Exception.class)
    public ResponseEntity<ApiError> business({{.Business.EntityClass}}Exception exception) {
        return switch (exception.kind()) {
            case INVALID_INPUT ->
                    response(HttpStatus.BAD_REQUEST, "{{.Business.ModuleName}}.invalid", exception.getMessage());
            case NOT_FOUND ->
                    response(HttpStatus.NOT_FOUND, "{{.Business.ModuleName}}.not_found", exception.getMessage());
            case CONFLICT ->
                    response(HttpStatus.CONFLICT, "{{.Business.ModuleName}}.conflict", exception.getMessage());
        };
    }
{{- end}}
{{- if .Tenancy}}
    @ExceptionHandler(TenancyException.class)
    public ResponseEntity<ApiError> tenancy(TenancyException exception) {
        return switch (exception.kind()) {
            case INVALID_INPUT ->
                    response(HttpStatus.BAD_REQUEST, "tenancy.invalid", exception.getMessage());
{{- if .TenancyMembers}}
            case MEMBER_INVALID ->
                    response(
                            HttpStatus.BAD_REQUEST,
                            "tenancy.member.invalid",
                            exception.getMessage());
            case INVITATION_INVALID ->
                    response(
                            HttpStatus.BAD_REQUEST,
                            "tenancy.invitation.invalid",
                            exception.getMessage());
            case MEMBER_CONFLICT ->
                    response(HttpStatus.CONFLICT, "tenancy.member.conflict", exception.getMessage());
            case LAST_ADMINISTRATOR ->
                    response(
                            HttpStatus.CONFLICT,
                            "tenancy.last_administrator",
                            exception.getMessage());
            case MEMBER_NOT_FOUND ->
                    response(HttpStatus.NOT_FOUND, "tenancy.member.not_found", exception.getMessage());
{{- if .TenancyLifecycle}}
            case ORGANIZATION_INVALID ->
                    response(
                            HttpStatus.BAD_REQUEST,
                            "tenancy.organization.invalid",
                            exception.getMessage());
            case LIFECYCLE_FORBIDDEN ->
                    response(
                            HttpStatus.FORBIDDEN,
                            "tenancy.organization.forbidden",
                            exception.getMessage());
            case LIFECYCLE_CONFLICT ->
                    response(
                            HttpStatus.CONFLICT,
                            "tenancy.organization.state_conflict",
                            exception.getMessage());
            case ORGANIZATION_NOT_FOUND ->
                    response(
                            HttpStatus.NOT_FOUND,
                            "tenancy.organization.not_found",
                            exception.getMessage());
            case OWNER_PROTECTED ->
                    response(
                            HttpStatus.CONFLICT,
                            "tenancy.owner_protected",
                            exception.getMessage());
{{- end}}
{{- end}}
        };
    }
{{- end}}
{{- if .Files}}
    @ExceptionHandler(FileAssetException.class)
    public ResponseEntity<ApiError> files(FileAssetException exception) {
        return switch (exception.kind()) {
            case INVALID ->
                    response(HttpStatus.BAD_REQUEST, "files.invalid", exception.getMessage());
            case NOT_FOUND ->
                    response(HttpStatus.NOT_FOUND, "files.not_found", exception.getMessage());
            case TOO_LARGE ->
                    response(
                            HttpStatus.PAYLOAD_TOO_LARGE,
                            "files.too_large",
                            "file size must not exceed 10485760 bytes");
            case STORAGE -> {
                LOGGER.error("file asset operation failed type={}", exception.getClass().getName());
                yield response(
                        HttpStatus.INTERNAL_SERVER_ERROR,
                        "internal.error",
                        "the request could not be completed");
            }
        };
    }

    @ExceptionHandler(MaxUploadSizeExceededException.class)
    public ResponseEntity<ApiError> uploadTooLarge(MaxUploadSizeExceededException exception) {
        return response(
                HttpStatus.PAYLOAD_TOO_LARGE,
                "files.too_large",
                "file size must not exceed 10485760 bytes");
    }
{{- end}}
{{- if .JobAdmin}}
    @ExceptionHandler(JobAdministrationException.class)
    public ResponseEntity<ApiError> jobAdministration(
            JobAdministrationException exception) {
        return switch (exception.kind()) {
            case INVALID ->
                    response(HttpStatus.BAD_REQUEST, "jobs.invalid", exception.getMessage());
            case NOT_FOUND ->
                    response(HttpStatus.NOT_FOUND, "jobs.not_found", exception.getMessage());
            case CONFLICT ->
                    response(HttpStatus.CONFLICT, "jobs.not_retryable", exception.getMessage());
        };
    }
{{- end}}
{{- if .CSVTransfer}}
    @ExceptionHandler(CSVTransferException.class)
    public ResponseEntity<ApiError> csvTransfer(CSVTransferException exception) {
        return switch (exception.kind()) {
            case INVALID ->
                    response(HttpStatus.BAD_REQUEST, "csv.invalid", exception.getMessage());
            case TOO_LARGE ->
                    response(HttpStatus.PAYLOAD_TOO_LARGE, "csv.too_large", exception.getMessage());
            case TOO_MANY_ROWS ->
                    response(
                            HttpStatus.valueOf(422),
                            "csv.too_many_rows",
                            exception.getMessage());
            case CONFLICT ->
                    response(HttpStatus.CONFLICT, "csv.conflict", exception.getMessage());
            case UNSUPPORTED_MEDIA_TYPE ->
                    response(
                            HttpStatus.UNSUPPORTED_MEDIA_TYPE,
                            "csv.unsupported_media_type",
                            exception.getMessage());
        };
    }
{{- end}}

    @ExceptionHandler({MethodArgumentNotValidException.class, HttpMessageNotReadableException.class})
    public ResponseEntity<ApiError> invalidRequest(Exception exception) {
        return response(HttpStatus.BAD_REQUEST, "request.invalid", "request data is invalid");
    }

    @ExceptionHandler(Exception.class)
    public ResponseEntity<ApiError> internal(Exception exception) {
        LOGGER.error("request failed: {}", exception.getClass().getName());
        return response(
                HttpStatus.INTERNAL_SERVER_ERROR,
                "internal.error",
                "the request could not be completed");
    }

    private static ResponseEntity<ApiError> response(
            HttpStatus status, String code, String message) {
        return ResponseEntity.status(status).body(new ApiError(code, message));
    }
}
