package {{.PackageName}}.approvals;

import {{.PackageName}}.identity.AuthenticationInterceptor;
import {{.PackageName}}.identity.Principal;
import {{.PackageName}}.identity.RequirePermission;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestAttribute;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/v1/approvals")
public final class ApprovalController {

    private final ApprovalService service;

    public ApprovalController(ApprovalService service) {
        this.service = service;
    }

    @PostMapping
    @RequirePermission(value = "approvals:submit"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ResponseEntity<ApprovalRequest> submit(
            @RequestBody ApprovalService.SubmitInput input,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return ResponseEntity.status(HttpStatus.CREATED).body(service.submit(input, actor));
    }

    @GetMapping
    @RequirePermission(value = "approvals:read"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ApprovalService.Page list(
            @RequestParam(defaultValue = "") String status,
            @RequestParam(defaultValue = "") String cursor,
            @RequestParam(defaultValue = "20") int limit,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.list(status, cursor, limit, actor);
    }

    @GetMapping("/mine")
    @RequirePermission(value = "approvals:mine"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ApprovalService.Page listMine(
            @RequestParam(defaultValue = "") String status,
            @RequestParam(defaultValue = "") String cursor,
            @RequestParam(defaultValue = "20") int limit,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.listMine(status, cursor, limit, actor);
    }

    @GetMapping("/{id}")
    @RequirePermission(value = "approvals:read"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ApprovalRequest get(
            @PathVariable String id,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.get(id, actor);
    }

    @GetMapping("/{id}/events")
    @RequirePermission(value = "approvals:read"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ApprovalService.EventPage history(
            @PathVariable String id,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.history(id, actor);
    }

    @PostMapping("/{id}/approve")
    @RequirePermission(value = "approvals:decide"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ApprovalRequest approve(
            @PathVariable String id,
            @RequestBody ApprovalService.DecisionInput input,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.approve(id, input, actor);
    }

    @PostMapping("/{id}/reject")
    @RequirePermission(value = "approvals:decide"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ApprovalRequest reject(
            @PathVariable String id,
            @RequestBody ApprovalService.DecisionInput input,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.reject(id, input, actor);
    }

    @PostMapping("/{id}/cancel")
    @RequirePermission(value = "approvals:mine"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ApprovalRequest cancel(
            @PathVariable String id,
            @RequestBody ApprovalService.DecisionInput input,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.cancel(id, input, actor);
    }
}
