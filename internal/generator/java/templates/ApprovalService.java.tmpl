package {{.PackageName}}.approvals;

import {{.PackageName}}.identity.AuditEvent;
import {{.PackageName}}.identity.Principal;
import edu.umd.cs.findbugs.annotations.SuppressFBWarnings;
import java.time.Clock;
import java.time.Instant;
import java.util.List;
import java.util.Set;
import java.util.UUID;
import org.springframework.stereotype.Service;

@Service
public final class ApprovalService {

    public static final String PENDING = "pending";
    public static final String APPROVED = "approved";
    public static final String REJECTED = "rejected";
    public static final String CANCELLED = "cancelled";

    private static final Set<String> STATUSES =
            Set.of(PENDING, APPROVED, REJECTED, CANCELLED);
    private static final String REQUESTER = "requester";
    private static final String OTHER = "other";

    private final ApprovalRepository repository;
    private final Clock clock;

    public ApprovalService(ApprovalRepository repository) {
        this(repository, Clock.systemUTC());
    }

    ApprovalService(ApprovalRepository repository, Clock clock) {
        this.repository = repository;
        this.clock = clock;
    }

    public ApprovalRequest submit(SubmitInput input, Principal actor) {
        String organizationId = actorScope(actor);
        if (input == null) {
            throw invalid();
        }
        String subjectId = text(input.subjectId());
        String summary = text(input.summary());
        String details = text(input.details());
        if (!validRequiredText(subjectId, 191)
                || !validRequiredText(summary, 255)
                || !validOptionalText(details, 4000)) {
            throw invalid();
        }
        Instant now = clock.instant();
        ApprovalRequest request =
                new ApprovalRequest(
                        newId(),
                        emptyToNull(organizationId),
                        "{{.Business.ModuleName}}.{{.Business.EntityName}}",
                        subjectId,
                        actor.userId(),
                        summary,
                        details,
                        PENDING,
                        1L,
                        null,
                        null,
                        null,
                        now,
                        now);
        repository.create(
                request,
                event(request.id(), actor.userId(), PENDING, "", now),
                audit(actor, "approvals:submit", request.id(), now));
        return request;
    }

    public ApprovalRequest get(String id, Principal actor) {
        String organizationId = actorScope(actor);
        String normalizedId = requireId(id);
        return repository
                .get(organizationId, normalizedId)
                .orElseThrow(ApprovalService::notFound);
    }

    public Page list(String status, String cursor, int limit, Principal actor) {
        return listFor("", status, cursor, limit, actor);
    }

    public Page listMine(String status, String cursor, int limit, Principal actor) {
        actorScope(actor);
        return listFor(actor.userId(), status, cursor, limit, actor);
    }

    public ApprovalRequest approve(String id, DecisionInput input, Principal actor) {
        return decide(id, input, APPROVED, actor);
    }

    public ApprovalRequest reject(String id, DecisionInput input, Principal actor) {
        DecisionInput validated = requireDecision(input);
        if (text(validated.comment()).isEmpty()) {
            throw invalid();
        }
        return decide(id, validated, REJECTED, actor);
    }

    public ApprovalRequest cancel(String id, DecisionInput input, Principal actor) {
        DecisionInput validated = requireDecision(input);
        ApprovalRequest current = get(id, actor);
        if (!current.requesterUserId().equals(actor.userId())) {
            throw new ApprovalException(
                    ApprovalException.Kind.FORBIDDEN,
                    "only the requester can cancel an approval request");
        }
        requirePendingVersion(current, validated.version());
        return transition(current, validated, CANCELLED, REQUESTER, actor);
    }

    public EventPage history(String id, Principal actor) {
        ApprovalRequest request = get(id, actor);
        return new EventPage(
                List.copyOf(repository.events(actorScope(actor), request.id())));
    }

    private Page listFor(
            String requesterUserId,
            String status,
            String cursor,
            int limit,
            Principal actor) {
        String organizationId = actorScope(actor);
        String normalizedStatus = text(status);
        String normalizedCursor = text(cursor);
        if ((!normalizedStatus.isEmpty() && !STATUSES.contains(normalizedStatus))
                || normalizedCursor.length() > 191
                || limit < 1
                || limit > 100) {
            throw invalid();
        }
        ApprovalRepository.PageResult result =
                repository.list(
                        organizationId,
                        requesterUserId,
                        normalizedStatus,
                        normalizedCursor,
                        limit);
        return new Page(result.items(), result.nextCursor());
    }

    private ApprovalRequest decide(
            String id, DecisionInput input, String status, Principal actor) {
        DecisionInput validated = requireDecision(input);
        ApprovalRequest current = get(id, actor);
        if (current.requesterUserId().equals(actor.userId())) {
            throw new ApprovalException(
                    ApprovalException.Kind.SELF_DECISION,
                    "requesters cannot decide their own approval request");
        }
        requirePendingVersion(current, validated.version());
        return transition(current, validated, status, OTHER, actor);
    }

    private ApprovalRequest transition(
            ApprovalRequest current,
            DecisionInput input,
            String status,
            String actorRule,
            Principal actor) {
        String comment = text(input.comment());
        Instant now = clock.instant();
        ApprovalRepository.Transition transition =
                new ApprovalRepository.Transition(
                        actorScope(actor),
                        current.id(),
                        input.version(),
                        actor.userId(),
                        actorRule,
                        PENDING,
                        status,
                        comment,
                        now);
        return repository.transition(
                transition,
                event(current.id(), actor.userId(), status, comment, now),
                audit(actor, "approvals:" + status, current.id(), now));
    }

    private static DecisionInput requireDecision(DecisionInput input) {
        if (input == null
                || input.version() == null
                || input.version() < 1L
                || !validOptionalText(text(input.comment()), 2000)) {
            throw invalid();
        }
        return new DecisionInput(input.version(), text(input.comment()));
    }

    private static void requirePendingVersion(ApprovalRequest request, long version) {
        if (!PENDING.equals(request.status()) || request.version() != version) {
            throw conflict();
        }
    }

    private static String actorScope(Principal actor) {
        if (actor == null
                || actor.userId() == null
                || actor.userId().isBlank(){{if .Tenancy}}
                || actor.organizationId() == null
                || actor.organizationId().isBlank(){{end}}) {
            throw invalid();
        }
{{- if .Tenancy}}
        return actor.organizationId().trim();
{{- else}}
        return "";
{{- end}}
    }

    private static String requireId(String id) {
        String normalized = text(id);
        if (!validRequiredText(normalized, 191)) {
            throw invalid();
        }
        return normalized;
    }

    private static boolean validRequiredText(String value, int maximumLength) {
        return !value.isEmpty() && validOptionalText(value, maximumLength);
    }

    private static boolean validOptionalText(String value, int maximumLength) {
        return value.length() <= maximumLength
                && value.codePoints().noneMatch(Character::isISOControl);
    }

    private static String text(String value) {
        return value == null ? "" : value.trim();
    }

    private static String emptyToNull(String value) {
        return value.isEmpty() ? null : value;
    }

    private static ApprovalEvent event(
            String requestId, String actorUserId, String status, String comment, Instant now) {
        return new ApprovalEvent(
                newId(), requestId, actorUserId, status, emptyToNull(comment), now);
    }

    private static AuditEvent audit(
            Principal actor, String action, String target, Instant now) {
        return new AuditEvent(
                newId(), actor.userId(), action, "succeeded", target, "", "", now);
    }

    private static ApprovalException invalid() {
        return new ApprovalException(
                ApprovalException.Kind.INVALID, "approval data is invalid");
    }

    private static ApprovalException notFound() {
        return new ApprovalException(
                ApprovalException.Kind.NOT_FOUND, "approval request was not found");
    }

    private static ApprovalException conflict() {
        return new ApprovalException(
                ApprovalException.Kind.CONFLICT,
                "approval request changed or is no longer pending");
    }

    private static String newId() {
        return UUID.randomUUID().toString();
    }

    public record SubmitInput(String subjectId, String summary, String details) {}

    public record DecisionInput(Long version, String comment) {}

    @SuppressFBWarnings(
            value = "EI_EXPOSE_REP",
            justification = "Page lists are immutable snapshots created by the repository")
    public record Page(List<ApprovalRequest> items, String nextCursor) {}

    @SuppressFBWarnings(
            value = "EI_EXPOSE_REP",
            justification = "Event lists are immutable snapshots created by the repository")
    public record EventPage(List<ApprovalEvent> items) {}
}
