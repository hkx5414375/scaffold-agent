package {{.PackageName}}.{{.Business.PackageName}}.transfer;

public final class CSVTransferException extends RuntimeException {

    public enum Kind {
        INVALID,
        TOO_LARGE,
        TOO_MANY_ROWS,
        CONFLICT,
        UNSUPPORTED_MEDIA_TYPE
    }

    private final Kind kind;

    public CSVTransferException(Kind kind, String message) {
        super(message);
        this.kind = kind;
    }

    public CSVTransferException(Kind kind, String message, Throwable cause) {
        super(message, cause);
        this.kind = kind;
    }

    public Kind kind() {
        return kind;
    }
}
