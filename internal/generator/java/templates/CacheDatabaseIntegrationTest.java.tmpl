package {{.PackageName}}.cache;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

{{- if .Tenancy}}
import {{.PackageName}}.identity.IdentityService;
import {{.PackageName}}.identity.JdbcIdentityRepository;
import {{.PackageName}}.identity.PasswordHasher;
import {{.PackageName}}.identity.Principal;
import {{.PackageName}}.identity.TokenCodec;
import {{.PackageName}}.tenancy.JdbcTenancyRepository;
import {{.PackageName}}.tenancy.Organization;
import {{.PackageName}}.tenancy.TenancyService;
{{- end}}
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.sql.Statement;
import java.time.Clock;
import java.time.Duration;
import java.time.Instant;
import java.time.ZoneId;
import java.time.ZoneOffset;
import java.util.UUID;
import org.flywaydb.core.Flyway;
import org.junit.jupiter.api.Assumptions;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Timeout;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.datasource.DataSourceTransactionManager;
import org.springframework.jdbc.datasource.DriverManagerDataSource;
import org.springframework.transaction.support.TransactionTemplate;
import tools.jackson.databind.ObjectMapper;

class CacheDatabaseIntegrationTest {

    @Test
    @Timeout(45)
    void upsertsScopesExpiresDeletesAndPurgesJson() throws SQLException {
        String adminUrl = environment("TEST_DATABASE_URL");
        Assumptions.assumeTrue(!adminUrl.isBlank(), "TEST_DATABASE_URL is not set");
        String username = environment("TEST_DATABASE_USER");
        String password = environment("TEST_DATABASE_PASSWORD");
        String databaseScope =
                "scaffold_java_cache_" + UUID.randomUUID().toString().replace("-", "");
        String applicationUrl;
{{- if eq .Database.Engine "postgresql"}}
        execute(adminUrl, username, password, "create schema " + databaseScope);
        applicationUrl =
                adminUrl
                        + (adminUrl.contains("?") ? "&" : "?")
                        + "currentSchema="
                        + databaseScope;
{{- else}}
        execute(adminUrl, username, password, "create database `" + databaseScope + "`");
        applicationUrl = mysqlDatabaseUrl(adminUrl, databaseScope);
{{- end}}
        try {
            DriverManagerDataSource dataSource =
                    new DriverManagerDataSource(applicationUrl, username, password);
            Flyway flyway = Flyway.configure().dataSource(dataSource).load();
            assertThat(flyway.migrate().migrationsExecuted).isEqualTo({{.MigrationCount}});
            assertThat(flyway.migrate().migrationsExecuted).isZero();
            JdbcTemplate jdbc = new JdbcTemplate(dataSource);
{{- if .Tenancy}}
            TransactionTemplate transactions =
                    new TransactionTemplate(new DataSourceTransactionManager(dataSource));
            IdentityService identity =
                    new IdentityService(
                            new JdbcIdentityRepository(jdbc, transactions),
                            new PasswordHasher(),
                            new TokenCodec());
            identity.ensureAdmin("admin@example.com", "correct horse battery staple");
            Principal actor =
                    identity.login(
                                    "admin@example.com",
                                    "correct horse battery staple",
                                    "127.0.0.1",
                                    "integration-test")
                            .principal();
            TenancyService tenancy =
                    new TenancyService(new JdbcTenancyRepository(jdbc, transactions));
            Organization organization = tenancy.create("Acme", actor);
            String organizationId = organization.id();
{{- else}}
            String organizationId = "ignored";
{{- end}}
            MutableClock clock = new MutableClock(Instant.parse("2026-09-01T00:00:00Z"));
            CacheService service =
                    new CacheService(
                            new JdbcCacheRepository(jdbc),
                            new ObjectMapper(),
                            clock);
            service.set(organizationId, "task:1", new Value("first"), Duration.ofHours(1));
            assertThat(service.get(organizationId, "task:1", Value.class))
                    .isEqualTo(new Value("first"));
            service.set(organizationId, "task:1", new Value("second"), Duration.ofHours(2));
            assertThat(service.get(organizationId, "task:1", Value.class))
                    .isEqualTo(new Value("second"));
{{- if .Tenancy}}
            assertThatThrownBy(() -> service.get("other-organization", "task:1", Value.class))
                    .isInstanceOf(CacheException.class)
                    .hasFieldOrPropertyWithValue("kind", CacheException.Kind.MISS);
{{- end}}
            service.set(organizationId, "expired", new Value("old"), Duration.ofSeconds(1));
            clock.advance(Duration.ofSeconds(2));
            assertThatThrownBy(() -> service.get(organizationId, "expired", Value.class))
                    .isInstanceOf(CacheException.class)
                    .hasFieldOrPropertyWithValue("kind", CacheException.Kind.MISS);
            assertThat(service.purgeExpired(100)).isEqualTo(1);
            service.delete(organizationId, "task:1");
            service.delete(organizationId, "task:1");
            assertThat(jdbc.queryForObject("select count(*) from application_cache", Integer.class))
                    .isZero();
        } finally {
{{- if eq .Database.Engine "postgresql"}}
            execute(adminUrl, username, password, "drop schema " + databaseScope + " cascade");
{{- else}}
            execute(adminUrl, username, password, "drop database `" + databaseScope + "`");
{{- end}}
        }
    }

    private static void execute(String url, String username, String password, String sql)
            throws SQLException {
        try (Connection connection = DriverManager.getConnection(url, username, password);
                Statement statement = connection.createStatement()) {
            statement.execute(sql);
        }
    }

{{- if eq .Database.Engine "mysql"}}
    private static String mysqlDatabaseUrl(String adminUrl, String database) {
        int queryOffset = adminUrl.indexOf('?');
        String query = queryOffset < 0 ? "" : adminUrl.substring(queryOffset);
        String base = queryOffset < 0 ? adminUrl : adminUrl.substring(0, queryOffset);
        int slash = base.lastIndexOf('/');
        if (slash < "jdbc:mysql://".length()) {
            throw new IllegalArgumentException("TEST_DATABASE_URL must include a trailing slash");
        }
        return base.substring(0, slash + 1) + database + query;
    }

{{- end}}
    private static String environment(String name) {
        String value = System.getenv(name);
        return value == null ? "" : value.trim();
    }

    private record Value(String name) {}

    private static final class MutableClock extends Clock {

        private Instant value;

        private MutableClock(Instant value) {
            this.value = value;
        }

        private void advance(Duration duration) {
            value = value.plus(duration);
        }

        @Override
        public ZoneId getZone() {
            return ZoneOffset.UTC;
        }

        @Override
        public Clock withZone(ZoneId zone) {
            return this;
        }

        @Override
        public Instant instant() {
            return value;
        }
    }
}
