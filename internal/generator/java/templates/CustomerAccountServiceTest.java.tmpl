    private static final class FakeRepository implements CustomerAccountRepository {

        private final Map<String, CustomerAccount> accounts = new HashMap<>();
        private final Map<String, String> sessions = new HashMap<>();
        private final List<AuditEvent> audits = new ArrayList<>();

        @Override
        public void register(
                CustomerAccount account,
                String tokenHash,
                Instant expiresAt,
                AuditEvent auditEvent) {
            boolean duplicate =
                    accounts.values().stream()
                            .anyMatch(
                                    existing ->
                                            scope(existing).equals(scope(account))
                                                    && existing.email().equals(account.email()));
            if (duplicate) {
                throw conflict();
            }
            accounts.put(account.id(), account);
            sessions.put(tokenHash, account.id());
            audits.add(auditEvent);
        }

        @Override
        public Optional<CustomerAccount> findByEmail(String organizationId, String email) {
            return accounts.values().stream()
                    .filter(
                            account ->
                                    scope(account).equals(organizationId)
                                            && account.email().equals(email))
                    .findFirst();
        }

        @Override
        public void createSession(
                String tokenHash,
                String customerId,
                Instant expiresAt,
                AuditEvent auditEvent) {
            sessions.put(tokenHash, customerId);
            audits.add(auditEvent);
        }

        @Override
        public Optional<CustomerAccount> findBySession(
                String organizationId, String tokenHash, Instant now) {
            String customerId = sessions.get(tokenHash);
            if (customerId == null) {
                return Optional.empty();
            }
            return get(organizationId, customerId);
        }

        @Override
        public void deleteSession(String tokenHash, AuditEvent auditEvent) {
            if (sessions.remove(tokenHash) != null) {
                audits.add(auditEvent);
            }
        }

        @Override
        public void appendAudit(AuditEvent auditEvent) {
            audits.add(auditEvent);
        }

        @Override
        public CustomerAccount updateProfile(Mutation mutation, AuditEvent auditEvent) {
            CustomerAccount current = require(mutation);
            CustomerAccount updated =
                    replace(
                            current,
                            mutation.replacement(),
                            current.passwordHash(),
                            current.status(),
                            mutation.updatedAt());
            accounts.put(updated.id(), updated);
            audits.add(auditEvent);
            return updated;
        }

        @Override
        public CustomerAccount changePassword(Mutation mutation, AuditEvent auditEvent) {
            CustomerAccount current = require(mutation);
            CustomerAccount updated =
                    replace(
                            current,
                            current.displayName(),
                            mutation.replacement(),
                            current.status(),
                            mutation.updatedAt());
            accounts.put(updated.id(), updated);
            revoke(updated.id());
            audits.add(auditEvent);
            return updated;
        }

        @Override
        public Optional<CustomerAccount> get(String organizationId, String id) {
            CustomerAccount account = accounts.get(id);
            return account != null && scope(account).equals(organizationId)
                    ? Optional.of(account)
                    : Optional.empty();
        }

        @Override
        public PageResult list(
                String organizationId, String status, String cursor, int limit) {
            List<CustomerAccount> values =
                    accounts.values().stream()
                            .filter(account -> scope(account).equals(organizationId))
                            .filter(account -> status.isEmpty() || account.status().equals(status))
                            .filter(account -> cursor.isEmpty() || account.id().compareTo(cursor) > 0)
                            .sorted((left, right) -> left.id().compareTo(right.id()))
                            .limit(limit)
                            .toList();
            return new PageResult(values, "");
        }

        @Override
        public CustomerAccount transition(Transition transition, AuditEvent auditEvent) {
            CustomerAccount current = accounts.get(transition.id());
            if (current == null
                    || !scope(current).equals(transition.organizationId())
                    || current.version() != transition.expectedVersion()
                    || !current.status().equals(transition.fromStatus())) {
                throw conflict();
            }
            CustomerAccount updated =
                    replace(
                            current,
                            current.displayName(),
                            current.passwordHash(),
                            transition.toStatus(),
                            transition.updatedAt());
            accounts.put(updated.id(), updated);
            revoke(updated.id());
            audits.add(auditEvent);
            return updated;
        }

        private CustomerAccount require(Mutation mutation) {
            CustomerAccount current = accounts.get(mutation.id());
            if (current == null
                    || !scope(current).equals(mutation.organizationId())
                    || current.version() != mutation.expectedVersion()
                    || !CustomerAccountService.ACTIVE.equals(current.status())) {
                throw conflict();
            }
            return current;
        }

        private void revoke(String customerId) {
            sessions.entrySet().removeIf(entry -> entry.getValue().equals(customerId));
        }

        private static CustomerAccount replace(
                CustomerAccount current,
                String displayName,
                String passwordHash,
                String status,
                Instant updatedAt) {
            return new CustomerAccount(
                    current.id(),
                    current.organizationId(),
                    current.email(),
                    passwordHash,
                    displayName,
                    status,
                    current.version() + 1,
                    current.createdAt(),
                    updatedAt);
        }

        private static String scope(CustomerAccount account) {
            return account.organizationId() == null ? "" : account.organizationId();
        }

        private static CustomerAccountException conflict() {
            return new CustomerAccountException(
                    CustomerAccountException.Kind.CONFLICT,
                    "customer account conflicts");
        }
    }
}
