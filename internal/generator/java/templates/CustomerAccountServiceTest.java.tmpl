class CustomerAccountServiceTest {

    private static final Instant NOW = Instant.parse("2026-09-01T00:00:00Z");
    private static final String FIRST_PASSWORD = "correct horse battery staple";
    private static final String SECOND_PASSWORD = "another correct password";

    @Test
    void supportsCustomerSelfServiceAndAdministrationLifecycle() {
        FakeRepository repository = new FakeRepository();
        PasswordHasher hasher = new PasswordHasher();
        CustomerAccountService service = service(repository, hasher);

        CustomerAccountService.AuthenticationResult registered =
                service.register(
                        organizationId(),
                        new CustomerAccountService.RegisterInput(
                                " Customer@Example.com ", FIRST_PASSWORD, " Customer One "),
                        "127.0.0.1",
                        "unit-test");
        assertThat(registered.customer().email()).isEqualTo("customer@example.com");
        assertThat(registered.customer().displayName()).isEqualTo("Customer One");
        assertThat(service.authenticate(organizationId(), registered.token()).id())
                .isEqualTo(registered.customer().id());

        CustomerAccount profiled =
                service.updateProfile(
                        registered.customer(),
                        new CustomerAccountService.ProfileInput("Customer Two", 1L),
                        "127.0.0.1",
                        "unit-test");
        CustomerAccount passwordChanged =
                service.changePassword(
                        profiled,
                        new CustomerAccountService.PasswordInput(
                                FIRST_PASSWORD, SECOND_PASSWORD, 2L),
                        "127.0.0.1",
                        "unit-test");
        assertThat(profiled.version()).isEqualTo(2L);
        assertThat(passwordChanged.version()).isEqualTo(3L);
        assertThat(hasher.verify(passwordChanged.passwordHash(), SECOND_PASSWORD)).isTrue();
        assertKind(
                () -> service.authenticate(organizationId(), registered.token()),
                CustomerAccountException.Kind.INVALID_CREDENTIALS);

        CustomerAccountService.AuthenticationResult loggedIn =
                service.login(
                        organizationId(),
                        new CustomerAccountService.LoginInput(
                                "customer@example.com", SECOND_PASSWORD),
                        "127.0.0.1",
                        "unit-test");
        CustomerAccount suspended =
                service.suspend(
                        loggedIn.customer().id(),
                        new CustomerAccountService.TransitionInput(3L),
                        actor());
        assertThat(suspended.status()).isEqualTo(CustomerAccountService.SUSPENDED);
        assertKind(
                () -> service.authenticate(organizationId(), loggedIn.token()),
                CustomerAccountException.Kind.INVALID_CREDENTIALS);
        assertKind(
                () ->
                        service.login(
                                organizationId(),
                                new CustomerAccountService.LoginInput(
                                        "customer@example.com", SECOND_PASSWORD),
                                "127.0.0.1",
                                "unit-test"),
                CustomerAccountException.Kind.INVALID_CREDENTIALS);

        CustomerAccount active =
                service.reactivate(
                        suspended.id(),
                        new CustomerAccountService.TransitionInput(4L),
                        actor());
        CustomerAccountService.AuthenticationResult finalLogin =
                service.login(
                        organizationId(),
                        new CustomerAccountService.LoginInput(
                                "customer@example.com", SECOND_PASSWORD),
                        "127.0.0.1",
                        "unit-test");
        CustomerAccount closed =
                service.close(
                        finalLogin.customer(),
                        new CustomerAccountService.TransitionInput(active.version()),
                        "127.0.0.1",
                        "unit-test");
        assertThat(closed.status()).isEqualTo(CustomerAccountService.CLOSED);
        assertThat(repository.audits)
                .extracting(AuditEvent::action)
                .contains(
                        "customer.register",
                        "customer.profile.update",
                        "customer.password.change",
                        "customers:accounts:suspend",
                        "customers:accounts:reactivate",
                        "customer.close");
    }

    @Test
    void rejectsDuplicateStaleUnsafeAndCrossScopeOperations() {
        FakeRepository repository = new FakeRepository();
        CustomerAccountService service = service(repository, new PasswordHasher());
        CustomerAccount customer =
                service.register(
                                organizationId(),
                                new CustomerAccountService.RegisterInput(
                                        "customer@example.com", FIRST_PASSWORD, "Customer"),
                                "",
                                "")
                        .customer();

        assertKind(
                () ->
                        service.register(
                                organizationId(),
                                new CustomerAccountService.RegisterInput(
                                        "CUSTOMER@example.com", FIRST_PASSWORD, "Duplicate"),
                                "",
                                ""),
                CustomerAccountException.Kind.CONFLICT);
        assertKind(
                () ->
                        service.updateProfile(
                                customer,
                                new CustomerAccountService.ProfileInput("Stale", 2L),
                                "",
                                ""),
                CustomerAccountException.Kind.CONFLICT);
        assertKind(
                () ->
                        service.login(
                                organizationId(),
                                new CustomerAccountService.LoginInput(
                                        "missing@example.com", FIRST_PASSWORD),
                                "",
                                ""),
                CustomerAccountException.Kind.INVALID_CREDENTIALS);
        assertKind(
                () -> service.list("unknown", "", 20, actor()),
                CustomerAccountException.Kind.INVALID);
{{- if .Tenancy}}
        assertKind(
                () -> service.get(customer.id(), otherActor()),
                CustomerAccountException.Kind.NOT_FOUND);
{{- end}}
    }

    @Test
    void keepsPasswordHashesPrivateAndUsesDecimalStringVersions() throws Exception {
        JsonMapper mapper =
                JsonMapper.builder()
                        .findAndAddModules()
                        .propertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE)
                        .build();
        CustomerAccount account =
                new CustomerAccount(
                        "customer-1",
{{- if .Tenancy}}
                        organizationId(),
{{- else}}
                        null,
{{- end}}
                        "customer@example.com",
                        "private-password-hash",
                        "Customer",
                        CustomerAccountService.ACTIVE,
                        3L,
                        NOW,
                        NOW);

        String json = mapper.writeValueAsString(account);
        assertThat(json).contains("\"version\":\"3\"");
        assertThat(json).doesNotContain("password_hash", "private-password-hash");
        CustomerAccountService.ProfileInput input =
                mapper.readValue(
                        "{\"display_name\":\"Updated\",\"version\":\"3\"}",
                        CustomerAccountService.ProfileInput.class);
        assertThat(input.version()).isEqualTo(3L);
    }

    private static CustomerAccountService service(
            FakeRepository repository, PasswordHasher hasher) {
        return new CustomerAccountService(
                repository,
                hasher,
                new TokenCodec(),
                Clock.fixed(NOW, ZoneOffset.UTC));
    }

    private static void assertKind(
            Runnable operation, CustomerAccountException.Kind kind) {
        assertThatThrownBy(operation::run)
                .isInstanceOf(CustomerAccountException.class)
                .hasFieldOrPropertyWithValue("kind", kind);
    }

