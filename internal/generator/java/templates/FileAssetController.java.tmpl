package {{.PackageName}}.files;

import {{.PackageName}}.identity.AuthenticationInterceptor;
import {{.PackageName}}.identity.Principal;
import {{.PackageName}}.identity.RequirePermission;
import edu.umd.cs.findbugs.annotations.SuppressFBWarnings;
import java.io.IOException;
import java.io.InputStream;
import java.nio.charset.StandardCharsets;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.http.ContentDisposition;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestAttribute;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RequestPart;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.web.servlet.mvc.method.annotation.StreamingResponseBody;

@RestController
@RequestMapping("/api/v1/files")
public final class FileAssetController {

    private static final Logger LOGGER = LoggerFactory.getLogger(FileAssetController.class);

    private final FileAssetService service;

    @SuppressFBWarnings(
            value = "EI_EXPOSE_REP2",
            justification = "The application service is a process-scoped Spring dependency")
    public FileAssetController(FileAssetService service) {
        this.service = service;
    }

    @PostMapping(consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
    @RequirePermission(value = "files:create"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ResponseEntity<FileAsset> upload(
            @RequestPart("file") MultipartFile file,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        try (InputStream content = file.getInputStream()) {
            FileAsset asset =
                    service.upload(
                            file.getOriginalFilename(),
                            file.getContentType(),
                            content,
                            actor);
            return ResponseEntity.status(HttpStatus.CREATED).body(asset);
        } catch (IOException exception) {
            throw new FileAssetException(
                    FileAssetException.Kind.STORAGE,
                    "file upload could not be read",
                    exception);
        }
    }

    @GetMapping("/{id}")
    @RequirePermission(value = "files:read"{{if .Tenancy}}, tenantScoped = true{{end}})
    public FileAsset get(
            @PathVariable String id,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.get(id, actor);
    }

    @GetMapping
    @RequirePermission(value = "files:read"{{if .Tenancy}}, tenantScoped = true{{end}})
    public FileAssetService.Page list(
            @RequestParam(defaultValue = "") String cursor,
            @RequestParam(defaultValue = "20") int limit,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        return service.list(cursor, limit, actor);
    }

    @GetMapping("/{id}/content")
    @RequirePermission(value = "files:read"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ResponseEntity<StreamingResponseBody> download(
            @PathVariable String id,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        FileAssetService.Download download = service.open(id, actor);
        FileAsset asset = download.asset();
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.parseMediaType(asset.mediaType()));
        headers.setContentLength(asset.size());
        headers.setContentDisposition(
                ContentDisposition.attachment()
                        .filename(asset.name(), StandardCharsets.UTF_8)
                        .build());
        headers.set("X-Content-Type-Options", "nosniff");
        StreamingResponseBody body =
                output -> {
                    try (InputStream content = download.content()) {
                        content.transferTo(output);
                    } catch (IOException exception) {
                        LOGGER.warn(
                                "file response stream failed file_id={} error_type={}",
                                asset.id(),
                                exception.getClass().getName());
                        throw exception;
                    }
                };
        return ResponseEntity.ok().headers(headers).body(body);
    }

    @DeleteMapping("/{id}")
    @RequirePermission(value = "files:delete"{{if .Tenancy}}, tenantScoped = true{{end}})
    public ResponseEntity<Void> delete(
            @PathVariable String id,
            @RequestAttribute(AuthenticationInterceptor.PRINCIPAL_ATTRIBUTE) Principal actor) {
        service.delete(id, actor);
        return ResponseEntity.noContent().build();
    }
}
