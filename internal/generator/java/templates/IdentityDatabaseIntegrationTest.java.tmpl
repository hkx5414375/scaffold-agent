package {{.PackageName}}.identity;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.sql.Statement;
import java.time.Clock;
import java.util.UUID;
import org.flywaydb.core.Flyway;
import org.junit.jupiter.api.Assumptions;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Timeout;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.datasource.DataSourceTransactionManager;
import org.springframework.jdbc.datasource.DriverManagerDataSource;
import org.springframework.transaction.support.TransactionTemplate;

class IdentityDatabaseIntegrationTest {

    @Test
    @Timeout(30)
    void migratesAndPersistsIdentitySecurityTransactions() throws SQLException {
        String adminUrl = environment("TEST_DATABASE_URL");
        Assumptions.assumeTrue(!adminUrl.isBlank(), "TEST_DATABASE_URL is not set");
        String username = environment("TEST_DATABASE_USER");
        String password = environment("TEST_DATABASE_PASSWORD");
        String scope = "scaffold_java_" + UUID.randomUUID().toString().replace("-", "");
        String applicationUrl;
{{- if eq .Database.Engine "postgresql"}}
        execute(adminUrl, username, password, "create schema " + scope);
        applicationUrl = adminUrl + (adminUrl.contains("?") ? "&" : "?") + "currentSchema=" + scope;
{{- else}}
        execute(adminUrl, username, password, "create database `" + scope + "`");
        applicationUrl = mysqlDatabaseUrl(adminUrl, scope);
{{- end}}
        try {
            DriverManagerDataSource dataSource =
                    new DriverManagerDataSource(applicationUrl, username, password);
            Flyway flyway = Flyway.configure().dataSource(dataSource).load();
            assertThat(flyway.migrate().migrationsExecuted).isEqualTo(1);
            assertThat(flyway.migrate().migrationsExecuted).isZero();

            JdbcTemplate jdbcTemplate = new JdbcTemplate(dataSource);
            JdbcIdentityRepository repository =
                    new JdbcIdentityRepository(
                            jdbcTemplate,
                            new TransactionTemplate(new DataSourceTransactionManager(dataSource)));
            IdentityService service =
                    new IdentityService(
                            repository,
                            new PasswordHasher(),
                            new TokenCodec(),
                            Clock.systemUTC());
            String passwordValue = "correct horse battery staple";
            service.ensureAdmin("admin@example.com", passwordValue);
            IdentityService.LoginResult login =
                    service.login(
                            "admin@example.com", passwordValue, "127.0.0.1", "integration-test");
            assertThat(service.authenticate(login.token(), "").userId())
                    .isEqualTo(login.principal().userId());

            service.authorize(
                    login.principal(),
                    "identity:token:create",
                    "127.0.0.1",
                    "integration-test");
            IdentityService.ApiTokenResult apiToken =
                    service.createApiToken(login.principal(), "integration");
            assertThat(service.authenticate("", apiToken.token()).method()).isEqualTo("token");

            assertThatThrownBy(
                            () ->
                                    service.login(
                                            "admin@example.com",
                                            "incorrect password",
                                            "127.0.0.1",
                                            "integration-test"))
                    .isInstanceOf(IdentityException.class);
            Integer auditCount =
                    jdbcTemplate.queryForObject(
                            "select count(*) from audit_events where action like 'identity.%'",
                            Integer.class);
            assertThat(auditCount).isEqualTo(3);
            assertThat(
                            jdbcTemplate.queryForObject(
                                    "select count(*) from identity_sessions where token_hash = ?",
                                    Integer.class,
                                    login.token()))
                    .isZero();
            assertThat(
                            jdbcTemplate.queryForObject(
                                    "select count(*) from identity_api_tokens where token_hash = ?",
                                    Integer.class,
                                    apiToken.token()))
                    .isZero();
        } finally {
{{- if eq .Database.Engine "postgresql"}}
            execute(adminUrl, username, password, "drop schema " + scope + " cascade");
{{- else}}
            execute(adminUrl, username, password, "drop database `" + scope + "`");
{{- end}}
        }
    }

    private static void execute(String url, String username, String password, String sql)
            throws SQLException {
        try (Connection connection = DriverManager.getConnection(url, username, password);
                Statement statement = connection.createStatement()) {
            statement.execute(sql);
        }
    }

{{- if eq .Database.Engine "mysql"}}
    private static String mysqlDatabaseUrl(String adminUrl, String database) {
        int queryOffset = adminUrl.indexOf('?');
        String query = queryOffset < 0 ? "" : adminUrl.substring(queryOffset);
        String base = queryOffset < 0 ? adminUrl : adminUrl.substring(0, queryOffset);
        int slash = base.lastIndexOf('/');
        if (slash < "jdbc:mysql://".length()) {
            throw new IllegalArgumentException("TEST_DATABASE_URL must include a trailing slash");
        }
        return base.substring(0, slash + 1) + database + query;
    }

{{- end}}
    private static String environment(String name) {
        String value = System.getenv(name);
        return value == null ? "" : value.trim();
    }
}
