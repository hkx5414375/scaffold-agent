package {{.PackageName}}.inventory;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

import {{.PackageName}}.identity.IdentityService;
import {{.PackageName}}.identity.JdbcIdentityRepository;
import {{.PackageName}}.identity.PasswordHasher;
import {{.PackageName}}.identity.Principal;
import {{.PackageName}}.identity.TokenCodec;
import {{.PackageName}}.inventory.InventoryModels.Item;
import {{.PackageName}}.inventory.InventoryModels.PurchaseOrder;
import {{.PackageName}}.inventory.InventoryModels.ReceiptResult;
import {{.PackageName}}.inventory.InventoryModels.ReservationResult;
import {{.PackageName}}.inventory.InventoryModels.StockResult;
import {{.PackageName}}.inventory.InventoryModels.Warehouse;
{{- if .Tenancy}}
import {{.PackageName}}.tenancy.JdbcTenancyRepository;
import {{.PackageName}}.tenancy.Organization;
import {{.PackageName}}.tenancy.TenancyService;
{{- end}}
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.sql.Statement;
import java.sql.Timestamp;
import java.time.Clock;
import java.time.Instant;
import java.time.ZoneOffset;
import java.util.List;
import java.util.UUID;
import org.flywaydb.core.Flyway;
import org.junit.jupiter.api.Assumptions;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Timeout;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.datasource.DataSourceTransactionManager;
import org.springframework.jdbc.datasource.DriverManagerDataSource;
import org.springframework.transaction.support.TransactionTemplate;
import tools.jackson.databind.ObjectMapper;

class InventoryDatabaseIntegrationTest {

    private static final Instant NOW = Instant.parse("2026-09-02T00:00:00Z");

    @Test
    @Timeout(60)
    void enforcesAtomicStockReservationsReceivingIdempotencyAndTenantLifecycle()
            throws SQLException {
        String adminUrl = environment("TEST_DATABASE_URL");
        Assumptions.assumeTrue(!adminUrl.isBlank(), "TEST_DATABASE_URL is not set");
        String username = environment("TEST_DATABASE_USER");
        String password = environment("TEST_DATABASE_PASSWORD");
        String namespace =
                "scaffold_java_inventory_" + UUID.randomUUID().toString().replace("-", "");
        String applicationUrl;
{{- if eq .Database.Engine "postgresql"}}
        execute(adminUrl, username, password, "create schema " + namespace);
        applicationUrl =
                adminUrl + (adminUrl.contains("?") ? "&" : "?") + "currentSchema=" + namespace;
{{- else}}
        execute(adminUrl, username, password, "create database `" + namespace + "`");
        applicationUrl = mysqlDatabaseUrl(adminUrl, namespace);
{{- end}}
        try {
            DriverManagerDataSource dataSource =
                    new DriverManagerDataSource(applicationUrl, username, password);
            Flyway flyway = Flyway.configure().dataSource(dataSource).load();
            assertThat(flyway.migrate().migrationsExecuted).isEqualTo({{.MigrationCount}});
            assertThat(flyway.migrate().migrationsExecuted).isZero();

            JdbcTemplate jdbc = new JdbcTemplate(dataSource);
            TransactionTemplate transactions =
                    new TransactionTemplate(new DataSourceTransactionManager(dataSource));
            IdentityService identity =
                    new IdentityService(
                            new JdbcIdentityRepository(jdbc, transactions),
                            new PasswordHasher(),
                            new TokenCodec());
            identity.ensureAdmin("inventory@example.com", "correct horse battery staple");
            Principal actor =
                    identity.login(
                                    "inventory@example.com",
                                    "correct horse battery staple",
                                    "127.0.0.1",
                                    "integration-test")
                            .principal();
{{- if .Tenancy}}
            TenancyService tenancy =
                    new TenancyService(new JdbcTenancyRepository(jdbc, transactions));
            Organization organization = tenancy.create("Inventory", actor);
            actor = scoped(actor, organization.id());
{{- end}}
            Principal scopedActor = actor;
            InventoryService inventory =
                    new InventoryService(
                            new JdbcInventoryRepository(jdbc, transactions, new ObjectMapper()),
                            Clock.fixed(NOW, ZoneOffset.UTC));

            Item item =
                    inventory.createItem(
                            new InventoryService.ItemWrite(" sku-1 ", "Widget", "ea"),
                            scopedActor);
            Warehouse warehouse =
                    inventory.createWarehouse(
                            new InventoryService.WarehouseWrite(" main ", "Main"),
                            scopedActor);
            StockResult adjusted =
                    inventory.adjustStock(
                            new InventoryService.AdjustmentInput(
                                    item.id(), warehouse.id(), "100", "initial", "adjust-1"),
                            scopedActor);
            StockResult adjustedReplay =
                    inventory.adjustStock(
                            new InventoryService.AdjustmentInput(
                                    item.id(), warehouse.id(), "100", "initial", "adjust-1"),
                            scopedActor);
            assertThat(adjustedReplay).isEqualTo(adjusted);
            assertKind(
                    () ->
                            inventory.adjustStock(
                                    new InventoryService.AdjustmentInput(
                                            item.id(),
                                            warehouse.id(),
                                            "1",
                                            "different",
                                            "adjust-1"),
                                    scopedActor),
                    InventoryException.Kind.CONFLICT);

            ReservationResult reserved =
                    inventory.createReservation(
                            new InventoryService.ReservationWrite(
                                    "order-1", item.id(), warehouse.id(), "30", "reserve-1"),
                            scopedActor);
            ReservationResult reservedReplay =
                    inventory.createReservation(
                            new InventoryService.ReservationWrite(
                                    "order-1", item.id(), warehouse.id(), "30", "reserve-1"),
                            scopedActor);
            assertThat(reservedReplay).isEqualTo(reserved);
            ReservationResult consumed =
                    inventory.consumeReservation(
                            reserved.reservation().id(),
                            new InventoryService.ReservationTransition("1", "consume-1"),
                            scopedActor);
            assertThat(consumed.balance().onHand()).isEqualTo(70L);
            assertThat(consumed.balance().reserved()).isZero();

            PurchaseOrder purchase =
                    inventory.createPurchaseOrder(
                            new InventoryService.PurchaseOrderWrite(
                                    "po-1",
                                    "Supplier",
                                    List.of(
                                            new InventoryService.PurchaseOrderLineWrite(
                                                    item.id(), "50"))),
                            scopedActor);
            purchase =
                    inventory.submitPurchaseOrder(
                            purchase.id(),
                            new InventoryService.TransitionInput("1"),
                            scopedActor);
            ReceiptResult partial =
                    inventory.receivePurchaseOrder(
                            purchase.id(),
                            new InventoryService.ReceiptInput(
                                    purchase.lines().getFirst().id(),
                                    warehouse.id(),
                                    "20",
                                    "receive-1",
                                    "2"),
                            scopedActor);
            ReceiptResult partialReplay =
                    inventory.receivePurchaseOrder(
                            purchase.id(),
                            new InventoryService.ReceiptInput(
                                    purchase.lines().getFirst().id(),
                                    warehouse.id(),
                                    "20",
                                    "receive-1",
                                    "2"),
                            scopedActor);
            assertThat(partialReplay).isEqualTo(partial);
            ReceiptResult completed =
                    inventory.receivePurchaseOrder(
                            purchase.id(),
                            new InventoryService.ReceiptInput(
                                    purchase.lines().getFirst().id(),
                                    warehouse.id(),
                                    "30",
                                    "receive-2",
                                    "3"),
                            scopedActor);
            assertThat(completed.purchaseOrder().status()).isEqualTo(InventoryService.RECEIVED);
            assertThat(completed.balance().onHand()).isEqualTo(120L);
            assertKind(
                    () ->
                            inventory.adjustStock(
                                    new InventoryService.AdjustmentInput(
                                            item.id(),
                                            warehouse.id(),
                                            "-121",
                                            "invalid negative",
                                            "adjust-2"),
                                    scopedActor),
                    InventoryException.Kind.CONFLICT);
            assertThat(inventory.listMovements("", "", "", 100, scopedActor).items())
                    .hasSize(5);
            assertThat(permissionCount(jdbc)).isEqualTo(4);
            assertThat(auditCount(jdbc)).isGreaterThanOrEqualTo(9);
{{- if .Tenancy}}
            jdbc.update(
                    "update organizations set status = 'inactive', deactivated_at = ? where id = ?",
                    Timestamp.from(NOW),
                    organization.id());
            assertKind(
                    () ->
                            inventory.adjustStock(
                                    new InventoryService.AdjustmentInput(
                                            item.id(),
                                            warehouse.id(),
                                            "100",
                                            "initial",
                                            "adjust-1"),
                                    scopedActor),
                    InventoryException.Kind.NOT_FOUND);
{{- end}}
        } finally {
{{- if eq .Database.Engine "postgresql"}}
            execute(adminUrl, username, password, "drop schema " + namespace + " cascade");
{{- else}}
            execute(adminUrl, username, password, "drop database `" + namespace + "`");
{{- end}}
        }
    }

    private static int permissionCount(JdbcTemplate jdbc) {
        Integer count =
                jdbc.queryForObject(
                        "select count(*) from identity_permissions "
                                + "where code like 'inventory:%'",
                        Integer.class);
        return count == null ? 0 : count;
    }

    private static int auditCount(JdbcTemplate jdbc) {
        Integer count =
                jdbc.queryForObject(
                        "select count(*) from audit_events where action like 'inventory:%'",
                        Integer.class);
        return count == null ? 0 : count;
    }

    private static void assertKind(Runnable operation, InventoryException.Kind kind) {
        assertThatThrownBy(operation::run)
                .isInstanceOf(InventoryException.class)
                .hasFieldOrPropertyWithValue("kind", kind);
    }

{{- if .Tenancy}}
    private static Principal scoped(Principal actor, String organizationId) {
        return new Principal(
                actor.userId(), actor.email(), actor.role(), actor.method(), organizationId);
    }

{{- end}}
    private static void execute(String url, String username, String password, String sql)
            throws SQLException {
        try (Connection connection = DriverManager.getConnection(url, username, password);
                Statement statement = connection.createStatement()) {
            statement.execute(sql);
        }
    }

{{- if eq .Database.Engine "mysql"}}
    private static String mysqlDatabaseUrl(String adminUrl, String database) {
        int queryOffset = adminUrl.indexOf('?');
        String query = queryOffset < 0 ? "" : adminUrl.substring(queryOffset);
        String base = queryOffset < 0 ? adminUrl : adminUrl.substring(0, queryOffset);
        int slash = base.lastIndexOf('/');
        if (slash < "jdbc:mysql://".length()) {
            throw new IllegalArgumentException("TEST_DATABASE_URL must include a trailing slash");
        }
        return base.substring(0, slash + 1) + database + query;
    }

{{- end}}
    private static String environment(String name) {
        String value = System.getenv(name);
        return value == null ? "" : value.trim();
    }
}
