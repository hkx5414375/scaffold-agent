    private ReservationResult transitionReservation(
            String id, ReservationTransition input, String target, Principal actor) {
        if (input == null) {
            throw invalid();
        }
        String scope = actorScope(actor);
        String normalizedId = identifier(id);
        long currentVersion = positive(input.version());
        String key = identifier(input.idempotencyKey());
        Instant now = clock.instant();
        return repository.transitionReservation(
                new InventoryRepository.ReservationTransitionCommand(
                        scope,
                        normalizedId,
                        key,
                        fingerprint(
                                "reservation",
                                normalizedId,
                                target,
                                Long.toString(currentVersion)),
                        currentVersion,
                        target,
                        newId(),
                        actor.userId(),
                        now,
                        audit(actor, "inventory:reservation:" + target, normalizedId, now)));
    }

    public PurchaseOrder createPurchaseOrder(PurchaseOrderWrite input, Principal actor) {
        if (input == null || input.lines() == null || input.lines().isEmpty() || input.lines().size() > 100) {
            throw invalid();
        }
        String scope = actorScope(actor);
        Set<String> itemIds = new HashSet<>();
        List<PurchaseOrderLine> lines = new ArrayList<>(input.lines().size());
        for (PurchaseOrderLineWrite inputLine : input.lines()) {
            if (inputLine == null) {
                throw invalid();
            }
            String itemId = identifier(inputLine.itemId());
            if (!itemIds.add(itemId)) {
                throw invalid();
            }
            lines.add(new PurchaseOrderLine(newId(), itemId, positive(inputLine.orderedQuantity()), 0L));
        }
        Instant now = clock.instant();
        PurchaseOrder value =
                new PurchaseOrder(
                        newId(),
                        emptyToNull(scope),
                        code(input.number()),
                        required(input.supplierName(), 160),
                        DRAFT,
                        1L,
                        lines,
                        now,
                        now);
        repository.createPurchaseOrder(
                value, audit(actor, "inventory:purchase:create", value.id(), now));
        return value;
    }

