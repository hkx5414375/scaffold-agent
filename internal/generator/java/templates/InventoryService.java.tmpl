    public static final String ACTIVE = "active";
    public static final String ARCHIVED = "archived";
    public static final String RESERVATION_ACTIVE = "active";
    public static final String RELEASED = "released";
    public static final String CONSUMED = "consumed";
    public static final String DRAFT = "draft";
    public static final String SUBMITTED = "submitted";
    public static final String PARTIALLY_RECEIVED = "partially_received";
    public static final String RECEIVED = "received";
    public static final String CANCELLED = "cancelled";

    private static final int MAXIMUM_IDENTIFIER_LENGTH = 191;
    private static final Pattern CODE_PATTERN = Pattern.compile("^[A-Z0-9._-]{1,64}$");
    private static final Set<String> RECORD_STATUSES = Set.of(ACTIVE, ARCHIVED);
    private static final Set<String> RESERVATION_STATUSES =
            Set.of(RESERVATION_ACTIVE, RELEASED, CONSUMED);
    private static final Set<String> PURCHASE_STATUSES =
            Set.of(DRAFT, SUBMITTED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED);

    private final InventoryRepository repository;
    private final Clock clock;

    public InventoryService(InventoryRepository repository) {
        this(repository, Clock.systemUTC());
    }

    InventoryService(InventoryRepository repository, Clock clock) {
        this.repository = repository;
        this.clock = clock;
    }

    public Item createItem(ItemWrite input, Principal actor) {
        if (input == null) {
            throw invalid();
        }
        String scope = actorScope(actor);
        Instant now = clock.instant();
        Item value =
                new Item(
                        newId(),
                        emptyToNull(scope),
                        code(input.sku()),
                        required(input.name(), 160),
                        unit(input.unit()),
                        ACTIVE,
                        1L,
                        now,
                        now);
        repository.createItem(value, audit(actor, "inventory:item:create", value.id(), now));
        return value;
    }

    public Item getItem(String id, Principal actor) {
        return repository.getItem(actorScope(actor), identifier(id)).orElseThrow(InventoryService::notFound);
    }

    public ItemPage listItems(String status, String cursor, int limit, Principal actor) {
        String filter = filter(status, RECORD_STATUSES);
        validatePage(cursor, limit);
        InventoryRepository.PageResult<Item> result =
                repository.listItems(actorScope(actor), filter, text(cursor), limit);
        return new ItemPage(result.items(), result.nextCursor());
    }

    public Item updateItem(String id, ItemUpdate input, Principal actor) {
        if (input == null) {
            throw invalid();
        }
        String scope = actorScope(actor);
        String normalizedId = identifier(id);
        Instant now = clock.instant();
        Item value =
                new Item(
                        normalizedId,
                        emptyToNull(scope),
                        code(input.sku()),
                        required(input.name(), 160),
                        unit(input.unit()),
                        ACTIVE,
                        0L,
                        now,
                        now);
        return repository.updateItem(
                scope,
                value,
                positive(input.version()),
                audit(actor, "inventory:item:update", normalizedId, now));
    }

    public Item archiveItem(String id, TransitionInput input, Principal actor) {
