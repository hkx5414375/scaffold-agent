    public StockResult adjustStock(AdjustmentInput input, Principal actor) {
        if (input == null) {
            throw invalid();
        }
        String scope = actorScope(actor);
        String itemId = identifier(input.itemId());
        String warehouseId = identifier(input.warehouseId());
        long quantity = signedNonZero(input.quantityDelta());
        String reason = required(input.reason(), 500);
        String key = identifier(input.idempotencyKey());
        Instant now = clock.instant();
        Movement movement =
                new Movement(
                        newId(),
                        emptyToNull(scope),
                        itemId,
                        warehouseId,
                        "adjustment",
                        quantity,
                        0L,
                        "adjustment",
                        key,
                        reason,
                        key,
                        actor.userId(),
                        now);
        return repository.applyStock(
                new InventoryRepository.StockCommand(
                        scope,
                        key,
                        fingerprint(
                                "adjust",
                                itemId,
                                warehouseId,
                                Long.toString(quantity),
                                reason),
                        movement,
                        audit(actor, "inventory:stock:adjust", movement.id(), now)));
    }

