    private static String actorScope(Principal actor) {
        if (actor == null || !validRequired(text(actor.userId()), MAXIMUM_IDENTIFIER_LENGTH)) {
            throw invalid();
        }
{{- if .Tenancy}}
        String organizationId = text(actor.organizationId());
        if (!validRequired(organizationId, MAXIMUM_IDENTIFIER_LENGTH)) {
            throw invalid();
        }
        return organizationId;
{{- else}}
        return "";
{{- end}}
    }

    private static String identifier(String value) {
        String normalized = text(value);
        if (!validRequired(normalized, MAXIMUM_IDENTIFIER_LENGTH)) {
            throw invalid();
        }
        return normalized;
    }

    private static String optionalIdentifier(String value) {
        String normalized = text(value);
        return normalized.isEmpty() ? "" : identifier(normalized);
    }

    private static String code(String value) {
        String normalized = text(value).toUpperCase(Locale.ROOT);
        if (!CODE_PATTERN.matcher(normalized).matches()) {
            throw invalid();
        }
        return normalized;
    }

    private static String unit(String value) {
        String normalized = text(value).toUpperCase(Locale.ROOT);
        if (!validRequired(normalized, 32)) {
            throw invalid();
        }
        return normalized;
    }

    private static String required(String value, int maximum) {
        String normalized = text(value);
        if (!validRequired(normalized, maximum)) {
            throw invalid();
        }
        return normalized;
    }

    private static long positive(String value) {
        long parsed = canonical(value);
        if (parsed < 1L) {
            throw invalid();
        }
        return parsed;
    }

    private static long signedNonZero(String value) {
        long parsed = canonical(value);
        if (parsed == 0L) {
            throw invalid();
        }
        return parsed;
    }

    private static long canonical(String value) {
        String normalized = text(value);
        try {
            long parsed = Long.parseLong(normalized);
            if (!Long.toString(parsed).equals(normalized)) {
                throw invalid();
            }
            return parsed;
        } catch (NumberFormatException exception) {
            throw invalid();
        }
    }

    private static long version(TransitionInput input) {
        if (input == null) {
            throw invalid();
        }
        return positive(input.version());
    }

    private static String filter(String value, Set<String> allowed) {
        String normalized = text(value);
        if (!normalized.isEmpty() && !allowed.contains(normalized)) {
            throw invalid();
        }
        return normalized;
    }

    private static void validatePage(String cursor, int limit) {
        String normalized = text(cursor);
        if (limit < 1
                || limit > 100
                || normalized.length() > MAXIMUM_IDENTIFIER_LENGTH
                || !safe(normalized)) {
            throw invalid();
        }
    }

    private static boolean validRequired(String value, int maximum) {
        return !value.isEmpty()
                && value.codePointCount(0, value.length()) <= maximum
                && safe(value);
    }

    private static boolean safe(String value) {
        return value.codePoints().noneMatch(Character::isISOControl);
    }

    private static String text(String value) {
        return value == null ? "" : value.trim();
    }

    private static String emptyToNull(String value) {
        return value.isEmpty() ? null : value;
    }

    private static String fingerprint(String... values) {
        try {
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            for (int index = 0; index < values.length; index++) {
                if (index > 0) {
                    digest.update((byte) 0);
                }
                digest.update(values[index].getBytes(StandardCharsets.UTF_8));
            }
            return HexFormat.of().formatHex(digest.digest());
        } catch (NoSuchAlgorithmException exception) {
            throw new IllegalStateException("SHA-256 is unavailable", exception);
        }
    }

    private static AuditEvent audit(
            Principal actor, String action, String target, Instant now) {
        return new AuditEvent(newId(), actor.userId(), action, "succeeded", target, "", "", now);
    }

    private static String newId() {
