package {{.PackageName}}.{{.Business.PackageName}};

import {{.PackageName}}.identity.AuditEvent;
import edu.umd.cs.findbugs.annotations.SuppressFBWarnings;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Timestamp;
import java.time.Instant;
import java.util.ArrayList;
import java.util.List;
import java.util.Objects;
import java.util.Optional;
import org.springframework.dao.DataIntegrityViolationException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;
import org.springframework.transaction.support.TransactionTemplate;

@Repository
public final class Jdbc{{.Business.EntityClass}}Repository
        implements {{.Business.EntityClass}}Repository {

    private static final String SELECT_COLUMNS =
            "id"
{{- range .Business.Fields}}
                    + ", {{javaSQL .Name}}"
{{- end}}
                    + ", version, created_at, updated_at";

    private final JdbcTemplate jdbcTemplate;
    private final TransactionTemplate transactionTemplate;

    @SuppressFBWarnings(
            value = "EI_EXPOSE_REP2",
            justification = "Spring JDBC collaborators are process-scoped infrastructure dependencies")
    public Jdbc{{.Business.EntityClass}}Repository(
            JdbcTemplate jdbcTemplate, TransactionTemplate transactionTemplate) {
        this.jdbcTemplate = jdbcTemplate;
        this.transactionTemplate = transactionTemplate;
    }

    @Override
    public void create({{.Business.EntityClass}} value, AuditEvent auditEvent) {
        try {
            transactionTemplate.executeWithoutResult(
                    status -> {
                        jdbcTemplate.update(
                                "insert into {{javaSQL .Business.TableName}} "
                                        + "(id"
{{- range .Business.Fields}}
                                        + ", {{javaSQL .Name}}"
{{- end}}
                                        + ", version, created_at, updated_at) "
                                        + "values (?{{range .Business.Fields}}, ?{{end}}, ?, ?, ?)",
                                value.id(),
{{- range .Business.Fields}}
                                value.{{.JavaName}}(),
{{- end}}
                                value.version(),
                                Timestamp.from(value.createdAt()),
                                Timestamp.from(value.updatedAt()));
                        appendAudit(auditEvent);
                    });
        } catch (DataIntegrityViolationException exception) {
            throw conflict("a unique value already exists", exception);
        }
    }

    @Override
    public Optional<{{.Business.EntityClass}}> get(String id) {
        return getInternal(id);
    }

    @Override
    public PageResult list(String cursor, int limit) {
        List<{{.Business.EntityClass}}> values =
                new ArrayList<>(
                        jdbcTemplate.query(
                                "select "
                                        + SELECT_COLUMNS
                                        + " from {{javaSQL .Business.TableName}} "
                                        + "where (? = '' or id > ?) order by id limit ?",
                                Jdbc{{.Business.EntityClass}}Repository::mapValue,
                                cursor,
                                cursor,
                                limit + 1));
        String nextCursor = "";
        if (values.size() > limit) {
            nextCursor = values.get(limit - 1).id();
            values = new ArrayList<>(values.subList(0, limit));
        }
        return new PageResult(List.copyOf(values), nextCursor);
    }

    @Override
    public {{.Business.EntityClass}} update(
            {{.Business.EntityClass}} value, AuditEvent auditEvent) {
        try {
            return Objects.requireNonNull(
                    transactionTemplate.execute(
                            status -> {
                                int changed =
                                        jdbcTemplate.update(
                                                "update {{javaSQL .Business.TableName}} set "
{{- range $index, $field := .Business.Fields}}
{{- if $index}}
                                                        + ", "
{{- end}}
                                                        + "{{javaSQL $field.Name}} = ?"
{{- end}}
                                                        + ", version = version + 1, updated_at = ? "
                                                        + "where id = ? and version = ?",
{{- range .Business.Fields}}
                                                value.{{.JavaName}}(),
{{- end}}
                                                Timestamp.from(value.updatedAt()),
                                                value.id(),
                                                value.version());
                                if (changed != 1) {
                                    throw missingOrConflict(value.id());
                                }
                                appendAudit(auditEvent);
                                return getInternal(value.id())
                                        .orElseThrow(() -> missing(value.id()));
                            }));
        } catch (DataIntegrityViolationException exception) {
            throw conflict("a unique value already exists", exception);
        }
    }

    @Override
    public void delete(String id, long version, AuditEvent auditEvent) {
        transactionTemplate.executeWithoutResult(
                status -> {
                    int changed =
                            jdbcTemplate.update(
                                    "delete from {{javaSQL .Business.TableName}} where id = ? and version = ?",
                                    id,
                                    version);
                    if (changed != 1) {
                        throw missingOrConflict(id);
                    }
                    appendAudit(auditEvent);
                });
    }

    private Optional<{{.Business.EntityClass}}> getInternal(String id) {
        List<{{.Business.EntityClass}}> values =
                jdbcTemplate.query(
                        "select "
                                + SELECT_COLUMNS
                                + " from {{javaSQL .Business.TableName}} where id = ?",
                        Jdbc{{.Business.EntityClass}}Repository::mapValue,
                        id);
        return values.isEmpty() ? Optional.empty() : Optional.of(values.getFirst());
    }

    private RuntimeException missingOrConflict(String id) {
        Integer count =
                jdbcTemplate.queryForObject(
                        "select count(*) from {{javaSQL .Business.TableName}} where id = ?",
                        Integer.class,
                        id);
        return count == null || count == 0 ? missing(id) : conflict("version is stale", null);
    }

    private void appendAudit(AuditEvent event) {
        jdbcTemplate.update(
                "insert into audit_events "
                        + "(id, user_id, action, outcome, target, ip_address, user_agent, created_at) "
                        + "values (?, ?, ?, ?, ?, ?, ?, ?)",
                event.id(),
                emptyToNull(event.userId()),
                event.action(),
                event.outcome(),
                emptyToNull(event.target()),
                emptyToNull(event.ipAddress()),
                emptyToNull(event.userAgent()),
                Timestamp.from(event.createdAt()));
    }

    private static {{.Business.EntityClass}} mapValue(ResultSet resultSet, int rowNumber)
            throws SQLException {
        return new {{.Business.EntityClass}}(
                resultSet.getString("id"),
{{- range .Business.Fields}}
{{- if eq .JavaType "String"}}
                resultSet.getString("{{.Name}}"),
{{- else if eq .JavaType "Boolean"}}
{{- if .Required}}
                resultSet.getBoolean("{{.Name}}"),
{{- else}}
                resultSet.getObject("{{.Name}}", Boolean.class),
{{- end}}
{{- else if eq .JavaType "Long"}}
{{- if .Required}}
                resultSet.getLong("{{.Name}}"),
{{- else}}
                resultSet.getObject("{{.Name}}", Long.class),
{{- end}}
{{- else}}
                instant(resultSet.getTimestamp("{{.Name}}")),
{{- end}}
{{- end}}
                resultSet.getLong("version"),
                instant(resultSet.getTimestamp("created_at")),
                instant(resultSet.getTimestamp("updated_at")));
    }

    private static Instant instant(Timestamp timestamp) {
        return timestamp == null ? null : timestamp.toInstant();
    }

    private static String emptyToNull(String value) {
        return value == null || value.isEmpty() ? null : value;
    }

    private static {{.Business.EntityClass}}Exception missing(String id) {
        return new {{.Business.EntityClass}}Exception(
                {{.Business.EntityClass}}Exception.Kind.NOT_FOUND,
                "{{.Business.EntityName}} " + id + " was not found");
    }

    private static {{.Business.EntityClass}}Exception conflict(
            String message, Throwable cause) {
        {{.Business.EntityClass}}Exception exception =
                new {{.Business.EntityClass}}Exception(
                        {{.Business.EntityClass}}Exception.Kind.CONFLICT, message);
        if (cause != null) {
            exception.initCause(cause);
        }
        return exception;
    }
}
