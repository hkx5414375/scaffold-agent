                    + "value.created_at, value.updated_at";
    private static final String CONTACT_COLUMNS =
            "value.id, value.organization_id, value.account_id, value.name, value.email, "
                    + "value.phone, value.status, value.version, value.created_at, value.updated_at";
    private static final String ACTIVITY_COLUMNS =
            "value.id, value.organization_id, value.subject_type, value.subject_id, "
                    + "value.activity_type, value.summary, value.occurred_at, "
                    + "value.created_by, value.created_at";
    private static final String OPPORTUNITY_COLUMNS =
