                    + "value.currency, value.stage, value.version, value.created_at, value.updated_at";

    private final JdbcTemplate jdbcTemplate;
    private final TransactionTemplate transactionTemplate;

    @SuppressFBWarnings(
            value = "EI_EXPOSE_REP2",
            justification = "Spring JDBC collaborators are process-scoped infrastructure dependencies")
    public JdbcCRMRepository(
            JdbcTemplate jdbcTemplate, TransactionTemplate transactionTemplate) {
        this.jdbcTemplate = jdbcTemplate;
        this.transactionTemplate = transactionTemplate;
    }

    @Override
    public void createAccount(CRMAccount value, AuditEvent audit) {
        runCreate(
                scope(value.organizationId()),
                () ->
                        jdbcTemplate.update(
                                "insert into crm_accounts "
                                        + "(id, organization_id, name, status, version, created_at, updated_at) "
                                        + "values (?, ?, ?, ?, ?, ?, ?)",
                                value.id(),
                                value.organizationId(),
                                value.name(),
                                value.status(),
                                value.version(),
                                Timestamp.from(value.createdAt()),
                                Timestamp.from(value.updatedAt())),
                audit);
    }

    @Override
    public Optional<CRMAccount> getAccount(String organizationId, String id) {
        return first(
                jdbcTemplate.query(
                        select(ACCOUNT_COLUMNS, "crm_accounts")
                                + " where value.id = ? and coalesce(value.organization_id, '') = ?"
                                + activeScope("value"),
                        JdbcCRMRepository::mapAccount,
                        id,
                        organizationId));
    }

    @Override
    public PageResult<CRMAccount> listAccounts(
            String organizationId, String status, String cursor, int limit) {
        return page(
                jdbcTemplate.query(
                        select(ACCOUNT_COLUMNS, "crm_accounts")
                                + " where coalesce(value.organization_id, '') = ? "
                                + "and (? = '' or value.status = ?) "
                                + "and (? = '' or value.id > ?)"
                                + activeScope("value")
                                + " order by value.id limit ?",
                        JdbcCRMRepository::mapAccount,
                        organizationId,
                        status,
                        status,
                        cursor,
                        cursor,
                        limit + 1),
                limit,
                CRMAccount::id);
    }

    @Override
    public CRMAccount updateAccount(
            String organizationId,
            String id,
            String name,
            long version,
            Instant updatedAt,
            AuditEvent audit) {
        return mutate(
                organizationId,
                () ->
                        jdbcTemplate.update(
                                "update crm_accounts set name = ?, version = version + 1, "
                                        + "updated_at = ? where id = ? "
                                        + "and coalesce(organization_id, '') = ? "
                                        + "and version = ? and status = 'active'",
                                name,
                                Timestamp.from(updatedAt),
                                id,
                                organizationId,
                                version),
                audit,
                () -> getAccount(organizationId, id).orElseThrow(JdbcCRMRepository::notFound));
    }

    @Override
    public CRMAccount transitionAccount(Transition value, AuditEvent audit) {
        return mutate(
                value.organizationId(),
                () ->
                        jdbcTemplate.update(
                                "update crm_accounts set status = ?, version = version + 1, "
                                        + "updated_at = ? where id = ? "
                                        + "and coalesce(organization_id, '') = ? "
                                        + "and version = ? and status = ?",
                                value.toStatus(),
                                Timestamp.from(value.updatedAt()),
                                value.id(),
                                value.organizationId(),
                                value.version(),
                                value.fromStatus()),
                audit,
                () ->
                        getAccount(value.organizationId(), value.id())
                                .orElseThrow(JdbcCRMRepository::notFound));
    }

