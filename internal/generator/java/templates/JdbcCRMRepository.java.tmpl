    private void runCreate(String organizationId, Mutation mutation, AuditEvent audit) {
        try {
            transactionTemplate.executeWithoutResult(
                    status -> {
                        lockScope(organizationId);
                        requireMutation(mutation.run());
                        appendAudit(audit);
                    });
        } catch (DataIntegrityViolationException exception) {
            throw conflict(exception);
        }
    }

    private <T> T mutate(
            String organizationId, Mutation mutation, AuditEvent audit, Result<T> result) {
        try {
            return Objects.requireNonNull(
                    transactionTemplate.execute(
                            status -> {
                                lockScope(organizationId);
                                requireMutation(mutation.run());
                                appendAudit(audit);
                                return result.get();
                            }));
        } catch (DataIntegrityViolationException exception) {
            throw conflict(exception);
        }
    }

    private void lockScope(String organizationId) {
{{- if .Tenancy}}
        List<String> values =
                jdbcTemplate.query(
                        "select id from organizations where id = ? and status = 'active' for update",
                        (resultSet, rowNumber) -> resultSet.getString(1),
                        organizationId);
        if (values.isEmpty()) {
            throw notFound();
        }
{{- end}}
    }

    private void requireAccount(String organizationId, String accountId) {
        if (accountId == null || accountId.isEmpty()) {
            return;
        }
        List<String> values =
                jdbcTemplate.query(
                        "select id from crm_accounts where id = ? "
                                + "and coalesce(organization_id, '') = ? "
                                + "and status = 'active' for update",
                        (resultSet, rowNumber) -> resultSet.getString(1),
                        accountId,
                        organizationId);
        if (values.isEmpty()) {
            throw notFound();
        }
    }

    private void requireSubject(String organizationId, String subjectType, String subjectId) {
        String table =
                switch (subjectType) {
                    case "account" -> "crm_accounts";
                    case "contact" -> "crm_contacts";
                    case "opportunity" -> "crm_opportunities";
                    default -> throw notFound();
                };
        List<String> values =
                jdbcTemplate.query(
                        "select id from "
                                + table
                                + " where id = ? and coalesce(organization_id, '') = ? for update",
                        (resultSet, rowNumber) -> resultSet.getString(1),
                        subjectId,
                        organizationId);
        if (values.isEmpty()) {
            throw notFound();
        }
    }

    private void appendAudit(AuditEvent event) {
        jdbcTemplate.update(
                "insert into audit_events "
                        + "(id, user_id, action, outcome, target, ip_address, user_agent, created_at) "
                        + "values (?, ?, ?, ?, ?, ?, ?, ?)",
                event.id(),
                emptyToNull(event.userId()),
                event.action(),
                event.outcome(),
                emptyToNull(event.target()),
                emptyToNull(event.ipAddress()),
                emptyToNull(event.userAgent()),
                Timestamp.from(event.createdAt()));
    }

    private static String select(String columns, String table) {
        return "select " + columns + " from " + table + " value";
    }

    private static String activeScope(String alias) {
{{- if .Tenancy}}
        return " and exists (select 1 from organizations organization where organization.id = "
                + alias
                + ".organization_id and organization.status = 'active')";
{{- else}}
        return "";
{{- end}}
    }

    private static CRMAccount mapAccount(ResultSet value, int rowNumber) throws SQLException {
        return new CRMAccount(
                value.getString("id"),
                value.getString("organization_id"),
                value.getString("name"),
                value.getString("status"),
                value.getLong("version"),
                instant(value.getTimestamp("created_at")),
                instant(value.getTimestamp("updated_at")));
    }

    private static CRMContact mapContact(ResultSet value, int rowNumber) throws SQLException {
