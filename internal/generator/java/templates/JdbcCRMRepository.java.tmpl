    private static <T> Optional<T> first(List<T> values) {
        return values.isEmpty() ? Optional.empty() : Optional.of(values.getFirst());
    }

    private static <T> PageResult<T> page(
            List<T> source, int limit, Identifier<T> identifier) {
        List<T> values = new ArrayList<>(source);
        String nextCursor = "";
        if (values.size() > limit) {
            nextCursor = identifier.get(values.get(limit - 1));
            values = new ArrayList<>(values.subList(0, limit));
        }
        return new PageResult<>(List.copyOf(values), nextCursor);
    }

    private static void requireMutation(int changed) {
        if (changed != 1) {
            throw conflict(null);
        }
    }

    private static Instant instant(Timestamp timestamp) {
        return timestamp == null ? null : timestamp.toInstant();
    }

    private static String scope(String value) {
        return value == null ? "" : value;
    }

    private static String emptyToNull(String value) {
        return value == null || value.isEmpty() ? null : value;
    }

    private static CRMException notFound() {
        return new CRMException(CRMException.Kind.NOT_FOUND, "CRM record was not found");
    }

    private static CRMException conflict(Throwable cause) {
        CRMException exception =
                new CRMException(
                        CRMException.Kind.CONFLICT,
                        "CRM record changed or conflicts with current state");
        if (cause != null) {
            exception.initCause(cause);
        }
        return exception;
    }

    @FunctionalInterface
    private interface Mutation {
        int run();
    }

    @FunctionalInterface
    private interface Result<T> {
        T get();
    }

    @FunctionalInterface
    private interface Identifier<T> {
        String get(T value);
    }
}
