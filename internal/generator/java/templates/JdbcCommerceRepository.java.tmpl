    @Override
    public void createCoupon(Coupon coupon, AuditEvent audit) {
        try {
            transactionTemplate.executeWithoutResult(
                    status -> {
                        requireOne(
                                jdbcTemplate.update(
                                        "insert into commerce_coupons "
                                                + "(id, organization_id, campaign_id, code, "
                                                + "maximum_uses, redeemed_uses, created_at) "
                                                + "select ?, ?, ?, ?, ?, 0, ? "
                                                + "from commerce_campaigns where id = ? "
                                                + "and coalesce(organization_id, '') = ? "
                                                + "and coupon_required = true "
                                                + "and status <> 'archived'",
                                        coupon.id(),
                                        coupon.organizationId(),
                                        coupon.campaignId(),
                                        coupon.code(),
                                        coupon.maximumUses(),
                                        timestamp(coupon.createdAt()),
                                        coupon.campaignId(),
                                        scope(coupon.organizationId())));
                        appendAudit(audit);
                    });
        } catch (DataIntegrityViolationException exception) {
            throw conflict(exception);
        }
    }

