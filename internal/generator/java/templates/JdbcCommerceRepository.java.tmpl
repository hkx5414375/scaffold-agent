                                        + "and (? = '' or campaign.id > ?) "
                                        + "order by campaign.id limit ?",
                                JdbcCommerceRepository::mapCampaign,
                                scope,
                                cursor,
                                cursor,
                                limit + 1));
        String nextCursor = "";
        if (values.size() > limit) {
            nextCursor = values.get(limit - 1).id();
            values = new ArrayList<>(values.subList(0, limit));
        }
        return new PageResult<>(values, nextCursor);
    }

    private Optional<Cart> lockCart(String scope, String customerId, String currency) {
        return loadCart(scope, customerId, currency, " for update");
    }

    private Optional<Cart> loadCart(String scope, String customerId, String currency) {
        return loadCart(scope, customerId, currency, "");
    }

    private Optional<Cart> loadCart(
            String scope, String customerId, String currency, String suffix) {
        List<Cart> values =
                jdbcTemplate.query(
                        "select cart.id, cart.organization_id, cart.customer_id, "
                                + "cart.currency, cart.status, cart.version, "
                                + "cart.created_at, cart.updated_at "
                                + "from commerce_carts cart "
{{- if .Tenancy}}
                                + "join organizations organization "
                                + "on organization.id = cart.organization_id "
                                + "and organization.status = 'active' "
{{- end}}
                                + "where coalesce(cart.organization_id, '') = ? "
                                + "and cart.customer_id = ? and cart.currency = ? "
                                + "and cart.status = 'active'"
                                + suffix,
                        (resultSet, rowNumber) -> mapCart(resultSet),
                        scope,
                        customerId,
                        currency);
        if (values.isEmpty()) {
            return Optional.empty();
        }
        Cart cart = values.getFirst();
        List<Line> lines =
                jdbcTemplate.query(
                        "select product_id, sku, name, unit_minor, quantity, "
                                + "unit_minor * quantity line_minor "
                                + "from commerce_cart_lines where cart_id = ? "
                                + "order by product_id",
                        JdbcCommerceRepository::mapLine,
                        cart.id());
        long subtotal = 0L;
        try {
            for (Line line : lines) {
                subtotal = Math.addExact(subtotal, line.lineMinor());
            }
        } catch (ArithmeticException exception) {
            throw conflict();
        }
        return Optional.of(
                new Cart(
                        cart.id(),
                        cart.organizationId(),
                        cart.customerId(),
                        cart.currency(),
                        cart.status(),
                        lines,
                        subtotal,
                        cart.version(),
                        cart.createdAt(),
                        cart.updatedAt()));
    }

    private void reservePromotion(CheckoutCommand command) {
        if (command.campaign() != null) {
            requireOne(
                    jdbcTemplate.update(
                            "update commerce_campaigns set updated_at = updated_at "
                                    + "where id = ? and coalesce(organization_id, '') = ? "
                                    + "and status = 'active' and starts_at <= ? "
                                    + "and ends_at > ? and minimum_minor <= ?",
                            command.campaign().id(),
                            scope(command.order().organizationId()),
                            timestamp(command.order().createdAt()),
                            timestamp(command.order().createdAt()),
                            command.order().subtotalMinor()));
        }
        if (command.coupon() != null) {
            requireOne(
                    jdbcTemplate.update(
                            "update commerce_coupons set redeemed_uses = redeemed_uses + 1 "
                                    + "where id = ? and campaign_id = ? "
                                    + "and coalesce(organization_id, '') = ? and code = ? "
                                    + "and redeemed_uses < maximum_uses",
                            command.coupon().id(),
                            command.campaign().id(),
                            scope(command.order().organizationId()),
                            command.coupon().code()));
        }
    }

    private void insertOrder(Order order) {
        jdbcTemplate.update(
                "insert into commerce_orders "
                        + "(id, organization_id, customer_id, status, currency, "
                        + "subtotal_minor, discount_minor, total_minor, campaign_id, "
                        + "coupon_code, fulfillment_ref, return_reason, version, "
                        + "created_at, updated_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, "
                        + "'', '', 1, ?, ?)",
                order.id(),
                order.organizationId(),
                order.customerId(),
                order.status(),
                order.currency(),
                order.subtotalMinor(),
                order.discountMinor(),
                order.totalMinor(),
                order.campaignId(),
                order.couponCode(),
                timestamp(order.createdAt()),
                timestamp(order.updatedAt()));
        for (Line line : order.lines()) {
            jdbcTemplate.update(
                    "insert into commerce_order_lines "
                            + "(order_id, product_id, sku, name, unit_minor, quantity, "
                            + "line_minor) values (?, ?, ?, ?, ?, ?, ?)",
                    order.id(),
                    line.productId(),
                    line.sku(),
                    line.name(),
                    line.unitMinor(),
                    line.quantity(),
                    line.lineMinor());
        }
        PaymentIntent payment = order.payment();
        jdbcTemplate.update(
                "insert into commerce_payment_intents "
                        + "(id, order_id, provider, provider_ref, status, amount_minor, "
                        + "refunded_minor, currency, updated_at) "
                        + "values (?, ?, ?, ?, ?, ?, 0, ?, ?)",
                payment.id(),
                order.id(),
                payment.provider(),
                payment.providerRef(),
                payment.status(),
                payment.amountMinor(),
                payment.currency(),
                timestamp(payment.updatedAt()));
    }

    private Optional<Campaign> getCampaign(String scope, String id) {
        List<Campaign> values =
                jdbcTemplate.query(
                        "select "
                                + CAMPAIGN_COLUMNS
                                + " from commerce_campaigns campaign "
                                + "where campaign.id = ? "
                                + "and coalesce(campaign.organization_id, '') = ?",
                        JdbcCommerceRepository::mapCampaign,
                        id,
                        scope);
        return values.stream().findFirst();
    }

    private void appendOrderEvent(
            String orderId, String from, String to, String reference, Instant now) {
        jdbcTemplate.update(
                "insert into commerce_order_events "
                        + "(id, order_id, from_status, to_status, reference, created_at) "
                        + "values (?, ?, ?, ?, ?, ?)",
                orderId + ":" + UUID.randomUUID(),
                orderId,
                from,
                to,
                reference,
                timestamp(now));
    }

    private void appendAudit(AuditEvent event) {
        jdbcTemplate.update(
                "insert into audit_events "
                        + "(id, user_id, action, outcome, target, ip_address, "
                        + "user_agent, created_at) values (?, ?, ?, ?, ?, ?, ?, ?)",
                event.id(),
                emptyToNull(event.userId()),
                event.action(),
                event.outcome(),
                emptyToNull(event.target()),
                emptyToNull(event.ipAddress()),
                emptyToNull(event.userAgent()),
                timestamp(event.createdAt()));
    }

    private static Cart mapCart(ResultSet resultSet) throws SQLException {
        return new Cart(
                resultSet.getString("id"),
                resultSet.getString("organization_id"),
                resultSet.getString("customer_id"),
                resultSet.getString("currency"),
                resultSet.getString("status"),
                List.of(),
                0L,
                resultSet.getLong("version"),
                instant(resultSet.getTimestamp("created_at")),
                instant(resultSet.getTimestamp("updated_at")));
    }

    private static Line mapLine(ResultSet resultSet, int rowNumber) throws SQLException {
        return new Line(
                resultSet.getString("product_id"),
                resultSet.getString("sku"),
                resultSet.getString("name"),
                resultSet.getLong("unit_minor"),
                resultSet.getLong("quantity"),
                resultSet.getLong("line_minor"));
    }

    private static Order mapOrder(ResultSet resultSet, int rowNumber) throws SQLException {
        PaymentIntent payment =
                new PaymentIntent(
                        resultSet.getString("payment_id"),
                        resultSet.getString("provider"),
                        resultSet.getString("provider_ref"),
                        resultSet.getString("payment_status"),
                        resultSet.getLong("amount_minor"),
                        resultSet.getLong("refunded_minor"),
                        resultSet.getString("payment_currency"),
                        instant(resultSet.getTimestamp("payment_updated_at")));
        return new Order(
                resultSet.getString("id"),
                resultSet.getString("organization_id"),
                resultSet.getString("customer_id"),
                resultSet.getString("status"),
                resultSet.getString("currency"),
                resultSet.getLong("subtotal_minor"),
                resultSet.getLong("discount_minor"),
                resultSet.getLong("total_minor"),
                resultSet.getString("campaign_id"),
                resultSet.getString("coupon_code"),
                List.of(),
                payment,
                resultSet.getString("fulfillment_ref"),
                resultSet.getString("return_reason"),
                resultSet.getLong("version"),
                instant(resultSet.getTimestamp("created_at")),
                instant(resultSet.getTimestamp("updated_at")));
    }

    private static Order withLines(Order order, List<Line> lines) {
        return new Order(
                order.id(),
                order.organizationId(),
                order.customerId(),
                order.status(),
                order.currency(),
                order.subtotalMinor(),
                order.discountMinor(),
                order.totalMinor(),
                order.campaignId(),
                order.couponCode(),
                lines,
                order.payment(),
                order.fulfillmentRef(),
                order.returnReason(),
                order.version(),
                order.createdAt(),
                order.updatedAt());
    }

    private static Campaign mapCampaign(ResultSet resultSet, int rowNumber)
            throws SQLException {
        return new Campaign(
                resultSet.getString("id"),
                resultSet.getString("organization_id"),
                resultSet.getString("name"),
                resultSet.getString("kind"),
                resultSet.getLong("value"),
                resultSet.getLong("minimum_minor"),
                resultSet.getString("currency"),
                resultSet.getInt("priority"),
                resultSet.getBoolean("coupon_required"),
                resultSet.getString("status"),
                instant(resultSet.getTimestamp("starts_at")),
                instant(resultSet.getTimestamp("ends_at")),
                resultSet.getLong("version"),
                instant(resultSet.getTimestamp("created_at")),
                instant(resultSet.getTimestamp("updated_at")));
    }

    private static Promotion mapPromotion(ResultSet resultSet, int rowNumber)
            throws SQLException {
        Campaign campaign = mapCampaign(resultSet, rowNumber);
        Coupon coupon =
                new Coupon(
                        resultSet.getString("coupon_id"),
                        resultSet.getString("coupon_org"),
                        resultSet.getString("coupon_campaign"),
                        resultSet.getString("coupon_code"),
                        resultSet.getLong("maximum_uses"),
                        resultSet.getLong("redeemed_uses"),
                        instant(resultSet.getTimestamp("coupon_created")));
        return new Promotion(campaign, coupon);
    }

    private static void requireOne(int changed) {
        if (changed != 1) {
            throw conflict();
        }
    }

    private static Timestamp timestamp(Instant value) {
        return Timestamp.from(value);
    }

    private static Instant instant(Timestamp value) {
        return value == null ? null : value.toInstant();
    }

    private static String scope(String value) {
        return value == null ? "" : value;
    }

    private static String emptyToNull(String value) {
        return value == null || value.isEmpty() ? null : value;
    }

    private static CommerceException notFound() {
        return new CommerceException(
                CommerceException.Kind.NOT_FOUND, "commerce record was not found");
    }

    private static CommerceException conflict() {
        return conflict(null);
    }

    private static CommerceException conflict(Throwable cause) {
        CommerceException exception =
                new CommerceException(
                        CommerceException.Kind.CONFLICT, "commerce state conflicts");
        if (cause != null) {
            exception.initCause(cause);
        }
        return exception;
    }

