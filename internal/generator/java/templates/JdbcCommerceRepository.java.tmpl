                    + "order_value.version, order_value.created_at, order_value.updated_at, "
                    + "payment.id payment_id, payment.provider, payment.provider_ref, "
                    + "payment.status payment_status, payment.amount_minor, "
                    + "payment.refunded_minor, payment.currency payment_currency, "
                    + "payment.updated_at payment_updated_at";

    private static final String CAMPAIGN_COLUMNS =
            "campaign.id, campaign.organization_id, campaign.name, campaign.kind, "
                    + "campaign.value, campaign.minimum_minor, campaign.currency, "
                    + "campaign.priority, campaign.coupon_required, campaign.status, "
