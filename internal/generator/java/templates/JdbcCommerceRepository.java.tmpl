    @Override
    public Cart removeLine(
            String scope,
            String customerId,
            String currency,
            String productId,
            long version,
            Instant now) {
        return Objects.requireNonNull(
                transactionTemplate.execute(
                        status -> {
                            Cart cart =
                                    lockCart(scope, customerId, currency)
                                            .orElseThrow(JdbcCommerceRepository::notFound);
                            if (cart.version() != version) {
                                throw conflict();
                            }
                            requireOne(
                                    jdbcTemplate.update(
                                            "delete from commerce_cart_lines "
                                                    + "where cart_id = ? and product_id = ?",
                                            cart.id(),
                                            productId));
                            requireOne(
                                    jdbcTemplate.update(
                                            "update commerce_carts set version = version + 1, "
                                                    + "updated_at = ? where id = ? "
                                                    + "and status = 'active' and version = ?",
                                            timestamp(now),
                                            cart.id(),
                                            version));
                            return loadCart(scope, customerId, currency)
                                    .orElseThrow(JdbcCommerceRepository::notFound);
                        }));
    }

    @Override
    public Optional<Promotion> promotion(
            String scope,
            String currency,
            String couponCode,
            long subtotalMinor,
            Instant now) {
        if (!couponCode.isEmpty()) {
            List<Promotion> values =
                    jdbcTemplate.query(
                            "select "
                                    + CAMPAIGN_COLUMNS
                                    + ", coupon.id coupon_id, coupon.organization_id coupon_org, "
                                    + "coupon.campaign_id coupon_campaign, coupon.code coupon_code, "
                                    + "coupon.maximum_uses, coupon.redeemed_uses, "
                                    + "coupon.created_at coupon_created "
                                    + "from commerce_campaigns campaign join commerce_coupons coupon "
                                    + "on coupon.campaign_id = campaign.id "
                                    + "and coalesce(coupon.organization_id, '') = "
                                    + "coalesce(campaign.organization_id, '') "
                                    + "where coalesce(campaign.organization_id, '') = ? "
                                    + "and campaign.currency = ? and campaign.status = 'active' "
                                    + "and campaign.starts_at <= ? and campaign.ends_at > ? "
                                    + "and campaign.minimum_minor <= ? and coupon.code = ? "
                                    + "and coupon.redeemed_uses < coupon.maximum_uses "
                                    + "order by campaign.priority desc, campaign.id limit 1",
                            JdbcCommerceRepository::mapPromotion,
                            scope,
                            currency,
                            timestamp(now),
                            timestamp(now),
                            subtotalMinor,
                            couponCode);
            return values.stream().findFirst();
        }
        List<Campaign> values =
                jdbcTemplate.query(
                        "select "
                                + CAMPAIGN_COLUMNS
                                + " from commerce_campaigns campaign "
                                + "where coalesce(campaign.organization_id, '') = ? "
                                + "and campaign.currency = ? and campaign.status = 'active' "
                                + "and campaign.coupon_required = false "
                                + "and campaign.starts_at <= ? and campaign.ends_at > ? "
                                + "and campaign.minimum_minor <= ? "
                                + "order by campaign.priority desc, campaign.id limit 1",
                        JdbcCommerceRepository::mapCampaign,
                        scope,
                        currency,
                        timestamp(now),
                        timestamp(now),
                        subtotalMinor);
        return values.stream().findFirst().map(value -> new Promotion(value, null));
    }

    @Override
    public Optional<Order> replayCheckout(
            String scope,
            String customerId,
            String key,
            String currency,
            String couponCode,
            long cartVersion) {
        List<Replay> values =
                jdbcTemplate.query(
                        "select idempotency.order_id, order_value.currency, "
                                + "idempotency.coupon_code, idempotency.cart_version "
                                + "from commerce_checkout_idempotency idempotency "
                                + "join commerce_orders order_value "
                                + "on order_value.id = idempotency.order_id "
                                + "where idempotency.organization_scope = ? "
                                + "and idempotency.customer_id = ? "
                                + "and idempotency.idempotency_key = ?",
                        (resultSet, rowNumber) ->
                                new Replay(
                                        resultSet.getString("order_id"),
                                        resultSet.getString("currency"),
                                        resultSet.getString("coupon_code"),
                                        resultSet.getLong("cart_version")),
                        scope,
                        customerId,
                        key);
        if (values.isEmpty()) {
            return Optional.empty();
        }
        Replay replay = values.getFirst();
        if (!currency.equals(replay.currency())
                || !couponCode.equals(replay.couponCode())
                || cartVersion != replay.cartVersion()) {
            throw conflict();
        }
        return getOrder(scope, customerId, replay.orderId());
    }

    @Override
    public Order checkout(CheckoutCommand command) {
        try {
            return Objects.requireNonNull(
                    transactionTemplate.execute(
                            status -> {
                                Optional<Order> replay =
                                        replayCheckout(
                                                scope(command.order().organizationId()),
                                                command.order().customerId(),
                                                command.idempotencyKey(),
                                                command.order().currency(),
                                                command.coupon() == null
                                                        ? ""
                                                        : command.coupon().code(),
                                                command.cartVersion());
                                if (replay.isPresent()) {
                                    return replay.get();
                                }
                                requireOne(
                                        jdbcTemplate.update(
                                                "update commerce_carts set status = "
                                                        + "'checked_out', version = version + 1, "
                                                        + "updated_at = ? where id = ? "
                                                        + "and coalesce(organization_id, '') = ? "
                                                        + "and customer_id = ? and status = 'active' "
                                                        + "and version = ?",
                                                timestamp(command.order().updatedAt()),
                                                command.cartId(),
                                                scope(command.order().organizationId()),
                                                command.order().customerId(),
                                                command.cartVersion()));
                                reservePromotion(command);
                                insertOrder(command.order());
                                jdbcTemplate.update(
                                        "insert into commerce_checkout_idempotency "
                                                + "(organization_scope, customer_id, "
                                                + "idempotency_key, cart_id, cart_version, "
                                                + "coupon_code, order_id) values (?, ?, ?, ?, ?, ?, ?)",
                                        scope(command.order().organizationId()),
                                        command.order().customerId(),
                                        command.idempotencyKey(),
                                        command.cartId(),
                                        command.cartVersion(),
                                        command.coupon() == null ? "" : command.coupon().code(),
                                        command.order().id());
                                appendOrderEvent(
                                        command.order().id(),
                                        "",
                                        command.order().status(),
                                        "",
                                        command.order().createdAt());
                                appendAudit(command.audit());
                                return command.order();
                            }));
        } catch (DataIntegrityViolationException exception) {
            throw conflict(exception);
        }
    }

    @Override
    public Optional<Order> getOrder(String scope, String customerId, String id) {
        List<Order> values =
                jdbcTemplate.query(
                        "select "
                                + ORDER_COLUMNS
                                + " from commerce_orders order_value "
                                + "join commerce_payment_intents payment "
                                + "on payment.order_id = order_value.id "
                                + "where order_value.id = ? "
                                + "and (? = '' or coalesce(order_value.organization_id, '') = ?) "
                                + "and (? = '' or order_value.customer_id = ?)",
                        JdbcCommerceRepository::mapOrder,
                        id,
                        scope,
                        scope,
                        customerId,
                        customerId);
        if (values.isEmpty()) {
            return Optional.empty();
        }
        Order order = values.getFirst();
        List<Line> lines =
                jdbcTemplate.query(
                        "select product_id, sku, name, unit_minor, quantity, line_minor "
                                + "from commerce_order_lines where order_id = ? "
                                + "order by product_id",
                        JdbcCommerceRepository::mapLine,
                        id);
        return Optional.of(withLines(order, lines));
    }

    @Override
    public PageResult<Order> listOrders(
            String scope, String customerId, String cursor, int limit) {
        List<String> ids =
                new ArrayList<>(
                        jdbcTemplate.queryForList(
                                "select id from commerce_orders "
                                        + "where coalesce(organization_id, '') = ? "
                                        + "and (? = '' or customer_id = ?) "
                                        + "and (? = '' or id > ?) order by id limit ?",
                                String.class,
                                scope,
                                customerId,
                                customerId,
                                cursor,
                                cursor,
                                limit + 1));
        String nextCursor = "";
        if (ids.size() > limit) {
            nextCursor = ids.get(limit - 1);
            ids = new ArrayList<>(ids.subList(0, limit));
        }
        List<Order> orders = new ArrayList<>(ids.size());
        for (String id : ids) {
            orders.add(getOrder(scope, customerId, id).orElseThrow(JdbcCommerceRepository::notFound));
        }
        return new PageResult<>(orders, nextCursor);
    }

    @Override
    public Order applyPayment(
            String providerReference, String eventId, String status, Instant now) {
        try {
            return Objects.requireNonNull(
                    transactionTemplate.execute(
                            transaction -> {
                                List<PaymentReplay> replay =
                                        jdbcTemplate.query(
                                                "select provider_ref, status, order_id "
                                                        + "from commerce_payment_events "
                                                        + "where provider = 'sandbox' "
                                                        + "and event_id = ?",
                                                (resultSet, rowNumber) ->
                                                        new PaymentReplay(
                                                                resultSet.getString("provider_ref"),
                                                                resultSet.getString("status"),
                                                                resultSet.getString("order_id")),
                                                eventId);
                                if (!replay.isEmpty()) {
                                    PaymentReplay value = replay.getFirst();
                                    if (!providerReference.equals(value.providerReference())
                                            || !status.equals(value.status())) {
                                        throw conflict();
                                    }
                                    return getOrder("", "", value.orderId())
                                            .orElseThrow(JdbcCommerceRepository::notFound);
                                }
                                List<PaymentState> states =
                                        jdbcTemplate.query(
                                                "select payment.order_id, "
                                                        + "coalesce(order_value.organization_id, '') "
                                                        + "organization_scope, payment.status "
                                                        + "from commerce_payment_intents payment "
                                                        + "join commerce_orders order_value "
                                                        + "on order_value.id = payment.order_id "
                                                        + "where payment.provider_ref = ? for update",
                                                (resultSet, rowNumber) ->
                                                        new PaymentState(
                                                                resultSet.getString("order_id"),
                                                                resultSet.getString("organization_scope"),
                                                                resultSet.getString("status")),
                                                providerReference);
                                if (states.isEmpty()) {
                                    throw notFound();
                                }
                                PaymentState current = states.getFirst();
                                if (!REQUIRES_ACTION.equals(current.status())
                                        && !status.equals(current.status())) {
                                    throw conflict();
                                }
                                if (REQUIRES_ACTION.equals(current.status())) {
                                    requireOne(
                                            jdbcTemplate.update(
                                                    "update commerce_payment_intents set status = ?, "
                                                            + "updated_at = ? where provider_ref = ? "
                                                            + "and status = 'requires_action'",
                                                    status,
                                                    timestamp(now),
                                                    providerReference));
                                    String orderStatus =
                                            SUCCEEDED.equals(status) ? CONFIRMED : CANCELLED;
                                    requireOne(
                                            jdbcTemplate.update(
                                                    "update commerce_orders set status = ?, "
                                                            + "version = version + 1, updated_at = ? "
                                                            + "where id = ? and status = 'pending_payment'",
                                                    orderStatus,
                                                    timestamp(now),
                                                    current.orderId()));
                                    appendOrderEvent(
                                            current.orderId(),
                                            PENDING_PAYMENT,
                                            orderStatus,
                                            providerReference,
                                            now);
                                }
                                jdbcTemplate.update(
                                        "insert into commerce_payment_events "
                                                + "(provider, event_id, provider_ref, status, "
                                                + "order_id, created_at) values "
                                                + "('sandbox', ?, ?, ?, ?, ?)",
                                        eventId,
                                        providerReference,
                                        status,
                                        current.orderId(),
                                        timestamp(now));
                                return getOrder(current.scope(), "", current.orderId())
                                        .orElseThrow(JdbcCommerceRepository::notFound);
                            }));
        } catch (DataIntegrityViolationException exception) {
            throw conflict(exception);
        }
    }

    @Override
    public Order transitionOrder(OrderTransition command) {
        return Objects.requireNonNull(
                transactionTemplate.execute(
                        status -> {
                            String fulfillment =
                                    FULFILLED.equals(command.toStatus())
                                            ? command.reference()
                                            : "";
                            String returnReason =
                                    RETURN_REQUESTED.equals(command.toStatus())
                                            ? command.reference()
                                            : "";
                            requireOne(
                                    jdbcTemplate.update(
                                            "update commerce_orders set status = ?, "
                                                    + "fulfillment_ref = case when ? <> '' "
                                                    + "then ? else fulfillment_ref end, "
                                                    + "return_reason = case when ? <> '' "
                                                    + "then ? else return_reason end, "
                                                    + "version = version + 1, updated_at = ? "
                                                    + "where id = ? and "
                                                    + "coalesce(organization_id, '') = ? "
                                                    + "and version = ? and status = ?",
                                            command.toStatus(),
                                            fulfillment,
                                            fulfillment,
                                            returnReason,
                                            returnReason,
                                            timestamp(command.now()),
                                            command.id(),
                                            command.scope(),
                                            command.version(),
                                            command.fromStatus()));
                            appendOrderEvent(
                                    command.id(),
                                    command.fromStatus(),
                                    command.toStatus(),
                                    command.reference(),
                                    command.now());
                            appendAudit(command.audit());
                            return getOrder(command.scope(), "", command.id())
                                    .orElseThrow(JdbcCommerceRepository::notFound);
                        }));
    }

    @Override
    public Order refund(RefundCommand command) {
        try {
            return Objects.requireNonNull(
                    transactionTemplate.execute(
                            status -> {
                                List<RefundReplay> replays =
                                        jdbcTemplate.query(
                                                "select payment_id, provider_ref, amount_minor "
                                                        + "from commerce_refunds "
                                                        + "where organization_scope = ? "
                                                        + "and idempotency_key = ?",
                                                (resultSet, rowNumber) ->
                                                        new RefundReplay(
                                                                resultSet.getString("payment_id"),
                                                                resultSet.getString("provider_ref"),
                                                                resultSet.getLong("amount_minor")),
                                                command.scope(),
                                                command.idempotencyKey());
                                List<String> paymentIds =
                                        jdbcTemplate.queryForList(
                                                "select payment.id "
                                                        + "from commerce_payment_intents payment "
                                                        + "join commerce_orders order_value "
                                                        + "on order_value.id = payment.order_id "
                                                        + "where payment.order_id = ? and "
                                                        + "coalesce(order_value.organization_id, '') = ?",
                                                String.class,
                                                command.orderId(),
                                                command.scope());
                                if (paymentIds.isEmpty()) {
                                    throw notFound();
                                }
                                String paymentId = paymentIds.getFirst();
                                if (!replays.isEmpty()) {
                                    RefundReplay replay = replays.getFirst();
                                    if (!paymentId.equals(replay.paymentId())
                                            || !command.providerRefundReference()
                                                    .equals(replay.providerReference())
                                            || command.amountMinor() != replay.amountMinor()) {
                                        throw conflict();
                                    }
                                    return getOrder(command.scope(), "", command.orderId())
                                            .orElseThrow(JdbcCommerceRepository::notFound);
                                }
                                requireOne(
                                        jdbcTemplate.update(
                                                "update commerce_payment_intents set "
                                                        + "refunded_minor = refunded_minor + ?, "
                                                        + "updated_at = ? where id = ? "
                                                        + "and status = 'succeeded' and "
                                                        + "refunded_minor + ? <= amount_minor",
                                                command.amountMinor(),
                                                timestamp(command.now()),
                                                paymentId,
                                                command.amountMinor()));
                                jdbcTemplate.update(
                                        "insert into commerce_refunds "
                                                + "(organization_scope, payment_id, "
                                                + "idempotency_key, provider_ref, amount_minor, "
                                                + "created_at) values (?, ?, ?, ?, ?, ?)",
                                        command.scope(),
                                        paymentId,
                                        command.idempotencyKey(),
                                        command.providerRefundReference(),
                                        command.amountMinor(),
                                        timestamp(command.now()));
                                appendAudit(command.audit());
                                return getOrder(command.scope(), "", command.orderId())
                                        .orElseThrow(JdbcCommerceRepository::notFound);
                            }));
        } catch (DataIntegrityViolationException exception) {
            throw conflict(exception);
        }
    }

    @Override
    public void createCampaign(Campaign campaign, AuditEvent audit) {
        try {
            transactionTemplate.executeWithoutResult(
                    status -> {
                        jdbcTemplate.update(
                                "insert into commerce_campaigns "
                                        + "(id, organization_id, name, kind, value, "
                                        + "minimum_minor, currency, priority, coupon_required, "
                                        + "status, starts_at, ends_at, version, created_at, "
                                        + "updated_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, "
                                        + "?, ?, ?, ?, ?)",
                                campaign.id(),
                                campaign.organizationId(),
                                campaign.name(),
                                campaign.kind(),
                                campaign.value(),
                                campaign.minimumMinor(),
                                campaign.currency(),
                                campaign.priority(),
                                campaign.couponRequired(),
                                campaign.status(),
                                timestamp(campaign.startsAt()),
                                timestamp(campaign.endsAt()),
                                campaign.version(),
                                timestamp(campaign.createdAt()),
                                timestamp(campaign.updatedAt()));
                        appendAudit(audit);
                    });
        } catch (DataIntegrityViolationException exception) {
            throw conflict(exception);
        }
    }

    @Override
    public Campaign transitionCampaign(CampaignTransition command) {
        return Objects.requireNonNull(
                transactionTemplate.execute(
                        status -> {
                            requireOne(
                                    jdbcTemplate.update(
                                            "update commerce_campaigns set status = ?, "
                                                    + "version = version + 1, updated_at = ? "
                                                    + "where id = ? and "
                                                    + "coalesce(organization_id, '') = ? "
                                                    + "and version = ? and status = ?",
                                            command.toStatus(),
