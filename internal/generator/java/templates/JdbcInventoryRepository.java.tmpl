    @Override
    public StockResult applyStock(StockCommand command) {
        return transact(
                command.scope(),
                () -> {
                    Optional<StockResult> replay =
                            claim(command, "stock", StockResult.class, command.movement().createdAt());
                    if (replay.isPresent()) {
                        return replay.get();
                    }
                    requireActiveStock(
                            command.scope(),
                            command.movement().itemId(),
                            command.movement().warehouseId());
                    Balance balance =
                            lockBalance(
                                    command.scope(),
                                    command.movement().itemId(),
                                    command.movement().warehouseId(),
                                    command.movement().createdAt());
                    long onHand = add(balance.onHand(), command.movement().quantityDelta());
                    long reserved = add(balance.reserved(), command.movement().reservedDelta());
                    validateBalance(onHand, reserved);
                    Balance updated =
                            updateBalance(
                                    command.scope(),
                                    balance,
                                    onHand,
                                    reserved,
                                    command.movement().createdAt());
                    insertMovement(command.scope(), command.movement());
                    StockResult result = new StockResult(updated, command.movement());
                    completeClaim(
                            command.scope(),
                            command.idempotencyKey(),
                            command.movement().referenceId(),
                            command.movement().id(),
                            result);
                    appendAudit(command.audit());
                    return result;
                });
    }

    @Override
    public ReservationResult createReservation(ReservationCommand command) {
        return transact(
                command.scope(),
                () -> {
                    Optional<ReservationResult> replay =
                            claim(
                                    command,
                                    "reservation",
                                    ReservationResult.class,
                                    command.reservation().createdAt());
                    if (replay.isPresent()) {
                        return replay.get();
                    }
                    Reservation value = command.reservation();
                    requireActiveStock(command.scope(), value.itemId(), value.warehouseId());
                    Balance balance =
                            lockBalance(
                                    command.scope(),
                                    value.itemId(),
                                    value.warehouseId(),
                                    value.createdAt());
                    long reserved = add(balance.reserved(), value.quantity());
                    validateBalance(balance.onHand(), reserved);
                    requireOne(
                            jdbcTemplate.update(
                                    "insert into inventory_reservations "
                                            + "(id, organization_id, external_reference, item_id, "
                                            + "warehouse_id, quantity, status, version, created_at, "
                                            + "updated_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                                    value.id(),
                                    command.scope(),
                                    value.externalReference(),
                                    value.itemId(),
                                    value.warehouseId(),
                                    value.quantity(),
                                    value.status(),
                                    value.version(),
                                    Timestamp.from(value.createdAt()),
                                    Timestamp.from(value.updatedAt())));
                    Balance updated =
                            updateBalance(
                                    command.scope(),
                                    balance,
                                    balance.onHand(),
                                    reserved,
                                    value.updatedAt());
                    insertMovement(command.scope(), command.movement());
                    ReservationResult result =
                            new ReservationResult(value, updated, command.movement());
                    completeClaim(
                            command.scope(),
                            command.idempotencyKey(),
                            value.id(),
                            command.movement().id(),
                            result);
                    appendAudit(command.audit());
                    return result;
                });
    }

