    private static <T> Optional<T> first(List<T> values) {
        return values.isEmpty() ? Optional.empty() : Optional.of(values.getFirst());
    }

    private static <T> PageResult<T> page(
            List<T> source, int limit, Identifier<T> identifier) {
        List<T> values = new ArrayList<>(source);
        String nextCursor = "";
        if (values.size() > limit) {
            nextCursor = identifier.get(values.get(limit - 1));
            values = new ArrayList<>(values.subList(0, limit));
        }
        return new PageResult<>(List.copyOf(values), nextCursor);
    }

    private static void validateBalance(long onHand, long reserved) {
        if (onHand < 0L || reserved < 0L || reserved > onHand) {
            throw conflict(null);
        }
    }

    private static long add(long left, long right) {
        try {
            return Math.addExact(left, right);
        } catch (ArithmeticException exception) {
            throw conflict(exception);
        }
    }

    private static void requireOne(int changed) {
        if (changed != 1) {
            throw conflict(null);
        }
    }

    private static Instant instant(Timestamp value) {
        return value == null ? null : value.toInstant();
    }

    private static String scope(String value) {
        return value == null ? "" : value;
    }

    private static String emptyToNull(String value) {
        return value == null || value.isEmpty() ? null : value;
    }

    private static boolean blank(String value) {
        return value == null || value.isEmpty();
    }

    private static InventoryException notFound() {
        return new InventoryException(
                InventoryException.Kind.NOT_FOUND, "inventory record was not found");
    }

    private static InventoryException conflict(Throwable cause) {
        InventoryException exception =
                new InventoryException(
                        InventoryException.Kind.CONFLICT,
                        "inventory record changed or conflicts with current state");
        if (cause != null) {
            exception.initCause(cause);
        }
        return exception;
    }

    private record IdempotencyRecord(
            String fingerprint,
            String resultType,
            String resultId,
            String movementId,
            String payload) {}

    @FunctionalInterface
    private interface Operation<T> {
        T run();
    }

    @FunctionalInterface
    private interface Identifier<T> {
        String get(T value);
    }
}
