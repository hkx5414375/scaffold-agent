    @Override
    public ReservationResult transitionReservation(ReservationTransitionCommand command) {
        return transact(
                command.scope(),
                () -> {
                    Optional<ReservationResult> replay =
                            claim(
                                    command,
                                    "reservation",
                                    ReservationResult.class,
                                    command.occurredAt());
                    if (replay.isPresent()) {
                        return replay.get();
                    }
                    Reservation current = lockReservation(command.scope(), command.reservationId());
                    if (!InventoryService.RESERVATION_ACTIVE.equals(current.status())
                            || current.version() != command.version()) {
                        throw conflict(null);
                    }
                    Balance balance =
                            lockBalance(
                                    command.scope(),
                                    current.itemId(),
                                    current.warehouseId(),
                                    command.occurredAt());
                    long quantityDelta = 0L;
                    String kind = "reservation_released";
                    String reason = "stock reservation released";
                    if (InventoryService.CONSUMED.equals(command.target())) {
                        quantityDelta = Math.negateExact(current.quantity());
                        kind = "reservation_consumed";
                        reason = "stock reservation consumed";
                    }
                    long onHand = add(balance.onHand(), quantityDelta);
                    long reserved = add(balance.reserved(), Math.negateExact(current.quantity()));
                    validateBalance(onHand, reserved);
                    requireOne(
                            jdbcTemplate.update(
                                    "update inventory_reservations set status = ?, "
                                            + "version = version + 1, updated_at = ? "
                                            + "where id = ? and organization_id = ? "
                                            + "and version = ? and status = 'active'",
                                    command.target(),
                                    Timestamp.from(command.occurredAt()),
                                    current.id(),
                                    command.scope(),
                                    command.version()));
                    Reservation updatedReservation =
                            getReservationInside(command.scope(), current.id());
                    Balance updatedBalance =
                            updateBalance(
                                    command.scope(),
                                    balance,
                                    onHand,
                                    reserved,
                                    command.occurredAt());
                    Movement movement =
                            new Movement(
                                    command.movementId(),
                                    emptyToNull(command.scope()),
                                    current.itemId(),
                                    current.warehouseId(),
                                    kind,
                                    quantityDelta,
                                    Math.negateExact(current.quantity()),
                                    "reservation",
                                    current.id(),
                                    reason,
                                    command.idempotencyKey(),
                                    command.actorId(),
                                    command.occurredAt());
                    insertMovement(command.scope(), movement);
                    ReservationResult result =
                            new ReservationResult(updatedReservation, updatedBalance, movement);
                    completeClaim(
                            command.scope(),
                            command.idempotencyKey(),
                            current.id(),
                            movement.id(),
                            result);
                    appendAudit(command.audit());
                    return result;
                });
    }

    @Override
    public void createPurchaseOrder(PurchaseOrder value, AuditEvent audit) {
        transact(
                scope(value.organizationId()),
                () -> {
                    String organizationId = scope(value.organizationId());
                    for (PurchaseOrderLine line : value.lines()) {
                        requireActiveItem(organizationId, line.itemId());
                    }
                    requireOne(
                            jdbcTemplate.update(
                                    "insert into inventory_purchase_orders "
                                            + "(id, organization_id, order_number, supplier_name, "
                                            + "status, version, created_at, updated_at) "
                                            + "values (?, ?, ?, ?, ?, ?, ?, ?)",
                                    value.id(),
                                    organizationId,
                                    value.number(),
                                    value.supplierName(),
                                    value.status(),
                                    value.version(),
                                    Timestamp.from(value.createdAt()),
                                    Timestamp.from(value.updatedAt())));
                    for (PurchaseOrderLine line : value.lines()) {
                        requireOne(
                                jdbcTemplate.update(
                                        "insert into inventory_purchase_order_lines "
                                                + "(id, purchase_order_id, item_id, ordered_quantity, "
                                                + "received_quantity) values (?, ?, ?, ?, ?)",
                                        line.id(),
                                        value.id(),
                                        line.itemId(),
                                        line.orderedQuantity(),
                                        line.receivedQuantity()));
                    }
                    appendAudit(audit);
                    return Boolean.TRUE;
                });
    }

