    @Override
    public PurchaseOrder transitionPurchaseOrder(
            String scope,
            String id,
            long version,
            String target,
            Instant now,
            AuditEvent audit) {
        return transact(
                scope,
                () -> {
                    String condition = "status = 'draft'";
                    if (InventoryService.CANCELLED.equals(target)) {
                        condition =
                                "status in ('draft', 'submitted') and not exists (select 1 from "
                                        + "inventory_purchase_order_lines line where "
                                        + "line.purchase_order_id = inventory_purchase_orders.id "
                                        + "and line.received_quantity > 0)";
                    }
                    requireOne(
                            jdbcTemplate.update(
                                    "update inventory_purchase_orders set status = ?, "
                                            + "version = version + 1, updated_at = ? "
                                            + "where id = ? and organization_id = ? and version = ? and "
                                            + condition,
                                    target,
                                    Timestamp.from(now),
                                    id,
                                    scope,
                                    version));
                    appendAudit(audit);
                    return getPurchaseOrderInside(scope, id);
                });
    }

    @Override
    public ReceiptResult receivePurchaseOrder(ReceiptCommand command) {
        return transact(
                command.scope(),
                () -> {
                    Optional<ReceiptResult> replay =
                            claim(command, "receipt", ReceiptResult.class, command.occurredAt());
                    if (replay.isPresent()) {
                        return replay.get();
                    }
                    PurchaseOrder purchase =
                            lockPurchaseOrder(command.scope(), command.purchaseOrderId());
                    if (purchase.version() != command.version()
                            || (!InventoryService.SUBMITTED.equals(purchase.status())
                                    && !InventoryService.PARTIALLY_RECEIVED.equals(
                                            purchase.status()))) {
                        throw conflict(null);
                    }
                    PurchaseOrderLine line = lockPurchaseLine(purchase.id(), command.lineId());
                    long received = add(line.receivedQuantity(), command.quantity());
                    if (received > line.orderedQuantity()) {
                        throw conflict(null);
                    }
                    requireActiveStock(command.scope(), line.itemId(), command.warehouseId());
                    Balance balance =
                            lockBalance(
                                    command.scope(),
                                    line.itemId(),
                                    command.warehouseId(),
                                    command.occurredAt());
                    requireOne(
                            jdbcTemplate.update(
                                    "update inventory_purchase_order_lines "
                                            + "set received_quantity = ? where id = ?",
                                    received,
                                    line.id()));
                    Integer remaining =
                            jdbcTemplate.queryForObject(
                                    "select count(*) from inventory_purchase_order_lines "
                                            + "where purchase_order_id = ? "
                                            + "and received_quantity < ordered_quantity",
                                    Integer.class,
                                    purchase.id());
                    String target =
                            remaining != null && remaining > 0
                                    ? InventoryService.PARTIALLY_RECEIVED
                                    : InventoryService.RECEIVED;
                    requireOne(
                            jdbcTemplate.update(
                                    "update inventory_purchase_orders set status = ?, "
                                            + "version = version + 1, updated_at = ? "
                                            + "where id = ? and organization_id = ? and version = ?",
                                    target,
                                    Timestamp.from(command.occurredAt()),
                                    purchase.id(),
                                    command.scope(),
                                    command.version()));
                    Balance updatedBalance =
                            updateBalance(
                                    command.scope(),
                                    balance,
                                    add(balance.onHand(), command.quantity()),
                                    balance.reserved(),
                                    command.occurredAt());
                    Movement movement =
                            new Movement(
                                    command.movementId(),
                                    emptyToNull(command.scope()),
                                    line.itemId(),
                                    command.warehouseId(),
                                    "purchase_received",
                                    command.quantity(),
                                    0L,
                                    "purchase_order",
                                    purchase.id(),
                                    "purchase order received",
                                    command.idempotencyKey(),
                                    command.actorId(),
                                    command.occurredAt());
                    insertMovement(command.scope(), movement);
                    PurchaseOrder updatedPurchase =
                            getPurchaseOrderInside(command.scope(), purchase.id());
                    ReceiptResult result =
                            new ReceiptResult(updatedPurchase, updatedBalance, movement);
                    completeClaim(
                            command.scope(),
                            command.idempotencyKey(),
                            purchase.id(),
                            movement.id(),
                            result);
                    appendAudit(command.audit());
                    return result;
                });
    }

