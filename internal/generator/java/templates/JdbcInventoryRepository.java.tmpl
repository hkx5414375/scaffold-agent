    private <T> Optional<T> claim(
            StockCommand command, String type, Class<T> resultClass, Instant now) {
        return claim(
                command.scope(),
                command.idempotencyKey(),
                command.fingerprint(),
                type,
                resultClass,
                now);
    }

    private <T> Optional<T> claim(
            ReservationCommand command, String type, Class<T> resultClass, Instant now) {
        return claim(
                command.scope(),
                command.idempotencyKey(),
                command.fingerprint(),
                type,
                resultClass,
                now);
    }

    private <T> Optional<T> claim(
            ReservationTransitionCommand command,
            String type,
            Class<T> resultClass,
            Instant now) {
        return claim(
                command.scope(),
                command.idempotencyKey(),
                command.fingerprint(),
                type,
                resultClass,
                now);
    }

    private <T> Optional<T> claim(
            ReceiptCommand command, String type, Class<T> resultClass, Instant now) {
        return claim(
                command.scope(),
                command.idempotencyKey(),
                command.fingerprint(),
                type,
                resultClass,
                now);
    }

    private <T> Optional<T> claim(
            String scope,
            String key,
            String fingerprint,
            String resultType,
            Class<T> resultClass,
            Instant now) {
        int inserted =
                jdbcTemplate.update(
{{- if eq .Database.Engine "postgresql"}}
                        "insert into inventory_idempotency "
                                + "(organization_id, idempotency_key, fingerprint, result_type, "
                                + "created_at) values (?, ?, ?, ?, ?) "
                                + "on conflict (organization_id, idempotency_key) do nothing",
{{- else}}
                        "insert ignore into inventory_idempotency "
                                + "(organization_id, idempotency_key, fingerprint, result_type, "
                                + "created_at) values (?, ?, ?, ?, ?)",
{{- end}}
                        scope,
                        key,
                        fingerprint,
                        resultType,
                        Timestamp.from(now));
        if (inserted == 1) {
            return Optional.empty();
        }
        List<IdempotencyRecord> records =
                jdbcTemplate.query(
                        "select fingerprint, result_type, result_id, movement_id, result_payload "
                                + "from inventory_idempotency "
                                + "where organization_id = ? and idempotency_key = ?",
                        (value, rowNumber) ->
                                new IdempotencyRecord(
                                        value.getString("fingerprint"),
                                        value.getString("result_type"),
                                        value.getString("result_id"),
                                        value.getString("movement_id"),
                                        value.getString("result_payload")),
                        scope,
                        key);
        if (records.size() != 1) {
            throw conflict(null);
        }
        IdempotencyRecord record = records.getFirst();
        if (!fingerprint.equals(record.fingerprint())
                || !resultType.equals(record.resultType())
                || blank(record.resultId())
                || blank(record.movementId())
                || blank(record.payload())) {
            throw conflict(null);
        }
        try {
            return Optional.of(objectMapper.readValue(record.payload(), resultClass));
        } catch (Exception exception) {
            throw conflict(exception);
        }
    }

    private void completeClaim(
            String scope, String key, String resultId, String movementId, Object result) {
        String payload;
        try {
            payload = objectMapper.writeValueAsString(result);
        } catch (Exception exception) {
            throw conflict(exception);
        }
        requireOne(
                jdbcTemplate.update(
                        "update inventory_idempotency set result_id = ?, movement_id = ?, "
                                + "result_payload = ? where organization_id = ? "
                                + "and idempotency_key = ? and result_id is null "
                                + "and movement_id is null",
                        resultId,
                        movementId,
                        payload,
                        scope,
                        key));
    }

