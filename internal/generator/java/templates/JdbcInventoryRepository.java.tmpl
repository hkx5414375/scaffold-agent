    private Balance updateBalance(
            String scope, Balance current, long onHand, long reserved, Instant now) {
        validateBalance(onHand, reserved);
        requireOne(
                jdbcTemplate.update(
                        "update inventory_balances set on_hand = ?, reserved = ?, "
                                + "version = version + 1, updated_at = ? "
                                + "where organization_id = ? and item_id = ? and warehouse_id = ? "
                                + "and version = ?",
                        onHand,
                        reserved,
                        Timestamp.from(now),
                        scope,
                        current.itemId(),
                        current.warehouseId(),
                        current.version()));
        List<Balance> values =
                jdbcTemplate.query(
                        select(BALANCE_COLUMNS, "inventory_balances")
                                + " where value.organization_id = ? and value.item_id = ? "
                                + "and value.warehouse_id = ?",
                        JdbcInventoryRepository::mapBalance,
                        scope,
                        current.itemId(),
                        current.warehouseId());
        if (values.size() != 1) {
            throw conflict(null);
        }
        return values.getFirst();
    }

