    @Override
    public void createItem(Item value, AuditEvent audit) {
        transact(
                scope(value.organizationId()),
                () -> {
                    requireOne(
                            jdbcTemplate.update(
                                    "insert into inventory_items "
                                            + "(id, organization_id, sku, name, unit, status, "
                                            + "version, created_at, updated_at) "
                                            + "values (?, ?, ?, ?, ?, ?, ?, ?, ?)",
                                    value.id(),
                                    scope(value.organizationId()),
                                    value.sku(),
                                    value.name(),
                                    value.unit(),
                                    value.status(),
                                    value.version(),
                                    Timestamp.from(value.createdAt()),
                                    Timestamp.from(value.updatedAt())));
                    appendAudit(audit);
                    return Boolean.TRUE;
                });
    }

