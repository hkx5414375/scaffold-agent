package {{.PackageName}}.tenancy;

import {{.PackageName}}.identity.AuditEvent;
import edu.umd.cs.findbugs.annotations.SuppressFBWarnings;
import java.sql.Timestamp;
import java.time.Instant;
import java.util.List;
import java.util.Optional;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;
import org.springframework.transaction.support.TransactionTemplate;

@Repository
public final class JdbcTenancyRepository implements TenancyRepository {

    private final JdbcTemplate jdbcTemplate;
    private final TransactionTemplate transactionTemplate;

    @SuppressFBWarnings(
            value = "EI_EXPOSE_REP2",
            justification = "Spring JDBC collaborators are process-scoped infrastructure dependencies")
    public JdbcTenancyRepository(
            JdbcTemplate jdbcTemplate, TransactionTemplate transactionTemplate) {
        this.jdbcTemplate = jdbcTemplate;
        this.transactionTemplate = transactionTemplate;
    }

    @Override
    public void createOrganization(
            Organization organization,
            String userId,
            String role,
            Instant createdAt,
            AuditEvent auditEvent) {
        transactionTemplate.executeWithoutResult(
                status -> {
                    jdbcTemplate.update(
                            "insert into organizations "
                                    + "(id, name, created_by, created_at, updated_at) "
                                    + "values (?, ?, ?, ?, ?)",
                            organization.id(),
                            organization.name(),
                            userId,
                            Timestamp.from(createdAt),
                            Timestamp.from(createdAt));
                    jdbcTemplate.update(
                            "insert into organization_memberships "
                                    + "(organization_id, user_id, role_code, created_at) "
                                    + "values (?, ?, ?, ?)",
                            organization.id(),
                            userId,
                            role,
                            Timestamp.from(createdAt));
                    appendAuditInternal(auditEvent);
                });
    }

    @Override
    public List<Organization> listOrganizations(String userId) {
        return jdbcTemplate.query(
                "select organizations.id, organizations.name, "
                        + "memberships.role_code, organizations.created_at "
                        + "from organization_memberships memberships "
                        + "join organizations on organizations.id = memberships.organization_id "
                        + "where memberships.user_id = ? "
                        + "order by organizations.name, organizations.id",
                (resultSet, rowNumber) ->
                        new Organization(
                                resultSet.getString("id"),
                                resultSet.getString("name"),
                                resultSet.getString("role_code"),
                                resultSet.getTimestamp("created_at").toInstant()),
                userId);
    }

    @Override
    public Optional<String> membershipRole(String organizationId, String userId) {
        List<String> roles =
                jdbcTemplate.query(
                        "select role_code from organization_memberships "
                                + "where organization_id = ? and user_id = ?",
                        (resultSet, rowNumber) -> resultSet.getString("role_code"),
                        organizationId,
                        userId);
        return roles.isEmpty() ? Optional.empty() : Optional.of(roles.getFirst());
    }

    @Override
    public boolean hasPermission(String role, String permission) {
        Integer count =
                jdbcTemplate.queryForObject(
                        "select count(*) from identity_role_permissions "
                                + "where role_code = ? and permission_code = ?",
                        Integer.class,
                        role,
                        permission);
        return count != null && count == 1;
    }

    @Override
    public void appendAudit(AuditEvent auditEvent) {
        appendAuditInternal(auditEvent);
    }

    private void appendAuditInternal(AuditEvent event) {
        jdbcTemplate.update(
                "insert into audit_events "
                        + "(id, user_id, action, outcome, target, ip_address, user_agent, created_at) "
                        + "values (?, ?, ?, ?, ?, ?, ?, ?)",
                event.id(),
                emptyToNull(event.userId()),
                event.action(),
                event.outcome(),
                emptyToNull(event.target()),
                emptyToNull(event.ipAddress()),
                emptyToNull(event.userAgent()),
                Timestamp.from(event.createdAt()));
    }

    private static String emptyToNull(String value) {
        return value == null || value.isEmpty() ? null : value;
    }
}
