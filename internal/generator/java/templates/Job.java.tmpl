package {{.PackageName}}.jobs;

import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonInclude;
import java.time.Instant;

@JsonInclude(JsonInclude.Include.NON_NULL)
public record Job(
        String id,
        String organizationId,
        String type,
        String payloadJson,
        String status,
        int priority,
        int attempts,
        int maxAttempts,
        Instant availableAt,
        String leaseOwner,
        Instant leaseUntil,
        String lastError,
        Instant createdAt,
        Instant updatedAt,
        Instant completedAt,
        @JsonIgnore String scopeKey,
        @JsonIgnore String dedupeKey) {}
