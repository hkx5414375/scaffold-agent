package {{.PackageName}}.jobs;

import static org.assertj.core.api.Assertions.assertThat;

import tools.jackson.databind.ObjectMapper;
import java.time.Clock;
import java.time.Duration;
import java.time.Instant;
import java.time.ZoneOffset;
import java.util.ArrayDeque;
import java.util.List;
import java.util.Queue;
import org.junit.jupiter.api.Test;

class JobWorkerTest {

    private static final Instant NOW = Instant.parse("2026-09-01T00:00:00Z");

    @Test
    void completesSuccessfulHandlerAndRetriesFailure() {
        FakeRepository repository = new FakeRepository();
        repository.jobs.add(job("success", "system.noop"));
        repository.jobs.add(job("failure", "system.fail"));
        JobService service =
                new JobService(
                        repository,
                        new ObjectMapper(),
                        Clock.fixed(NOW, ZoneOffset.UTC));
        JobWorker worker =
                new JobWorker(
                        service,
                        "worker-1",
                        List.of(
                                handler("system.noop", false),
                                handler("system.fail", true)),
                        Duration.ofSeconds(30));

        worker.runOnce();
        worker.runOnce();

        assertThat(repository.completed).isEqualTo("success");
        assertThat(repository.failed).isEqualTo("failure");
    }

    private static JobWorker.Handler handler(String type, boolean fail) {
        return new JobWorker.Handler() {
            @Override
            public String type() {
                return type;
            }

            @Override
            public void handle(Job job) {
                if (fail) {
                    throw new IllegalStateException("expected failure");
                }
            }
        };
    }

    private static Job job(String id, String type) {
        return new Job(
                id,
                null,
                type,
                "{}",
                "running",
                0,
                1,
                3,
                NOW,
                "worker-1",
                NOW.plusSeconds(30),
                null,
                NOW,
                NOW,
                null,
                "global",
                "job:" + id);
    }

    private static final class FakeRepository implements JobRepository {

        private final Queue<Job> jobs = new ArrayDeque<>();
        private String completed;
        private String failed;

        @Override
        public Job enqueue(Job job) {
            return job;
        }

        @Override
        public Job leaseNext(String workerId, Instant now, Instant leaseUntil) {
            Job job = jobs.remove();
            return new Job(
                    job.id(),
                    job.organizationId(),
                    job.type(),
                    job.payloadJson(),
                    "running",
                    job.priority(),
                    job.attempts(),
                    job.maxAttempts(),
                    job.availableAt(),
                    workerId,
                    leaseUntil,
                    job.lastError(),
                    job.createdAt(),
                    now,
                    null,
                    job.scopeKey(),
                    job.dedupeKey());
        }

        @Override
        public void extendLease(String jobId, String workerId, Instant now, Instant leaseUntil) {}

        @Override
        public void complete(String jobId, String workerId, Instant now) {
            completed = jobId;
        }

        @Override
        public void fail(
                String jobId,
                String workerId,
                String message,
                Instant retryAt,
                boolean dead,
                Instant now) {
            failed = jobId;
        }
    }
}
