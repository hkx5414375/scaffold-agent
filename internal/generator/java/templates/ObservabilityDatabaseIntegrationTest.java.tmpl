package {{.PackageName}}.http;

import static org.assertj.core.api.Assertions.assertThat;

import org.junit.jupiter.api.Assumptions;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Timeout;
import org.springframework.jdbc.datasource.DriverManagerDataSource;

class ObservabilityDatabaseIntegrationTest {

    @Test
    @Timeout(10)
    void reportsConfiguredDatabaseAsReady() {
        String url = environment("TEST_DATABASE_URL");
        Assumptions.assumeTrue(!url.isBlank(), "TEST_DATABASE_URL is not set");
        DriverManagerDataSource dataSource =
                new DriverManagerDataSource(
                        url,
                        environment("TEST_DATABASE_USER"),
                        environment("TEST_DATABASE_PASSWORD"));
        BoundedReadinessProbe probe = new BoundedReadinessProbe(dataSource);
        try {
            assertThat(probe.isReady()).isTrue();
        } finally {
            probe.close();
        }
    }

    private static String environment(String name) {
        String value = System.getenv(name);
        return value == null ? "" : value.trim();
    }
}
