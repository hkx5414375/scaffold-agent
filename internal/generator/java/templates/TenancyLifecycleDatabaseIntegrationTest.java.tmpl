package {{.PackageName}}.tenancy;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

import {{.PackageName}}.identity.IdentityException;
import {{.PackageName}}.identity.IdentityService;
import {{.PackageName}}.identity.JdbcIdentityRepository;
import {{.PackageName}}.identity.PasswordHasher;
import {{.PackageName}}.identity.Principal;
import {{.PackageName}}.identity.TokenCodec;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.UUID;
import org.flywaydb.core.Flyway;
import org.junit.jupiter.api.Assumptions;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Timeout;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.datasource.DataSourceTransactionManager;
import org.springframework.jdbc.datasource.DriverManagerDataSource;
import org.springframework.transaction.support.TransactionTemplate;

class TenancyLifecycleDatabaseIntegrationTest {

    @Test
    @Timeout(45)
    void transfersOwnershipAndReversesDeactivationWithoutDeletingTenantData()
            throws SQLException {
        String adminUrl = environment("TEST_DATABASE_URL");
        Assumptions.assumeTrue(!adminUrl.isBlank(), "TEST_DATABASE_URL is not set");
        String username = environment("TEST_DATABASE_USER");
        String password = environment("TEST_DATABASE_PASSWORD");
        String scope = "scaffold_java_lifecycle_" + UUID.randomUUID().toString().replace("-", "");
        String applicationUrl;
{{- if eq .Database.Engine "postgresql"}}
        execute(adminUrl, username, password, "create schema " + scope);
        applicationUrl = adminUrl + (adminUrl.contains("?") ? "&" : "?") + "currentSchema=" + scope;
{{- else}}
        execute(adminUrl, username, password, "create database `" + scope + "`");
        applicationUrl = mysqlDatabaseUrl(adminUrl, scope);
{{- end}}
        try {
            DriverManagerDataSource dataSource =
                    new DriverManagerDataSource(applicationUrl, username, password);
            Flyway flyway = Flyway.configure().dataSource(dataSource).load();
            assertThat(flyway.migrate().migrationsExecuted).isEqualTo({{.MigrationCount}});
            assertThat(flyway.migrate().migrationsExecuted).isZero();

            JdbcTemplate jdbcTemplate = new JdbcTemplate(dataSource);
            TransactionTemplate transactions =
                    new TransactionTemplate(new DataSourceTransactionManager(dataSource));
            IdentityService identityService =
                    new IdentityService(
                            new JdbcIdentityRepository(jdbcTemplate, transactions),
                            new PasswordHasher(),
                            new TokenCodec());
            String passwordValue = "correct horse battery staple";
            identityService.ensureAdmin("owner@example.com", passwordValue);
            identityService.ensureAdmin("member@example.com", passwordValue);
            Principal owner = login(identityService, "owner@example.com", passwordValue);
            Principal member = login(identityService, "member@example.com", passwordValue);

            TenancyService tenancy =
                    new TenancyService(new JdbcTenancyRepository(jdbcTemplate, transactions));
            Organization organization = tenancy.create("Acme", owner);
            assertThat(organization.ownerUserId()).isEqualTo(owner.userId());
            assertThat(organization.isOwner()).isTrue();
            Principal scopedOwner =
                    tenancy.authorize(
                            owner,
                            organization.id(),
                            "tenancy:members:manage",
                            "127.0.0.1",
                            "integration-test");
            TenancyMemberService members =
                    new TenancyMemberService(
                            new JdbcTenancyMemberRepository(jdbcTemplate, transactions));
            OrganizationInvitation invitation =
                    members.invite("member@example.com", "user", scopedOwner);
            members.accept(invitation.acceptanceToken(), member);

            TenancyLifecycleService lifecycle =
                    new TenancyLifecycleService(
                            new JdbcTenancyLifecycleRepository(jdbcTemplate, transactions));
            assertThat(lifecycle.rename(organization.id(), "Renamed", owner).name())
                    .isEqualTo("Renamed");
            assertThatThrownBy(() -> lifecycle.deactivate(organization.id(), member))
                    .isInstanceOf(TenancyException.class)
                    .hasFieldOrPropertyWithValue(
                            "kind", TenancyException.Kind.LIFECYCLE_FORBIDDEN);
            assertThatThrownBy(() -> members.changeRole(owner.userId(), "user", scopedOwner))
                    .isInstanceOf(TenancyException.class)
                    .hasFieldOrPropertyWithValue(
                            "kind", TenancyException.Kind.OWNER_PROTECTED);
            assertThatThrownBy(() -> members.remove(owner.userId(), scopedOwner))
                    .isInstanceOf(TenancyException.class)
                    .hasFieldOrPropertyWithValue(
                            "kind", TenancyException.Kind.OWNER_PROTECTED);

            Organization transferred =
                    lifecycle.transferOwnership(organization.id(), member.userId(), owner);
            assertThat(transferred.ownerUserId()).isEqualTo(member.userId());
            assertThat(transferred.isOwner()).isFalse();
            assertThat(
                            jdbcTemplate.queryForObject(
                                    "select role_code from organization_memberships "
                                            + "where organization_id = ? and user_id = ?",
                                    String.class,
                                    organization.id(),
                                    member.userId()))
                    .isEqualTo("admin");

            assertThatThrownBy(() -> lifecycle.deactivate(organization.id(), owner))
                    .isInstanceOf(TenancyException.class)
                    .hasFieldOrPropertyWithValue(
                            "kind", TenancyException.Kind.LIFECYCLE_FORBIDDEN);
            Organization inactive = lifecycle.deactivate(organization.id(), member);
            assertThat(inactive.status()).isEqualTo("inactive");
            assertThat(inactive.deactivatedAt()).isNotNull();
            assertThatThrownBy(
                            () ->
                                    tenancy.authorize(
                                            member,
                                            organization.id(),
                                            "tenancy:members:read",
                                            "127.0.0.1",
                                            "integration-test"))
                    .isInstanceOf(IdentityException.class);
            assertThat(tenancy.list(member).getFirst().status()).isEqualTo("inactive");

            Organization active = lifecycle.reactivate(organization.id(), member);
            assertThat(active.status()).isEqualTo("active");
            assertThat(active.deactivatedAt()).isNull();
            assertThat(
                            tenancy.authorize(
                                            member,
                                            organization.id(),
                                            "tenancy:members:read",
                                            "127.0.0.1",
                                            "integration-test")
                                    .organizationId())
                    .isEqualTo(organization.id());
            assertThat(
                            jdbcTemplate.queryForObject(
                                    "select count(*) from audit_events "
                                            + "where action like 'tenancy.organization.%'",
                                    Integer.class))
                    .isGreaterThanOrEqualTo(7);
        } finally {
{{- if eq .Database.Engine "postgresql"}}
            execute(adminUrl, username, password, "drop schema " + scope + " cascade");
{{- else}}
            execute(adminUrl, username, password, "drop database `" + scope + "`");
{{- end}}
        }
    }

    private static Principal login(IdentityService service, String email, String password) {
        return service.login(email, password, "127.0.0.1", "integration-test").principal();
    }

    private static void execute(String url, String username, String password, String sql)
            throws SQLException {
        try (Connection connection = DriverManager.getConnection(url, username, password);
                Statement statement = connection.createStatement()) {
            statement.execute(sql);
        }
    }

{{- if eq .Database.Engine "mysql"}}
    private static String mysqlDatabaseUrl(String adminUrl, String database) {
        int queryOffset = adminUrl.indexOf('?');
        String query = queryOffset < 0 ? "" : adminUrl.substring(queryOffset);
        String base = queryOffset < 0 ? adminUrl : adminUrl.substring(0, queryOffset);
        int slash = base.lastIndexOf('/');
        if (slash < "jdbc:mysql://".length()) {
            throw new IllegalArgumentException("TEST_DATABASE_URL must include a trailing slash");
        }
        return base.substring(0, slash + 1) + database + query;
    }

{{- end}}
    private static String environment(String name) {
        String value = System.getenv(name);
        return value == null ? "" : value.trim();
    }
}
