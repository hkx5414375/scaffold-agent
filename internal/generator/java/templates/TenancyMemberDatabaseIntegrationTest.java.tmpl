class TenancyMemberDatabaseIntegrationTest {

    @Test
    @Timeout(45)
    void managesInvitationsAndProtectsConcurrentLastAdministratorChanges() throws Exception {
        String adminUrl = environment("TEST_DATABASE_URL");
        Assumptions.assumeTrue(!adminUrl.isBlank(), "TEST_DATABASE_URL is not set");
        String username = environment("TEST_DATABASE_USER");
        String password = environment("TEST_DATABASE_PASSWORD");
        String scope = "scaffold_java_members_" + UUID.randomUUID().toString().replace("-", "");
        String applicationUrl;
{{- if eq .Database.Engine "postgresql"}}
        execute(adminUrl, username, password, "create schema " + scope);
        applicationUrl = adminUrl + (adminUrl.contains("?") ? "&" : "?") + "currentSchema=" + scope;
{{- else}}
        execute(adminUrl, username, password, "create database `" + scope + "`");
        applicationUrl = mysqlDatabaseUrl(adminUrl, scope);
{{- end}}
        try {
            DriverManagerDataSource dataSource =
                    new DriverManagerDataSource(applicationUrl, username, password);
            Flyway flyway = Flyway.configure().dataSource(dataSource).load();
            assertThat(flyway.migrate().migrationsExecuted).isEqualTo({{.MigrationCount}});
            assertThat(flyway.migrate().migrationsExecuted).isZero();

            JdbcTemplate jdbcTemplate = new JdbcTemplate(dataSource);
            TransactionTemplate transactions =
                    new TransactionTemplate(new DataSourceTransactionManager(dataSource));
            IdentityService identityService =
                    new IdentityService(
                            new JdbcIdentityRepository(jdbcTemplate, transactions),
                            new PasswordHasher(),
                            new TokenCodec());
            String passwordValue = "correct horse battery staple";
            identityService.ensureAdmin("admin@example.com", passwordValue);
            identityService.ensureAdmin("member@example.com", passwordValue);
            Principal admin = login(identityService, "admin@example.com", passwordValue);
            Principal member = login(identityService, "member@example.com", passwordValue);

            TenancyService tenancy =
                    new TenancyService(new JdbcTenancyRepository(jdbcTemplate, transactions));
            Organization organization = tenancy.create("Acme", admin);
            Principal scopedAdmin =
                    tenancy.authorize(
                            admin,
                            organization.id(),
                            "tenancy:members:manage",
                            "127.0.0.1",
                            "integration-test");
            TenancyMemberService members =
                    new TenancyMemberService(
                            new JdbcTenancyMemberRepository(jdbcTemplate, transactions));
            OrganizationInvitation invitation =
                    members.invite("member@example.com", "admin", scopedAdmin);
            assertThat(invitation.acceptanceToken()).isNotBlank();
            assertThat(
                            jdbcTemplate.queryForObject(
                                    "select token_hash from organization_invitations where id = ?",
                                    String.class,
                                    invitation.id()))
                    .hasSize(64)
                    .isNotEqualTo(invitation.acceptanceToken());

            OrganizationMember accepted = members.accept(invitation.acceptanceToken(), member);
            assertThat(accepted.role()).isEqualTo("admin");
            assertThatThrownBy(() -> members.accept(invitation.acceptanceToken(), member))
                    .isInstanceOf(TenancyException.class)
                    .hasFieldOrPropertyWithValue(
                            "kind", TenancyException.Kind.INVITATION_INVALID);

            Principal scopedMember =
                    tenancy.authorize(
                            member,
                            organization.id(),
                            "tenancy:members:manage",
                            "127.0.0.1",
                            "integration-test");
            assertConcurrentAdministratorProtection(
                    members, scopedAdmin, scopedMember, admin.userId(), member.userId());
            assertThat(members.list(scopedAdmin))
                    .filteredOn(value -> "admin".equals(value.role()))
                    .hasSize(1);
            assertThat(
                            jdbcTemplate.queryForObject(
                                    "select count(*) from audit_events "
                                            + "where action like 'tenancy.member.%' "
                                            + "or action = 'tenancy.invitation.accept'",
                                    Integer.class))
                    .isGreaterThanOrEqualTo(4);
        } finally {
{{- if eq .Database.Engine "postgresql"}}
            execute(adminUrl, username, password, "drop schema " + scope + " cascade");
{{- else}}
            execute(adminUrl, username, password, "drop database `" + scope + "`");
{{- end}}
        }
    }

    private static void assertConcurrentAdministratorProtection(
            TenancyMemberService service,
            Principal firstActor,
            Principal secondActor,
            String firstUserId,
            String secondUserId)
            throws Exception {
        CountDownLatch start = new CountDownLatch(1);
        ExecutorService executor = Executors.newFixedThreadPool(2);
        try {
            Future<TenancyException.Kind> first =
                    executor.submit(
                            () -> demoteAfter(start, service, firstUserId, firstActor));
            Future<TenancyException.Kind> second =
                    executor.submit(
                            () -> demoteAfter(start, service, secondUserId, secondActor));
            start.countDown();
            assertThat(Arrays.asList(first.get(), second.get()))
                    .containsExactlyInAnyOrder(null, TenancyException.Kind.LAST_ADMINISTRATOR);
        } finally {
            executor.shutdownNow();
        }
    }

    private static TenancyException.Kind demoteAfter(
            CountDownLatch start,
            TenancyMemberService service,
            String userId,
            Principal actor)
            throws InterruptedException {
        start.await();
        try {
            service.changeRole(userId, "user", actor);
            return null;
        } catch (TenancyException exception) {
            return exception.kind();
        }
    }

    private static Principal login(IdentityService service, String email, String password) {
        return service.login(email, password, "127.0.0.1", "integration-test").principal();
    }

    private static void execute(String url, String username, String password, String sql)
            throws SQLException {
        try (Connection connection = DriverManager.getConnection(url, username, password);
                Statement statement = connection.createStatement()) {
            statement.execute(sql);
        }
    }

{{- if eq .Database.Engine "mysql"}}
    private static String mysqlDatabaseUrl(String adminUrl, String database) {
        int queryOffset = adminUrl.indexOf('?');
        String query = queryOffset < 0 ? "" : adminUrl.substring(queryOffset);
        String base = queryOffset < 0 ? adminUrl : adminUrl.substring(0, queryOffset);
        int slash = base.lastIndexOf('/');
        if (slash < "jdbc:mysql://".length()) {
            throw new IllegalArgumentException("TEST_DATABASE_URL must include a trailing slash");
        }
        return base.substring(0, slash + 1) + database + query;
    }

{{- end}}
    private static String environment(String name) {
        String value = System.getenv(name);
        return value == null ? "" : value.trim();
    }
}
