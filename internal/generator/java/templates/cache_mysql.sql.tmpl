create table application_cache (
    scope_key varchar(191) not null,
    cache_key varchar(191) not null,
    organization_id varchar(191){{if .Tenancy}} not null{{end}},
    value_json json not null,
    expires_at datetime(6) not null,
    updated_at datetime(6) not null,
    primary key (scope_key, cache_key),
    index application_cache_expiry_idx (expires_at){{if .Tenancy}},
    index application_cache_organization_idx (organization_id, cache_key),
    constraint application_cache_organization_fk foreign key (organization_id) references organizations (id) on delete cascade{{end}}
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;
