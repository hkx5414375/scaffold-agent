insert into identity_permissions (code, description) values
    ('customers:accounts:read', 'Read storefront customer accounts'),
    ('customers:accounts:manage', 'Suspend and reactivate storefront customer accounts')
on duplicate key update code = code;

insert into identity_role_permissions (role_code, permission_code) values
    ('admin', 'customers:accounts:read'),
    ('admin', 'customers:accounts:manage')
on duplicate key update role_code = role_code;

create table customer_accounts (
    id varchar(191) primary key,
{{- if .Tenancy}}
    organization_id varchar(191) not null,
{{- else}}
    organization_id varchar(191) null,
{{- end}}
    email varchar(254) not null,
    password_hash varchar(512) not null,
    display_name varchar(160) not null,
    status varchar(16) not null,
    version bigint not null,
    created_at datetime(6) not null,
    updated_at datetime(6) not null,
    customer_scope varchar(191) generated always as (coalesce(organization_id, '')) stored,
    constraint customer_accounts_status_check
        check (status in ('active', 'suspended', 'closed')),
    constraint customer_accounts_version_check check (version > 0),
{{- if .Tenancy}}
    constraint customer_accounts_organization_fk foreign key (organization_id)
        references organizations (id) on delete cascade,
{{- end}}
    unique key customer_accounts_scope_email_unique (customer_scope, email),
    index customer_accounts_scope_status_idx (customer_scope, status, id)
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table customer_sessions (
    token_hash char(64) primary key,
    customer_id varchar(191) not null,
    expires_at datetime(6) not null,
    created_at datetime(6) not null,
    index customer_sessions_customer_idx (customer_id),
    index customer_sessions_expiry_idx (expires_at),
    constraint customer_sessions_customer_fk foreign key (customer_id)
        references customer_accounts (id) on delete cascade
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;
