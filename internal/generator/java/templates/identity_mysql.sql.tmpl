create table identity_roles (
    code varchar(191) primary key,
    display_name varchar(191) not null
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table identity_permissions (
    code varchar(191) primary key,
    description varchar(512) not null
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

create table identity_role_permissions (
    role_code varchar(191) not null,
    permission_code varchar(191) not null,
    primary key (role_code, permission_code),
    constraint identity_role_permission_role_fk foreign key (role_code)
        references identity_roles (code) on delete cascade,
    constraint identity_role_permission_permission_fk foreign key (permission_code)
        references identity_permissions (code) on delete cascade
) engine = InnoDB default character set utf8mb4 collate utf8mb4_0900_ai_ci;

