insert into identity_permissions (code, description) values
    ('inventory:read', 'Read inventory, reservations, movements, and purchase orders'),
    ('inventory:catalog:write', 'Manage inventory items and warehouses'),
    ('inventory:stock:manage', 'Adjust, reserve, release, and consume inventory'),
    ('inventory:procurement:manage', 'Create, submit, cancel, and receive purchase orders')
on conflict (code) do nothing;

insert into identity_role_permissions (role_code, permission_code) values
    ('admin', 'inventory:read'), ('admin', 'inventory:catalog:write'),
    ('admin', 'inventory:stock:manage'), ('admin', 'inventory:procurement:manage')
on conflict (role_code, permission_code) do nothing;

create table if not exists inventory_items (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    sku varchar(64) not null,
    name varchar(160) not null,
    unit varchar(32) not null,
    status varchar(16) not null check (status in ('active', 'archived')),
    version bigint not null check (version > 0),
    created_at timestamptz not null,
    updated_at timestamptz not null,
    unique (organization_id, sku)
);
create index if not exists inventory_items_scope_status_id_idx on inventory_items (organization_id, status, id);

create table if not exists inventory_warehouses (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    code varchar(64) not null,
    name varchar(160) not null,
    status varchar(16) not null check (status in ('active', 'archived')),
    version bigint not null check (version > 0),
    created_at timestamptz not null,
    updated_at timestamptz not null,
    unique (organization_id, code)
);
create index if not exists inventory_warehouses_scope_status_id_idx on inventory_warehouses (organization_id, status, id);

create table if not exists inventory_balances (
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    item_id varchar(191) not null references inventory_items(id),
    warehouse_id varchar(191) not null references inventory_warehouses(id),
    on_hand bigint not null check (on_hand >= 0),
    reserved bigint not null check (reserved >= 0 and reserved <= on_hand),
    version bigint not null check (version > 0),
    updated_at timestamptz not null,
    primary key (item_id, warehouse_id)
);
create index if not exists inventory_balances_scope_item_id_idx on inventory_balances (organization_id, item_id, warehouse_id);

create table if not exists inventory_movements (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    item_id varchar(191) not null references inventory_items(id),
    warehouse_id varchar(191) not null references inventory_warehouses(id),
    movement_kind varchar(32) not null check (movement_kind in ('adjustment', 'reservation_created', 'reservation_released', 'reservation_consumed', 'purchase_received')),
    quantity_delta bigint not null,
    reserved_delta bigint not null,
    reference_type varchar(32) not null,
    reference_id varchar(191) not null,
    reason varchar(500) not null,
    idempotency_key varchar(191) not null,
    created_by varchar(191) not null references identity_users(id),
    created_at timestamptz not null
);
create index if not exists inventory_movements_scope_stock_id_idx on inventory_movements (organization_id, item_id, warehouse_id, id);

create table if not exists inventory_reservations (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    external_reference varchar(191) not null,
    item_id varchar(191) not null references inventory_items(id),
    warehouse_id varchar(191) not null references inventory_warehouses(id),
    quantity bigint not null check (quantity > 0),
    status varchar(16) not null check (status in ('active', 'released', 'consumed')),
    version bigint not null check (version > 0),
    created_at timestamptz not null,
    updated_at timestamptz not null,
    unique (organization_id, external_reference)
);
create index if not exists inventory_reservations_scope_status_id_idx on inventory_reservations (organization_id, status, id);

create table if not exists inventory_purchase_orders (
    id varchar(191) primary key,
    organization_id varchar(191){{if .Tenancy}} not null references organizations(id) on delete cascade{{end}},
    order_number varchar(64) not null,
    supplier_name varchar(160) not null,
    status varchar(32) not null check (status in ('draft', 'submitted', 'partially_received', 'received', 'cancelled')),
    version bigint not null check (version > 0),
    created_at timestamptz not null,
    updated_at timestamptz not null,
    unique (organization_id, order_number)
);
create index if not exists inventory_purchase_orders_scope_status_id_idx on inventory_purchase_orders (organization_id, status, id);

create table if not exists inventory_purchase_order_lines (
    id varchar(191) primary key,
    purchase_order_id varchar(191) not null references inventory_purchase_orders(id) on delete cascade,
    item_id varchar(191) not null references inventory_items(id),
    ordered_quantity bigint not null check (ordered_quantity > 0),
    received_quantity bigint not null check (received_quantity >= 0 and received_quantity <= ordered_quantity),
    unique (purchase_order_id, item_id)
);

create table if not exists inventory_idempotency (
    organization_id varchar(191) not null,
    idempotency_key varchar(191) not null,
    fingerprint char(64) not null,
    result_type varchar(32) not null,
    result_id varchar(191),
    movement_id varchar(191) references inventory_movements(id),
    result_payload text,
    created_at timestamptz not null,
    primary key (organization_id, idempotency_key)
);

