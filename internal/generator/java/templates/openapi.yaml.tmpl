    CommerceOrder:
      type: object
      required: [id, customer_id, status, currency, subtotal_minor, discount_minor, total_minor, lines, payment, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        customer_id: {type: string}
        status: {type: string, enum: [pending_payment, confirmed, fulfilling, fulfilled, return_requested, returned, cancelled]}
        currency: {type: string, pattern: "^[A-Z]{3}$"}
        subtotal_minor: {type: string, pattern: "^(0|[1-9][0-9]{0,18})$"}
        discount_minor: {type: string, pattern: "^(0|[1-9][0-9]{0,18})$"}
        total_minor: {type: string, pattern: "^(0|[1-9][0-9]{0,18})$"}
        campaign_id: {type: string}
        coupon_code: {type: string}
        lines: {type: array, minItems: 1, items: {$ref: "#/components/schemas/CommerceOrderLine"}}
        payment: {$ref: "#/components/schemas/CommercePaymentIntent"}
        fulfillment_ref: {type: string}
        return_reason: {type: string}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
    CommerceOrderPage:
      type: object
      required: [items]
      properties: {items: {type: array, items: {$ref: "#/components/schemas/CommerceOrder"}}, next_cursor: {type: string}}
    CommerceReturnWrite:
      type: object
      additionalProperties: false
      required: [version, reason]
      properties:
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        reason: {type: string, minLength: 1, maxLength: 500}
    CommercePaymentEvent:
      type: object
      additionalProperties: false
      required: [event_id, status]
      properties:
        event_id: {type: string, minLength: 1, maxLength: 191}
        status: {type: string, enum: [succeeded, failed]}
    CommerceTransition:
      type: object
      additionalProperties: false
      required: [version]
      properties:
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        reference: {type: string, maxLength: 191}
    CommerceRefundWrite:
      type: object
      additionalProperties: false
      required: [amount_minor, idempotency_key]
      properties:
        amount_minor: {type: string, pattern: "^[1-9][0-9]{0,18}$"}
        idempotency_key: {type: string, minLength: 1, maxLength: 191}
    CommerceCampaign:
      type: object
      required: [id, name, kind, value, minimum_minor, currency, priority, coupon_required, status, starts_at, ends_at, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        name: {type: string, minLength: 1, maxLength: 160}
        kind: {type: string, enum: [fixed, percent]}
        value: {type: string, pattern: "^[1-9][0-9]{0,18}$"}
        minimum_minor: {type: string, pattern: "^(0|[1-9][0-9]{0,18})$"}
        currency: {type: string, pattern: "^[A-Z]{3}$"}
        priority: {type: integer, minimum: -1000, maximum: 1000}
        coupon_required: {type: boolean}
        status: {type: string, enum: [draft, active, archived]}
        starts_at: {type: string, format: date-time}
        ends_at: {type: string, format: date-time}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
    CommerceCampaignWrite:
      type: object
      additionalProperties: false
      required: [name, kind, value, minimum_minor, currency, priority, coupon_required, starts_at, ends_at]
      properties:
        name: {type: string, minLength: 1, maxLength: 160}
        kind: {type: string, enum: [fixed, percent]}
        value: {type: string, pattern: "^[1-9][0-9]{0,18}$"}
        minimum_minor: {type: string, pattern: "^(0|[1-9][0-9]{0,18})$"}
        currency: {type: string, pattern: "^[A-Z]{3}$"}
        priority: {type: integer, minimum: -1000, maximum: 1000}
        coupon_required: {type: boolean}
        starts_at: {type: string, format: date-time}
        ends_at: {type: string, format: date-time}
    CommerceCampaignPage:
      type: object
      required: [items]
      properties: {items: {type: array, items: {$ref: "#/components/schemas/CommerceCampaign"}}, next_cursor: {type: string}}
    CommerceCoupon:
      type: object
      required: [id, campaign_id, code, maximum_uses, redeemed_uses, created_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        campaign_id: {type: string}
        code: {type: string, pattern: "^[A-Z0-9][A-Z0-9_-]{0,63}$"}
        maximum_uses: {type: string, pattern: "^[1-9][0-9]*$"}
        redeemed_uses: {type: string, pattern: "^(0|[1-9][0-9]*)$"}
        created_at: {type: string, format: date-time}
    CommerceCouponWrite:
      type: object
      additionalProperties: false
      required: [campaign_id, code, maximum_uses]
      properties:
        campaign_id: {type: string}
        code: {type: string, pattern: "^[A-Z0-9][A-Z0-9_-]{0,63}$"}
        maximum_uses: {type: string, pattern: "^[1-9][0-9]*$"}
{{end}}
    ApiError:
      type: object
      additionalProperties: false
      required: [code, message]
      properties:
        code:
          type: string
        message:
          type: string
