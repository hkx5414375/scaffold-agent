openapi: 3.1.0
info:
  title: {{.ProjectName}} API
  version: 0.1.0
paths:
  /healthz:
    get:
      operationId: getHealth
      responses:
        "200":
          description: Process is running
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /readyz:
    get:
      operationId: getReadiness
      responses:
        "200":
          description: Database is available
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
        "503":
          description: Database is unavailable
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /api/v1/auth/login:
    post:
      operationId: login
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Authenticated browser session
          headers:
            Set-Cookie:
              schema:
                type: string
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/logout:
    post:
      operationId: logout
      responses:
        "204":
          description: Browser session revoked when present
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/me:
    get:
      operationId: getCurrentPrincipal
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Current principal
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/tokens:
    post:
      operationId: createApiToken
      x-required-permission: identity:token:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TokenRequest"
      responses:
        "201":
          description: Raw API token returned once
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/TokenResponse"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{- if .Tenancy}}
  /api/v1/organizations:
    post:
      operationId: createOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateOrganizationRequest"
      responses:
        "201":
          description: Organization created with an administrator membership
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: listOrganizations
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organizations visible to the authenticated identity
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationPage"
        "401":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
{{- if .TenancyMembers}}
  /api/v1/organizations/{organizationId}/members:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationHeader"
    get:
      operationId: listOrganizationMembers
      x-required-permission: tenancy:members:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organization members
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMemberPage"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationId}/invitations:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationHeader"
    post:
      operationId: createOrganizationInvitation
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationWrite"
      responses:
        "201":
          description: Invitation with its acceptance token returned exactly once
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationInvitation"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationId}/members/{userId}:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationMemberUserId"
      - $ref: "#/components/parameters/OrganizationHeader"
    patch:
      operationId: changeOrganizationMemberRole
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationMemberRoleWrite"
      responses:
        "200":
          description: Updated organization member
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: removeOrganizationMember
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "204":
          description: Organization member removed
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organization-invitations/accept:
    post:
      operationId: acceptOrganizationInvitation
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationAccept"
      responses:
        "200":
          description: Accepted organization membership
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
{{- if .Business}}
  {{.Business.RoutePath}}:
    post:
      operationId: create{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:create
      security:
        - sessionCookie: []
        - bearerToken: []
{{- if .Tenancy}}
      parameters:
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityClass}}Write"
      responses:
        "201":
          description: Created {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: list{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:read
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
{{- if .Tenancy}}
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
        - name: cursor
          in: query
          schema:
            type: string
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Bounded keyset page
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}Page"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
  {{.Business.RoutePath}}/{id}:
    parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    get:
      operationId: get{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: One {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
    put:
      operationId: update{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:update
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityClass}}Update"
      responses:
        "200":
          description: Updated {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: delete{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:delete
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
        - name: version
          in: query
          required: true
          schema:
            type: string
            pattern: "^[1-9][0-9]*$"
      responses:
        "204":
          description: Deleted
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
components:
{{- if .Tenancy}}
  parameters:
    OrganizationHeader:
      name: X-Organization-ID
      in: header
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- if .TenancyMembers}}
    OrganizationPathId:
      name: organizationId
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
    OrganizationMemberUserId:
      name: userId
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- end}}
  securitySchemes:
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
    bearerToken:
      type: http
      scheme: bearer
  responses:
    ErrorResponse:
      description: Stable API error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
  schemas:
    StatusResponse:
      type: object
      additionalProperties: false
      required: [status]
      properties:
        status:
          type: string
          enum: [ok, unavailable]
    LoginRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          format: email
          maxLength: 254
        password:
          type: string
          format: password
          maxLength: 1024
    Principal:
      type: object
      additionalProperties: false
      required: [user_id, email, role, method]
      properties:
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        method:
          type: string
          enum: [session, token]
{{- if .Tenancy}}
        organization_id:
          type: string
{{- end}}
    PrincipalResponse:
      type: object
      additionalProperties: false
      required: [principal]
      properties:
        principal:
          $ref: "#/components/schemas/Principal"
    TokenRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
    TokenResponse:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
{{- if .Tenancy}}
    CreateOrganizationRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    Organization:
      type: object
      additionalProperties: false
      required: [id, name, role, created_at]
      properties:
        id:
          type: string
        name:
          type: string
          minLength: 1
          maxLength: 120
        role:
          type: string
          enum: [admin, user]
        created_at:
          type: string
          format: date-time
    OrganizationPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/Organization"
{{- if .TenancyMembers}}
    OrganizationMember:
      type: object
      additionalProperties: false
      required: [organization_id, user_id, email, role, joined_at]
      properties:
        organization_id:
          type: string
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        joined_at:
          type: string
          format: date-time
    OrganizationMemberPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/OrganizationMember"
    OrganizationInvitation:
      type: object
      additionalProperties: false
      required: [id, organization_id, email, role, acceptance_token, expires_at, created_at]
      properties:
        id:
          type: string
        organization_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        acceptance_token:
          type: string
        expires_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    OrganizationInvitationWrite:
      type: object
      additionalProperties: false
      required: [email, role]
      properties:
        email:
          type: string
          format: email
          maxLength: 254
        role:
          type: string
          enum: [admin, user]
    OrganizationMemberRoleWrite:
      type: object
      additionalProperties: false
      required: [role]
      properties:
        role:
          type: string
          enum: [admin, user]
    OrganizationInvitationAccept:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
          minLength: 1
          maxLength: 512
{{- end}}
{{- end}}
{{- if .Business}}
    {{.Business.EntityClass}}:
      type: object
      additionalProperties: false
      required:
        - id
{{- if .Tenancy}}
        - organization_id
{{- end}}
{{- range .Business.Fields}}
        - {{.Name}}
{{- end}}
        - version
        - created_at
        - updated_at
      properties:
        id:
          type: string
{{- if .Tenancy}}
        organization_id:
          type: string
{{- end}}
{{- range .Business.Fields}}
        {{.Name}}:
{{- if .Required}}
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- else}}
          oneOf:
            - type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
              format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
              pattern: {{.OpenAPIPattern}}
{{- end}}
            - type: "null"
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    {{.Business.EntityClass}}Write:
      type: object
      additionalProperties: false
{{- if .Business.RequiredFields}}
      required:
{{- range .Business.RequiredFields}}
        - {{.}}
{{- end}}
{{- end}}
      properties:
{{- range .Business.Fields}}
        {{.Name}}:
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- if .StringLike}}
          minLength: 1
          maxLength: {{.MaximumLength}}
{{- end}}
{{- end}}
    {{.Business.EntityClass}}Update:
      type: object
      additionalProperties: false
      required:
{{- range .Business.RequiredFields}}
        - {{.}}
{{- end}}
        - version
      properties:
{{- range .Business.Fields}}
        {{.Name}}:
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- if .StringLike}}
          minLength: 1
          maxLength: {{.MaximumLength}}
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
    {{.Business.EntityClass}}Page:
      type: object
      additionalProperties: false
      required: [items, next_cursor]
      properties:
        items:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/{{.Business.EntityClass}}"
        next_cursor:
          type: string
{{- end}}
    ApiError:
      type: object
      additionalProperties: false
      required: [code, message]
      properties:
        code:
          type: string
        message:
          type: string
