        occurred_at: {type: string, format: date-time}
    CRMOpportunity:
      type: object
      required: [id, account_id, name, amount_minor, currency, stage, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
