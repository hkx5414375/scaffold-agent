openapi: 3.1.0
info:
  title: {{.ProjectName}} API
  version: 0.1.0
paths:
  /healthz:
    get:
      operationId: getHealth
      responses:
        "200":
          description: Process is running
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /readyz:
    get:
      operationId: getReadiness
      responses:
        "200":
          description: Database is available
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
        "503":
          description: Database is unavailable
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /api/v1/auth/login:
    post:
      operationId: login
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Authenticated browser session
          headers:
            Set-Cookie:
              schema:
                type: string
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/logout:
    post:
      operationId: logout
      responses:
        "204":
          description: Browser session revoked when present
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/me:
    get:
      operationId: getCurrentPrincipal
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Current principal
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/tokens:
    post:
      operationId: createApiToken
      x-required-permission: identity:token:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TokenRequest"
      responses:
        "201":
          description: Raw API token returned once
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/TokenResponse"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{- if .Business}}
  {{.Business.RoutePath}}:
    post:
      operationId: create{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityClass}}Write"
      responses:
        "201":
          description: Created {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: list{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:read
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
        - name: cursor
          in: query
          schema:
            type: string
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Bounded keyset page
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}Page"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
  {{.Business.RoutePath}}/{id}:
    parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
    get:
      operationId: get{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: One {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
    put:
      operationId: update{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:update
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityClass}}Update"
      responses:
        "200":
          description: Updated {{.Business.EntityName}}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: delete{{.Business.EntityClass}}
      x-required-permission: {{.Business.PermissionPrefix}}:delete
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
        - name: version
          in: query
          required: true
          schema:
            type: string
            pattern: "^[1-9][0-9]*$"
      responses:
        "204":
          description: Deleted
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
components:
  securitySchemes:
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
    bearerToken:
      type: http
      scheme: bearer
  responses:
    ErrorResponse:
      description: Stable API error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
  schemas:
    StatusResponse:
      type: object
      additionalProperties: false
      required: [status]
      properties:
        status:
          type: string
          enum: [ok, unavailable]
    LoginRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          format: email
          maxLength: 254
        password:
          type: string
          format: password
          maxLength: 1024
    Principal:
      type: object
      additionalProperties: false
      required: [user_id, email, role, method]
      properties:
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        method:
          type: string
          enum: [session, token]
    PrincipalResponse:
      type: object
      additionalProperties: false
      required: [principal]
      properties:
        principal:
          $ref: "#/components/schemas/Principal"
    TokenRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
    TokenResponse:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
{{- if .Business}}
    {{.Business.EntityClass}}:
      type: object
      additionalProperties: false
      required:
        - id
{{- range .Business.Fields}}
        - {{.Name}}
{{- end}}
        - version
        - created_at
        - updated_at
      properties:
        id:
          type: string
{{- range .Business.Fields}}
        {{.Name}}:
{{- if .Required}}
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- else}}
          oneOf:
            - type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
              format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
              pattern: {{.OpenAPIPattern}}
{{- end}}
            - type: "null"
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    {{.Business.EntityClass}}Write:
      type: object
      additionalProperties: false
{{- if .Business.RequiredFields}}
      required:
{{- range .Business.RequiredFields}}
        - {{.}}
{{- end}}
{{- end}}
      properties:
{{- range .Business.Fields}}
        {{.Name}}:
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- if .StringLike}}
          minLength: 1
          maxLength: {{.MaximumLength}}
{{- end}}
{{- end}}
    {{.Business.EntityClass}}Update:
      type: object
      additionalProperties: false
      required:
{{- range .Business.RequiredFields}}
        - {{.}}
{{- end}}
        - version
      properties:
{{- range .Business.Fields}}
        {{.Name}}:
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- if .StringLike}}
          minLength: 1
          maxLength: {{.MaximumLength}}
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
    {{.Business.EntityClass}}Page:
      type: object
      additionalProperties: false
      required: [items, next_cursor]
      properties:
        items:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/{{.Business.EntityClass}}"
        next_cursor:
          type: string
{{- end}}
    ApiError:
      type: object
      additionalProperties: false
      required: [code, message]
      properties:
        code:
          type: string
        message:
          type: string
