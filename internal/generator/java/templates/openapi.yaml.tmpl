components:
{{- if or .Tenancy .Approvals .Catalog}}
  parameters:
{{- if .Approvals}}
    ApprovalStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [pending, approved, rejected, cancelled]
    ApprovalId:
      name: id
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- if .Catalog}}
    CatalogStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [draft, active, archived]
    CatalogProductId:
      name: id
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- if or .Approvals .Catalog}}
    PageCursor:
      name: cursor
      in: query
      schema:
        type: string
        maxLength: 191
    PageLimit:
      name: limit
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 20
{{- end}}
{{- if .Tenancy}}
    OrganizationHeader:
      name: X-Organization-ID
      in: header
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- if .TenancyMembers}}
    OrganizationPathId:
      name: organizationId
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
    OrganizationMemberUserId:
      name: userId
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- end}}
{{- end}}
  securitySchemes:
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
    bearerToken:
      type: http
      scheme: bearer
  responses:
    ErrorResponse:
      description: Stable API error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
  schemas:
{{- if .Approvals}}
    ApprovalRequest:
      type: object
      additionalProperties: false
      required:
        [id, subject_type, subject_id, requester_user_id, summary, details, status, version, created_at, updated_at]
      properties:
        id:
          type: string
        organization_id:
          type: string
        subject_type:
          type: string
          enum: [{{.Business.ModuleName}}.{{.Business.EntityName}}]
        subject_id:
          type: string
        requester_user_id:
          type: string
        summary:
          type: string
          maxLength: 255
        details:
          type: string
          maxLength: 4000
        status:
          type: string
          enum: [pending, approved, rejected, cancelled]
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
        resolution_comment:
          type: string
          maxLength: 2000
        resolved_by_user_id:
          type: string
        resolved_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    ApprovalSubmit:
      type: object
      additionalProperties: false
      required: [subject_id, summary]
      properties:
        subject_id:
          type: string
          minLength: 1
          maxLength: 191
        summary:
          type: string
          minLength: 1
          maxLength: 255
        details:
          type: string
          maxLength: 4000
    ApprovalDecision:
      type: object
      additionalProperties: false
      required: [version]
      properties:
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
        comment:
          type: string
          maxLength: 2000
    ApprovalPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/ApprovalRequest"
        next_cursor:
          type: string
    ApprovalEvent:
      type: object
      additionalProperties: false
      required: [id, request_id, actor_user_id, status, created_at]
      properties:
        id:
          type: string
        request_id:
          type: string
        actor_user_id:
          type: string
        status:
          type: string
          enum: [pending, approved, rejected, cancelled]
        comment:
          type: string
          maxLength: 2000
        created_at:
          type: string
          format: date-time
    ApprovalEventPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/ApprovalEvent"
{{- end}}
{{- if .Files}}
    FileAsset:
      type: object
      additionalProperties: false
      required: [id, name, media_type, size, sha256, created_at]
      properties:
        id:
          type: string
        organization_id:
          type: string
        name:
          type: string
          maxLength: 255
        media_type:
          type: string
          maxLength: 255
        size:
          type: integer
          format: int64
          minimum: 0
          maximum: 10485760
        sha256:
          type: string
          pattern: "^[0-9a-f]{64}$"
        created_at:
          type: string
          format: date-time
    FileAssetPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/FileAsset"
        next_cursor:
          type: string
{{- end}}
{{- if .JobAdmin}}
    JobAdministrationItem:
      type: object
      additionalProperties: false
      required:
        - id
        - type
        - status
        - priority
        - attempts
        - max_attempts
        - available_at
        - created_at
        - updated_at
      properties:
        id:
          type: string
        organization_id:
          type: string
        type:
          type: string
        status:
          type: string
          enum: [queued, running, succeeded, retry, dead]
        priority:
          type: integer
          format: int32
        attempts:
          type: integer
          format: int32
          minimum: 0
        max_attempts:
          type: integer
          format: int32
          minimum: 1
          maximum: 100
        available_at:
          type: string
          format: date-time
        lease_owner:
          type: string
        lease_until:
          type: string
          format: date-time
        last_error:
          type: string
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
        completed_at:
          type: string
          format: date-time
    JobAdministrationPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/JobAdministrationItem"
        next_cursor:
          type: string
{{- end}}
{{- if .CSVTransfer}}
    CSVImportResult:
      type: object
      additionalProperties: false
      required: [imported]
      properties:
        imported:
          type: integer
          minimum: 1
          maximum: 1000
{{- end}}
    StatusResponse:
      type: object
      additionalProperties: false
      required: [status]
      properties:
        status:
          type: string
          enum: [{{if .Observability}}ok, ready{{else}}ok{{end}}, unavailable]
    LoginRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          format: email
          maxLength: 254
        password:
          type: string
          format: password
          maxLength: 1024
    Principal:
      type: object
      additionalProperties: false
      required: [user_id, email, role, method]
      properties:
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        method:
          type: string
          enum: [session, token]
{{- if .Tenancy}}
        organization_id:
          type: string
{{- end}}
    PrincipalResponse:
      type: object
      additionalProperties: false
      required: [principal]
      properties:
        principal:
          $ref: "#/components/schemas/Principal"
    TokenRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
    TokenResponse:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
{{- if .Tenancy}}
    CreateOrganizationRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    Organization:
      type: object
      additionalProperties: false
      required: [id, name, role, created_at{{if .TenancyLifecycle}}, owner_user_id, is_owner, status, updated_at{{end}}]
      properties:
        id:
          type: string
        name:
          type: string
          minLength: 1
          maxLength: 120
        role:
          type: string
          enum: [admin, user]
        created_at:
          type: string
          format: date-time
{{- if .TenancyLifecycle}}
        owner_user_id:
          type: string
        is_owner:
          type: boolean
        status:
          type: string
          enum: [active, inactive]
        updated_at:
          type: string
          format: date-time
        deactivated_at:
          type: string
          format: date-time
{{- end}}
    OrganizationPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/Organization"
{{- if .TenancyMembers}}
    OrganizationMember:
      type: object
      additionalProperties: false
      required: [organization_id, user_id, email, role, joined_at{{if .TenancyLifecycle}}, is_owner{{end}}]
      properties:
        organization_id:
          type: string
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        joined_at:
          type: string
          format: date-time
{{- if .TenancyLifecycle}}
        is_owner:
          type: boolean
{{- end}}
    OrganizationMemberPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/OrganizationMember"
    OrganizationInvitation:
      type: object
      additionalProperties: false
      required: [id, organization_id, email, role, acceptance_token, expires_at, created_at]
      properties:
        id:
          type: string
        organization_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        acceptance_token:
          type: string
        expires_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    OrganizationInvitationWrite:
      type: object
      additionalProperties: false
      required: [email, role]
      properties:
        email:
          type: string
          format: email
          maxLength: 254
        role:
          type: string
          enum: [admin, user]
    OrganizationMemberRoleWrite:
      type: object
      additionalProperties: false
      required: [role]
      properties:
        role:
          type: string
          enum: [admin, user]
    OrganizationInvitationAccept:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
          minLength: 1
          maxLength: 512
{{- if .TenancyLifecycle}}
    OrganizationRename:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    OrganizationOwnershipTransfer:
      type: object
      additionalProperties: false
      required: [target_user_id]
      properties:
        target_user_id:
          type: string
          minLength: 1
          maxLength: 191
{{- end}}
{{- end}}
{{- end}}
{{- if .Business}}
    {{.Business.EntityClass}}:
      type: object
      additionalProperties: false
      required:
        - id
{{- if .Tenancy}}
        - organization_id
{{- end}}
{{- range .Business.Fields}}
        - {{.Name}}
{{- end}}
        - version
        - created_at
        - updated_at
      properties:
        id:
          type: string
{{- if .Tenancy}}
        organization_id:
          type: string
{{- end}}
{{- range .Business.Fields}}
        {{.Name}}:
{{- if .Required}}
          type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- else}}
          oneOf:
            - type: {{.OpenAPIType}}
{{- if .OpenAPIFormat}}
              format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
              pattern: {{.OpenAPIPattern}}
{{- end}}
            - type: "null"
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    {{.Business.EntityClass}}Write:
      type: object
      additionalProperties: false
{{- if .Business.RequiredFields}}
      required:
{{- range .Business.RequiredFields}}
