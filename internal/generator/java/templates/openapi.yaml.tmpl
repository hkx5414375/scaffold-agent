components:
{{- if or .Tenancy .Approvals .Catalog .CustomerAccounts .CRM .Inventory .Commerce}}
  parameters:
{{- if .CRM}}
    CRMRecordStatus:
      name: status
      in: query
      schema: {type: string, enum: [active, archived]}
    CRMOpportunityStage:
      name: stage
      in: query
      schema: {type: string, enum: [lead, qualified, proposal, won, lost]}
    CRMRecordId:
      name: id
      in: path
      required: true
      schema: {type: string, minLength: 1, maxLength: 191}
{{- end}}
{{- if .Inventory}}
    InventoryRecordStatus:
      name: status
      in: query
      schema: {type: string, enum: [active, archived]}
    InventoryReservationStatus:
      name: status
      in: query
      schema: {type: string, enum: [active, released, consumed]}
    InventoryPurchaseStatus:
      name: status
      in: query
      schema: {type: string, enum: [draft, submitted, partially_received, received, cancelled]}
    InventoryRecordId:
      name: id
      in: path
      required: true
      schema: {type: string, minLength: 1, maxLength: 191}
{{- end}}
{{- if .Approvals}}
    ApprovalStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [pending, approved, rejected, cancelled]
    ApprovalId:
      name: id
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- if .Catalog}}
    CatalogStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [draft, active, archived]
    CatalogProductId:
      name: id
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- if .CustomerAccounts}}
    CustomerStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [active, suspended, closed]
    CustomerId:
      name: id
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- if or .Approvals .Catalog .CustomerAccounts .CRM .Inventory .Commerce}}
    PageCursor:
      name: cursor
      in: query
      schema:
        type: string
        maxLength: 191
    PageLimit:
      name: limit
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 20
{{- end}}
{{- if .Tenancy}}
    OrganizationHeader:
      name: X-Organization-ID
      in: header
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- if .TenancyMembers}}
    OrganizationPathId:
      name: organizationId
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
    OrganizationMemberUserId:
      name: userId
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- end}}
{{- end}}
  securitySchemes:
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
    bearerToken:
      type: http
      scheme: bearer
{{- if .CustomerAccounts}}
    customerSessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_customer_session
{{- end}}
  responses:
    ErrorResponse:
      description: Stable API error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
  schemas:
{{- if .CRM}}
    CRMAccount:
      type: object
      required: [id, name, status, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        name: {type: string, minLength: 1, maxLength: 160}
        status: {type: string, enum: [active, archived]}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
    CRMAccountWrite:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name: {type: string, minLength: 1, maxLength: 160}
    CRMAccountUpdate:
      type: object
      additionalProperties: false
      required: [name, version]
      properties:
        name: {type: string, minLength: 1, maxLength: 160}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
    CRMContact:
      type: object
      required: [id, name, status, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        account_id: {type: string}
        name: {type: string, minLength: 1, maxLength: 160}
        email: {type: string, format: email, maxLength: 254}
        phone: {type: string, maxLength: 64}
        status: {type: string, enum: [active, archived]}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
    CRMContactWrite:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        account_id: {type: string}
        name: {type: string, minLength: 1, maxLength: 160}
        email: {type: string, format: email, maxLength: 254}
        phone: {type: string, maxLength: 64}
    CRMContactUpdate:
      type: object
      additionalProperties: false
      required: [name, version]
      properties:
        account_id: {type: string}
        name: {type: string, minLength: 1, maxLength: 160}
        email: {type: string, format: email, maxLength: 254}
        phone: {type: string, maxLength: 64}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
    CRMActivity:
      type: object
      required: [id, subject_type, subject_id, type, summary, occurred_at, created_by, created_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        subject_type: {type: string, enum: [account, contact, opportunity]}
        subject_id: {type: string}
        type: {type: string, enum: [note, call, email, meeting]}
        summary: {type: string, minLength: 1, maxLength: 4000}
        occurred_at: {type: string, format: date-time}
        created_by: {type: string}
        created_at: {type: string, format: date-time}
    CRMActivityWrite:
      type: object
      additionalProperties: false
      required: [subject_type, subject_id, type, summary, occurred_at]
      properties:
        subject_type: {type: string, enum: [account, contact, opportunity]}
        subject_id: {type: string}
        type: {type: string, enum: [note, call, email, meeting]}
