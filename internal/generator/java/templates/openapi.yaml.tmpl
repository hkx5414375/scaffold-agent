openapi: 3.1.0
info:
  title: {{.ProjectName}} API
  version: 0.1.0
paths:
  /healthz:
    get:
      operationId: getHealth
      responses:
        "200":
          description: Process is running
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /readyz:
    get:
      operationId: getReadiness
      responses:
        "200":
          description: Database is available
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
{{- if .Observability}}
  /metrics:
    get:
      operationId: getMetrics
      responses:
        "200":
          description: Low-cardinality Prometheus process metrics without user-derived labels
          content:
            text/plain:
              schema:
                type: string
{{- end}}
        "503":
          description: Database is unavailable
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /api/v1/auth/login:
    post:
      operationId: login
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Authenticated browser session
          headers:
            Set-Cookie:
              schema:
                type: string
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/logout:
    post:
      operationId: logout
      responses:
        "204":
          description: Browser session revoked when present
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/me:
    get:
      operationId: getCurrentPrincipal
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Current principal
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PrincipalResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/auth/tokens:
    post:
      operationId: createApiToken
      x-required-permission: identity:token:create
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TokenRequest"
      responses:
        "201":
          description: Raw API token returned once
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/TokenResponse"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
{{- if .Tenancy}}
  /api/v1/organizations:
    post:
      operationId: createOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateOrganizationRequest"
      responses:
        "201":
          description: Organization created with an administrator membership
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: listOrganizations
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organizations visible to the authenticated identity
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationPage"
        "401":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
{{- if .TenancyMembers}}
{{- if .TenancyLifecycle}}
  /api/v1/organizations/{organizationId}:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
    patch:
      operationId: renameOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationRename"
      responses:
        "200":
          description: Renamed active organization
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationId}/ownership-transfers:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
    post:
      operationId: transferOrganizationOwnership
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationOwnershipTransfer"
      responses:
        "200":
          description: Ownership transferred to an existing member
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationId}/deactivation:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
    post:
      operationId: deactivateOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organization deactivated without deleting tenant data
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationId}/reactivation:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
    post:
      operationId: reactivateOrganization
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organization reactivated by its owner
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
  /api/v1/organizations/{organizationId}/members:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationHeader"
    get:
      operationId: listOrganizationMembers
      x-required-permission: tenancy:members:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Organization members
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMemberPage"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationId}/invitations:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationHeader"
    post:
      operationId: createOrganizationInvitation
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationWrite"
      responses:
        "201":
          description: Invitation with its acceptance token returned exactly once
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationInvitation"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organizations/{organizationId}/members/{userId}:
    parameters:
      - $ref: "#/components/parameters/OrganizationPathId"
      - $ref: "#/components/parameters/OrganizationMemberUserId"
      - $ref: "#/components/parameters/OrganizationHeader"
    patch:
      operationId: changeOrganizationMemberRole
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationMemberRoleWrite"
      responses:
        "200":
          description: Updated organization member
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: removeOrganizationMember
      x-required-permission: tenancy:members:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "204":
          description: Organization member removed
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/organization-invitations/accept:
    post:
      operationId: acceptOrganizationInvitation
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationAccept"
      responses:
        "200":
          description: Accepted organization membership
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
{{- if .Files}}
  /api/v1/files:
    post:
      operationId: uploadFileAsset
      x-required-permission: files:create
      security:
        - sessionCookie: []
        - bearerToken: []
{{- if .Tenancy}}
      parameters:
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              additionalProperties: false
              required: [file]
              properties:
                file:
                  type: string
                  format: binary
      responses:
        "201":
          description: File asset created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAsset"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "413":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: listFileAssets
      x-required-permission: files:read
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
{{- if .Tenancy}}
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
        - name: cursor
          in: query
          schema:
            type: string
            maxLength: 191
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Bounded file metadata page
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAssetPage"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/files/{id}:
    parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    get:
      operationId: getFileAsset
      x-required-permission: files:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Active file metadata
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAsset"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
    delete:
      operationId: deleteFileAsset
      x-required-permission: files:delete
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "204":
          description: File metadata and object deleted
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "500":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/files/{id}/content:
    parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    get:
      operationId: downloadFileAsset
      x-required-permission: files:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Streamed file content
          headers:
            Content-Disposition:
              schema:
                type: string
            X-Content-Type-Options:
              schema:
                type: string
                const: nosniff
          content:
            application/octet-stream:
              schema:
                type: string
                format: binary
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
{{- if .JobAdmin}}
  /api/v1/jobs:
    get:
      operationId: listBackgroundJobs
      x-required-permission: jobs:read
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
{{- if .Tenancy}}
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
        - name: status
          in: query
          schema:
            type: string
            enum: [queued, running, succeeded, retry, dead]
        - name: cursor
          in: query
          schema:
            type: string
            maxLength: 191
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Bounded background job metadata page without payloads or internal keys
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/JobAdministrationPage"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/jobs/{id}/retry:
    parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: retryDeadBackgroundJob
      x-required-permission: jobs:manage
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Dead background job reset and returned to the queue
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/JobAdministrationItem"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
{{- if .Approvals}}
  /api/v1/approvals:
    post:
      operationId: submitApproval
      x-required-permission: approvals:submit
      security:
        - sessionCookie: []
        - bearerToken: []
{{- if .Tenancy}}
      parameters:
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ApprovalSubmit"
      responses:
        "201":
          description: Pending approval request
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalRequest"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
    get:
      operationId: listApprovals
      x-required-permission: approvals:read
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
{{- if .Tenancy}}
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
        - $ref: "#/components/parameters/ApprovalStatus"
        - $ref: "#/components/parameters/PageCursor"
        - $ref: "#/components/parameters/PageLimit"
      responses:
        "200":
          description: Bounded approval review queue
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalPage"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/approvals/mine:
    get:
      operationId: listOwnApprovals
      x-required-permission: approvals:mine
      security:
        - sessionCookie: []
        - bearerToken: []
      parameters:
{{- if .Tenancy}}
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
        - $ref: "#/components/parameters/ApprovalStatus"
        - $ref: "#/components/parameters/PageCursor"
        - $ref: "#/components/parameters/PageLimit"
      responses:
        "200":
          description: Current requester's approval requests
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalPage"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/approvals/{id}:
    parameters:
      - $ref: "#/components/parameters/ApprovalId"
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    get:
      operationId: getApproval
      x-required-permission: approvals:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: One scoped approval request
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalRequest"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
  /api/v1/approvals/{id}/events:
    parameters:
      - $ref: "#/components/parameters/ApprovalId"
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    get:
      operationId: listApprovalEvents
      x-required-permission: approvals:read
      security:
        - sessionCookie: []
        - bearerToken: []
      responses:
        "200":
          description: Immutable approval event history
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalEventPage"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
{{- range $operation := list "approve" "reject"}}
  /api/v1/approvals/{id}/{{$operation}}:
    parameters:
      - $ref: "#/components/parameters/ApprovalId"
{{- if $.Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: {{$operation}}Approval
      x-required-permission: approvals:decide
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ApprovalDecision"
      responses:
        "200":
          description: Resolved approval request
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalRequest"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
  /api/v1/approvals/{id}/cancel:
    parameters:
      - $ref: "#/components/parameters/ApprovalId"
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: cancelApproval
      x-required-permission: approvals:mine
      security:
        - sessionCookie: []
        - bearerToken: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ApprovalDecision"
      responses:
        "200":
          description: Cancelled approval request
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalRequest"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "404":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
{{- end}}
{{- if .CSVTransfer}}
  {{.Business.RoutePath}}/import:
    post:
      operationId: import{{.Business.EntityClass}}CSV
      x-required-permission: {{.Business.PermissionPrefix}}:import
      security:
        - sessionCookie: []
        - bearerToken: []
{{- if .Tenancy}}
      parameters:
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      requestBody:
        required: true
        content:
          text/csv:
            schema:
              type: string
              format: binary
      responses:
        "201":
          description: Entire validated CSV batch inserted atomically
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CSVImportResult"
        "400":
          $ref: "#/components/responses/ErrorResponse"
        "401":
          $ref: "#/components/responses/ErrorResponse"
        "403":
          $ref: "#/components/responses/ErrorResponse"
        "409":
          $ref: "#/components/responses/ErrorResponse"
        "413":
          $ref: "#/components/responses/ErrorResponse"
        "415":
          $ref: "#/components/responses/ErrorResponse"
        "422":
          $ref: "#/components/responses/ErrorResponse"
  {{.Business.RoutePath}}/import-template:
    get:
      operationId: download{{.Business.EntityClass}}CSVTemplate
      x-required-permission: {{.Business.PermissionPrefix}}:import
      security:
        - sessionCookie: []
        - bearerToken: []
{{- if .Tenancy}}
      parameters:
        - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      responses:
        "200":
          description: Header-only generated CSV template
          content:
            text/csv:
              schema:
