"""Atomic SQL application cache persistence."""

import json
from datetime import datetime
from typing import Protocol, cast

from sqlalchemy import delete, func, select, text, tuple_
from sqlalchemy.dialects.mysql import insert as mysql_insert
from sqlalchemy.dialects.postgresql import insert as postgresql_insert
from sqlalchemy.dialects.sqlite import insert as sqlite_insert
from sqlalchemy.engine import Engine, RowMapping

from {{.PackageName}}.cache.models import CacheEntry, application_cache


class CacheMiss(Exception):
    """No unexpired entry exists for the scoped key."""


class CacheRepository(Protocol):
    """Cross-instance cache persistence seam."""

    def set(self, entry: CacheEntry) -> None: ...

    def get(self, scope_key: str, key: str, now: datetime) -> CacheEntry: ...

    def delete(self, scope_key: str, key: str) -> None: ...

    def purge_expired(self, now: datetime, limit: int) -> int: ...


class SQLAlchemyCacheRepository:
    """Dialect-native upsert and bounded expiry cleanup adapter."""

    def __init__(self, engine: Engine) -> None:
        self._engine = engine

    def set(self, entry: CacheEntry) -> None:
        values = {
            "scope_key": entry.scope_key,
            "cache_key": entry.key,
            "organization_id": {{if .Tenancy}}entry.scope_key{{else}}None{{end}},
            "value_json": json.loads(entry.value_json),
            "expires_at": entry.expires_at,
            "updated_at": func.now(),
        }
        dialect = self._engine.dialect.name
        with self._engine.begin() as connection:
            if dialect == "postgresql":
                postgresql_statement = postgresql_insert(application_cache).values(**values)
                connection.execute(
                    postgresql_statement.on_conflict_do_update(
                        index_elements=[
                            application_cache.c.scope_key,
                            application_cache.c.cache_key,
                        ],
                        set_={
                            "value_json": postgresql_statement.excluded.value_json,
                            "expires_at": postgresql_statement.excluded.expires_at,
                            "updated_at": func.now(),
                        },
                    )
                )
            elif dialect == "mysql":
                mysql_statement = mysql_insert(application_cache).values(**values)
                connection.execute(
                    mysql_statement.on_duplicate_key_update(
                        value_json=mysql_statement.inserted.value_json,
                        expires_at=mysql_statement.inserted.expires_at,
                        updated_at=text("utc_timestamp(6)"),
                    )
                )
            else:
                sqlite_statement = sqlite_insert(application_cache).values(**values)
                connection.execute(
                    sqlite_statement.on_conflict_do_update(
                        index_elements=[
                            application_cache.c.scope_key,
                            application_cache.c.cache_key,
                        ],
                        set_={
                            "value_json": sqlite_statement.excluded.value_json,
                            "expires_at": sqlite_statement.excluded.expires_at,
                            "updated_at": func.current_timestamp(),
                        },
                    )
                )

    def get(self, scope_key: str, key: str, now: datetime) -> CacheEntry:
        with self._engine.connect() as connection:
            row = (
                connection.execute(
                    select(application_cache).where(
                        application_cache.c.scope_key == scope_key,
                        application_cache.c.cache_key == key,
                        application_cache.c.expires_at > now,
                    )
                )
                .mappings()
                .first()
            )
        if row is None:
            raise CacheMiss()
        return _map_entry(row)

    def delete(self, scope_key: str, key: str) -> None:
        with self._engine.begin() as connection:
            connection.execute(
                delete(application_cache).where(
                    application_cache.c.scope_key == scope_key,
                    application_cache.c.cache_key == key,
                )
            )

    def purge_expired(self, now: datetime, limit: int) -> int:
        dialect = self._engine.dialect.name
        with self._engine.begin() as connection:
            if dialect == "postgresql":
                result = connection.execute(
                    text(
                        "delete from application_cache where ctid in ("
                        "select ctid from application_cache where expires_at <= :now "
                        "order by expires_at limit :limit)"
                    ),
                    {"now": now, "limit": limit},
                )
            elif dialect == "mysql":
                result = connection.execute(
                    text(
                        "delete from application_cache where expires_at <= :now "
                        "order by expires_at limit :limit"
                    ),
                    {"now": now, "limit": limit},
                )
            else:
                candidates = (
                    select(application_cache.c.scope_key, application_cache.c.cache_key)
                    .where(application_cache.c.expires_at <= now)
                    .order_by(application_cache.c.expires_at)
                    .limit(limit)
                )
                result = connection.execute(
                    delete(application_cache).where(
                        tuple_(
                            application_cache.c.scope_key,
                            application_cache.c.cache_key,
                        ).in_(candidates)
                    )
                )
        return max(result.rowcount or 0, 0)


def _map_entry(row: RowMapping) -> CacheEntry:
    return CacheEntry(
        scope_key=str(row["scope_key"]),
        key=str(row["cache_key"]),
        value_json=json.dumps(
            row["value_json"],
            allow_nan=False,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        ),
        expires_at=cast(datetime, row["expires_at"]),
    )
