"""Commerce catalog API records and SQLAlchemy table metadata."""

from datetime import datetime
from enum import StrEnum

import sqlalchemy as sa
from pydantic import BaseModel, ConfigDict, Field, field_validator

from {{.PackageName}}.identity.models import metadata

NON_NEGATIVE_INTEGER = r"^(0|[1-9][0-9]*)$"
POSITIVE_VERSION = r"^[1-9][0-9]*$"

catalog_products = sa.Table(
    "catalog_products",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    sa.Column(
        "organization_id",
        sa.String(191),
{{- if .Tenancy}}
        sa.ForeignKey("organizations.id", ondelete="CASCADE"),
        nullable=False,
{{- else}}
        nullable=True,
{{- end}}
    ),
    sa.Column("sku", sa.String(64), nullable=False),
    sa.Column("name", sa.String(160), nullable=False),
    sa.Column("description", sa.Text(), nullable=False),
    sa.Column("price_minor", sa.BigInteger(), nullable=False),
    sa.Column("currency", sa.String(3), nullable=False),
    sa.Column("status", sa.String(16), nullable=False),
    sa.Column("version", sa.BigInteger(), nullable=False),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
    sa.Column("updated_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint("price_minor >= 0", name="catalog_products_price"),
    sa.CheckConstraint(
        "status in ('draft', 'active', 'archived')",
        name="catalog_products_status",
    ),
    sa.CheckConstraint("version > 0", name="catalog_products_version"),
{{- if .Tenancy}}
    sa.UniqueConstraint(
        "organization_id",
        "sku",
        name="catalog_products_scope_sku_unique",
    ),
{{- else}}
    sa.UniqueConstraint("sku", name="catalog_products_sku_unique"),
{{- end}}
)
sa.Index(
    "catalog_products_scope_status_idx",
{{- if .Tenancy}}
    catalog_products.c.organization_id,
{{- end}}
    catalog_products.c.status,
    catalog_products.c.id,
)


class CatalogStatus(StrEnum):
    """Portable product publication states."""

    DRAFT = "draft"
    ACTIVE = "active"
    ARCHIVED = "archived"


class CatalogErrorKind(StrEnum):
    """Stable catalog failure categories."""

    INVALID = "invalid"
    NOT_FOUND = "not_found"
    CONFLICT = "conflict"
    STORAGE = "storage"


class CatalogError(Exception):
    """Expected catalog failure without storage internals."""

    def __init__(self, kind: CatalogErrorKind, message: str) -> None:
        super().__init__(message)
        self.kind = kind
        self.message = message


class StrictModel(BaseModel):
    """Reject fields outside the stable catalog contract."""

    model_config = ConfigDict(extra="forbid")


class CatalogProduct(StrictModel):
    """Persisted product with string-safe money and version values."""

    id: str = Field(min_length=1, max_length=191)
{{- if .Tenancy}}
    organization_id: str = Field(min_length=1, max_length=191)
{{- end}}
    sku: str = Field(pattern=r"^[A-Z0-9][A-Z0-9._-]{0,63}$", max_length=64)
    name: str = Field(min_length=1, max_length=160)
    description: str = Field(default="", max_length=4000)
    price_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    currency: str = Field(pattern=r"^[A-Z]{3}$", max_length=3)
    status: CatalogStatus
    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)
    created_at: datetime
    updated_at: datetime

    @field_validator("created_at", "updated_at")
    @classmethod
    def require_timezone(cls, value: datetime) -> datetime:
        """Reject ambiguous local timestamps."""
        if value.tzinfo is None or value.utcoffset() is None:
            raise ValueError("datetime values must include a UTC offset")
        return value


class CatalogWrite(StrictModel):
    """Bounded product content input."""

    sku: str = Field(min_length=1, max_length=64)
    name: str = Field(min_length=1, max_length=160)
    description: str = Field(default="", max_length=4000)
    price_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    currency: str = Field(min_length=3, max_length=3)


class CatalogUpdate(CatalogWrite):
    """Optimistic product replacement."""

    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)


class CatalogTransition(StrictModel):
    """Optimistic publication transition input."""

    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)


class CatalogPage(StrictModel):
    """Bounded keyset product page."""

    items: list[CatalogProduct]
    next_cursor: str
