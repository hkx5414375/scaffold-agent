"""Transactional commerce catalog persistence with atomic audit evidence."""

from dataclasses import dataclass
from datetime import UTC, datetime
from typing import Protocol, cast

from sqlalchemy import func, insert, select, update
from sqlalchemy.engine import Connection, Engine, RowMapping
from sqlalchemy.exc import IntegrityError

from {{.PackageName}}.catalog.models import (
    CatalogProduct,
    CatalogStatus,
    catalog_products,
)
from {{.PackageName}}.identity.models import AuditEvent
from {{.PackageName}}.identity.repository import append_audit
{{- if .Tenancy}}
from {{.PackageName}}.tenancy.models import organizations
{{- end}}


class CatalogConflict(Exception):
    """A version, state, scope, or SKU constraint rejected a mutation."""


@dataclass(frozen=True, slots=True)
class CatalogMutation:
    """Normalized optimistic product content replacement."""

    organization_id: str
    product_id: str
    sku: str
    name: str
    description: str
    price_minor: int
    currency: str
    expected_version: int
    updated_at: datetime


@dataclass(frozen=True, slots=True)
class CatalogStatusTransition:
    """Database-enforced publication transition."""

    organization_id: str
    product_id: str
    expected_version: int
    from_status: CatalogStatus
    to_status: CatalogStatus
    updated_at: datetime


@dataclass(frozen=True, slots=True)
class CatalogPageResult:
    """Internal bounded keyset page."""

    items: list[CatalogProduct]
    next_cursor: str


class CatalogRepository(Protocol):
    """Persistence seam for scoped catalog transactions."""

    def create(self, product: CatalogProduct, audit: AuditEvent) -> None: ...

    def get(self, organization_id: str, product_id: str) -> CatalogProduct | None: ...

    def get_public(self, organization_id: str, product_id: str) -> CatalogProduct | None: ...

    def list_page(
        self,
        organization_id: str,
        status: str,
        cursor: str,
        limit: int,
        public_read: bool,
    ) -> CatalogPageResult: ...

    def update(self, mutation: CatalogMutation, audit: AuditEvent) -> CatalogProduct: ...

    def transition(
        self,
        transition: CatalogStatusTransition,
        audit: AuditEvent,
    ) -> CatalogProduct: ...


class SQLAlchemyCatalogRepository:
    """SQLAlchemy adapter repeating scope, version, and state predicates in SQL."""

    def __init__(self, engine: Engine) -> None:
        self._engine = engine

    def create(self, product: CatalogProduct, audit: AuditEvent) -> None:
        try:
            with self._engine.begin() as connection:
                connection.execute(insert(catalog_products).values(**_product_values(product)))
                append_audit(connection, audit)
        except IntegrityError as error:
            raise CatalogConflict() from error

    def get(self, organization_id: str, product_id: str) -> CatalogProduct | None:
        statement = select(catalog_products).where(
            catalog_products.c.id == product_id,
            func.coalesce(catalog_products.c.organization_id, "") == organization_id,
        )
        with self._engine.connect() as connection:
            row = connection.execute(statement).mappings().first()
        return _map_product(row) if row is not None else None

    def get_public(self, organization_id: str, product_id: str) -> CatalogProduct | None:
        statement = select(catalog_products)
{{- if .Tenancy}}
        statement = statement.join(
            organizations,
            organizations.c.id == catalog_products.c.organization_id,
        )
{{- end}}
        statement = statement.where(
            catalog_products.c.id == product_id,
            func.coalesce(catalog_products.c.organization_id, "") == organization_id,
            catalog_products.c.status == CatalogStatus.ACTIVE.value,
{{- if .Tenancy}}
            organizations.c.status == "active",
{{- end}}
        )
        with self._engine.connect() as connection:
            row = connection.execute(statement).mappings().first()
        return _map_product(row) if row is not None else None

    def list_page(
        self,
        organization_id: str,
        status: str,
        cursor: str,
        limit: int,
        public_read: bool,
    ) -> CatalogPageResult:
        statement = select(catalog_products)
{{- if .Tenancy}}
        if public_read:
            statement = statement.join(
                organizations,
                organizations.c.id == catalog_products.c.organization_id,
            ).where(organizations.c.status == "active")
{{- end}}
        statement = statement.where(
            func.coalesce(catalog_products.c.organization_id, "") == organization_id
        )
        if status:
            statement = statement.where(catalog_products.c.status == status)
        if public_read:
            statement = statement.where(catalog_products.c.status == CatalogStatus.ACTIVE.value)
        if cursor:
            statement = statement.where(catalog_products.c.id > cursor)
        statement = statement.order_by(catalog_products.c.id).limit(limit + 1)
        with self._engine.connect() as connection:
            rows = connection.execute(statement).mappings().all()
        values = [_map_product(row) for row in rows]
        next_cursor = values[limit - 1].id if len(values) > limit else ""
        return CatalogPageResult(values[:limit], next_cursor)

    def update(self, mutation: CatalogMutation, audit: AuditEvent) -> CatalogProduct:
        try:
            with self._engine.begin() as connection:
                changed = connection.execute(
                    update(catalog_products)
                    .where(
                        catalog_products.c.id == mutation.product_id,
                        func.coalesce(catalog_products.c.organization_id, "")
                        == mutation.organization_id,
                        catalog_products.c.version == mutation.expected_version,
                        catalog_products.c.status != CatalogStatus.ARCHIVED.value,
                    )
                    .values(
                        sku=mutation.sku,
                        name=mutation.name,
                        description=mutation.description,
                        price_minor=mutation.price_minor,
                        currency=mutation.currency,
                        version=catalog_products.c.version + 1,
                        updated_at=mutation.updated_at,
                    )
                ).rowcount
                _require_mutation(changed)
                append_audit(connection, audit)
                return _read_changed(connection, mutation.organization_id, mutation.product_id)
        except IntegrityError as error:
            raise CatalogConflict() from error

    def transition(
        self,
        transition: CatalogStatusTransition,
        audit: AuditEvent,
    ) -> CatalogProduct:
        try:
            with self._engine.begin() as connection:
                changed = connection.execute(
                    update(catalog_products)
                    .where(
                        catalog_products.c.id == transition.product_id,
                        func.coalesce(catalog_products.c.organization_id, "")
                        == transition.organization_id,
                        catalog_products.c.version == transition.expected_version,
                        catalog_products.c.status == transition.from_status.value,
                    )
                    .values(
                        status=transition.to_status.value,
                        version=catalog_products.c.version + 1,
                        updated_at=transition.updated_at,
                    )
                ).rowcount
                _require_mutation(changed)
                append_audit(connection, audit)
                return _read_changed(
                    connection,
                    transition.organization_id,
                    transition.product_id,
                )
        except IntegrityError as error:
            raise CatalogConflict() from error


def _read_changed(
    connection: Connection,
    organization_id: str,
    product_id: str,
) -> CatalogProduct:
    row = (
        connection.execute(
            select(catalog_products).where(
                catalog_products.c.id == product_id,
                func.coalesce(catalog_products.c.organization_id, "") == organization_id,
            )
        )
        .mappings()
        .one()
    )
    return _map_product(row)


def _require_mutation(changed: int) -> None:
    if changed != 1:
        raise CatalogConflict()


def _product_values(value: CatalogProduct) -> dict[str, object]:
    return {
        "id": value.id,
        "organization_id": {{if .Tenancy}}value.organization_id{{else}}None{{end}},
        "sku": value.sku,
        "name": value.name,
        "description": value.description,
        "price_minor": int(value.price_minor),
        "currency": value.currency,
        "status": value.status.value,
        "version": int(value.version),
        "created_at": value.created_at,
        "updated_at": value.updated_at,
    }


def _map_product(row: RowMapping) -> CatalogProduct:
    return CatalogProduct(
        id=str(row["id"]),
{{- if .Tenancy}}
        organization_id=str(row["organization_id"]),
{{- end}}
        sku=str(row["sku"]),
        name=str(row["name"]),
        description=str(row["description"]),
        price_minor=str(row["price_minor"]),
        currency=str(row["currency"]),
        status=CatalogStatus(str(row["status"])),
        version=str(row["version"]),
        created_at=_utc(cast(datetime, row["created_at"])),
        updated_at=_utc(cast(datetime, row["updated_at"])),
    )


def _utc(value: datetime) -> datetime:
    if value.tzinfo is None or value.utcoffset() is None:
        return value.replace(tzinfo=UTC)
    return value.astimezone(UTC)
