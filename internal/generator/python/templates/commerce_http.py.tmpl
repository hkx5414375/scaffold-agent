router = APIRouter(tags=["commerce"])


def commerce_service(request: Request) -> CommerceService:
    service: CommerceService = request.app.state.commerce_service
    return service


def install_error_handlers(app: FastAPI) -> None:
    """Install stable commerce errors without exposing provider or storage internals."""

    @app.exception_handler(CommerceError)
    async def commerce_error(_request: Request, error: CommerceError) -> JSONResponse:
        status, code = {
            CommerceErrorKind.INVALID: (400, "commerce.invalid"),
            CommerceErrorKind.NOT_FOUND: (404, "commerce.not_found"),
            CommerceErrorKind.CONFLICT: (409, "commerce.conflict"),
            CommerceErrorKind.STORAGE: (500, "internal.error"),
        }[error.kind]
        return JSONResponse(
            status_code=status,
            content=ApiError(code=code, message=error.message).model_dump(),
        )


Customer = Annotated[CustomerRecord, Depends(current_customer)]
Service = Annotated[CommerceService, Depends(commerce_service)]
