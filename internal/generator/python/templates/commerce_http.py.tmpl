@router.post(
    "/api/v1/storefront/sandbox/payments/{provider_ref}/complete",
    response_model=CommerceOrder,
    response_model_exclude_none=True,
)
def complete_sandbox_payment(
    provider_ref: str,
    value: SandboxCompletion,
    request: Request,
    service: Service,
) -> CommerceOrder:
    if not bool(request.app.state.commerce_sandbox_enabled):
        raise HTTPException(status_code=404, detail="not found")
    gateway: SandboxPaymentGateway = request.app.state.commerce_sandbox_gateway
    try:
        gateway.complete(provider_ref, value.status.value)
    except GatewayNotFound as error:
        raise CommerceError(CommerceErrorKind.NOT_FOUND, "commerce record was not found") from error
    except GatewayConflict as error:
        raise CommerceError(
            CommerceErrorKind.CONFLICT,
            "commerce state conflicts with the request",
        ) from error
    return service.complete_payment(provider_ref, value.event_id, value.status.value)


