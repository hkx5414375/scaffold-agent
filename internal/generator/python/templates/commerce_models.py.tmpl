class CommerceErrorKind(StrEnum):
    INVALID = "invalid"
    NOT_FOUND = "not_found"
    CONFLICT = "conflict"
    STORAGE = "storage"


class CommerceError(Exception):
    def __init__(self, kind: CommerceErrorKind, message: str) -> None:
        super().__init__(message)
        self.kind = kind
        self.message = message


class StrictModel(BaseModel):
    model_config = ConfigDict(extra="forbid")


class OrderStatus(StrEnum):
    PENDING_PAYMENT = "pending_payment"
    CONFIRMED = "confirmed"
    FULFILLING = "fulfilling"
    FULFILLED = "fulfilled"
    RETURN_REQUESTED = "return_requested"
    RETURNED = "returned"
    CANCELLED = "cancelled"


class PaymentStatus(StrEnum):
    REQUIRES_ACTION = "requires_action"
    SUCCEEDED = "succeeded"
    FAILED = "failed"


class CampaignStatus(StrEnum):
    DRAFT = "draft"
    ACTIVE = "active"
    ARCHIVED = "archived"


class DiscountKind(StrEnum):
    FIXED = "fixed"
    PERCENT = "percent"


class CommerceLine(StrictModel):
    product_id: str = Field(min_length=1, max_length=191)
    sku: str = Field(min_length=1, max_length=64)
    name: str = Field(min_length=1, max_length=160)
    unit_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    quantity: str = Field(pattern=POSITIVE_INTEGER, max_length=3)
    line_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)


class CommerceCart(StrictModel):
    id: str | None = Field(default=None, max_length=191)
    organization_id: str | None = Field(default=None, max_length=191)
    customer_id: str = Field(min_length=1, max_length=191)
    currency: str = Field(pattern=r"^[A-Z]{3}$")
    status: str = Field(pattern=r"^(active|checked_out)$")
    lines: list[CommerceLine]
    subtotal_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    version: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    created_at: datetime | None = None
    updated_at: datetime | None = None


class CartLineInput(StrictModel):
    currency: str = Field(min_length=3, max_length=3)
    quantity: str = Field(pattern=POSITIVE_INTEGER, max_length=3)
    version: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)


class CartMutation(StrictModel):
    currency: str = Field(min_length=3, max_length=3)
    version: str = Field(pattern=POSITIVE_INTEGER, max_length=19)


class CheckoutInput(CartMutation):
    coupon_code: str = Field(default="", max_length=64)
    idempotency_key: str = Field(min_length=1, max_length=191)


class PaymentIntent(StrictModel):
    id: str = Field(min_length=1, max_length=191)
    provider: str = Field(min_length=1, max_length=32)
    provider_ref: str = Field(min_length=1, max_length=191)
    status: PaymentStatus
    amount_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    refunded_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    currency: str = Field(pattern=r"^[A-Z]{3}$")
    updated_at: datetime


class CommerceOrder(StrictModel):
    id: str = Field(min_length=1, max_length=191)
    organization_id: str | None = Field(default=None, max_length=191)
    customer_id: str = Field(min_length=1, max_length=191)
    status: OrderStatus
    currency: str = Field(pattern=r"^[A-Z]{3}$")
    subtotal_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    discount_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    total_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    campaign_id: str | None = None
    coupon_code: str | None = None
    lines: list[CommerceLine]
    payment: PaymentIntent
    fulfillment_ref: str | None = None
    return_reason: str | None = None
    version: str = Field(pattern=POSITIVE_INTEGER, max_length=19)
    created_at: datetime
    updated_at: datetime


class CommerceOrderPage(StrictModel):
    items: list[CommerceOrder]
    next_cursor: str


class OrderTransition(StrictModel):
    version: str = Field(pattern=POSITIVE_INTEGER, max_length=19)
    reference: str = Field(default="", max_length=191)


class ReturnInput(StrictModel):
    version: str = Field(pattern=POSITIVE_INTEGER, max_length=19)
    reason: str = Field(min_length=1, max_length=500)


class RefundInput(StrictModel):
    amount_minor: str = Field(pattern=POSITIVE_INTEGER, max_length=19)
    idempotency_key: str = Field(min_length=1, max_length=191)


class SandboxCompletion(StrictModel):
    event_id: str = Field(min_length=1, max_length=191)
    status: PaymentStatus


class CampaignInput(StrictModel):
    name: str = Field(min_length=1, max_length=160)
    kind: DiscountKind
    value: str = Field(pattern=POSITIVE_INTEGER, max_length=19)
    minimum_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    currency: str = Field(min_length=3, max_length=3)
    priority: int = Field(ge=-1000, le=1000)
    coupon_required: bool = False
    starts_at: datetime
    ends_at: datetime

    @field_validator("starts_at", "ends_at")
    @classmethod
    def require_timezone(cls, value: datetime) -> datetime:
        if value.tzinfo is None or value.utcoffset() is None:
            raise ValueError("datetime values must include a UTC offset")
        return value


class Campaign(StrictModel):
    id: str
    organization_id: str | None = None
    name: str
    kind: DiscountKind
    value: str
    minimum_minor: str
    currency: str
    priority: int
    coupon_required: bool
    status: CampaignStatus
    starts_at: datetime
    ends_at: datetime
    version: str
    created_at: datetime
    updated_at: datetime


class CampaignPage(StrictModel):
    items: list[Campaign]
    next_cursor: str


class CampaignTransition(StrictModel):
    version: str = Field(pattern=POSITIVE_INTEGER, max_length=19)


class CouponInput(StrictModel):
    campaign_id: str = Field(min_length=1, max_length=191)
    code: str = Field(min_length=1, max_length=64)
    maximum_uses: str = Field(pattern=POSITIVE_INTEGER, max_length=19)


class Coupon(StrictModel):
    id: str
    organization_id: str | None = None
    campaign_id: str
    code: str
    maximum_uses: str
    used_count: str
    created_at: datetime


commerce_metadata = metadata
