"""Portable commerce API records and SQLAlchemy table metadata."""

from datetime import datetime
from enum import StrEnum

import sqlalchemy as sa
from pydantic import BaseModel, ConfigDict, Field, field_validator

from {{.PackageName}}.identity.models import metadata

NON_NEGATIVE_INTEGER = r"^(0|[1-9][0-9]*)$"
POSITIVE_INTEGER = r"^[1-9][0-9]*$"


def _organization_column() -> sa.Column[str]:
    return sa.Column(
        "organization_id",
        sa.String(191),
{{- if .Tenancy}}
        sa.ForeignKey("organizations.id", ondelete="CASCADE"),
{{- end}}
        nullable=False,
    )


commerce_carts = sa.Table(
    "commerce_carts",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    _organization_column(),
    sa.Column(
        "customer_id",
        sa.String(191),
        sa.ForeignKey("customer_accounts.id", ondelete="CASCADE"),
        nullable=False,
    ),
    sa.Column("currency", sa.String(3), nullable=False),
    sa.Column("status", sa.String(16), nullable=False),
    sa.Column("version", sa.BigInteger(), nullable=False),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
    sa.Column("updated_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint("status in ('active', 'checked_out')", name="commerce_carts_status"),
    sa.CheckConstraint("version > 0", name="commerce_carts_version"),
    sa.UniqueConstraint(
        "organization_id",
        "customer_id",
        "currency",
        "status",
        name="commerce_carts_scope_customer_currency_status_unique",
    ),
)
sa.Index(
    "commerce_carts_scope_customer_idx",
    commerce_carts.c.organization_id,
    commerce_carts.c.customer_id,
    commerce_carts.c.id,
)

commerce_cart_lines = sa.Table(
    "commerce_cart_lines",
    metadata,
    sa.Column(
        "cart_id",
        sa.String(191),
        sa.ForeignKey("commerce_carts.id", ondelete="CASCADE"),
        primary_key=True,
    ),
    sa.Column("product_id", sa.String(191), sa.ForeignKey("catalog_products.id"), primary_key=True),
    sa.Column("sku", sa.String(64), nullable=False),
    sa.Column("name", sa.String(160), nullable=False),
    sa.Column("unit_minor", sa.BigInteger(), nullable=False),
    sa.Column("quantity", sa.BigInteger(), nullable=False),
    sa.Column("line_minor", sa.BigInteger(), nullable=False),
    sa.CheckConstraint("unit_minor >= 0", name="commerce_cart_lines_unit"),
    sa.CheckConstraint("quantity > 0 and quantity <= 999", name="commerce_cart_lines_quantity"),
    sa.CheckConstraint("line_minor >= 0", name="commerce_cart_lines_total"),
)

commerce_campaigns = sa.Table(
    "commerce_campaigns",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    _organization_column(),
    sa.Column("name", sa.String(160), nullable=False),
    sa.Column("discount_kind", sa.String(16), nullable=False),
    sa.Column("discount_value", sa.BigInteger(), nullable=False),
    sa.Column("minimum_minor", sa.BigInteger(), nullable=False),
    sa.Column("currency", sa.String(3), nullable=False),
    sa.Column("priority", sa.Integer(), nullable=False),
    sa.Column("coupon_required", sa.Boolean(), nullable=False),
    sa.Column("status", sa.String(16), nullable=False),
    sa.Column("starts_at", sa.DateTime(timezone=True), nullable=False),
    sa.Column("ends_at", sa.DateTime(timezone=True), nullable=False),
    sa.Column("version", sa.BigInteger(), nullable=False),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
    sa.Column("updated_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint("discount_kind in ('fixed', 'percent')", name="commerce_campaigns_kind"),
    sa.CheckConstraint("discount_value > 0", name="commerce_campaigns_value"),
    sa.CheckConstraint("minimum_minor >= 0", name="commerce_campaigns_minimum"),
    sa.CheckConstraint(
        "status in ('draft', 'active', 'archived')", name="commerce_campaigns_status"
    ),
    sa.CheckConstraint("ends_at > starts_at", name="commerce_campaigns_window"),
    sa.CheckConstraint("version > 0", name="commerce_campaigns_version"),
)
sa.Index(
    "commerce_campaigns_scope_active_idx",
    commerce_campaigns.c.organization_id,
    commerce_campaigns.c.status,
    commerce_campaigns.c.currency,
    commerce_campaigns.c.priority,
    commerce_campaigns.c.id,
)

commerce_coupons = sa.Table(
    "commerce_coupons",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    _organization_column(),
    sa.Column(
        "campaign_id", sa.String(191), sa.ForeignKey("commerce_campaigns.id"), nullable=False
    ),
    sa.Column("code", sa.String(64), nullable=False),
    sa.Column("maximum_uses", sa.BigInteger(), nullable=False),
    sa.Column("used_count", sa.BigInteger(), nullable=False, server_default="0"),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint("maximum_uses > 0", name="commerce_coupons_maximum"),
    sa.CheckConstraint(
        "used_count >= 0 and used_count <= maximum_uses", name="commerce_coupons_usage"
    ),
    sa.UniqueConstraint("organization_id", "code", name="commerce_coupons_scope_code_unique"),
)

commerce_orders = sa.Table(
    "commerce_orders",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    _organization_column(),
    sa.Column("customer_id", sa.String(191), sa.ForeignKey("customer_accounts.id"), nullable=False),
    sa.Column("status", sa.String(32), nullable=False),
    sa.Column("currency", sa.String(3), nullable=False),
    sa.Column("subtotal_minor", sa.BigInteger(), nullable=False),
    sa.Column("discount_minor", sa.BigInteger(), nullable=False),
    sa.Column("total_minor", sa.BigInteger(), nullable=False),
    sa.Column("campaign_id", sa.String(191), nullable=True),
    sa.Column("coupon_code", sa.String(64), nullable=True),
    sa.Column("fulfillment_ref", sa.String(191), nullable=True),
    sa.Column("return_reason", sa.String(500), nullable=True),
    sa.Column("version", sa.BigInteger(), nullable=False),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
    sa.Column("updated_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint(
        "status in ('pending_payment', 'confirmed', 'fulfilling', 'fulfilled', "
        "'return_requested', 'returned', 'cancelled')",
        name="commerce_orders_status",
    ),
    sa.CheckConstraint("subtotal_minor >= 0", name="commerce_orders_subtotal"),
    sa.CheckConstraint(
        "discount_minor >= 0 and discount_minor <= subtotal_minor",
        name="commerce_orders_discount",
    ),
    sa.CheckConstraint(
        "total_minor = subtotal_minor - discount_minor", name="commerce_orders_total"
    ),
    sa.CheckConstraint("version > 0", name="commerce_orders_version"),
)
sa.Index(
    "commerce_orders_scope_customer_idx",
    commerce_orders.c.organization_id,
    commerce_orders.c.customer_id,
    commerce_orders.c.id,
)

commerce_order_lines = sa.Table(
