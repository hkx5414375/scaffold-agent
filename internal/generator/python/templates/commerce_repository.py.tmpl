def _append_order_event(
    connection: Connection,
    order_id: str,
    from_status: str,
    to_status: str,
    actor_id: str,
    created_at: datetime,
) -> None:
    connection.execute(
        insert(commerce_order_events).values(
            id=str(uuid4()),
            order_id=order_id,
            from_status=from_status,
            to_status=to_status,
            actor_id=actor_id,
            created_at=created_at,
        )
    )


def _required_order(value: CommerceOrder | None) -> CommerceOrder:
    if value is None:
        raise RepositoryNotFound()
    return value


def _require_one(changed: int) -> None:
    if changed != 1:
        raise RepositoryConflict()


def _utc(value: datetime) -> datetime:
    if value.tzinfo is None or value.utcoffset() is None:
        return value.replace(tzinfo=UTC)
    return value.astimezone(UTC)
