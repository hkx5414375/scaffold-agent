"""Provider-neutral commerce use cases and deterministic state machines."""

import re
from collections.abc import Callable
from datetime import UTC, datetime
from uuid import uuid4

from {{.PackageName}}.catalog.repository import CatalogRepository
from {{.PackageName}}.commerce.gateway import GatewayConflict, GatewayNotFound, PaymentGateway
from {{.PackageName}}.commerce.models import (
    Campaign,
    CampaignInput,
    CampaignPage,
    CampaignStatus,
    CampaignTransition,
    CartLineInput,
    CartMutation,
    CheckoutInput,
    CommerceCart,
    CommerceError,
    CommerceErrorKind,
    CommerceLine,
    CommerceOrder,
    CommerceOrderPage,
    Coupon,
    CouponInput,
    DiscountKind,
    OrderStatus,
    OrderTransition,
