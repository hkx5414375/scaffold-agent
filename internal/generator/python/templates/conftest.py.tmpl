"""Create one disposable database scope for every configured integration test."""

import os
from collections.abc import Iterator
from contextlib import contextmanager
from uuid import uuid4

import pytest
from sqlalchemy.engine import URL, make_url
from sqlalchemy.schema import CreateSchema, DropSchema

from {{.PackageName}}.database import create_database_engine

_SCOPE_PREFIX = "scaffold_test_"


@pytest.fixture(autouse=True)
def isolate_configured_database(
    request: pytest.FixtureRequest,
    monkeypatch: pytest.MonkeyPatch,
) -> Iterator[None]:
    """Point each opt-in database test at a fresh, recoverable scope."""
    database_url = os.getenv("TEST_DATABASE_URL")
    if database_url is None or not request.node.name.startswith("test_configured_database"):
        yield
        return
    with _isolated_database_url(database_url) as isolated_url:
        monkeypatch.setenv("TEST_DATABASE_URL", isolated_url)
        yield


@contextmanager
def _isolated_database_url(database_url: str) -> Iterator[str]:
    url = make_url(database_url)
    backend = url.get_backend_name()
    scope = _SCOPE_PREFIX + uuid4().hex
    if backend == "postgresql":
        with _postgresql_scope(url, scope) as isolated_url:
            yield isolated_url
        return
    if backend == "mysql":
        with _mysql_scope(url, scope) as isolated_url:
            yield isolated_url
        return
    yield database_url


@contextmanager
def _postgresql_scope(url: URL, scope: str) -> Iterator[str]:
    admin_engine = create_database_engine(_render(url))
    try:
        with admin_engine.begin() as connection:
            connection.execute(CreateSchema(scope))
        existing_options = str(url.query.get("options", "")).strip()
        search_path_option = "-csearch_path=" + scope
        options = (existing_options + " " + search_path_option).strip()
        isolated_url = url.update_query_dict({"options": options})
        try:
            yield _render(isolated_url)
        finally:
            with admin_engine.begin() as connection:
                connection.execute(DropSchema(scope, cascade=True, if_exists=True))
    finally:
        admin_engine.dispose()


@contextmanager
def _mysql_scope(url: URL, scope: str) -> Iterator[str]:
    admin_engine = create_database_engine(_render(url.set(database=None)))
    quoted_scope = admin_engine.dialect.identifier_preparer.quote_identifier(scope)
    create_sql = "CREATE DATABASE " + quoted_scope + " CHARACTER SET utf8mb4"  # nosec B608
    drop_sql = "DROP DATABASE IF EXISTS " + quoted_scope  # nosec B608 -- same bounded identifier
    try:
        with admin_engine.begin() as connection:
            connection.exec_driver_sql(create_sql)
        try:
            yield _render(url.set(database=scope))
        finally:
            with admin_engine.begin() as connection:
                connection.exec_driver_sql(drop_sql)
    finally:
        admin_engine.dispose()


def _render(url: URL) -> str:
    return url.render_as_string(hide_password=False)
