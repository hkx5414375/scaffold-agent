router = APIRouter(tags=["crm"])


def crm_service(request: Request) -> CRMService:
    """Resolve the process-scoped CRM service."""
    service: CRMService = request.app.state.crm_service
    return service


def install_error_handlers(app: FastAPI) -> None:
    """Install stable CRM failure responses."""

    @app.exception_handler(CRMError)
    async def crm_error(_request: Request, error: CRMError) -> JSONResponse:
        status, code = {
            CRMErrorKind.INVALID: (400, "crm.invalid"),
            CRMErrorKind.NOT_FOUND: (404, "crm.not_found"),
            CRMErrorKind.CONFLICT: (409, "crm.conflict"),
            CRMErrorKind.STORAGE: (500, "internal.error"),
        }[error.kind]
        return JSONResponse(
            status_code=status,
            content=ApiError(code=code, message=error.message).model_dump(),
        )


@router.post(
    "/api/v1/crm/accounts",
    response_model=CRMAccount,
    response_model_exclude_none=True,
    status_code=201,
)
def create_account(
    value: AccountWrite,
    principal: Annotated[
        Principal,
        Depends(require_permission("crm:write"{{if .Tenancy}}, tenant_scoped=True{{end}})),
    ],
    service: Annotated[CRMService, Depends(crm_service)],
) -> CRMAccount:
    """Create one business account."""
    return service.create_account(value, principal)


