sa.Index("crm_contacts_account_idx", crm_contacts.c.account_id, crm_contacts.c.id)

crm_opportunities = sa.Table(
    "crm_opportunities",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    sa.Column(
        "organization_id",
        sa.String(191),
{{- if .Tenancy}}
        sa.ForeignKey("organizations.id", ondelete="CASCADE"),
