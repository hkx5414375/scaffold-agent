"""CRM API records and SQLAlchemy table metadata."""

from datetime import datetime
from enum import StrEnum

import sqlalchemy as sa
from pydantic import BaseModel, ConfigDict, Field, field_validator
from sqlalchemy.dialects.mysql import DATETIME

from {{.PackageName}}.identity.models import metadata

NON_NEGATIVE_INTEGER = r"^(0|[1-9][0-9]*)$"
POSITIVE_VERSION = r"^[1-9][0-9]*$"
TIMESTAMP = sa.DateTime(timezone=True).with_variant(DATETIME(fsp=6), "mysql")

crm_accounts = sa.Table(
    "crm_accounts",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    sa.Column(
        "organization_id",
        sa.String(191),
{{- if .Tenancy}}
        sa.ForeignKey("organizations.id", ondelete="CASCADE"),
        nullable=False,
{{- else}}
        nullable=True,
{{- end}}
    ),
    sa.Column("name", sa.String(160), nullable=False),
    sa.Column("status", sa.String(16), nullable=False),
    sa.Column("version", sa.BigInteger(), nullable=False),
    sa.Column("created_at", TIMESTAMP, nullable=False),
    sa.Column("updated_at", TIMESTAMP, nullable=False),
    sa.CheckConstraint("status in ('active', 'archived')", name="crm_accounts_status"),
    sa.CheckConstraint("version > 0", name="crm_accounts_version"),
)
sa.Index(
    "crm_accounts_scope_status_idx",
{{- if .Tenancy}}
    crm_accounts.c.organization_id,
{{- end}}
    crm_accounts.c.status,
    crm_accounts.c.id,
)

crm_contacts = sa.Table(
    "crm_contacts",
