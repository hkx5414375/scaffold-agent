class RecordStatus(StrEnum):
    """Reversible CRM record lifecycle."""

    ACTIVE = "active"
    ARCHIVED = "archived"


class ActivityType(StrEnum):
    """Immutable interaction category."""

    NOTE = "note"
    CALL = "call"
    EMAIL = "email"
    MEETING = "meeting"


class SubjectType(StrEnum):
    """CRM activity subject category."""

    ACCOUNT = "account"
    CONTACT = "contact"
    OPPORTUNITY = "opportunity"


class OpportunityStage(StrEnum):
    """Forward-only sales stage."""

    LEAD = "lead"
    QUALIFIED = "qualified"
    PROPOSAL = "proposal"
    WON = "won"
    LOST = "lost"


class CRMErrorKind(StrEnum):
    """Stable CRM failure categories."""

    INVALID = "invalid"
    NOT_FOUND = "not_found"
    CONFLICT = "conflict"
    STORAGE = "storage"


class CRMError(Exception):
    """Expected CRM failure without storage internals."""

    def __init__(self, kind: CRMErrorKind, message: str) -> None:
        super().__init__(message)
        self.kind = kind
        self.message = message


class StrictModel(BaseModel):
    """Reject fields outside the stable CRM contract."""

    model_config = ConfigDict(extra="forbid")


class CRMAccount(StrictModel):
    """Business customer company, distinct from a tenancy organization."""

    id: str = Field(min_length=1, max_length=191)
{{- if .Tenancy}}
    organization_id: str = Field(min_length=1, max_length=191)
{{- end}}
    name: str = Field(min_length=1, max_length=160)
    status: RecordStatus
    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)
    created_at: datetime
    updated_at: datetime

    @field_validator("created_at", "updated_at")
    @classmethod
    def require_timezone(cls, value: datetime) -> datetime:
        """Reject ambiguous local timestamps."""
        return _aware(value)


class CRMContact(StrictModel):
    """Natural person optionally associated with one business account."""

    id: str = Field(min_length=1, max_length=191)
{{- if .Tenancy}}
    organization_id: str = Field(min_length=1, max_length=191)
{{- end}}
    account_id: str | None = Field(default=None, min_length=1, max_length=191)
    name: str = Field(min_length=1, max_length=160)
    email: str | None = Field(default=None, max_length=254)
    phone: str | None = Field(default=None, max_length=64)
    status: RecordStatus
    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)
    created_at: datetime
    updated_at: datetime

    @field_validator("created_at", "updated_at")
    @classmethod
    def require_timezone(cls, value: datetime) -> datetime:
        """Reject ambiguous local timestamps."""
        return _aware(value)


class CRMActivity(StrictModel):
    """Immutable CRM interaction."""

    id: str = Field(min_length=1, max_length=191)
{{- if .Tenancy}}
    organization_id: str = Field(min_length=1, max_length=191)
{{- end}}
    subject_type: SubjectType
    subject_id: str = Field(min_length=1, max_length=191)
    type: ActivityType
    summary: str = Field(min_length=1, max_length=4000)
    occurred_at: datetime
    created_by: str = Field(min_length=1, max_length=191)
    created_at: datetime

    @field_validator("occurred_at", "created_at")
    @classmethod
    def require_timezone(cls, value: datetime) -> datetime:
        """Reject ambiguous local timestamps."""
        return _aware(value)


class CRMOpportunity(StrictModel):
    """Forward-only sales opportunity."""

    id: str = Field(min_length=1, max_length=191)
{{- if .Tenancy}}
    organization_id: str = Field(min_length=1, max_length=191)
{{- end}}
    account_id: str = Field(min_length=1, max_length=191)
    name: str = Field(min_length=1, max_length=160)
    amount_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    currency: str = Field(pattern=r"^[A-Z]{3}$", max_length=3)
    stage: OpportunityStage
    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)
    created_at: datetime
    updated_at: datetime

    @field_validator("created_at", "updated_at")
    @classmethod
    def require_timezone(cls, value: datetime) -> datetime:
        """Reject ambiguous local timestamps."""
        return _aware(value)


class AccountWrite(StrictModel):
    """Bounded business account input."""

    name: str = Field(min_length=1, max_length=160)


class AccountUpdate(AccountWrite):
    """Optimistic account replacement."""

    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)


class ContactWrite(StrictModel):
    """Bounded contact input."""

    account_id: str | None = Field(default=None, min_length=1, max_length=191)
    name: str = Field(min_length=1, max_length=160)
    email: str | None = Field(default=None, max_length=254)
    phone: str | None = Field(default=None, max_length=64)


class ContactUpdate(ContactWrite):
    """Optimistic contact replacement."""

    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)


class ActivityWrite(StrictModel):
    """Immutable activity input."""

    subject_type: SubjectType
    subject_id: str = Field(min_length=1, max_length=191)
    type: ActivityType
    summary: str = Field(min_length=1, max_length=4000)
    occurred_at: datetime

    @field_validator("occurred_at")
    @classmethod
    def require_timezone(cls, value: datetime) -> datetime:
        """Reject ambiguous local timestamps."""
        return _aware(value)


class OpportunityWrite(StrictModel):
    """Bounded opportunity input."""

    account_id: str = Field(min_length=1, max_length=191)
    name: str = Field(min_length=1, max_length=160)
    amount_minor: str = Field(pattern=NON_NEGATIVE_INTEGER, max_length=19)
    currency: str = Field(min_length=3, max_length=3)


class OpportunityUpdate(OpportunityWrite):
    """Optimistic opportunity replacement."""

    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)


class CRMTransition(StrictModel):
    """Optimistic record transition."""

    version: str = Field(pattern=POSITIVE_VERSION, max_length=19)


class CRMStageTransition(CRMTransition):
    """Optimistic opportunity stage transition."""

    stage: OpportunityStage


class AccountPage(StrictModel):
    """Bounded account page."""

    items: list[CRMAccount]
    next_cursor: str


class ContactPage(StrictModel):
    """Bounded contact page."""

    items: list[CRMContact]
    next_cursor: str


class ActivityPage(StrictModel):
    """Bounded activity page."""

    items: list[CRMActivity]
    next_cursor: str


class OpportunityPage(StrictModel):
    """Bounded opportunity page."""

    items: list[CRMOpportunity]
    next_cursor: str


def _aware(value: datetime) -> datetime:
    if value.tzinfo is None or value.utcoffset() is None:
        raise ValueError("datetime values must include a UTC offset")
    return value
