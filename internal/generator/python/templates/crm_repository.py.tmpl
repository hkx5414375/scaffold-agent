def _require_mutation(changed: int) -> None:
    if changed != 1:
        raise CRMConflict()


def _next[Identified: (CRMAccount, CRMContact, CRMActivity, CRMOpportunity)](
    values: list[Identified], limit: int
) -> str:
    return values[limit - 1].id if len(values) > limit else ""


