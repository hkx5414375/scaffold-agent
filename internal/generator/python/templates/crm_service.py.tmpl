    def list_activities(
        self,
        subject_type: str,
        subject_id: str,
        cursor: str,
        limit: int,
        actor: Principal,
    ) -> ActivityPage:
        """List immutable activities, optionally for one subject."""
        normalized_type = subject_type.strip()
        normalized_id = subject_id.strip()
        _page(normalized_type, SUBJECTS, cursor, limit)
        if bool(normalized_type) != bool(normalized_id):
            raise _invalid()
        if normalized_id:
            normalized_id = _identifier(normalized_id)
        try:
            result = self._repository.list_activities(
                _actor_scope(actor),
                normalized_type,
                normalized_id,
                cursor.strip(),
                limit,
            )
        except Exception as error:
            _raise_repository(error)
        return ActivityPage(items=result.items, next_cursor=result.next_cursor)

    def create_opportunity(self, value: OpportunityWrite, actor: Principal) -> CRMOpportunity:
        """Create one lead opportunity for an active scoped account."""
        account_id, name, amount_minor, currency = _opportunity(value)
{{- if .Tenancy}}
        organization_id = _actor_scope(actor)
{{- else}}
        _actor_scope(actor)
{{- end}}
        now = _now(self._clock)
        opportunity = CRMOpportunity(
            id=str(uuid4()),
{{- if .Tenancy}}
            organization_id=organization_id,
{{- end}}
            account_id=account_id,
            name=name,
            amount_minor=str(amount_minor),
            currency=currency,
            stage=OpportunityStage.LEAD,
            version="1",
            created_at=now,
            updated_at=now,
        )
        try:
            self._repository.create_opportunity(
                opportunity,
                _audit(actor, "crm:opportunities:create", opportunity.id, now),
            )
        except Exception as error:
            _raise_repository(error)
        return opportunity

    def get_opportunity(self, record_id: str, actor: Principal) -> CRMOpportunity:
        """Read one scoped sales opportunity."""
        try:
            value = self._repository.get_opportunity(_actor_scope(actor), _identifier(record_id))
        except Exception as error:
            _raise_repository(error)
        if value is None:
            raise _not_found()
        return value

    def list_opportunities(
        self, stage: str, cursor: str, limit: int, actor: Principal
    ) -> OpportunityPage:
        """List sales opportunities in keyset order."""
        normalized_stage = stage.strip()
        _page(normalized_stage, STAGES, cursor, limit)
        try:
            result = self._repository.list_opportunities(
                _actor_scope(actor), normalized_stage, cursor.strip(), limit
            )
        except Exception as error:
            _raise_repository(error)
        return OpportunityPage(items=result.items, next_cursor=result.next_cursor)

    def update_opportunity(
        self, record_id: str, value: OpportunityUpdate, actor: Principal
    ) -> CRMOpportunity:
        """Replace content of a nonterminal opportunity."""
        account_id, name, amount_minor, currency = _opportunity(value)
        organization_id = _actor_scope(actor)
        normalized_id = _identifier(record_id)
        now = _now(self._clock)
        mutation = OpportunityMutation(
            organization_id=organization_id,
            opportunity_id=normalized_id,
            account_id=account_id,
            name=name,
            amount_minor=amount_minor,
            currency=currency,
            expected_version=_integer(value.version, positive=True),
            updated_at=now,
        )
        try:
            return self._repository.update_opportunity(
                mutation, _audit(actor, "crm:opportunities:update", normalized_id, now)
            )
        except Exception as error:
            _raise_repository(error)

    def advance_opportunity(
        self, record_id: str, value: CRMStageTransition, actor: Principal
    ) -> CRMOpportunity:
        """Advance exactly one stage or move a nonterminal opportunity to lost."""
        organization_id = _actor_scope(actor)
        normalized_id = _identifier(record_id)
        current = self.get_opportunity(normalized_id, actor)
        if not _valid_stage_transition(current.stage, value.stage):
            raise _conflict()
        now = _now(self._clock)
        transition = StageTransition(
            organization_id=organization_id,
            opportunity_id=normalized_id,
            expected_version=_integer(value.version, positive=True),
            from_stage=current.stage,
            to_stage=value.stage,
            updated_at=now,
        )
        try:
            return self._repository.advance_opportunity(
                transition,
                _audit(actor, "crm:opportunities:advance", normalized_id, now),
            )
        except Exception as error:
            _raise_repository(error)


def _contact(value: ContactWrite) -> ContactWrite:
    account_id = (value.account_id or "").strip()
    normalized_account = _identifier(account_id) if account_id else None
    email = (value.email or "").strip().lower()
    parsed = parseaddr(email)[1] if email else ""
    phone = (value.phone or "").strip()
    if (
        email and (parsed != email or EMAIL_PATTERN.fullmatch(email) is None or not _safe(email))
    ) or not _optional(phone, 64):
        raise _invalid()
    return ContactWrite(
        account_id=normalized_account,
        name=_required(value.name, 160),
        email=email or None,
        phone=phone or None,
    )


def _opportunity(value: OpportunityWrite) -> tuple[str, str, int, str]:
    currency = value.currency.strip().upper()
    if CURRENCY_PATTERN.fullmatch(currency) is None:
        raise _invalid()
    return (
        _identifier(value.account_id),
        _required(value.name, 160),
        _integer(value.amount_minor),
        currency,
    )


def _valid_stage_transition(from_stage: OpportunityStage, to_stage: OpportunityStage) -> bool:
    return (
        to_stage == OpportunityStage.LOST
        and from_stage
        in {
            OpportunityStage.LEAD,
            OpportunityStage.QUALIFIED,
            OpportunityStage.PROPOSAL,
        }
    ) or (from_stage, to_stage) in {
        (OpportunityStage.LEAD, OpportunityStage.QUALIFIED),
        (OpportunityStage.QUALIFIED, OpportunityStage.PROPOSAL),
        (OpportunityStage.PROPOSAL, OpportunityStage.WON),
    }


def _actor_scope(actor: Principal) -> str:
    if not _required(actor.user_id, MAXIMUM_IDENTIFIER_LENGTH):
        raise _invalid()
{{- if .Tenancy}}
    organization_id = (actor.organization_id or "").strip()
    if not _required(organization_id, MAXIMUM_IDENTIFIER_LENGTH):
        raise _invalid()
    return organization_id
{{- else}}
    return ""
{{- end}}


def _identifier(value: str) -> str:
    normalized = value.strip()
    if not _required(normalized, MAXIMUM_IDENTIFIER_LENGTH):
        raise _invalid()
    return normalized


def _integer(value: str, *, positive: bool = False) -> int:
    try:
        number = int(value, 10)
    except ValueError as error:
        raise _invalid() from error
    minimum = 1 if positive else 0
    if number < minimum or number > MAXIMUM_INTEGER or str(number) != value:
        raise _invalid()
    return number


def _page(filter_value: str, choices: set[str], cursor: str, limit: int) -> None:
    normalized_cursor = cursor.strip()
    if (
        (filter_value and filter_value not in choices)
        or len(normalized_cursor) > MAXIMUM_IDENTIFIER_LENGTH
        or not _safe(normalized_cursor)
        or limit < 1
        or limit > 100
    ):
        raise _invalid()


def _required(value: str, maximum: int) -> str:
    normalized = value.strip()
    if not normalized or not _optional(normalized, maximum):
        raise _invalid()
    return normalized


def _optional(value: str, maximum: int) -> bool:
    return len(value) <= maximum and _safe(value)


def _safe(value: str) -> bool:
    return all(character.isprintable() for character in value)


def _aware(value: datetime) -> datetime:
    if value.tzinfo is None or value.utcoffset() is None:
        raise _invalid()
    return value.astimezone(UTC)


def _now(clock: Callable[[], datetime]) -> datetime:
    return _aware(clock())


def _audit(actor: Principal, action: str, target: str, now: datetime) -> AuditEvent:
    return AuditEvent(
        id=str(uuid4()),
        user_id=actor.user_id,
        action=action,
        outcome="succeeded",
        target=target,
        ip_address=None,
        user_agent=None,
        created_at=now,
    )


def _raise_repository(error: Exception) -> NoReturn:
    if isinstance(error, CRMError):
        raise error
    if isinstance(error, CRMNotFound):
        raise _not_found() from error
    if isinstance(error, CRMConflict):
        raise _conflict() from error
    raise _storage() from error


def _invalid() -> CRMError:
    return CRMError(CRMErrorKind.INVALID, "CRM data is invalid")


def _not_found() -> CRMError:
    return CRMError(CRMErrorKind.NOT_FOUND, "CRM record was not found")


def _conflict() -> CRMError:
    return CRMError(
        CRMErrorKind.CONFLICT,
        "CRM record changed or conflicts with current state",
    )


def _storage() -> CRMError:
    return CRMError(CRMErrorKind.STORAGE, "CRM operation could not be completed")
