    def create_activity(self, value: ActivityWrite, actor: Principal) -> CRMActivity:
        """Record one immutable activity for an existing scoped subject."""
{{- if .Tenancy}}
        organization_id = _actor_scope(actor)
{{- else}}
        _actor_scope(actor)
{{- end}}
        now = _now(self._clock)
        activity = CRMActivity(
            id=str(uuid4()),
{{- if .Tenancy}}
            organization_id=organization_id,
{{- end}}
            subject_type=value.subject_type,
            subject_id=_identifier(value.subject_id),
            type=value.type,
            summary=_required(value.summary, 4000),
            occurred_at=_aware(value.occurred_at),
            created_by=actor.user_id,
            created_at=now,
        )
        try:
            self._repository.create_activity(
                activity, _audit(actor, "crm:activities:create", activity.id, now)
            )
        except Exception as error:
            _raise_repository(error)
