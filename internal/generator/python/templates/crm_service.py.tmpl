MAXIMUM_INTEGER = 2**63 - 1
MAXIMUM_IDENTIFIER_LENGTH = 191
CURRENCY_PATTERN = re.compile(r"^[A-Z]{3}$")
EMAIL_PATTERN = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
STATUSES = {status.value for status in RecordStatus}
STAGES = {stage.value for stage in OpportunityStage}
SUBJECTS = {subject.value for subject in SubjectType}


class CRMService:
    """Enforce CRM normalization, tenant scope, and state machines."""

    def __init__(
        self,
        repository: CRMRepository,
        clock: Callable[[], datetime] | None = None,
    ) -> None:
        self._repository = repository
        self._clock = clock or (lambda: datetime.now(UTC))

    def create_account(self, value: AccountWrite, actor: Principal) -> CRMAccount:
        """Create one active business account."""
{{- if .Tenancy}}
        organization_id = _actor_scope(actor)
{{- else}}
        _actor_scope(actor)
{{- end}}
        now = _now(self._clock)
        account = CRMAccount(
            id=str(uuid4()),
{{- if .Tenancy}}
            organization_id=organization_id,
{{- end}}
            name=_required(value.name, 160),
            status=RecordStatus.ACTIVE,
            version="1",
            created_at=now,
            updated_at=now,
        )
        try:
            self._repository.create_account(
                account, _audit(actor, "crm:accounts:create", account.id, now)
            )
        except Exception as error:
            _raise_repository(error)
        return account

    def get_account(self, record_id: str, actor: Principal) -> CRMAccount:
        """Read one scoped business account."""
        try:
            value = self._repository.get_account(_actor_scope(actor), _identifier(record_id))
        except Exception as error:
            _raise_repository(error)
        if value is None:
            raise _not_found()
        return value

    def list_accounts(self, status: str, cursor: str, limit: int, actor: Principal) -> AccountPage:
        """List business accounts in keyset order."""
        normalized_status = status.strip()
        _page(normalized_status, STATUSES, cursor, limit)
        try:
            result = self._repository.list_accounts(
                _actor_scope(actor), normalized_status, cursor.strip(), limit
            )
        except Exception as error:
            _raise_repository(error)
        return AccountPage(items=result.items, next_cursor=result.next_cursor)

    def update_account(self, record_id: str, value: AccountUpdate, actor: Principal) -> CRMAccount:
        """Update mutable account content with an optimistic version."""
        organization_id = _actor_scope(actor)
        normalized_id = _identifier(record_id)
        now = _now(self._clock)
        mutation = AccountMutation(
            organization_id=organization_id,
            account_id=normalized_id,
            name=_required(value.name, 160),
            expected_version=_integer(value.version, positive=True),
            updated_at=now,
        )
        try:
            return self._repository.update_account(
                mutation, _audit(actor, "crm:accounts:update", normalized_id, now)
            )
        except Exception as error:
            _raise_repository(error)

    def archive_account(self, record_id: str, value: CRMTransition, actor: Principal) -> CRMAccount:
        """Archive one active account without deleting it."""
        return self._transition_account(
            record_id,
            value,
            RecordStatus.ACTIVE,
            RecordStatus.ARCHIVED,
            "crm:accounts:archive",
            actor,
        )

    def reactivate_account(
        self, record_id: str, value: CRMTransition, actor: Principal
    ) -> CRMAccount:
        """Reactivate one archived account."""
        return self._transition_account(
            record_id,
            value,
            RecordStatus.ARCHIVED,
            RecordStatus.ACTIVE,
            "crm:accounts:reactivate",
            actor,
        )

    def _transition_account(
        self,
        record_id: str,
        value: CRMTransition,
        from_status: RecordStatus,
        to_status: RecordStatus,
        action: str,
        actor: Principal,
    ) -> CRMAccount:
        organization_id = _actor_scope(actor)
        normalized_id = _identifier(record_id)
        now = _now(self._clock)
        transition = RecordTransition(
            organization_id,
            normalized_id,
            _integer(value.version, positive=True),
            from_status,
            to_status,
            now,
        )
        try:
            return self._repository.transition_account(
                transition, _audit(actor, action, normalized_id, now)
            )
        except Exception as error:
            _raise_repository(error)

