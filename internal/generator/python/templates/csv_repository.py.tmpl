"""Atomic CSV import and audited bounded export persistence."""

from collections.abc import Callable
from typing import Protocol

from sqlalchemy import insert, select
from sqlalchemy.engine import Engine
from sqlalchemy.exc import IntegrityError

from {{.PackageName}}.identity.models import AuditEvent
from {{.PackageName}}.identity.repository import append_audit
from {{.PackageName}}.{{.Business.PackageName}}.models import {{.Business.EntityClass}}Record, table
from {{.PackageName}}.{{.Business.PackageName}}.repository import _database_values, _map_record


class CSVTransferConflict(Exception):
    """At least one imported row conflicts with current data."""


class CSVTransferTooLarge(Exception):
    """The encoded export would exceed the byte limit."""


class CSVTransferTooManyRows(Exception):
    """The export would exceed the row limit."""


class CSVTransferRepository(Protocol):
    """Persistence seam coupling every transfer to one audit transaction."""

    def import_batch(
        self,
        values: list[{{.Business.EntityClass}}Record],
        audit: AuditEvent,
    ) -> None: ...

    def export(
        self,
        organization_id: str,
        maximum_rows: int,
        maximum_bytes: int,
        header_bytes: int,
        row_size: Callable[[{{.Business.EntityClass}}Record], int],
        audit: AuditEvent,
    ) -> list[{{.Business.EntityClass}}Record]: ...


class SQLAlchemyCSVTransferRepository:
    """SQLAlchemy adapter with all-or-nothing insert and audited export."""

    def __init__(self, engine: Engine) -> None:
        self._engine = engine

    def import_batch(
        self,
        values: list[{{.Business.EntityClass}}Record],
        audit: AuditEvent,
    ) -> None:
        if not values or len(values) > 1000:
            raise ValueError("CSV import batch is invalid")
        try:
            with self._engine.begin() as connection:
                for value in values:
                    connection.execute(
                        insert(table).values(**_database_values(value, include_created=True))
                    )
                append_audit(connection, audit)
        except IntegrityError as error:
            raise CSVTransferConflict() from error

    def export(
        self,
        organization_id: str,
        maximum_rows: int,
        maximum_bytes: int,
        header_bytes: int,
        row_size: Callable[[{{.Business.EntityClass}}Record], int],
        audit: AuditEvent,
    ) -> list[{{.Business.EntityClass}}Record]:
        if maximum_rows < 1 or maximum_rows > 1000 or maximum_bytes < 1:
            raise ValueError("CSV export bounds are invalid")
        statement = select(table).order_by(table.c.id).limit(maximum_rows + 1)
{{- if .Tenancy}}
        statement = statement.where(table.c.organization_id == organization_id)
{{- else}}
        del organization_id
{{- end}}
        with self._engine.begin() as connection:
            rows = connection.execute(statement).mappings().all()
            if len(rows) > maximum_rows:
                raise CSVTransferTooManyRows()
            values = [_map_record(row) for row in rows]
            encoded_bytes = header_bytes
            for value in values:
                encoded_bytes += row_size(value)
                if encoded_bytes > maximum_bytes:
                    raise CSVTransferTooLarge()
            append_audit(connection, audit)
        return values
