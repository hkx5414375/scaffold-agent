    principal: Annotated[
        Principal,
        Depends(require_permission("customers:accounts:manage"{{if .Tenancy}}, tenant_scoped=True{{end}})),
    ],
    service: Annotated[CustomerAccountService, Depends(customer_account_service)],
) -> CustomerAccount:
