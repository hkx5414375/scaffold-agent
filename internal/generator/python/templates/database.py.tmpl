"""SQLAlchemy engine construction and bounded readiness."""

from collections.abc import Mapping
{{- if .Observability}}
from concurrent.futures import ThreadPoolExecutor
from concurrent.futures import TimeoutError as FutureTimeoutError
{{- end}}
from typing import Any, cast

from sqlalchemy import create_engine, text
from sqlalchemy.engine import Engine, make_url
from sqlalchemy.exc import SQLAlchemyError


def create_database_engine(
    database_url: str,
    *,
    connect_args: Mapping[str, Any] | None = None,
) -> Engine:
    """Create a bounded, pre-pinged synchronous database pool."""
    url = make_url(database_url)
    arguments: dict[str, Any] = dict(connect_args or {})
    if url.drivername.startswith("postgresql"):
        arguments.setdefault("connect_timeout", 2)
    elif url.drivername.startswith("mysql"):
        arguments.setdefault("connect_timeout", 2)
        arguments.setdefault("read_timeout", 2)
        arguments.setdefault("write_timeout", 2)
    return create_engine(
        url,
        pool_pre_ping=True,
        pool_size=10,
        max_overflow=0,
        pool_timeout=5,
        connect_args=arguments,
    )


class DatabaseProbe:
    """Expose only a boolean readiness result to HTTP."""

    def __init__(self, engine: Engine{{if .Observability}}, timeout_seconds: float = 2.0{{end}}) -> None:
        self._engine = engine
{{- if .Observability}}
        if timeout_seconds <= 0:
            raise ValueError("readiness timeout must be positive")
        self._timeout_seconds = timeout_seconds
        self._executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="readiness")
{{- end}}

    def is_ready(self) -> bool:
        """Return whether one bounded database round trip succeeds."""
{{- if .Observability}}
        future = self._executor.submit(self._check)
        try:
            return future.result(timeout=self._timeout_seconds)
        except FutureTimeoutError:
            return False
        except Exception:
            return False
        finally:
            future.cancel()

    def close(self) -> None:
        """Stop accepting readiness work without waiting for a blocked driver."""
        self._executor.shutdown(wait=False, cancel_futures=True)

    def _check(self) -> bool:
        """Acquire and validate one connection inside the bounded worker."""
{{- end}}
        try:
            with self._engine.connect() as connection:
                value = cast(int, connection.execute(text("select 1")).scalar_one())
                return value == 1
        except SQLAlchemyError:
            return False
