"""FastAPI transport for identity use cases."""

from collections.abc import Callable
from typing import Annotated

from fastapi import APIRouter, Cookie, Depends, Header, Request, Response
from pydantic import BaseModel, ConfigDict, Field

from {{.PackageName}}.errors import IdentityError, IdentityErrorKind
from {{.PackageName}}.identity.models import Principal
from {{.PackageName}}.identity.service import IdentityService

SESSION_COOKIE = "scaffold_session"
MAXIMUM_CREDENTIAL_LENGTH = 512
router = APIRouter(prefix="/api/v1/auth", tags=["identity"])


class LoginRequest(BaseModel):
    """Bounded login input."""

    email: str = Field(min_length=3, max_length=254)
    password: str = Field(min_length=1, max_length=1024)
    model_config = ConfigDict(extra="forbid")


class LoginResponse(BaseModel):
    """Authenticated principal returned after login."""

    principal: Principal
    model_config = ConfigDict(extra="forbid")


class ApiTokenRequest(BaseModel):
    """Named API token request."""

    name: str = Field(min_length=1, max_length=80)
    model_config = ConfigDict(extra="forbid")


class ApiTokenResponse(BaseModel):
    """Raw token shown exactly once."""

    token: str
    model_config = ConfigDict(extra="forbid")


def identity_service(request: Request) -> IdentityService:
    """Resolve the process-scoped identity service."""
    service: IdentityService = request.app.state.identity_service
    return service


def client_context(request: Request) -> tuple[str, str]:
    """Read bounded direct-peer and user-agent audit values."""
    address = request.client.host if request.client is not None else "unknown"
    return address[:512], request.headers.get("user-agent", "")[:512]


def _bearer_token(authorization: str | None) -> str:
    if authorization is None:
        return ""
    scheme, separator, credential = authorization.partition(" ")
    if separator != " " or scheme.lower() != "bearer":
        raise IdentityError(IdentityErrorKind.INVALID_CREDENTIALS, "authentication is required")
    if not credential or len(credential) > MAXIMUM_CREDENTIAL_LENGTH:
        raise IdentityError(IdentityErrorKind.INVALID_CREDENTIALS, "authentication is required")
    return credential


def current_principal(
    service: Annotated[IdentityService, Depends(identity_service)],
    session_token: Annotated[str | None, Cookie(alias=SESSION_COOKIE)] = None,
    authorization: Annotated[str | None, Header()] = None,
) -> Principal:
    """Authenticate one bearer token or browser session."""
    bounded_session = session_token or ""
    if len(bounded_session) > MAXIMUM_CREDENTIAL_LENGTH:
        raise IdentityError(IdentityErrorKind.INVALID_CREDENTIALS, "authentication is required")
    return service.authenticate(bounded_session, _bearer_token(authorization))


def require_permission(permission: str) -> Callable[..., Principal]:
    """Build an explicit permission dependency for one route."""

    def dependency(
        request: Request,
        principal: Annotated[Principal, Depends(current_principal)],
        service: Annotated[IdentityService, Depends(identity_service)],
    ) -> Principal:
        ip_address, user_agent = client_context(request)
        service.authorize(principal, permission, ip_address, user_agent)
        return principal

    return dependency


@router.post("/login", response_model=LoginResponse)
def login(
    payload: LoginRequest,
    request: Request,
    response: Response,
    service: Annotated[IdentityService, Depends(identity_service)],
) -> LoginResponse:
    """Create a bounded browser session."""
    ip_address, user_agent = client_context(request)
    result = service.login(payload.email, payload.password, ip_address, user_agent)
    response.set_cookie(
        key=SESSION_COOKIE,
        value=result.token,
        max_age=24 * 60 * 60,
        httponly=True,
        secure=bool(request.app.state.cookie_secure),
        samesite="lax",
        path="/",
    )
    return LoginResponse(principal=result.principal)


@router.post("/logout", status_code=204)
def logout(
    response: Response,
    service: Annotated[IdentityService, Depends(identity_service)],
    session_token: Annotated[str | None, Cookie(alias=SESSION_COOKIE)] = None,
) -> None:
    """Revoke the current browser session and clear its cookie."""
    if session_token is not None and len(session_token) <= MAXIMUM_CREDENTIAL_LENGTH:
        service.logout(session_token)
    response.delete_cookie(key=SESSION_COOKIE, path="/", httponly=True, samesite="lax")


@router.get("/me", response_model=Principal)
def me(principal: Annotated[Principal, Depends(current_principal)]) -> Principal:
    """Return the safe current principal."""
    return principal


@router.post("/tokens", response_model=ApiTokenResponse, status_code=201)
def create_api_token(
    payload: ApiTokenRequest,
    principal: Annotated[
        Principal,
        Depends(require_permission("identity:token:create")),
    ],
    service: Annotated[IdentityService, Depends(identity_service)],
) -> ApiTokenResponse:
    """Create one expiring digest-backed API token."""
    result = service.create_api_token(principal, payload.name)
    return ApiTokenResponse(token=result.token)
