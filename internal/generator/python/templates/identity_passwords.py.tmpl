"""Bounded PBKDF2-SHA256 password hashing."""

import base64
import hashlib
import secrets

from {{.PackageName}}.errors import IdentityError, IdentityErrorKind

ALGORITHM = "pbkdf2-sha256"
ITERATIONS = 600_000
MINIMUM_ITERATIONS = 100_000
MAXIMUM_ITERATIONS = 2_000_000
SALT_BYTES = 16
KEY_BYTES = 32
MINIMUM_PASSWORD_LENGTH = 12
MAXIMUM_PASSWORD_LENGTH = 1024
DUMMY_HASH = (
    "pbkdf2-sha256$600000$AAAAAAAAAAAAAAAAAAAAAA$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
)


def hash_password(password: str) -> str:
    """Return a salted, bounded PBKDF2 verifier."""
    if not MINIMUM_PASSWORD_LENGTH <= len(password) <= MAXIMUM_PASSWORD_LENGTH:
        raise IdentityError(
            IdentityErrorKind.INVALID_INPUT,
            "password must contain between 12 and 1024 characters",
        )
    salt = secrets.token_bytes(SALT_BYTES)
    key = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, ITERATIONS, dklen=KEY_BYTES)
    return "$".join((ALGORITHM, str(ITERATIONS), _encode(salt), _encode(key)))


def verify_password(encoded: str, password: str) -> bool:
    """Verify one password without accepting unbounded attacker parameters."""
    if len(password) > MAXIMUM_PASSWORD_LENGTH:
        return False
    parts = encoded.split("$")
    if len(parts) != 4 or parts[0] != ALGORITHM:
        return False
    try:
        iterations = int(parts[1])
        if not MINIMUM_ITERATIONS <= iterations <= MAXIMUM_ITERATIONS:
            return False
        salt = _decode(parts[2])
        expected = _decode(parts[3])
    except (ValueError, UnicodeError):
        return False
    if len(salt) < SALT_BYTES or len(expected) != KEY_BYTES:
        return False
    actual = hashlib.pbkdf2_hmac(
        "sha256",
        password.encode(),
        salt,
        iterations,
        dklen=len(expected),
    )
    return secrets.compare_digest(actual, expected)


def _encode(value: bytes) -> str:
    return base64.b64encode(value).decode("ascii").rstrip("=")


def _decode(value: str) -> bytes:
    padding = "=" * (-len(value) % 4)
    return base64.b64decode(value + padding, validate=True)
