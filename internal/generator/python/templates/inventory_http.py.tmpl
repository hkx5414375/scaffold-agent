    WarehouseWrite,
)
from {{.PackageName}}.inventory.service import InventoryService

router = APIRouter(tags=["inventory"])


def inventory_service(request: Request) -> InventoryService:
    service: InventoryService = request.app.state.inventory_service
    return service


def install_error_handlers(app: FastAPI) -> None:
    @app.exception_handler(InventoryError)
    async def inventory_error(_request: Request, error: InventoryError) -> JSONResponse:
        status, code = {
            InventoryErrorKind.INVALID: (400, "inventory.invalid"),
            InventoryErrorKind.NOT_FOUND: (404, "inventory.not_found"),
            InventoryErrorKind.CONFLICT: (409, "inventory.conflict"),
            InventoryErrorKind.STORAGE: (500, "internal.error"),
        }[error.kind]
        return JSONResponse(
            status_code=status,
            content=ApiError(code=code, message=error.message).model_dump(),
        )


ReadPrincipal = Annotated[
    Principal,
    Depends(require_permission("inventory:read"{{if .Tenancy}}, tenant_scoped=True{{end}})),
]
CatalogPrincipal = Annotated[
    Principal,
    Depends(require_permission("inventory:catalog:write"{{if .Tenancy}}, tenant_scoped=True{{end}})),
]
StockPrincipal = Annotated[
    Principal,
    Depends(require_permission("inventory:stock:manage"{{if .Tenancy}}, tenant_scoped=True{{end}})),
]
ProcurementPrincipal = Annotated[
    Principal,
    Depends(require_permission("inventory:procurement:manage"{{if .Tenancy}}, tenant_scoped=True{{end}})),
]
Service = Annotated[InventoryService, Depends(inventory_service)]


@router.post("/api/v1/inventory/items", response_model=InventoryItem, status_code=201)
def create_item(value: ItemWrite, principal: CatalogPrincipal, service: Service) -> InventoryItem:
    return service.create_item(value, principal)


@router.get("/api/v1/inventory/items", response_model=ItemPage)
def list_items(
    principal: ReadPrincipal,
    service: Service,
    status: Annotated[str, Query(max_length=16)] = "",
    cursor: Annotated[str, Query(max_length=191)] = "",
    limit: Annotated[int, Query(ge=1, le=100)] = 20,
) -> ItemPage:
    return service.list_items(status, cursor, limit, principal)


