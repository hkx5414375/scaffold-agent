        name="inventory_movements_kind",
    ),
)
sa.Index(
    "inventory_movements_scope_stock_id_idx",
    inventory_movements.c.organization_id,
    inventory_movements.c.item_id,
    inventory_movements.c.warehouse_id,
    inventory_movements.c.id,
)

inventory_reservations = sa.Table(
