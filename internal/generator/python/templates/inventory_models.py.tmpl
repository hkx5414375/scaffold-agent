"""ERP inventory API records and SQLAlchemy table metadata."""

from datetime import datetime
from enum import StrEnum

import sqlalchemy as sa
from pydantic import BaseModel, ConfigDict, Field, field_validator

from {{.PackageName}}.identity.models import metadata

SIGNED_INTEGER = r"^-?(0|[1-9][0-9]*)$"
NON_NEGATIVE_INTEGER = r"^(0|[1-9][0-9]*)$"
POSITIVE_INTEGER = r"^[1-9][0-9]*$"


def _organization_column() -> sa.Column[str]:
    return sa.Column(
        "organization_id",
        sa.String(191),
{{- if .Tenancy}}
        sa.ForeignKey("organizations.id", ondelete="CASCADE"),
{{- end}}
        nullable=False,
    )


inventory_items = sa.Table(
    "inventory_items",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    _organization_column(),
    sa.Column("sku", sa.String(64), nullable=False),
    sa.Column("name", sa.String(160), nullable=False),
    sa.Column("unit", sa.String(32), nullable=False),
    sa.Column("status", sa.String(16), nullable=False),
    sa.Column("version", sa.BigInteger(), nullable=False),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
    sa.Column("updated_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint("status in ('active', 'archived')", name="inventory_items_status"),
    sa.CheckConstraint("version > 0", name="inventory_items_version"),
    sa.UniqueConstraint("organization_id", "sku", name="inventory_items_scope_sku_unique"),
)
sa.Index(
    "inventory_items_scope_status_id_idx",
    inventory_items.c.organization_id,
    inventory_items.c.status,
    inventory_items.c.id,
)

inventory_warehouses = sa.Table(
    "inventory_warehouses",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    _organization_column(),
    sa.Column("code", sa.String(64), nullable=False),
    sa.Column("name", sa.String(160), nullable=False),
    sa.Column("status", sa.String(16), nullable=False),
    sa.Column("version", sa.BigInteger(), nullable=False),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
    sa.Column("updated_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint("status in ('active', 'archived')", name="inventory_warehouses_status"),
    sa.CheckConstraint("version > 0", name="inventory_warehouses_version"),
    sa.UniqueConstraint("organization_id", "code", name="inventory_warehouses_scope_code_unique"),
)
sa.Index(
    "inventory_warehouses_scope_status_id_idx",
    inventory_warehouses.c.organization_id,
    inventory_warehouses.c.status,
    inventory_warehouses.c.id,
)

inventory_balances = sa.Table(
    "inventory_balances",
    metadata,
    _organization_column(),
    sa.Column("item_id", sa.String(191), sa.ForeignKey("inventory_items.id"), primary_key=True),
    sa.Column(
        "warehouse_id",
        sa.String(191),
        sa.ForeignKey("inventory_warehouses.id"),
        primary_key=True,
    ),
    sa.Column("on_hand", sa.BigInteger(), nullable=False),
    sa.Column("reserved", sa.BigInteger(), nullable=False),
    sa.Column("version", sa.BigInteger(), nullable=False),
    sa.Column("updated_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint("on_hand >= 0", name="inventory_balances_on_hand"),
    sa.CheckConstraint("reserved >= 0 and reserved <= on_hand", name="inventory_balances_reserved"),
    sa.CheckConstraint("version > 0", name="inventory_balances_version"),
)
sa.Index(
    "inventory_balances_scope_item_id_idx",
    inventory_balances.c.organization_id,
    inventory_balances.c.item_id,
    inventory_balances.c.warehouse_id,
)

inventory_movements = sa.Table(
    "inventory_movements",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    _organization_column(),
    sa.Column("item_id", sa.String(191), sa.ForeignKey("inventory_items.id"), nullable=False),
    sa.Column(
        "warehouse_id", sa.String(191), sa.ForeignKey("inventory_warehouses.id"), nullable=False
    ),
    sa.Column("movement_kind", sa.String(32), nullable=False),
    sa.Column("quantity_delta", sa.BigInteger(), nullable=False),
    sa.Column("reserved_delta", sa.BigInteger(), nullable=False),
    sa.Column("reference_type", sa.String(32), nullable=False),
    sa.Column("reference_id", sa.String(191), nullable=False),
    sa.Column("reason", sa.String(500), nullable=False),
    sa.Column("idempotency_key", sa.String(191), nullable=False),
    sa.Column("created_by", sa.String(191), sa.ForeignKey("identity_users.id"), nullable=False),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
    sa.CheckConstraint(
        "movement_kind in ('adjustment', 'reservation_created', "
