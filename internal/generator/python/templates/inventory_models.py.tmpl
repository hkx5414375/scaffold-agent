)

inventory_purchase_order_lines = sa.Table(
    "inventory_purchase_order_lines",
    metadata,
    sa.Column("id", sa.String(191), primary_key=True),
    sa.Column(
        "purchase_order_id",
        sa.String(191),
        sa.ForeignKey("inventory_purchase_orders.id", ondelete="CASCADE"),
        nullable=False,
    ),
    sa.Column("item_id", sa.String(191), sa.ForeignKey("inventory_items.id"), nullable=False),
    sa.Column("ordered_quantity", sa.BigInteger(), nullable=False),
    sa.Column("received_quantity", sa.BigInteger(), nullable=False),
    sa.CheckConstraint("ordered_quantity > 0", name="inventory_purchase_lines_ordered"),
    sa.CheckConstraint(
        "received_quantity >= 0 and received_quantity <= ordered_quantity",
        name="inventory_purchase_lines_received",
    ),
    sa.UniqueConstraint(
        "purchase_order_id", "item_id", name="inventory_purchase_lines_item_unique"
    ),
