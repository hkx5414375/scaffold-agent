inventory_idempotency = sa.Table(
    "inventory_idempotency",
    metadata,
    sa.Column("organization_id", sa.String(191), primary_key=True),
    sa.Column("idempotency_key", sa.String(191), primary_key=True),
    sa.Column("fingerprint", sa.String(64), nullable=False),
    sa.Column("result_type", sa.String(32), nullable=False),
    sa.Column("result_id", sa.String(191), nullable=True),
    sa.Column(
        "movement_id", sa.String(191), sa.ForeignKey("inventory_movements.id"), nullable=True
    ),
    sa.Column("result_payload", sa.Text(), nullable=True),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False),
)


class RecordStatus(StrEnum):
    ACTIVE = "active"
    ARCHIVED = "archived"


class ReservationStatus(StrEnum):
    ACTIVE = "active"
    RELEASED = "released"
    CONSUMED = "consumed"


class PurchaseOrderStatus(StrEnum):
    DRAFT = "draft"
    SUBMITTED = "submitted"
    PARTIALLY_RECEIVED = "partially_received"
    RECEIVED = "received"
    CANCELLED = "cancelled"


class MovementKind(StrEnum):
    ADJUSTMENT = "adjustment"
    RESERVATION_CREATED = "reservation_created"
    RESERVATION_RELEASED = "reservation_released"
    RESERVATION_CONSUMED = "reservation_consumed"
    PURCHASE_RECEIVED = "purchase_received"


class InventoryErrorKind(StrEnum):
    INVALID = "invalid"
    NOT_FOUND = "not_found"
    CONFLICT = "conflict"
    STORAGE = "storage"


class InventoryError(Exception):
    def __init__(self, kind: InventoryErrorKind, message: str) -> None:
        super().__init__(message)
        self.kind = kind
        self.message = message


class StrictModel(BaseModel):
    model_config = ConfigDict(extra="forbid")


class InventoryItem(StrictModel):
    id: str = Field(min_length=1, max_length=191)
{{- if .Tenancy}}
    organization_id: str = Field(min_length=1, max_length=191)
{{- end}}
    sku: str = Field(pattern=r"^[A-Z0-9._-]{1,64}$")
    name: str = Field(min_length=1, max_length=160)
    unit: str = Field(min_length=1, max_length=32)
    status: RecordStatus
    version: str = Field(pattern=POSITIVE_INTEGER, max_length=19)
    created_at: datetime
    updated_at: datetime

    @field_validator("created_at", "updated_at")
    @classmethod
    def require_timezone(cls, value: datetime) -> datetime:
        return _aware(value)


