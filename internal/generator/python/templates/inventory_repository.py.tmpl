    def list_balances(
        self, organization_id: str, item_id: str, cursor: str, limit: int
    ) -> BalancePageResult:
        cursor_value = inventory_balances.c.item_id + ":" + inventory_balances.c.warehouse_id
        statement = select(inventory_balances).where(
            inventory_balances.c.organization_id == organization_id,
