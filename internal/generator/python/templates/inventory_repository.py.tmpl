                .mappings()
                .all()
            )
        values = [_map_reservation(row) for row in rows]
        return ReservationPageResult(values[:limit], _next(values, limit))

    def transition_reservation(self, value: ReservationTransitionCommand) -> ReservationResult:
        def mutation(connection: Connection) -> ReservationResult:
            replay = _claim(
                connection,
                value.organization_id,
                value.idempotency_key,
                value.fingerprint,
                "reservation",
                ReservationResult,
                value.occurred_at,
            )
            if replay is not None:
                return replay
            reservation = _lock_reservation(connection, value.organization_id, value.reservation_id)
            if (
                reservation.status != ReservationStatus.ACTIVE
                or int(reservation.version) != value.expected_version
            ):
                raise InventoryConflict()
            balance = _lock_stock(
                connection,
                value.organization_id,
                reservation.item_id,
                reservation.warehouse_id,
                value.occurred_at,
            )
            quantity = int(reservation.quantity)
            consumed = value.target == ReservationStatus.CONSUMED
            quantity_delta = -quantity if consumed else 0
            on_hand = _add(int(balance.on_hand), quantity_delta)
            reserved = _add(int(balance.reserved), -quantity)
            _validate_balance(on_hand, reserved)
            changed = connection.execute(
                update(inventory_reservations)
                .where(
                    inventory_reservations.c.id == reservation.id,
                    inventory_reservations.c.organization_id == value.organization_id,
                    inventory_reservations.c.version == value.expected_version,
                    inventory_reservations.c.status == ReservationStatus.ACTIVE.value,
                )
                .values(
                    status=value.target.value,
                    version=inventory_reservations.c.version + 1,
                    updated_at=value.occurred_at,
                )
            ).rowcount
            _require_changed(changed)
            updated_reservation = _read_reservation(
                connection, value.organization_id, reservation.id
            )
            updated_balance = _update_balance(
                connection,
                value.organization_id,
                balance,
                on_hand,
                reserved,
                value.occurred_at,
            )
            movement = InventoryMovement(
                id=value.movement_id,
{{- if .Tenancy}}
                organization_id=value.organization_id,
{{- end}}
                item_id=reservation.item_id,
                warehouse_id=reservation.warehouse_id,
                kind=(
                    MovementKind.RESERVATION_CONSUMED
                    if consumed
                    else MovementKind.RESERVATION_RELEASED
                ),
                quantity_delta=str(quantity_delta),
                reserved_delta=str(-quantity),
                reference_type="reservation",
                reference_id=reservation.id,
                reason=("stock reservation consumed" if consumed else "stock reservation released"),
                idempotency_key=value.idempotency_key,
                created_by=value.actor_id,
                created_at=value.occurred_at,
            )
            connection.execute(
                insert(inventory_movements).values(
                    **_movement_values(value.organization_id, movement)
                )
            )
            result = ReservationResult(
                reservation=updated_reservation,
                balance=updated_balance,
                movement=movement,
            )
            _complete_claim(
                connection,
                value.organization_id,
                value.idempotency_key,
                reservation.id,
                movement.id,
                result,
            )
            append_audit(connection, value.audit)
            return result

        return self._command(value.organization_id, mutation)

    def create_purchase_order(self, value: PurchaseOrder, audit: AuditEvent) -> None:
        organization_id = _organization(value)

        def mutation(connection: Connection) -> bool:
            for line in value.lines:
                _require_active_item(connection, organization_id, line.item_id)
            connection.execute(
                insert(inventory_purchase_orders).values(**_purchase_values(organization_id, value))
            )
            for line in value.lines:
                connection.execute(
                    insert(inventory_purchase_order_lines).values(**_line_values(value.id, line))
                )
            append_audit(connection, audit)
            return True

        self._command(organization_id, mutation)

    def get_purchase_order(self, organization_id: str, record_id: str) -> PurchaseOrder | None:
        row = self._read_one(inventory_purchase_orders, organization_id, record_id)
        if row is None:
            return None
        with self._engine.connect() as connection:
            return _map_purchase(row, _purchase_lines(connection, record_id))

    def list_purchase_orders(
        self, organization_id: str, status: str, cursor: str, limit: int
    ) -> PurchaseOrderPageResult:
        statement = select(inventory_purchase_orders).where(
            inventory_purchase_orders.c.organization_id == organization_id,
            _active_scope(inventory_purchase_orders),
        )
        if status:
            statement = statement.where(inventory_purchase_orders.c.status == status)
        if cursor:
            statement = statement.where(inventory_purchase_orders.c.id > cursor)
        with self._engine.connect() as connection:
            rows = (
                connection.execute(
                    statement.order_by(inventory_purchase_orders.c.id).limit(limit + 1)
                )
                .mappings()
                .all()
            )
            values = [
                _map_purchase(row, _purchase_lines(connection, str(row["id"]))) for row in rows
            ]
        return PurchaseOrderPageResult(values[:limit], _next(values, limit))

    def transition_purchase_order(self, value: PurchaseTransitionCommand) -> PurchaseOrder:
        def mutation(connection: Connection) -> PurchaseOrder:
            purchase = _lock_purchase(connection, value.organization_id, value.purchase_order_id)
            allowed = (
                value.target == PurchaseOrderStatus.SUBMITTED
                and purchase.status == PurchaseOrderStatus.DRAFT
            ) or (
                value.target == PurchaseOrderStatus.CANCELLED
                and purchase.status in {PurchaseOrderStatus.DRAFT, PurchaseOrderStatus.SUBMITTED}
                and all(int(line.received_quantity) == 0 for line in purchase.lines)
            )
            if not allowed or int(purchase.version) != value.expected_version:
                raise InventoryConflict()
            changed = connection.execute(
                update(inventory_purchase_orders)
                .where(
                    inventory_purchase_orders.c.id == purchase.id,
                    inventory_purchase_orders.c.organization_id == value.organization_id,
                    inventory_purchase_orders.c.version == value.expected_version,
                )
                .values(
                    status=value.target.value,
                    version=inventory_purchase_orders.c.version + 1,
                    updated_at=value.updated_at,
                )
            ).rowcount
            _require_changed(changed)
            append_audit(connection, value.audit)
            return _read_purchase(connection, value.organization_id, purchase.id)

        return self._command(value.organization_id, mutation)

    def receive_purchase_order(self, value: ReceiptCommand) -> ReceiptResult:
        def mutation(connection: Connection) -> ReceiptResult:
            replay = _claim(
                connection,
                value.organization_id,
                value.idempotency_key,
                value.fingerprint,
                "receipt",
                ReceiptResult,
                value.occurred_at,
            )
            if replay is not None:
                return replay
            purchase = _lock_purchase(connection, value.organization_id, value.purchase_order_id)
            if int(purchase.version) != value.expected_version or purchase.status not in {
                PurchaseOrderStatus.SUBMITTED,
                PurchaseOrderStatus.PARTIALLY_RECEIVED,
            }:
                raise InventoryConflict()
            line = _lock_purchase_line(connection, purchase.id, value.line_id)
            received = _add(int(line.received_quantity), value.quantity)
            if received > int(line.ordered_quantity):
                raise InventoryConflict()
            balance = _lock_stock(
                connection,
                value.organization_id,
                line.item_id,
                value.warehouse_id,
                value.occurred_at,
            )
            connection.execute(
                update(inventory_purchase_order_lines)
                .where(inventory_purchase_order_lines.c.id == line.id)
                .values(received_quantity=received)
            )
            remaining = cast(
                int,
                connection.scalar(
                    select(func.count())
                    .select_from(inventory_purchase_order_lines)
                    .where(
                        inventory_purchase_order_lines.c.purchase_order_id == purchase.id,
                        inventory_purchase_order_lines.c.received_quantity
                        < inventory_purchase_order_lines.c.ordered_quantity,
                    )
                ),
            )
            target = (
                PurchaseOrderStatus.PARTIALLY_RECEIVED
                if remaining > 0
                else PurchaseOrderStatus.RECEIVED
            )
            changed = connection.execute(
                update(inventory_purchase_orders)
                .where(
                    inventory_purchase_orders.c.id == purchase.id,
                    inventory_purchase_orders.c.organization_id == value.organization_id,
                    inventory_purchase_orders.c.version == value.expected_version,
                )
                .values(
                    status=target.value,
                    version=inventory_purchase_orders.c.version + 1,
                    updated_at=value.occurred_at,
                )
            ).rowcount
            _require_changed(changed)
            updated_balance = _update_balance(
                connection,
                value.organization_id,
                balance,
                _add(int(balance.on_hand), value.quantity),
                int(balance.reserved),
                value.occurred_at,
            )
            movement = InventoryMovement(
                id=value.movement_id,
{{- if .Tenancy}}
                organization_id=value.organization_id,
{{- end}}
                item_id=line.item_id,
                warehouse_id=value.warehouse_id,
                kind=MovementKind.PURCHASE_RECEIVED,
                quantity_delta=str(value.quantity),
                reserved_delta="0",
                reference_type="purchase_order",
                reference_id=purchase.id,
                reason="purchase order received",
                idempotency_key=value.idempotency_key,
                created_by=value.actor_id,
                created_at=value.occurred_at,
            )
            connection.execute(
                insert(inventory_movements).values(
                    **_movement_values(value.organization_id, movement)
                )
            )
            updated_purchase = _read_purchase(connection, value.organization_id, purchase.id)
            result = ReceiptResult(
                purchase_order=updated_purchase,
                balance=updated_balance,
                movement=movement,
            )
            _complete_claim(
                connection,
                value.organization_id,
                value.idempotency_key,
                purchase.id,
                movement.id,
                result,
            )
            append_audit(connection, value.audit)
            return result

        return self._command(value.organization_id, mutation)

    def list_movements(
        self,
        organization_id: str,
        item_id: str,
        warehouse_id: str,
        cursor: str,
        limit: int,
    ) -> MovementPageResult:
        statement = select(inventory_movements).where(
            inventory_movements.c.organization_id == organization_id,
            _active_scope(inventory_movements),
        )
        if item_id:
            statement = statement.where(inventory_movements.c.item_id == item_id)
        if warehouse_id:
            statement = statement.where(inventory_movements.c.warehouse_id == warehouse_id)
        if cursor:
            statement = statement.where(inventory_movements.c.id > cursor)
        with self._engine.connect() as connection:
            rows = (
                connection.execute(statement.order_by(inventory_movements.c.id).limit(limit + 1))
                .mappings()
                .all()
            )
        values = [_map_movement(row) for row in rows]
        return MovementPageResult(values[:limit], _next(values, limit))

    def _read_one(self, table: sa.Table, organization_id: str, record_id: str) -> RowMapping | None:
        with self._engine.connect() as connection:
            return (
                connection.execute(
                    select(table).where(
                        table.c.id == record_id,
                        table.c.organization_id == organization_id,
                        _active_scope(table),
                    )
                )
                .mappings()
                .first()
            )

    def _create(
        self,
        organization_id: str,
        table: sa.Table,
        values: dict[str, object],
        audit: AuditEvent,
    ) -> None:
        def mutation(connection: Connection) -> bool:
            connection.execute(insert(table).values(**values))
            append_audit(connection, audit)
            return True

        self._command(organization_id, mutation)

    def _mutate[ResultModel](
        self,
        organization_id: str,
        audit: AuditEvent,
        mutation: Callable[[Connection], ResultModel],
    ) -> ResultModel:
        def audited(connection: Connection) -> ResultModel:
            result = mutation(connection)
            append_audit(connection, audit)
            return result

        return self._command(organization_id, audited)

    def _command[ResultModel](
        self,
        organization_id: str,
        mutation: Callable[[Connection], ResultModel],
    ) -> ResultModel:
        try:
            with self._engine.begin() as connection:
                _lock_scope(connection, organization_id)
                return mutation(connection)
        except IntegrityError as error:
            raise InventoryConflict() from error


def _claim[ResultSnapshot: BaseModel](
    connection: Connection,
    organization_id: str,
    key: str,
    fingerprint: str,
    result_type: str,
    model: type[ResultSnapshot],
    now: datetime,
) -> ResultSnapshot | None:
    inserted = True
    try:
        with connection.begin_nested():
            connection.execute(
                insert(inventory_idempotency).values(
                    organization_id=organization_id,
                    idempotency_key=key,
                    fingerprint=fingerprint,
                    result_type=result_type,
                    result_id=None,
                    movement_id=None,
                    result_payload=None,
                    created_at=now,
                )
            )
    except IntegrityError:
        inserted = False
    if inserted:
        return None
    row = (
        connection.execute(
            select(inventory_idempotency)
            .where(
                inventory_idempotency.c.organization_id == organization_id,
                inventory_idempotency.c.idempotency_key == key,
            )
            .with_for_update()
        )
        .mappings()
        .one_or_none()
    )
    if (
        row is None
        or str(row["fingerprint"]) != fingerprint
        or str(row["result_type"]) != result_type
        or row["result_id"] is None
        or row["movement_id"] is None
        or row["result_payload"] is None
    ):
        raise InventoryConflict()
    try:
        return model.model_validate_json(str(row["result_payload"]))
    except ValueError as error:
        raise InventoryConflict() from error


def _complete_claim(
    connection: Connection,
    organization_id: str,
    key: str,
    result_id: str,
    movement_id: str,
    result: BaseModel,
) -> None:
    changed = connection.execute(
        update(inventory_idempotency)
        .where(
            inventory_idempotency.c.organization_id == organization_id,
            inventory_idempotency.c.idempotency_key == key,
            inventory_idempotency.c.result_id.is_(None),
            inventory_idempotency.c.movement_id.is_(None),
        )
        .values(
            result_id=result_id,
            movement_id=movement_id,
            result_payload=result.model_dump_json(),
        )
    ).rowcount
    _require_changed(changed)


def _lock_scope(connection: Connection, organization_id: str) -> None:
{{- if .Tenancy}}
    found = connection.execute(
        select(organizations.c.id)
        .where(
            organizations.c.id == organization_id,
            organizations.c.status == "active",
        )
        .with_for_update()
    ).scalar_one_or_none()
    if found is None:
        raise InventoryNotFound()
{{- else}}
    del connection
    if organization_id:
        raise InventoryNotFound()
{{- end}}


def _active_scope(table: sa.Table) -> sa.ColumnElement[bool]:
{{- if .Tenancy}}
    return sa.exists(
        select(organizations.c.id).where(
            organizations.c.id == table.c.organization_id,
            organizations.c.status == "active",
        )
    )
{{- else}}
    del table
    return sa.true()
{{- end}}


def _lock_stock(
    connection: Connection,
    organization_id: str,
    item_id: str,
    warehouse_id: str,
    now: datetime,
) -> InventoryBalance:
    _require_active_item(connection, organization_id, item_id)
    warehouse = connection.execute(
        select(inventory_warehouses.c.id)
        .where(
            inventory_warehouses.c.id == warehouse_id,
            inventory_warehouses.c.organization_id == organization_id,
            inventory_warehouses.c.status == RecordStatus.ACTIVE.value,
        )
        .with_for_update()
    ).scalar_one_or_none()
    if warehouse is None:
        raise InventoryNotFound()
    try:
        with connection.begin_nested():
            connection.execute(
                insert(inventory_balances).values(
                    organization_id=organization_id,
                    item_id=item_id,
                    warehouse_id=warehouse_id,
                    on_hand=0,
                    reserved=0,
                    version=1,
                    updated_at=now,
                )
            )
    except IntegrityError:
        pass
    row = (
        connection.execute(
            select(inventory_balances)
            .where(
                inventory_balances.c.organization_id == organization_id,
                inventory_balances.c.item_id == item_id,
                inventory_balances.c.warehouse_id == warehouse_id,
            )
            .with_for_update()
        )
        .mappings()
        .one_or_none()
    )
    if row is None:
        raise InventoryConflict()
    return _map_balance(row)


def _require_active_item(connection: Connection, organization_id: str, item_id: str) -> None:
    found = connection.execute(
        select(inventory_items.c.id)
        .where(
            inventory_items.c.id == item_id,
            inventory_items.c.organization_id == organization_id,
            inventory_items.c.status == RecordStatus.ACTIVE.value,
        )
        .with_for_update()
    ).scalar_one_or_none()
    if found is None:
        raise InventoryNotFound()


def _update_balance(
    connection: Connection,
    organization_id: str,
    current: InventoryBalance,
    on_hand: int,
    reserved: int,
    updated_at: datetime,
) -> InventoryBalance:
    _validate_balance(on_hand, reserved)
    changed = connection.execute(
        update(inventory_balances)
        .where(
            inventory_balances.c.organization_id == organization_id,
            inventory_balances.c.item_id == current.item_id,
            inventory_balances.c.warehouse_id == current.warehouse_id,
            inventory_balances.c.version == int(current.version),
        )
        .values(
            on_hand=on_hand,
            reserved=reserved,
            version=inventory_balances.c.version + 1,
            updated_at=updated_at,
        )
    ).rowcount
    _require_changed(changed)
    row = (
        connection.execute(
            select(inventory_balances).where(
                inventory_balances.c.organization_id == organization_id,
                inventory_balances.c.item_id == current.item_id,
                inventory_balances.c.warehouse_id == current.warehouse_id,
            )
        )
        .mappings()
        .one()
    )
    return _map_balance(row)


