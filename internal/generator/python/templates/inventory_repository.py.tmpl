            )
        values = [_map_balance(row) for row in rows]
        return BalancePageResult(values[:limit], _next_balance(values, limit))

    def apply_stock(self, value: StockCommand) -> StockResult:
        def mutation(connection: Connection) -> StockResult:
            replay = _claim(
                connection,
                value.organization_id,
                value.idempotency_key,
                value.fingerprint,
                "stock",
                StockResult,
                value.movement.created_at,
            )
            if replay is not None:
                return replay
            balance = _lock_stock(
                connection,
                value.organization_id,
                value.movement.item_id,
                value.movement.warehouse_id,
                value.movement.created_at,
            )
            on_hand = _add(int(balance.on_hand), int(value.movement.quantity_delta))
            reserved = _add(int(balance.reserved), int(value.movement.reserved_delta))
            changed = _update_balance(
                connection,
                value.organization_id,
                balance,
                on_hand,
                reserved,
                value.movement.created_at,
            )
            connection.execute(
                insert(inventory_movements).values(
                    **_movement_values(value.organization_id, value.movement)
                )
            )
            result = StockResult(balance=changed, movement=value.movement)
            _complete_claim(
                connection,
                value.organization_id,
                value.idempotency_key,
                value.movement.reference_id,
                value.movement.id,
                result,
            )
            append_audit(connection, value.audit)
            return result

        return self._command(value.organization_id, mutation)

    def create_reservation(self, value: ReservationCommand) -> ReservationResult:
        def mutation(connection: Connection) -> ReservationResult:
            replay = _claim(
                connection,
                value.organization_id,
                value.idempotency_key,
                value.fingerprint,
                "reservation",
                ReservationResult,
                value.reservation.created_at,
            )
            if replay is not None:
                return replay
            balance = _lock_stock(
                connection,
                value.organization_id,
                value.reservation.item_id,
                value.reservation.warehouse_id,
                value.reservation.created_at,
            )
            reserved = _add(int(balance.reserved), int(value.reservation.quantity))
            _validate_balance(int(balance.on_hand), reserved)
            connection.execute(
                insert(inventory_reservations).values(
                    **_reservation_values(value.organization_id, value.reservation)
                )
            )
            changed = _update_balance(
                connection,
                value.organization_id,
                balance,
                int(balance.on_hand),
                reserved,
                value.reservation.updated_at,
            )
            connection.execute(
                insert(inventory_movements).values(
                    **_movement_values(value.organization_id, value.movement)
                )
            )
            result = ReservationResult(
                reservation=value.reservation,
                balance=changed,
                movement=value.movement,
            )
            _complete_claim(
                connection,
                value.organization_id,
                value.idempotency_key,
                value.reservation.id,
                value.movement.id,
                result,
            )
            append_audit(connection, value.audit)
            return result

        return self._command(value.organization_id, mutation)

    def get_reservation(self, organization_id: str, record_id: str) -> InventoryReservation | None:
