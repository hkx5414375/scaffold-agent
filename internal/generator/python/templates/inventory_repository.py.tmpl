def _validate_balance(on_hand: int, reserved: int) -> None:
    if on_hand < 0 or reserved < 0 or reserved > on_hand:
        raise InventoryConflict()


def _add(left: int, right: int) -> int:
    value = left + right
    if value < MINIMUM_INTEGER or value > MAXIMUM_INTEGER:
        raise InventoryConflict()
    return value


def _require_changed(changed: int | None) -> None:
    if changed != 1:
        raise InventoryConflict()


def _next[
    Identified: (
        InventoryItem,
        InventoryWarehouse,
        InventoryReservation,
        PurchaseOrder,
        InventoryMovement,
    )
](values: list[Identified], limit: int) -> str:
    return values[limit - 1].id if len(values) > limit else ""


def _next_balance(values: list[InventoryBalance], limit: int) -> str:
    if len(values) <= limit:
        return ""
    value = values[limit - 1]
    return f"{value.item_id}:{value.warehouse_id}"


