class SQLAlchemyInventoryRepository:
    """SQLAlchemy adapter with row locks, atomic audit, and replay snapshots."""

    def __init__(self, engine: Engine) -> None:
        self._engine = engine

    def create_item(self, value: InventoryItem, audit: AuditEvent) -> None:
        self._create(_organization(value), inventory_items, _item_values(value), audit)

    def get_item(self, organization_id: str, record_id: str) -> InventoryItem | None:
        row = self._read_one(inventory_items, organization_id, record_id)
        return _map_item(row) if row is not None else None

    def list_items(
        self, organization_id: str, status: str, cursor: str, limit: int
    ) -> ItemPageResult:
        statement = select(inventory_items).where(
            inventory_items.c.organization_id == organization_id,
            _active_scope(inventory_items),
        )
        if status:
            statement = statement.where(inventory_items.c.status == status)
        if cursor:
            statement = statement.where(inventory_items.c.id > cursor)
        with self._engine.connect() as connection:
            rows = (
                connection.execute(statement.order_by(inventory_items.c.id).limit(limit + 1))
                .mappings()
                .all()
            )
        values = [_map_item(row) for row in rows]
        return ItemPageResult(values[:limit], _next(values, limit))

    def update_item(self, value: ItemMutation, audit: AuditEvent) -> InventoryItem:
        def mutation(connection: Connection) -> InventoryItem:
            changed = connection.execute(
                update(inventory_items)
                .where(
                    inventory_items.c.id == value.item_id,
                    inventory_items.c.organization_id == value.organization_id,
                    inventory_items.c.version == value.expected_version,
                    inventory_items.c.status == RecordStatus.ACTIVE.value,
                )
                .values(
                    sku=value.sku,
                    name=value.name,
                    unit=value.unit,
                    version=inventory_items.c.version + 1,
                    updated_at=value.updated_at,
                )
            ).rowcount
            _require_changed(changed)
            return _read_item(connection, value.organization_id, value.item_id)

        return self._mutate(value.organization_id, audit, mutation)

    def transition_item(self, value: RecordTransition, audit: AuditEvent) -> InventoryItem:
        def mutation(connection: Connection) -> InventoryItem:
            changed = connection.execute(
                update(inventory_items)
                .where(
                    inventory_items.c.id == value.record_id,
                    inventory_items.c.organization_id == value.organization_id,
                    inventory_items.c.version == value.expected_version,
                    inventory_items.c.status == value.from_status.value,
                )
                .values(
                    status=value.to_status.value,
                    version=inventory_items.c.version + 1,
                    updated_at=value.updated_at,
                )
            ).rowcount
            _require_changed(changed)
            return _read_item(connection, value.organization_id, value.record_id)

        return self._mutate(value.organization_id, audit, mutation)

