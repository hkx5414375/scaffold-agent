def _actor_scope(actor: Principal) -> str:
    _identifier(actor.user_id)
{{- if .Tenancy}}
    return _identifier(actor.organization_id or "")
{{- else}}
    return ""
{{- end}}


def _identifier(value: str) -> str:
    return _required(value, MAXIMUM_IDENTIFIER_LENGTH)


def _optional_identifier(value: str) -> str:
    normalized = value.strip()
    return _identifier(normalized) if normalized else ""


def _code(value: str) -> str:
    normalized = value.strip().upper()
    if (
        not normalized
        or len(normalized) > 64
        or any(character not in CODE_CHARACTERS for character in normalized)
    ):
        raise _invalid()
    return normalized


def _required(value: str, maximum: int) -> str:
    normalized = value.strip()
    if not normalized or len(normalized) > maximum or not _safe(normalized):
        raise _invalid()
    return normalized


def _safe(value: str) -> bool:
    return all(character.isprintable() for character in value)


def _canonical(value: str) -> int:
    try:
        number = int(value, 10)
    except ValueError as error:
        raise _invalid() from error
    if number < MINIMUM_INTEGER or number > MAXIMUM_INTEGER or str(number) != value:
        raise _invalid()
    return number


def _positive(value: str) -> int:
    number = _canonical(value)
    if number < 1:
        raise _invalid()
    return number


def _nonzero(value: str) -> int:
    number = _canonical(value)
    if number == 0:
        raise _invalid()
    return number


def _page(filter_value: str, choices: set[str], cursor: str, limit: int) -> str:
    normalized = filter_value.strip()
    normalized_cursor = cursor.strip()
    if (
        (normalized and normalized not in choices)
        or len(normalized_cursor) > MAXIMUM_IDENTIFIER_LENGTH
        or not _safe(normalized_cursor)
        or limit < 1
        or limit > 100
    ):
        raise _invalid()
    return normalized


def _fingerprint(*values: str) -> str:
    digest = sha256()
    for index, value in enumerate(values):
        if index:
            digest.update(b"\0")
        digest.update(value.encode("utf-8"))
    return digest.hexdigest()


def _now(clock: Callable[[], datetime]) -> datetime:
    value = clock()
    if value.tzinfo is None or value.utcoffset() is None:
        raise _invalid()
    return value.astimezone(UTC)


def _audit(actor: Principal, action: str, target: str, now: datetime) -> AuditEvent:
    return AuditEvent(
        id=_new_id(),
        user_id=actor.user_id,
        action=action,
        outcome="succeeded",
        target=target,
        ip_address=None,
        user_agent=None,
        created_at=now,
    )


def _new_id() -> str:
    return str(uuid4())


def _raise_repository(error: Exception) -> NoReturn:
    if isinstance(error, InventoryError):
        raise error
    if isinstance(error, InventoryNotFound):
        raise _not_found() from error
    if isinstance(error, InventoryConflict):
        raise _conflict() from error
    raise _storage() from error


def _invalid() -> InventoryError:
    return InventoryError(InventoryErrorKind.INVALID, "inventory data is invalid")


def _not_found() -> InventoryError:
    return InventoryError(InventoryErrorKind.NOT_FOUND, "inventory record was not found")


def _conflict() -> InventoryError:
    return InventoryError(
        InventoryErrorKind.CONFLICT,
        "inventory record changed or conflicts with current state",
    )


def _storage() -> InventoryError:
    return InventoryError(InventoryErrorKind.STORAGE, "inventory operation could not be completed")
