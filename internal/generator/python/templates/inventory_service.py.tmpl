    def create_purchase_order(self, value: PurchaseOrderWrite, actor: Principal) -> PurchaseOrder:
{{- if .Tenancy}}
        scope = _actor_scope(actor)
{{- end}}
        item_ids: set[str] = set()
        lines: list[PurchaseOrderLine] = []
        for line in value.lines:
            item_id = _identifier(line.item_id)
            if item_id in item_ids:
                raise _invalid()
            item_ids.add(item_id)
            lines.append(
                PurchaseOrderLine(
                    id=_new_id(),
                    item_id=item_id,
                    ordered_quantity=str(_positive(line.ordered_quantity)),
                    received_quantity="0",
                )
            )
        now = _now(self._clock)
        purchase = PurchaseOrder(
            id=_new_id(),
{{- if .Tenancy}}
            organization_id=scope,
{{- end}}
            number=_code(value.number),
            supplier_name=_required(value.supplier_name, 160),
            status=PurchaseOrderStatus.DRAFT,
            version="1",
            lines=lines,
            created_at=now,
            updated_at=now,
        )
        try:
            self._repository.create_purchase_order(
                purchase,
                _audit(actor, "inventory:purchase:create", purchase.id, now),
            )
        except Exception as error:
            _raise_repository(error)
        return purchase

