    def adjust_stock(self, value: AdjustmentWrite, actor: Principal) -> StockResult:
        scope = _actor_scope(actor)
        item_id = _identifier(value.item_id)
        warehouse_id = _identifier(value.warehouse_id)
        quantity = _nonzero(value.quantity_delta)
        reason = _required(value.reason, 500)
        key = _identifier(value.idempotency_key)
        now = _now(self._clock)
        movement = _movement(
            scope,
            item_id,
            warehouse_id,
            MovementKind.ADJUSTMENT,
            quantity,
            0,
            "adjustment",
            key,
            reason,
            key,
            actor,
            now,
        )
        command = StockCommand(
            organization_id=scope,
            idempotency_key=key,
            fingerprint=_fingerprint("adjust", item_id, warehouse_id, str(quantity), reason),
            movement=movement,
            audit=_audit(actor, "inventory:stock:adjust", movement.id, now),
        )
        try:
            return self._repository.apply_stock(command)
        except Exception as error:
            _raise_repository(error)

