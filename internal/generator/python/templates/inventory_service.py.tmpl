MAXIMUM_IDENTIFIER_LENGTH = 191
MAXIMUM_INTEGER = 9_223_372_036_854_775_807
MINIMUM_INTEGER = -9_223_372_036_854_775_808
CODE_CHARACTERS = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")
RECORD_STATUSES = {item.value for item in RecordStatus}
RESERVATION_STATUSES = {item.value for item in ReservationStatus}
PURCHASE_STATUSES = {item.value for item in PurchaseOrderStatus}


class InventoryService:
    """Normalize commands and preserve the portable inventory contract."""

    def __init__(
        self,
        repository: InventoryRepository,
        clock: Callable[[], datetime] = lambda: datetime.now(UTC),
    ) -> None:
        self._repository = repository
        self._clock = clock

    def create_item(self, value: ItemWrite, actor: Principal) -> InventoryItem:
{{- if .Tenancy}}
        scope = _actor_scope(actor)
{{- end}}
        now = _now(self._clock)
        item = InventoryItem(
            id=_new_id(),
{{- if .Tenancy}}
            organization_id=scope,
{{- end}}
            sku=_code(value.sku),
            name=_required(value.name, 160),
            unit=_required(value.unit, 32).upper(),
            status=RecordStatus.ACTIVE,
            version="1",
            created_at=now,
            updated_at=now,
        )
        try:
            self._repository.create_item(item, _audit(actor, "inventory:item:create", item.id, now))
        except Exception as error:
            _raise_repository(error)
        return item

    def get_item(self, record_id: str, actor: Principal) -> InventoryItem:
        try:
            value = self._repository.get_item(_actor_scope(actor), _identifier(record_id))
        except Exception as error:
            _raise_repository(error)
        if value is None:
            raise _not_found()
        return value

    def list_items(self, status: str, cursor: str, limit: int, actor: Principal) -> ItemPage:
        normalized = _page(status, RECORD_STATUSES, cursor, limit)
        try:
            result = self._repository.list_items(
                _actor_scope(actor), normalized, cursor.strip(), limit
            )
        except Exception as error:
            _raise_repository(error)
        return ItemPage(items=result.items, next_cursor=result.next_cursor)

    def update_item(self, record_id: str, value: ItemUpdate, actor: Principal) -> InventoryItem:
        scope = _actor_scope(actor)
        normalized_id = _identifier(record_id)
        now = _now(self._clock)
        mutation = ItemMutation(
            organization_id=scope,
            item_id=normalized_id,
            sku=_code(value.sku),
            name=_required(value.name, 160),
            unit=_required(value.unit, 32).upper(),
            expected_version=_positive(value.version),
            updated_at=now,
        )
        try:
            return self._repository.update_item(
                mutation, _audit(actor, "inventory:item:update", normalized_id, now)
            )
        except Exception as error:
            _raise_repository(error)

    def archive_item(
        self, record_id: str, value: InventoryTransition, actor: Principal
    ) -> InventoryItem:
        return self._transition_item(record_id, value, RecordStatus.ARCHIVED, actor)

    def reactivate_item(
        self, record_id: str, value: InventoryTransition, actor: Principal
    ) -> InventoryItem:
        return self._transition_item(record_id, value, RecordStatus.ACTIVE, actor)

    def _transition_item(
        self,
        record_id: str,
        value: InventoryTransition,
        target: RecordStatus,
        actor: Principal,
    ) -> InventoryItem:
        scope = _actor_scope(actor)
        normalized_id = _identifier(record_id)
        now = _now(self._clock)
        command = RecordTransition(
            organization_id=scope,
            record_id=normalized_id,
            expected_version=_positive(value.version),
            from_status=(
                RecordStatus.ACTIVE if target == RecordStatus.ARCHIVED else RecordStatus.ARCHIVED
            ),
            to_status=target,
            updated_at=now,
        )
        try:
            return self._repository.transition_item(
                command,
                _audit(actor, f"inventory:item:{target.value}", normalized_id, now),
            )
        except Exception as error:
            _raise_repository(error)

