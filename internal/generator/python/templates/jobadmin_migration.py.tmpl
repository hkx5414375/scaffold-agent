def upgrade() -> None:
    """Create administrator permissions without exposing payload data."""
    permissions = sa.table(
        "identity_permissions",
        sa.column("code", sa.String),
        sa.column("description", sa.String),
    )
    role_permissions = sa.table(
        "identity_role_permissions",
        sa.column("role_code", sa.String),
        sa.column("permission_code", sa.String),
    )
    rows = [
        {"code": "jobs:read", "description": "Inspect background job state"},
        {"code": "jobs:manage", "description": "Retry dead background jobs"},
    ]
    op.bulk_insert(permissions, rows)
    op.bulk_insert(
        role_permissions,
        [{"role_code": "admin", "permission_code": row["code"]} for row in rows],
    )


def downgrade() -> None:
    """Remove background job administration permissions."""
    connection = op.get_bind()
    connection.execute(
        sa.text(
            "delete from identity_role_permissions where permission_code in "
            "('jobs:read', 'jobs:manage')"
        )
    )
    connection.execute(
        sa.text("delete from identity_permissions where code in ('jobs:read', 'jobs:manage')")
    )
