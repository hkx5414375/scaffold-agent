@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    """Migrate, compose dependencies, bootstrap identity, and release the pool."""
    settings = get_settings()
    engine = create_database_engine(settings.database_url)
{{- if .Observability}}
    probe = DatabaseProbe(engine)
{{- end}}
    try:
        upgrade_database(engine)
        service = IdentityService(SQLAlchemyIdentityRepository(engine))
        if settings.bootstrap_admin_email and settings.bootstrap_admin_password:
            service.ensure_admin(settings.bootstrap_admin_email, settings.bootstrap_admin_password)
        app.state.identity_service = service
{{- if .Approvals}}
        app.state.approval_service = ApprovalService(SQLAlchemyApprovalRepository(engine))
{{- end}}
{{- if .Cache}}
        app.state.cache_service = CacheService(SQLAlchemyCacheRepository(engine))
{{- end}}
{{- if .Catalog}}
        app.state.catalog_service = CatalogService(SQLAlchemyCatalogRepository(engine))
{{- end}}
{{- if .Files}}
        app.state.file_asset_service = FileAssetService(
            SQLAlchemyFileAssetRepository(engine),
            LocalBlobStore(settings.file_storage_root),
        )
{{- end}}
{{- if .Jobs}}
        job_service = JobService(SQLAlchemyJobRepository(engine))
        app.state.job_service = job_service
{{- if .Notifications}}
        app.state.notification_service = NotificationService(job_service)
{{- end}}
{{- end}}
{{- if .JobAdmin}}
        app.state.job_administration_service = JobAdministrationService(
            SQLAlchemyJobAdministrationRepository(engine)
        )
{{- end}}
{{if .Business}}
        business_repository = SQLAlchemy{{.Business.EntityClass}}Repository(engine)
        app.state.business_service = {{.Business.EntityClass}}Service(business_repository)
{{- if .CSVTransfer}}
        app.state.csv_transfer_service = CSVTransferService(SQLAlchemyCSVTransferRepository(engine))
{{- end}}
{{end}}
        app.state.database_probe = {{if .Observability}}probe{{else}}DatabaseProbe(engine){{end}}
        app.state.cookie_secure = settings.cookie_secure
        yield
    finally:
{{- if .Observability}}
        probe.close()
{{- end}}
        engine.dispose()


def create_app() -> FastAPI:
    """Create one application without opening infrastructure during import."""
    application = FastAPI(title="{{.ProjectName}}", version="0.1.0", lifespan=lifespan)
{{- if .Observability}}
    observer = HttpObserver()
    application.state.http_observer = observer
    application.add_middleware(HttpObservabilityMiddleware, observer=observer)
{{- end}}
    install_error_handlers(application)
{{- if .Approvals}}
    install_approval_error_handlers(application)
{{- end}}
{{- if .Catalog}}
    install_catalog_error_handlers(application)
{{- end}}
{{- if .Files}}
    install_file_error_handlers(application)
{{- end}}
{{- if .JobAdmin}}
    install_job_administration_error_handlers(application)
{{- end}}
{{if .Business}}
    install_business_error_handlers(application)
{{- if .CSVTransfer}}
    install_csv_transfer_error_handlers(application)
{{- end}}
{{end}}
    application.include_router(health_router)
{{- if .Observability}}
    application.include_router(observability_router)
{{- end}}
    application.include_router(identity_router)
{{- if .Approvals}}
    application.include_router(approval_router)
{{- end}}
{{- if .Catalog}}
    application.include_router(catalog_router)
{{- end}}
{{- if .Files}}
    application.include_router(file_router)
{{- end}}
{{- if .JobAdmin}}
    application.include_router(job_administration_router)
{{- end}}
{{if .Business}}
{{- if .CSVTransfer}}
    application.include_router(csv_transfer_router)
{{- end}}
    application.include_router(business_router)
{{end}}
    return application


app = create_app()
