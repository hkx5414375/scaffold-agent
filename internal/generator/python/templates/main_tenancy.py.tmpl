"""Generated FastAPI application composition root."""

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

from fastapi import FastAPI

from {{.PackageName}}.config import get_settings
from {{.PackageName}}.database import DatabaseProbe, create_database_engine
from {{.PackageName}}.errors import install_error_handlers
from {{.PackageName}}.health import router as health_router
from {{.PackageName}}.identity.http import router as identity_router
from {{.PackageName}}.identity.repository import SQLAlchemyIdentityRepository
from {{.PackageName}}.identity.service import IdentityService
{{- if .Jobs}}
from {{.PackageName}}.jobs.repository import SQLAlchemyJobRepository
from {{.PackageName}}.jobs.service import JobService
{{- end}}
from {{.PackageName}}.migrations import upgrade_database
{{if .BusinessBeforeTenancy -}}
from {{.PackageName}}.{{.Business.PackageName}}.http import (
    install_error_handlers as install_business_error_handlers,
)
from {{.PackageName}}.{{.Business.PackageName}}.http import router as business_router
from {{.PackageName}}.{{.Business.PackageName}}.repository import SQLAlchemy{{.Business.EntityClass}}Repository
from {{.PackageName}}.{{.Business.PackageName}}.service import {{.Business.EntityClass}}Service
{{- end}}
from {{.PackageName}}.tenancy.http import router as tenancy_router
{{- if .TenancyLifecycle}}
from {{.PackageName}}.tenancy.lifecycle_http import (
    install_error_handlers as install_lifecycle_error_handlers,
)
from {{.PackageName}}.tenancy.lifecycle_http import router as lifecycle_router
from {{.PackageName}}.tenancy.lifecycle_repository import SQLAlchemyTenancyLifecycleRepository
from {{.PackageName}}.tenancy.lifecycle_service import TenancyLifecycleService
{{- end}}
{{- if .TenancyMembers}}
from {{.PackageName}}.tenancy.member_http import (
    install_error_handlers as install_member_error_handlers,
)
from {{.PackageName}}.tenancy.member_http import router as member_router
from {{.PackageName}}.tenancy.member_repository import SQLAlchemyTenancyMemberRepository
from {{.PackageName}}.tenancy.member_service import TenancyMemberService
{{- end}}
from {{.PackageName}}.tenancy.repository import SQLAlchemyTenancyRepository
from {{.PackageName}}.tenancy.service import TenancyService
{{if and .Business (not .BusinessBeforeTenancy) -}}
from {{.PackageName}}.{{.Business.PackageName}}.http import (
    install_error_handlers as install_business_error_handlers,
)
from {{.PackageName}}.{{.Business.PackageName}}.http import router as business_router
from {{.PackageName}}.{{.Business.PackageName}}.repository import SQLAlchemy{{.Business.EntityClass}}Repository
from {{.PackageName}}.{{.Business.PackageName}}.service import {{.Business.EntityClass}}Service
{{end}}

@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    """Migrate, compose dependencies, bootstrap identity, and release the pool."""
    settings = get_settings()
    engine = create_database_engine(settings.database_url)
    try:
        upgrade_database(engine)
        service = IdentityService(SQLAlchemyIdentityRepository(engine))
        if settings.bootstrap_admin_email and settings.bootstrap_admin_password:
            service.ensure_admin(settings.bootstrap_admin_email, settings.bootstrap_admin_password)
        app.state.identity_service = service
{{- if .Jobs}}
        app.state.job_service = JobService(SQLAlchemyJobRepository(engine))
{{- end}}
        app.state.tenancy_service = TenancyService(SQLAlchemyTenancyRepository(engine))
{{- if .TenancyLifecycle}}
        app.state.tenancy_lifecycle_service = TenancyLifecycleService(
            SQLAlchemyTenancyLifecycleRepository(engine)
        )
{{- end}}
{{- if .TenancyMembers}}
        app.state.tenancy_member_service = TenancyMemberService(
            SQLAlchemyTenancyMemberRepository(engine)
        )
{{- end}}
{{if .Business}}
        business_repository = SQLAlchemy{{.Business.EntityClass}}Repository(engine)
        app.state.business_service = {{.Business.EntityClass}}Service(business_repository)
{{end}}
        app.state.database_probe = DatabaseProbe(engine)
        app.state.cookie_secure = settings.cookie_secure
        yield
    finally:
        engine.dispose()


def create_app() -> FastAPI:
    """Create one application without opening infrastructure during import."""
    application = FastAPI(title="{{.ProjectName}}", version="0.1.0", lifespan=lifespan)
    install_error_handlers(application)
{{- if .TenancyLifecycle}}
    install_lifecycle_error_handlers(application)
{{- end}}
{{- if .TenancyMembers}}
    install_member_error_handlers(application)
{{- end}}
{{if .Business}}
    install_business_error_handlers(application)
{{end}}
    application.include_router(health_router)
    application.include_router(identity_router)
    application.include_router(tenancy_router)
{{- if .TenancyLifecycle}}
    application.include_router(lifecycle_router)
{{- end}}
{{- if .TenancyMembers}}
    application.include_router(member_router)
{{- end}}
{{if .Business}}
    application.include_router(business_router)
{{end}}
    return application


app = create_app()
