"""Alembic environment owned by Scaffold Agent."""

from logging.config import fileConfig

from alembic import context
from sqlalchemy import Connection, engine_from_config, pool

from {{.PackageName}}.identity.models import metadata
from {{.PackageName}}.{{.Business.PackageName}} import models as business_models
{{- if .Tenancy}}
from {{.PackageName}}.tenancy import models as tenancy_models
{{- end}}

_business_metadata = business_models.table.metadata
{{- if .Tenancy}}
_tenancy_metadata = tenancy_models.organizations.metadata
{{- end}}

configuration = context.config
if configuration.config_file_name is not None:
    fileConfig(configuration.config_file_name)


def run_migrations_offline() -> None:
    """Render migrations without opening a connection."""
    context.configure(
        url=configuration.get_main_option("sqlalchemy.url"),
        target_metadata=metadata,
        literal_binds=True,
        dialect_opts={"paramstyle": "named"},
    )
    with context.begin_transaction():
        context.run_migrations()


def run_migrations_online() -> None:
    """Run migrations on a supplied application transaction or configured engine."""
    supplied = configuration.attributes.get("connection")
    if isinstance(supplied, Connection):
        context.configure(connection=supplied, target_metadata=metadata)
        with context.begin_transaction():
            context.run_migrations()
        return
    connectable = engine_from_config(
        configuration.get_section(configuration.config_ini_section, {}),
        prefix="sqlalchemy.",
        poolclass=pool.NullPool,
    )
    with connectable.connect() as connection:
        context.configure(connection=connection, target_metadata=metadata)
        with context.begin_transaction():
            context.run_migrations()


if context.is_offline_mode():
    run_migrations_offline()
else:
    run_migrations_online()
