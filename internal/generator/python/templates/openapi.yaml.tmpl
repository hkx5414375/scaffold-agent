{{- end}}
{{- if .StringLike}}
          minLength: 1
          maxLength: {{.MaximumLength}}
{{- end}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- if .Int64}}
          maxLength: 20
{{- end}}
{{- end}}
    {{.Business.EntityClass}}Update:
