openapi: 3.1.0
info:
  title: "{{.ProjectName}}"
  version: 0.1.0
  description: Generated identity and health API contract.
servers:
  - url: /
paths:
  /healthz:
    get:
      operationId: health
      summary: Check process liveness
      responses:
        "200":
          description: Process is alive.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /readyz:
    get:
      operationId: readiness
      summary: Check database readiness
      responses:
        "200":
          description: Database is reachable.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
        "503":
          description: Database is unavailable.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
{{if .Observability}}
  /metrics:
    get:
      operationId: metrics
      summary: Read aggregate process-local HTTP metrics without labels
      responses:
        "200":
          description: Prometheus text metrics without user-derived labels.
          content:
            text/plain:
              schema:
                type: string
{{end}}
  /api/v1/auth/login:
    post:
      operationId: login
      summary: Create a browser session
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Authenticated session created.
          headers:
            Set-Cookie:
              schema:
                type: string
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LoginResponse"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
  /api/v1/auth/logout:
    post:
      operationId: logout
      summary: Revoke a browser session
      responses:
        "204":
          description: Session removed when present.
  /api/v1/auth/me:
    get:
      operationId: currentPrincipal
      summary: Read the authenticated principal
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Safe current principal.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LoginResponse"
        "401":
          $ref: "#/components/responses/Unauthorized"
  /api/v1/auth/tokens:
    post:
      operationId: createApiToken
      summary: Create an expiring API token
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ApiTokenRequest"
      responses:
        "201":
          description: Raw token returned once.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiTokenResponse"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "422":
          $ref: "#/components/responses/ValidationError"
{{if .Tenancy}}
  /api/v1/organizations:
    post:
      operationId: createOrganization
      summary: Create an organization and administrator membership
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationWrite"
      responses:
        "201":
          description: Organization created atomically with its administrator membership.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
    get:
      operationId: listOrganizations
      summary: List organizations visible to the authenticated identity
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Organizations visible through current memberships.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationPage"
        "401":
          $ref: "#/components/responses/Unauthorized"
{{end}}
{{if .TenancyLifecycle}}
  /api/v1/organizations/{organization_id}:
    parameters:
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    patch:
      operationId: renameOrganization
      summary: Rename one active organization as an administrator
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationRenameWrite"
      responses:
        "200":
          description: Renamed organization.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organizations/{organization_id}/ownership-transfers:
    parameters:
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    post:
      operationId: transferOrganizationOwnership
      summary: Transfer ownership to an existing member
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OwnershipTransferWrite"
      responses:
        "200":
          description: Ownership transferred and target promoted to administrator.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organizations/{organization_id}/deactivation:
    parameters:
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    post:
      operationId: deactivateOrganization
      summary: Reversibly deactivate an owned organization
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Organization deactivated without deleting tenant data.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organizations/{organization_id}/reactivation:
    parameters:
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    post:
      operationId: reactivateOrganization
      summary: Reactivate an owned organization without tenant authorization
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Organization returned to active service.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
{{end}}
{{if .TenancyMembers}}
  /api/v1/organizations/{organization_id}/members:
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    get:
      operationId: listOrganizationMembers
      summary: List organization members
      x-required-permission: tenancy:members:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Current organization members.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMemberPage"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
  /api/v1/organizations/{organization_id}/invitations:
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    post:
      operationId: createOrganizationInvitation
      summary: Create an email-bound organization invitation
      x-required-permission: tenancy:members:manage
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationWrite"
      responses:
        "201":
          description: Invitation and raw acceptance token returned once.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationInvitation"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organization-invitations/accept:
    post:
      operationId: acceptOrganizationInvitation
      summary: Accept an invitation bound to the authenticated email
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationAccept"
      responses:
        "200":
          description: Accepted organization membership.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organizations/{organization_id}/members/{user_id}:
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
      - name: user_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    patch:
      operationId: changeOrganizationMemberRole
      summary: Replace one organization member role
      x-required-permission: tenancy:members:manage
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationMemberRoleWrite"
      responses:
        "200":
          description: Updated organization membership.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
    delete:
      operationId: removeOrganizationMember
      summary: Remove one organization member
      x-required-permission: tenancy:members:manage
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "204":
          description: Organization member removed.
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
{{end}}
{{if .Files}}
  /api/v1/files:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: uploadFileAsset
      summary: Upload one bounded durable file
      x-required-permission: files:create
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              additionalProperties: false
              required: [file]
              properties:
                file:
                  type: string
                  format: binary
      responses:
        "201":
          description: File bytes and metadata created.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAsset"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "409":
          $ref: "#/components/responses/Conflict"
        "413":
          description: File exceeds the 10 MiB limit.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiError"
    get:
      operationId: listFileAssets
      summary: List one bounded page of active file metadata
      x-required-permission: files:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      parameters:
        - name: cursor
          in: query
          schema:
            type: string
            maxLength: 191
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Active file metadata page.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAssetPage"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
  /api/v1/files/{asset_id}:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
      - name: asset_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
{{- else}}
    parameters:
      - name: asset_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
{{- end}}
    get:
      operationId: getFileAsset
      summary: Read public file metadata
      x-required-permission: files:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Public metadata without the storage key.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileAsset"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
    delete:
      operationId: deleteFileAsset
      summary: Delete file metadata and bytes with compensation
      x-required-permission: files:delete
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "204":
          description: File deleted.
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
  /api/v1/files/{asset_id}/content:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
      - name: asset_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
{{- else}}
    parameters:
      - name: asset_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
{{- end}}
    get:
      operationId: downloadFileAsset
      summary: Stream file content as an attachment
      x-required-permission: files:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: File bytes with attachment and nosniff headers.
          headers:
            Content-Disposition:
              schema:
                type: string
            X-Content-Type-Options:
              schema:
                type: string
                const: nosniff
          content:
            application/octet-stream:
              schema:
                type: string
                format: binary
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
{{end}}
{{if .JobAdmin}}
  /api/v1/jobs:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    get:
      operationId: listBackgroundJobs
      summary: List bounded background job metadata without payloads or internal keys
      x-required-permission: jobs:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      parameters:
        - name: status
          in: query
          schema:
            type: string
            enum: [queued, running, succeeded, retry, dead]
        - name: cursor
          in: query
          schema:
            type: string
            maxLength: 191
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Payload-free background job metadata page.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/JobAdministrationPage"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
  /api/v1/jobs/{job_id}/retry:
    parameters:
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      - name: job_id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
    post:
      operationId: retryDeadBackgroundJob
      summary: Reset one dead job to queued without changing its payload
      x-required-permission: jobs:manage
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Dead background job returned to the queue.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/JobAdministrationItem"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
{{end}}
{{if .Approvals}}
  /api/v1/approvals:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: submitApproval
      summary: Submit one generated business subject for approval
      x-required-permission: approvals:submit
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ApprovalSubmit"
      responses:
        "201":
          description: Pending approval request with immutable submission evidence.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalRequest"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
    get:
      operationId: listApprovals
      summary: List a bounded approval review queue
      x-required-permission: approvals:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      parameters:
        - name: status
          in: query
          schema:
            type: string
            enum: [pending, approved, rejected, cancelled]
        - name: cursor
          in: query
          schema:
            type: string
            maxLength: 191
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Scoped approval review queue.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalPage"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
  /api/v1/approvals/mine:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    get:
      operationId: listOwnApprovals
      summary: List only the current requester's approval requests
      x-required-permission: approvals:mine
      security:
        - bearerAuth: []
        - sessionCookie: []
      parameters:
        - name: status
          in: query
          schema:
            type: string
            enum: [pending, approved, rejected, cancelled]
        - name: cursor
          in: query
          schema:
            type: string
            maxLength: 191
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Current requester's scoped approval requests.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalPage"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
  /api/v1/approvals/{id}:
    parameters:
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
    get:
      operationId: getApproval
      summary: Read one scoped approval request
      x-required-permission: approvals:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: One scoped approval request.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
  /api/v1/approvals/{id}/events:
    parameters:
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
    get:
      operationId: listApprovalEvents
      summary: Read immutable approval event history
      x-required-permission: approvals:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Immutable scoped approval events.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalEventPage"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
  /api/v1/approvals/{id}/approve:
    parameters:
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
    post:
      operationId: approveApproval
      summary: Approve one pending request as a different identity
      x-required-permission: approvals:decide
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ApprovalDecision"
      responses:
        "200":
          description: Approved request and immutable evidence.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApprovalRequest"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/approvals/{id}/reject:
    parameters:
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      - name: id
        in: path
        required: true
        schema:
          type: string
          minLength: 1
          maxLength: 191
