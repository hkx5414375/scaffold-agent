  /api/v1/inventory/purchase-orders/{id}/submit:
    parameters:
      - $ref: "#/components/parameters/InventoryRecordId"
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: submitInventoryPurchaseOrder
      x-required-permission: inventory:procurement:manage
      security: [{sessionCookie: []}, {bearerToken: []}]
      requestBody: {required: true, content: {application/json: {schema: {$ref: "#/components/schemas/InventoryTransition"}}}}
      responses: {"200": {description: Purchase order submitted, content: {application/json: {schema: {$ref: "#/components/schemas/InventoryPurchaseOrder"}}}}, "409": {$ref: "#/components/responses/ErrorResponse"}}
  /api/v1/inventory/purchase-orders/{id}/cancel:
    parameters:
      - $ref: "#/components/parameters/InventoryRecordId"
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: cancelInventoryPurchaseOrder
      x-required-permission: inventory:procurement:manage
      security: [{sessionCookie: []}, {bearerToken: []}]
      requestBody: {required: true, content: {application/json: {schema: {$ref: "#/components/schemas/InventoryTransition"}}}}
      responses: {"200": {description: Unreceived purchase order cancelled, content: {application/json: {schema: {$ref: "#/components/schemas/InventoryPurchaseOrder"}}}}, "409": {$ref: "#/components/responses/ErrorResponse"}}
  /api/v1/inventory/purchase-orders/{id}/receive:
    parameters:
      - $ref: "#/components/parameters/InventoryRecordId"
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: receiveInventoryPurchaseOrder
      x-required-permission: inventory:procurement:manage
      security: [{sessionCookie: []}, {bearerToken: []}]
      requestBody: {required: true, content: {application/json: {schema: {$ref: "#/components/schemas/InventoryReceipt"}}}}
      responses: {"200": {description: Purchase line atomically received, content: {application/json: {schema: {$ref: "#/components/schemas/InventoryReceiptResult"}}}}, "409": {$ref: "#/components/responses/ErrorResponse"}}
{{- end}}
components:
{{- if or .Tenancy .Catalog .CustomerAccounts .CRM .Inventory}}
  parameters:
{{- if .Tenancy}}
    OrganizationHeader:
      name: X-Organization-ID
      in: header
      required: true
      description: Organization selected for tenant-scoped authorization and persistence.
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
{{- if .Catalog}}
    CatalogStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [draft, active, archived]
    CatalogProductId:
      name: id
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
    CatalogPageCursor:
      name: cursor
      in: query
      schema:
        type: string
        maxLength: 191
    CatalogPageLimit:
      name: limit
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 20
{{- end}}
{{- if .CustomerAccounts}}
    CustomerStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [active, suspended, closed]
    CustomerId:
      name: id
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
    CustomerPageCursor:
      name: cursor
      in: query
      schema:
        type: string
        maxLength: 191
    CustomerPageLimit:
      name: limit
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 20
{{- end}}
{{- if .CRM}}
    CRMRecordStatus:
      name: status
      in: query
      schema:
        type: string
        enum: [active, archived]
    CRMOpportunityStage:
      name: stage
      in: query
      schema:
        type: string
        enum: [lead, qualified, proposal, won, lost]
    CRMRecordId:
      name: id
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 191
    CRMPageCursor:
      name: cursor
      in: query
      schema:
        type: string
        maxLength: 191
    CRMPageLimit:
      name: limit
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 20
{{- end}}
{{- if .Inventory}}
    InventoryRecordStatus:
      name: status
      in: query
      schema: {type: string, enum: [active, archived]}
    InventoryReservationStatus:
      name: status
      in: query
      schema: {type: string, enum: [active, released, consumed]}
    InventoryPurchaseStatus:
      name: status
      in: query
      schema: {type: string, enum: [draft, submitted, partially_received, received, cancelled]}
    InventoryRecordId:
      name: id
      in: path
      required: true
      schema: {type: string, minLength: 1, maxLength: 191}
{{- end}}
{{- end}}
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
{{- if .CustomerAccounts}}
    customerSessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_customer_session
{{- end}}
  responses:
    BadRequest:
      description: Invalid request.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    Unauthorized:
      description: Authentication failed.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    Forbidden:
      description: Permission is missing.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    NotFound:
      description: Record does not exist.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    Conflict:
      description: Unique value or optimistic version conflict.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    ValidationError:
      description: Input validation failed.
      content:
        application/json:
          schema:
            type: object
  schemas:
    StatusResponse:
      type: object
      additionalProperties: false
      required: [status]
      properties:
        status:
          type: string
          enum: [ok, {{if .Observability}}ready, {{end}}unavailable]
    LoginRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          minLength: 3
          maxLength: 254
        password:
          type: string
          minLength: 1
          maxLength: 1024
          format: password
    LoginResponse:
      type: object
      additionalProperties: false
      required: [principal]
      properties:
        principal:
          $ref: "#/components/schemas/Principal"
    Principal:
      type: object
      additionalProperties: false
      required: [user_id, email, role, method]
      properties:
        user_id:
          type: string
        email:
          type: string
        role:
          type: string
        method:
          type: string
          enum: [session, token]
{{- if .Tenancy}}
        organization_id:
          type: [string, "null"]
{{- end}}
    ApiTokenRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
    ApiTokenResponse:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
    ApiError:
      type: object
      additionalProperties: false
      required: [code, message]
      properties:
        code:
          type: string
        message:
          type: string
{{if .Tenancy}}
    OrganizationWrite:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    Organization:
      type: object
      additionalProperties: false
      required: [id, name, role, created_at{{if .TenancyLifecycle}}, owner_user_id, is_owner, status, updated_at{{end}}]
      properties:
        id:
          type: string
        name:
          type: string
          minLength: 1
          maxLength: 120
        role:
          type: string
          enum: [admin, user]
        created_at:
          type: string
          format: date-time
{{- if .TenancyLifecycle}}
        owner_user_id:
          type: string
        is_owner:
          type: boolean
        status:
          type: string
          enum: [active, inactive]
        updated_at:
          type: string
          format: date-time
        deactivated_at:
          type: string
          format: date-time
{{- end}}
    OrganizationPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/Organization"
{{end}}
{{if .TenancyMembers}}
    OrganizationMember:
      type: object
      additionalProperties: false
      required: [organization_id, user_id, email, role, joined_at{{if .TenancyLifecycle}}, is_owner{{end}}]
      properties:
        organization_id:
          type: string
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        joined_at:
          type: string
          format: date-time
{{- if .TenancyLifecycle}}
        is_owner:
          type: boolean
{{- end}}
    OrganizationMemberPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/OrganizationMember"
    OrganizationInvitationWrite:
      type: object
      additionalProperties: false
      required: [email, role]
      properties:
        email:
          type: string
          format: email
          maxLength: 254
        role:
          type: string
          enum: [admin, user]
    OrganizationInvitation:
      type: object
      additionalProperties: false
      required: [id, organization_id, email, role, acceptance_token, expires_at, created_at]
      properties:
        id:
          type: string
        organization_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        acceptance_token:
          type: string
        expires_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    OrganizationInvitationAccept:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
          minLength: 1
          maxLength: 512
    OrganizationMemberRoleWrite:
      type: object
      additionalProperties: false
      required: [role]
      properties:
        role:
          type: string
          enum: [admin, user]
{{- if .TenancyLifecycle}}
    OrganizationRenameWrite:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    OwnershipTransferWrite:
      type: object
      additionalProperties: false
      required: [target_user_id]
      properties:
        target_user_id:
          type: string
          minLength: 1
          maxLength: 191
{{- end}}
{{end}}
{{- if .Inventory}}
    InventoryItem:
      type: object
      required: [id, sku, name, unit, status, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        sku: {type: string, pattern: "^[A-Z0-9._-]{1,64}$"}
        name: {type: string, minLength: 1, maxLength: 160}
        unit: {type: string, minLength: 1, maxLength: 32}
        status: {type: string, enum: [active, archived]}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
    InventoryItemWrite:
      type: object
      additionalProperties: false
      required: [sku, name, unit]
      properties:
        sku: {type: string, minLength: 1, maxLength: 64}
        name: {type: string, minLength: 1, maxLength: 160}
        unit: {type: string, minLength: 1, maxLength: 32}
    InventoryItemUpdate:
      type: object
      additionalProperties: false
      required: [sku, name, unit, version]
      properties:
        sku: {type: string, minLength: 1, maxLength: 64}
        name: {type: string, minLength: 1, maxLength: 160}
        unit: {type: string, minLength: 1, maxLength: 32}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
    InventoryWarehouse:
      type: object
      required: [id, code, name, status, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        code: {type: string, pattern: "^[A-Z0-9._-]{1,64}$"}
        name: {type: string, minLength: 1, maxLength: 160}
        status: {type: string, enum: [active, archived]}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
    InventoryWarehouseWrite:
      type: object
      additionalProperties: false
      required: [code, name]
      properties:
        code: {type: string, minLength: 1, maxLength: 64}
        name: {type: string, minLength: 1, maxLength: 160}
    InventoryWarehouseUpdate:
      type: object
      additionalProperties: false
      required: [code, name, version]
      properties:
        code: {type: string, minLength: 1, maxLength: 64}
        name: {type: string, minLength: 1, maxLength: 160}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
    InventoryTransition:
      type: object
      additionalProperties: false
      required: [version]
      properties: {version: {type: string, pattern: "^[1-9][0-9]*$"}}
    InventoryBalance:
      type: object
      required: [item_id, warehouse_id, on_hand, reserved, available, version, updated_at]
      properties:
        item_id: {type: string}
        warehouse_id: {type: string}
        on_hand: {type: string, pattern: "^(0|[1-9][0-9]*)$"}
        reserved: {type: string, pattern: "^(0|[1-9][0-9]*)$"}
        available: {type: string, pattern: "^(0|[1-9][0-9]*)$"}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        updated_at: {type: string, format: date-time}
    InventoryMovement:
      type: object
      required: [id, item_id, warehouse_id, kind, quantity_delta, reserved_delta, reference_type, reference_id, reason, idempotency_key, created_by, created_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        item_id: {type: string}
        warehouse_id: {type: string}
        kind: {type: string, enum: [adjustment, reservation_created, reservation_released, reservation_consumed, purchase_received]}
        quantity_delta: {type: string, pattern: "^-?(0|[1-9][0-9]*)$"}
        reserved_delta: {type: string, pattern: "^-?(0|[1-9][0-9]*)$"}
        reference_type: {type: string}
        reference_id: {type: string}
        reason: {type: string, minLength: 1, maxLength: 500}
        idempotency_key: {type: string}
        created_by: {type: string}
        created_at: {type: string, format: date-time}
    InventoryAdjustment:
      type: object
      additionalProperties: false
      required: [item_id, warehouse_id, quantity_delta, reason, idempotency_key]
      properties:
        item_id: {type: string}
        warehouse_id: {type: string}
        quantity_delta: {type: string, pattern: "^-?[1-9][0-9]*$"}
        reason: {type: string, minLength: 1, maxLength: 500}
        idempotency_key: {type: string, minLength: 1, maxLength: 191}
    InventoryReservation:
      type: object
      required: [id, external_reference, item_id, warehouse_id, quantity, status, version, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        external_reference: {type: string}
        item_id: {type: string}
        warehouse_id: {type: string}
        quantity: {type: string, pattern: "^[1-9][0-9]*$"}
        status: {type: string, enum: [active, released, consumed]}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
    InventoryReservationWrite:
      type: object
      additionalProperties: false
      required: [external_reference, item_id, warehouse_id, quantity, idempotency_key]
      properties:
        external_reference: {type: string, minLength: 1, maxLength: 191}
        item_id: {type: string}
        warehouse_id: {type: string}
        quantity: {type: string, pattern: "^[1-9][0-9]*$"}
        idempotency_key: {type: string, minLength: 1, maxLength: 191}
    InventoryReservationTransition:
      type: object
      additionalProperties: false
      required: [version, idempotency_key]
      properties:
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        idempotency_key: {type: string, minLength: 1, maxLength: 191}
    InventoryPurchaseOrderLine:
      type: object
      required: [id, item_id, ordered_quantity, received_quantity]
      properties:
        id: {type: string}
        item_id: {type: string}
        ordered_quantity: {type: string, pattern: "^[1-9][0-9]*$"}
        received_quantity: {type: string, pattern: "^(0|[1-9][0-9]*)$"}
    InventoryPurchaseOrderLineWrite:
      type: object
      additionalProperties: false
      required: [item_id, ordered_quantity]
      properties:
        item_id: {type: string}
        ordered_quantity: {type: string, pattern: "^[1-9][0-9]*$"}
    InventoryPurchaseOrder:
      type: object
      required: [id, number, supplier_name, status, version, lines, created_at, updated_at{{if .Tenancy}}, organization_id{{end}}]
      properties:
        id: {type: string}
{{- if .Tenancy}}
        organization_id: {type: string}
{{- end}}
        number: {type: string, pattern: "^[A-Z0-9._-]{1,64}$"}
        supplier_name: {type: string, minLength: 1, maxLength: 160}
        status: {type: string, enum: [draft, submitted, partially_received, received, cancelled]}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
        lines: {type: array, minItems: 1, maxItems: 100, items: {$ref: "#/components/schemas/InventoryPurchaseOrderLine"}}
        created_at: {type: string, format: date-time}
        updated_at: {type: string, format: date-time}
    InventoryPurchaseOrderWrite:
      type: object
      additionalProperties: false
      required: [number, supplier_name, lines]
      properties:
        number: {type: string, minLength: 1, maxLength: 64}
        supplier_name: {type: string, minLength: 1, maxLength: 160}
        lines: {type: array, minItems: 1, maxItems: 100, items: {$ref: "#/components/schemas/InventoryPurchaseOrderLineWrite"}}
    InventoryReceipt:
      type: object
      additionalProperties: false
      required: [line_id, warehouse_id, quantity, idempotency_key, version]
      properties:
        line_id: {type: string}
        warehouse_id: {type: string}
        quantity: {type: string, pattern: "^[1-9][0-9]*$"}
        idempotency_key: {type: string, minLength: 1, maxLength: 191}
        version: {type: string, pattern: "^[1-9][0-9]*$"}
    InventoryStockResult:
      type: object
      required: [balance, movement]
      properties:
        balance: {$ref: "#/components/schemas/InventoryBalance"}
        movement: {$ref: "#/components/schemas/InventoryMovement"}
    InventoryReservationResult:
      type: object
      required: [reservation, balance, movement]
      properties:
        reservation: {$ref: "#/components/schemas/InventoryReservation"}
        balance: {$ref: "#/components/schemas/InventoryBalance"}
        movement: {$ref: "#/components/schemas/InventoryMovement"}
    InventoryReceiptResult:
      type: object
      required: [purchase_order, balance, movement]
      properties:
        purchase_order: {$ref: "#/components/schemas/InventoryPurchaseOrder"}
        balance: {$ref: "#/components/schemas/InventoryBalance"}
        movement: {$ref: "#/components/schemas/InventoryMovement"}
    InventoryItemPage:
      type: object
      required: [items]
      properties: {items: {type: array, items: {$ref: "#/components/schemas/InventoryItem"}}, next_cursor: {type: string}}
    InventoryWarehousePage:
      type: object
      required: [items]
      properties: {items: {type: array, items: {$ref: "#/components/schemas/InventoryWarehouse"}}, next_cursor: {type: string}}
    InventoryBalancePage:
      type: object
      required: [items]
      properties: {items: {type: array, items: {$ref: "#/components/schemas/InventoryBalance"}}, next_cursor: {type: string}}
    InventoryMovementPage:
      type: object
      required: [items]
      properties: {items: {type: array, items: {$ref: "#/components/schemas/InventoryMovement"}}, next_cursor: {type: string}}
    InventoryReservationPage:
      type: object
      required: [items]
      properties: {items: {type: array, items: {$ref: "#/components/schemas/InventoryReservation"}}, next_cursor: {type: string}}
    InventoryPurchaseOrderPage:
      type: object
      required: [items]
      properties: {items: {type: array, items: {$ref: "#/components/schemas/InventoryPurchaseOrder"}}, next_cursor: {type: string}}
{{- end}}
{{if .Approvals}}
    ApprovalRequest:
      type: object
      additionalProperties: false
      required:
        - id
{{- if .Tenancy}}
        - organization_id
{{- end}}
        - subject_type
        - subject_id
        - requester_user_id
        - summary
        - details
        - status
        - version
        - created_at
        - updated_at
      properties:
        id:
          type: string
          minLength: 1
          maxLength: 191
{{- if .Tenancy}}
        organization_id:
          type: string
          minLength: 1
          maxLength: 191
{{- end}}
        subject_type:
          type: string
          enum: [{{.Business.ModuleName}}.{{.Business.EntityName}}]
        subject_id:
          type: string
          minLength: 1
          maxLength: 191
        requester_user_id:
          type: string
          minLength: 1
          maxLength: 191
        summary:
          type: string
          minLength: 1
          maxLength: 255
        details:
          type: string
          maxLength: 4000
        status:
          type: string
          enum: [pending, approved, rejected, cancelled]
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
          maxLength: 19
        resolution_comment:
          type: string
          maxLength: 2000
        resolved_by_user_id:
          type: string
          maxLength: 191
        resolved_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    ApprovalSubmit:
      type: object
      additionalProperties: false
      required: [subject_id, summary]
      properties:
        subject_id:
          type: string
          minLength: 1
          maxLength: 191
        summary:
          type: string
          minLength: 1
          maxLength: 255
        details:
          type: string
          maxLength: 4000
          default: ""
    ApprovalDecision:
      type: object
      additionalProperties: false
      required: [version]
      properties:
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
          maxLength: 19
        comment:
          type: string
          maxLength: 2000
          default: ""
    ApprovalPage:
      type: object
      additionalProperties: false
      required: [items, next_cursor]
      properties:
        items:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/ApprovalRequest"
        next_cursor:
          type: string
          maxLength: 191
    ApprovalEvent:
      type: object
      additionalProperties: false
      required: [id, request_id, actor_user_id, status, created_at]
      properties:
        id:
          type: string
          minLength: 1
          maxLength: 191
        request_id:
          type: string
          minLength: 1
          maxLength: 191
        actor_user_id:
          type: string
          minLength: 1
          maxLength: 191
        status:
          type: string
          enum: [pending, approved, rejected, cancelled]
        comment:
          type: string
          maxLength: 2000
        created_at:
