openapi: 3.1.0
info:
  title: "{{.ProjectName}}"
  version: 0.1.0
  description: Generated identity and health API contract.
servers:
  - url: /
paths:
  /healthz:
    get:
      operationId: health
      summary: Check process liveness
      responses:
        "200":
          description: Process is alive.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /readyz:
    get:
      operationId: readiness
      summary: Check database readiness
      responses:
        "200":
          description: Database is reachable.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
        "503":
          description: Database is unavailable.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StatusResponse"
  /api/v1/auth/login:
    post:
      operationId: login
      summary: Create a browser session
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Authenticated session created.
          headers:
            Set-Cookie:
              schema:
                type: string
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LoginResponse"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
  /api/v1/auth/logout:
    post:
      operationId: logout
      summary: Revoke a browser session
      responses:
        "204":
          description: Session removed when present.
  /api/v1/auth/me:
    get:
      operationId: currentPrincipal
      summary: Read the authenticated principal
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Safe current principal.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LoginResponse"
        "401":
          $ref: "#/components/responses/Unauthorized"
  /api/v1/auth/tokens:
    post:
      operationId: createApiToken
      summary: Create an expiring API token
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ApiTokenRequest"
      responses:
        "201":
          description: Raw token returned once.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiTokenResponse"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "422":
          $ref: "#/components/responses/ValidationError"
{{if .Tenancy}}
  /api/v1/organizations:
    post:
      operationId: createOrganization
      summary: Create an organization and administrator membership
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationWrite"
      responses:
        "201":
          description: Organization created atomically with its administrator membership.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
    get:
      operationId: listOrganizations
      summary: List organizations visible to the authenticated identity
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Organizations visible through current memberships.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationPage"
        "401":
          $ref: "#/components/responses/Unauthorized"
{{end}}
{{if .TenancyLifecycle}}
  /api/v1/organizations/{organization_id}:
    parameters:
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    patch:
      operationId: renameOrganization
      summary: Rename one active organization as an administrator
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationRenameWrite"
      responses:
        "200":
          description: Renamed organization.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organizations/{organization_id}/ownership-transfers:
    parameters:
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    post:
      operationId: transferOrganizationOwnership
      summary: Transfer ownership to an existing member
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OwnershipTransferWrite"
      responses:
        "200":
          description: Ownership transferred and target promoted to administrator.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organizations/{organization_id}/deactivation:
    parameters:
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    post:
      operationId: deactivateOrganization
      summary: Reversibly deactivate an owned organization
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Organization deactivated without deleting tenant data.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organizations/{organization_id}/reactivation:
    parameters:
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    post:
      operationId: reactivateOrganization
      summary: Reactivate an owned organization without tenant authorization
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Organization returned to active service.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Organization"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
{{end}}
{{if .TenancyMembers}}
  /api/v1/organizations/{organization_id}/members:
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    get:
      operationId: listOrganizationMembers
      summary: List organization members
      x-required-permission: tenancy:members:read
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Current organization members.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMemberPage"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
  /api/v1/organizations/{organization_id}/invitations:
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    post:
      operationId: createOrganizationInvitation
      summary: Create an email-bound organization invitation
      x-required-permission: tenancy:members:manage
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationWrite"
      responses:
        "201":
          description: Invitation and raw acceptance token returned once.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationInvitation"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organization-invitations/accept:
    post:
      operationId: acceptOrganizationInvitation
      summary: Accept an invitation bound to the authenticated email
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationInvitationAccept"
      responses:
        "200":
          description: Accepted organization membership.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "409":
          $ref: "#/components/responses/Conflict"
  /api/v1/organizations/{organization_id}/members/{user_id}:
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
      - name: organization_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
      - name: user_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    patch:
      operationId: changeOrganizationMemberRole
      summary: Replace one organization member role
      x-required-permission: tenancy:members:manage
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/OrganizationMemberRoleWrite"
      responses:
        "200":
          description: Updated organization membership.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OrganizationMember"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
    delete:
      operationId: removeOrganizationMember
      summary: Remove one organization member
      x-required-permission: tenancy:members:manage
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "204":
          description: Organization member removed.
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
{{end}}
{{if .Business}}
  {{.Business.RoutePath}}:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: create{{.Business.EntityClass}}
      summary: Create one {{.Business.EntityName}}
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityClass}}Write"
      responses:
        "201":
          description: Record created.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}Record"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "409":
          $ref: "#/components/responses/Conflict"
        "422":
          $ref: "#/components/responses/ValidationError"
    get:
      operationId: list{{.Business.EntityClass}}
      summary: List a bounded {{.Business.EntityName}} keyset page
      security:
        - bearerAuth: []
        - sessionCookie: []
      parameters:
        - name: cursor
          in: query
          schema:
            type: string
            maxLength: 191
        - name: limit
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 20
      responses:
        "200":
          description: Bounded keyset page.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}Page"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
  {{.Business.RoutePath}}/{record_id}:
    parameters:
{{- if .Tenancy}}
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
      - name: record_id
        in: path
        required: true
        schema:
          type: string
          maxLength: 191
    get:
      operationId: get{{.Business.EntityClass}}
      summary: Read one {{.Business.EntityName}}
      security:
        - bearerAuth: []
        - sessionCookie: []
      responses:
        "200":
          description: Requested record.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}Record"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
    put:
      operationId: update{{.Business.EntityClass}}
      summary: Replace one exact {{.Business.EntityName}} version
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/{{.Business.EntityClass}}Update"
      responses:
        "200":
          description: Updated record.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{.Business.EntityClass}}Record"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
        "422":
          $ref: "#/components/responses/ValidationError"
    delete:
      operationId: delete{{.Business.EntityClass}}
      summary: Delete one exact {{.Business.EntityName}} version
      security:
        - bearerAuth: []
        - sessionCookie: []
      parameters:
        - name: version
          in: query
          required: true
          schema:
            type: string
            pattern: "^[1-9][0-9]*$"
            maxLength: 19
      responses:
        "204":
          description: Record deleted.
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"
{{end}}
components:
{{- if .Tenancy}}
  parameters:
    OrganizationHeader:
      name: X-Organization-ID
      in: header
      required: true
      description: Organization selected for tenant-scoped authorization and persistence.
      schema:
        type: string
        minLength: 1
        maxLength: 191
{{- end}}
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
    sessionCookie:
      type: apiKey
      in: cookie
      name: scaffold_session
  responses:
    BadRequest:
      description: Invalid request.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    Unauthorized:
      description: Authentication failed.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    Forbidden:
      description: Permission is missing.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    NotFound:
      description: Record does not exist.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    Conflict:
      description: Unique value or optimistic version conflict.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    ValidationError:
      description: Input validation failed.
      content:
        application/json:
          schema:
            type: object
  schemas:
    StatusResponse:
      type: object
      additionalProperties: false
      required: [status]
      properties:
        status:
          type: string
    LoginRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          minLength: 3
          maxLength: 254
        password:
          type: string
          minLength: 1
          maxLength: 1024
          format: password
    LoginResponse:
      type: object
      additionalProperties: false
      required: [principal]
      properties:
        principal:
          $ref: "#/components/schemas/Principal"
    Principal:
      type: object
      additionalProperties: false
      required: [user_id, email, role, method]
      properties:
        user_id:
          type: string
        email:
          type: string
        role:
          type: string
        method:
          type: string
          enum: [session, token]
{{- if .Tenancy}}
        organization_id:
          type: [string, "null"]
{{- end}}
    ApiTokenRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 80
    ApiTokenResponse:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
    ApiError:
      type: object
      additionalProperties: false
      required: [code, message]
      properties:
        code:
          type: string
        message:
          type: string
{{if .Tenancy}}
    OrganizationWrite:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    Organization:
      type: object
      additionalProperties: false
      required: [id, name, role, created_at{{if .TenancyLifecycle}}, owner_user_id, is_owner, status, updated_at{{end}}]
      properties:
        id:
          type: string
        name:
          type: string
          minLength: 1
          maxLength: 120
        role:
          type: string
          enum: [admin, user]
        created_at:
          type: string
          format: date-time
{{- if .TenancyLifecycle}}
        owner_user_id:
          type: string
        is_owner:
          type: boolean
        status:
          type: string
          enum: [active, inactive]
        updated_at:
          type: string
          format: date-time
        deactivated_at:
          type: string
          format: date-time
{{- end}}
    OrganizationPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/Organization"
{{end}}
{{if .TenancyMembers}}
    OrganizationMember:
      type: object
      additionalProperties: false
      required: [organization_id, user_id, email, role, joined_at{{if .TenancyLifecycle}}, is_owner{{end}}]
      properties:
        organization_id:
          type: string
        user_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        joined_at:
          type: string
          format: date-time
{{- if .TenancyLifecycle}}
        is_owner:
          type: boolean
{{- end}}
    OrganizationMemberPage:
      type: object
      additionalProperties: false
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/OrganizationMember"
    OrganizationInvitationWrite:
      type: object
      additionalProperties: false
      required: [email, role]
      properties:
        email:
          type: string
          format: email
          maxLength: 254
        role:
          type: string
          enum: [admin, user]
    OrganizationInvitation:
      type: object
      additionalProperties: false
      required: [id, organization_id, email, role, acceptance_token, expires_at, created_at]
      properties:
        id:
          type: string
        organization_id:
          type: string
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, user]
        acceptance_token:
          type: string
        expires_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    OrganizationInvitationAccept:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
          minLength: 1
          maxLength: 512
    OrganizationMemberRoleWrite:
      type: object
      additionalProperties: false
      required: [role]
      properties:
        role:
          type: string
          enum: [admin, user]
{{- if .TenancyLifecycle}}
    OrganizationRenameWrite:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
    OwnershipTransferWrite:
      type: object
      additionalProperties: false
      required: [target_user_id]
      properties:
        target_user_id:
          type: string
          minLength: 1
          maxLength: 191
{{- end}}
{{end}}
{{if .Business}}
    {{.Business.EntityClass}}Record:
      type: object
      additionalProperties: false
      required:
        - id
{{- if .Tenancy}}
        - organization_id
{{- end}}
{{- range .Business.Fields}}
{{- if .Required}}
        - {{.Name}}
{{- end}}
{{- end}}
        - version
        - created_at
        - updated_at
      properties:
        id:
          type: string
{{- if .Tenancy}}
        organization_id:
          type: string
{{- end}}
{{- range .Business.Fields}}
        {{.Name}}:
{{- if .Required}}
          type: {{.OpenAPIType}}
{{- else}}
          type: [{{.OpenAPIType}}, "null"]
{{- end}}
{{- if .StringLike}}
          minLength: 1
          maxLength: {{.MaximumLength}}
{{- end}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- if .Int64}}
          maxLength: 20
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
          maxLength: 19
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    {{.Business.EntityClass}}Write:
      type: object
      additionalProperties: false
      required:
{{- range .Business.Fields}}
{{- if .Required}}
        - {{.Name}}
{{- end}}
{{- end}}
      properties:
{{- range .Business.Fields}}
        {{.Name}}:
{{- if .Required}}
          type: {{.OpenAPIType}}
{{- else}}
          type: [{{.OpenAPIType}}, "null"]
{{- end}}
{{- if .StringLike}}
          minLength: 1
          maxLength: {{.MaximumLength}}
{{- end}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- if .Int64}}
          maxLength: 20
{{- end}}
{{- end}}
    {{.Business.EntityClass}}Update:
      type: object
      additionalProperties: false
      required:
{{- range .Business.Fields}}
{{- if .Required}}
        - {{.Name}}
{{- end}}
{{- end}}
        - version
      properties:
{{- range .Business.Fields}}
        {{.Name}}:
{{- if .Required}}
          type: {{.OpenAPIType}}
{{- else}}
          type: [{{.OpenAPIType}}, "null"]
{{- end}}
{{- if .StringLike}}
          minLength: 1
          maxLength: {{.MaximumLength}}
{{- end}}
{{- if .OpenAPIFormat}}
          format: {{.OpenAPIFormat}}
{{- end}}
{{- if .OpenAPIPattern}}
          pattern: {{.OpenAPIPattern}}
{{- end}}
{{- if .Int64}}
          maxLength: 20
{{- end}}
{{- end}}
        version:
          type: string
          pattern: "^[1-9][0-9]*$"
          maxLength: 19
    {{.Business.EntityClass}}Page:
      type: object
      additionalProperties: false
      required: [items, next_cursor]
      properties:
        items:
          type: array
          maxItems: 100
          items:
            $ref: "#/components/schemas/{{.Business.EntityClass}}Record"
        next_cursor:
          type: string
{{end}}
