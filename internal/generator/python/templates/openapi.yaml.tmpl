{{if .CSVTransfer}}
  {{.Business.RoutePath}}/import:
{{- if .Tenancy}}
    parameters:
      - $ref: "#/components/parameters/OrganizationHeader"
{{- end}}
    post:
      operationId: import{{.Business.EntityClass}}CSV
      summary: Atomically create records from one bounded Blueprint CSV document
      security:
        - bearerAuth: []
        - sessionCookie: []
      requestBody:
        required: true
        content:
          text/csv:
            schema:
              type: string
              format: binary
      responses:
        "201":
          description: Every validated row was created in one transaction.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CSVImportResult"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "409":
          $ref: "#/components/responses/Conflict"
        "413":
          description: The CSV exceeds 5 MiB.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiError"
        "415":
          description: Content-Type is not text/csv.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApiError"
        "422":
          $ref: "#/components/responses/ValidationError"
