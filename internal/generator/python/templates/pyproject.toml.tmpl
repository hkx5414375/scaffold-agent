[project]
name = "{{.ProjectName}}"
version = "0.1.0"
description = "Generated by Scaffold Agent"
readme = "README.md"
requires-python = ">=3.12,<3.14"
dependencies = [
  "alembic==1.19.1",
  "fastapi==0.141.1",
  "pydantic==2.13.5",
  "pydantic-settings==2.15.0",
{{- if .Files}}
  "python-multipart==0.0.32",
{{- end}}
  {{.Database.DriverDependency}},
  "sqlalchemy==2.0.52",
  "uvicorn==0.52.4",
]

[dependency-groups]
dev = [
  "bandit==1.9.4",
  "httpx==0.28.1",
  "mypy==2.3.1",
  "pytest==9.1.1",
  "pytest-cov==7.1.0",
  "ruff==0.16.5",
{{- if eq .Database.Engine "mysql"}}
  "types-pymysql==1.2.0.20260807",
{{- end}}
]

[build-system]
requires = ["hatchling==1.32.0"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{.PackageName}}"]

[tool.uv]
required-version = "==0.12.8"

[tool.ruff]
target-version = "py312"
line-length = 100
extend-exclude = [".scaffold-agent"]

[tool.ruff.lint]
select = ["B", "C4", "DTZ", "E", "F", "I", "PIE", "PT", "RET", "RUF", "S", "SIM", "UP"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "S105", "S106"]

[tool.mypy]
python_version = "3.12"
strict = true
warn_unreachable = true
plugins = ["pydantic.mypy"]

[[tool.mypy.overrides]]
module = ["alembic.*"]
ignore_missing_imports = true

[tool.pytest.ini_options]
addopts = "--strict-config --strict-markers --cov={{.PackageName}} --cov-report=term-missing --cov-fail-under=90"
testpaths = ["tests"]

[tool.coverage.run]
branch = true
source = ["{{.PackageName}}"]
omit = ["src/*/migration/*"]

[tool.bandit]
exclude_dirs = ["tests"]
