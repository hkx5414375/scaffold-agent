"""Generated package boundary and contract tests."""

import ast
from pathlib import Path

from {{.PackageName}}.main import create_app

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = ROOT / "src" / "{{.PackageName}}"


def test_application_and_stable_contract_expose_the_same_operations() -> None:
    runtime = create_app().openapi()
    stable_source = (ROOT / "api" / "openapi.yaml").read_text(encoding="utf-8")
    stable_operations = {
        ("/healthz", "get"),
        ("/readyz", "get"),
        ("/api/v1/auth/login", "post"),
        ("/api/v1/auth/logout", "post"),
        ("/api/v1/auth/me", "get"),
        ("/api/v1/auth/tokens", "post"),
{{- if .Tenancy}}
        ("/api/v1/organizations", "post"),
        ("/api/v1/organizations", "get"),
{{- end}}
{{- if .TenancyMembers}}
        ("/api/v1/organizations/{organization_id}/members", "get"),
        ("/api/v1/organizations/{organization_id}/invitations", "post"),
        ("/api/v1/organization-invitations/accept", "post"),
        ("/api/v1/organizations/{organization_id}/members/{user_id}", "patch"),
        ("/api/v1/organizations/{organization_id}/members/{user_id}", "delete"),
{{- end}}
{{- if .TenancyLifecycle}}
        ("/api/v1/organizations/{organization_id}", "patch"),
        ("/api/v1/organizations/{organization_id}/ownership-transfers", "post"),
        ("/api/v1/organizations/{organization_id}/deactivation", "post"),
        ("/api/v1/organizations/{organization_id}/reactivation", "post"),
{{- end}}
{{- if .Business}}
        ("{{.Business.RoutePath}}", "post"),
        ("{{.Business.RoutePath}}", "get"),
        ("{{.Business.RoutePath}}/{record_id}", "get"),
        ("{{.Business.RoutePath}}/{record_id}", "put"),
        ("{{.Business.RoutePath}}/{record_id}", "delete"),
{{- end}}
{{- if .Files}}
        ("/api/v1/files", "post"),
        ("/api/v1/files", "get"),
        ("/api/v1/files/{asset_id}", "get"),
        ("/api/v1/files/{asset_id}", "delete"),
        ("/api/v1/files/{asset_id}/content", "get"),
{{- end}}
{{- if .JobAdmin}}
        ("/api/v1/jobs", "get"),
        ("/api/v1/jobs/{job_id}/retry", "post"),
{{- end}}
    }
    runtime_operations = {
        (path, method)
        for path, item in runtime["paths"].items()
        for method in item
        if method in {"delete", "get", "patch", "post", "put"}
    }

    assert runtime_operations == stable_operations
    assert all(path in stable_source for path, _method in stable_operations)


def test_identity_service_has_no_transport_or_orm_imports() -> None:
    tree = ast.parse((PACKAGE / "identity" / "service.py").read_text(encoding="utf-8"))
    imported_roots = {
        alias.name.split(".", maxsplit=1)[0]
        for node in ast.walk(tree)
        if isinstance(node, ast.Import)
        for alias in node.names
    }
    imported_roots.update(
        node.module.split(".", maxsplit=1)[0]
        for node in ast.walk(tree)
        if isinstance(node, ast.ImportFrom) and node.module is not None
    )

    assert imported_roots.isdisjoint({"fastapi", "sqlalchemy"})
{{- if .Tenancy}}

    tenancy_tree = ast.parse((PACKAGE / "tenancy" / "service.py").read_text(encoding="utf-8"))
