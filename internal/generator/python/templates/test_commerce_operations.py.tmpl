def _service(
    repository: MemoryRepository | None = None,
) -> tuple[CommerceService, MemoryRepository, SandboxPaymentGateway]:
    values = repository or MemoryRepository()
    gateway = SandboxPaymentGateway()
    catalog = cast(CatalogRepository, MemoryCatalog())
    return CommerceService(values, catalog, gateway, lambda: NOW), values, gateway


