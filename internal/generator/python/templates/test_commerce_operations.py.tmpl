def test_cart_checkout_promotion_and_replay_are_deterministic() -> None:
    service, repository, gateway = _service()
    customer = _customer()
    assert service.cart(customer, "usd").version == "0"
    cart = service.put_line(
        customer,
        "product-one",
        CartLineInput(currency="usd", quantity="2", version="0"),
    )
    assert cart.subtotal_minor == "2000"
    campaign = service.create_campaign(_campaign_input(), _actor())
    campaign = service.activate_campaign(campaign.id, CampaignTransition(version="1"), _actor())
    assert campaign.status is CampaignStatus.ACTIVE
    checkout = CheckoutInput(
        currency="USD",
        version="1",
        coupon_code="",
        idempotency_key="checkout-one",
    )
    order = service.checkout(customer, checkout)
    assert order.total_minor == "1500"
    assert order.lines[0].unit_minor == "1000"
    assert service.checkout(customer, checkout) == order
    with pytest.raises(CommerceError) as conflict:
        service.checkout(customer, checkout.model_copy(update={"coupon_code": "DIFFERENT"}))
    assert conflict.value.kind is CommerceErrorKind.CONFLICT
    gateway.complete(order.payment.provider_ref, "succeeded")
    confirmed = service.complete_payment(
        order.payment.provider_ref, "provider-event-one", "succeeded"
    )
    assert confirmed.status is OrderStatus.CONFIRMED
    assert (
        service.complete_payment(order.payment.provider_ref, "provider-event-one", "succeeded")
        == confirmed
    )
    assert repository.carts[(SCOPE, customer.id, "USD")].status == "checked_out"


def test_coupon_refund_fulfillment_return_and_tenant_isolation() -> None:
    service, _repository, gateway = _service()
    customer = _customer()
    campaign = service.create_campaign(_campaign_input(coupon_required=True), _actor())
    service.activate_campaign(campaign.id, CampaignTransition(version="1"), _actor())
    coupon = service.create_coupon(
        CouponInput(campaign_id=campaign.id, code="save25", maximum_uses="1"), _actor()
    )
    assert coupon.code == "SAVE25"
    service.put_line(
        customer,
        "product-one",
        CartLineInput(currency="USD", quantity="1", version="0"),
    )
    order = service.checkout(
        customer,
        CheckoutInput(
            currency="USD",
            version="1",
            coupon_code="SAVE25",
            idempotency_key="coupon-checkout",
        ),
    )
    gateway.complete(order.payment.provider_ref, "succeeded")
    order = service.complete_payment(order.payment.provider_ref, "paid", "succeeded")
    order = service.start_fulfillment(order.id, OrderTransition(version="2"), _actor())
    order = service.complete_fulfillment(
        order.id,
        OrderTransition(version="3", reference="shipment-one"),
        _actor(),
    )
    assert order.fulfillment_ref == "shipment-one"
    order = service.request_return(customer, order.id, ReturnInput(version="4", reason="damaged"))
    assert order.return_reason == "damaged"
    order = service.complete_return(order.id, OrderTransition(version="5"), _actor())
    assert order.status is OrderStatus.RETURNED
    refunded = service.refund(
        order.id,
        RefundInput(amount_minor="250", idempotency_key="refund-one"),
        _actor(),
    )
    assert refunded.payment.refunded_minor == "250"
    assert (
        service.refund(
            order.id,
            RefundInput(amount_minor="250", idempotency_key="refund-one"),
            _actor(),
        ).payment.refunded_minor
        == "250"
    )
{{- if .Tenancy}}
    with pytest.raises(CommerceError) as hidden:
        service.order(order.id, _actor("organization-two"))
    assert hidden.value.kind is CommerceErrorKind.NOT_FOUND
{{- end}}


def test_validation_conflicts_and_sandbox_gateway_are_bounded() -> None:
    service, _repository, gateway = _service()
    customer = _customer()
    with pytest.raises(CommerceError):
        service.cart(customer, "invalid")
    with pytest.raises(CommerceError):
        service.put_line(
            customer,
            "missing",
            CartLineInput(currency="USD", quantity="1", version="0"),
        )
    with pytest.raises(GatewayConflict):
        gateway.create_intent("order", -1, "USD", "key")
    with pytest.raises(GatewayNotFound):
        gateway.fetch_status("missing")
    campaign = service.create_campaign(_campaign_input(), _actor())
    assert service.campaigns("", 20, _actor()).items == [campaign]
    archived = service.archive_campaign(
        service.activate_campaign(campaign.id, CampaignTransition(version="1"), _actor()).id,
        CampaignTransition(version="2"),
        _actor(),
    )
    assert archived.status is CampaignStatus.ARCHIVED
    with pytest.raises(CommerceError) as duplicate:
        service.create_coupon(
            CouponInput(campaign_id="missing", code="CODE", maximum_uses="1"), _actor()
        )
    assert duplicate.value.kind is CommerceErrorKind.CONFLICT

    class FailingRepository(MemoryRepository):
        def create_campaign(self, _campaign: Campaign, _audit: AuditEvent) -> Campaign:
            raise RuntimeError()

    service, _repository, _gateway = _service(FailingRepository())
    with pytest.raises(CommerceError) as storage:
        service.create_campaign(_campaign_input(), _actor())
    assert storage.value.kind is CommerceErrorKind.STORAGE
