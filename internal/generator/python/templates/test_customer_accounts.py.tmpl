NOW = datetime(2026, 9, 1, tzinfo=UTC)
SCOPE = {{if .Tenancy}}"organization-1"{{else}}""{{end}}
OTHER_SCOPE = {{if .Tenancy}}"organization-2"{{else}}""{{end}}


class MemoryRepository:
    def __init__(self) -> None:
        self.customers: dict[str, CustomerRecord] = {}
        self.sessions: dict[str, CustomerSession] = {}
        self.audits: list[AuditEvent] = []
        self.failure: Exception | None = None

    def register(
        self,
        customer: CustomerRecord,
        session: CustomerSession,
        audit: AuditEvent,
    ) -> None:
        self._fail()
        if any(
            item.organization_id == customer.organization_id and item.email == customer.email
            for item in self.customers.values()
        ):
            raise CustomerConflict()
        self.customers[customer.id] = customer
        self.sessions[session.token_hash] = session
        self.audits.append(audit)

    def find_by_email(self, organization_id: str, email: str) -> CustomerRecord | None:
        self._fail()
        return next(
            (
                customer
                for customer in self.customers.values()
                if customer.organization_id == organization_id and customer.email == email
            ),
            None,
        )

    def create_session(self, session: CustomerSession, audit: AuditEvent) -> None:
        self._fail()
        self.sessions[session.token_hash] = session
        self.audits.append(audit)

    def find_by_session(
        self,
        organization_id: str,
        token_hash: str,
        now: datetime,
    ) -> CustomerRecord | None:
        self._fail()
        session = self.sessions.get(token_hash)
        if session is None or session.expires_at <= now:
            return None
        customer = self.customers.get(session.customer_id)
        if (
            customer is None
            or customer.organization_id != organization_id
            or customer.status != CustomerStatus.ACTIVE
        ):
            return None
        return customer

    def delete_session(self, token_hash: str, audit: AuditEvent) -> None:
        self._fail()
        self.sessions.pop(token_hash, None)
        self.audits.append(audit)

    def append_audit(self, audit: AuditEvent) -> None:
        self._fail()
        self.audits.append(audit)

    def update_profile(
        self,
        mutation: CustomerMutation,
        audit: AuditEvent,
    ) -> CustomerRecord:
        self._fail()
        current = self._mutable(mutation)
        changed = replace(
            current,
            display_name=mutation.display_name,
            version=current.version + 1,
            updated_at=mutation.updated_at,
        )
        self.customers[current.id] = changed
        self.audits.append(audit)
        return changed

    def change_password(
        self,
        mutation: CustomerMutation,
        audit: AuditEvent,
    ) -> CustomerRecord:
        self._fail()
        current = self._mutable(mutation)
        changed = replace(
            current,
            password_hash=mutation.password_hash,
            version=current.version + 1,
            updated_at=mutation.updated_at,
        )
        self.customers[current.id] = changed
        self._revoke(current.id)
        self.audits.append(audit)
        return changed

    def get(self, organization_id: str, customer_id: str) -> CustomerRecord | None:
        self._fail()
        customer = self.customers.get(customer_id)
        if customer is None or customer.organization_id != organization_id:
            return None
        return customer

    def list_page(
        self,
        organization_id: str,
        status: str,
        cursor: str,
        limit: int,
    ) -> CustomerPageResult:
        self._fail()
        values = sorted(
            (
                customer
                for customer in self.customers.values()
                if customer.organization_id == organization_id
                and (not status or customer.status.value == status)
                and (not cursor or customer.id > cursor)
            ),
            key=lambda customer: customer.id,
        )
        next_cursor = values[limit - 1].id if len(values) > limit else ""
        return CustomerPageResult(values[:limit], next_cursor)

    def transition(
        self,
        transition: CustomerStatusTransition,
        audit: AuditEvent,
    ) -> CustomerRecord:
        self._fail()
        current = self.customers.get(transition.customer_id)
        if (
            current is None
            or current.organization_id != transition.organization_id
            or current.version != transition.expected_version
            or current.status != transition.from_status
        ):
            raise CustomerConflict()
        changed = replace(
            current,
            status=transition.to_status,
            version=current.version + 1,
            updated_at=transition.updated_at,
        )
        self.customers[current.id] = changed
        self._revoke(current.id)
        self.audits.append(audit)
        return changed

    def _mutable(self, mutation: CustomerMutation) -> CustomerRecord:
        current = self.customers.get(mutation.customer_id)
        if (
            current is None
            or current.organization_id != mutation.organization_id
            or current.version != mutation.expected_version
            or current.status != CustomerStatus.ACTIVE
        ):
            raise CustomerConflict()
        return current

    def _revoke(self, customer_id: str) -> None:
        self.sessions = {
            token_hash: session
            for token_hash, session in self.sessions.items()
            if session.customer_id != customer_id
        }

    def _fail(self) -> None:
        if self.failure is not None:
            raise self.failure


