"""Customer account transactions, isolation, session revocation, and grants."""

import os
from datetime import UTC, datetime
from uuid import uuid4

import pytest
from sqlalchemy import create_engine, delete, func, insert, select{{if .Tenancy}}, update{{end}}
from sqlalchemy.engine import Engine
from sqlalchemy.pool import StaticPool

import {{.PackageName}}.customer_accounts.service as customer_service_module
from {{.PackageName}}.customer_accounts.models import (
    CustomerError,
    CustomerErrorKind,
    CustomerLogin,
    CustomerPasswordChange,
    CustomerProfileUpdate,
    CustomerRegistration,
    CustomerStatus,
    CustomerTransition,
    customer_accounts,
    customer_sessions,
)
from {{.PackageName}}.customer_accounts.repository import SQLAlchemyCustomerRepository
from {{.PackageName}}.customer_accounts.service import CustomerAccountService
from {{.PackageName}}.database import create_database_engine
from {{.PackageName}}.identity.models import Principal, audit_events, role_permissions, users
from {{.PackageName}}.migrations import upgrade_database
{{- if .Tenancy}}
from {{.PackageName}}.tenancy.models import organization_memberships, organizations
from {{.PackageName}}.tenancy.repository import SQLAlchemyTenancyRepository
from {{.PackageName}}.tenancy.service import TenancyService
{{- end}}


def _repository_contract(engine: Engine, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(customer_service_module, "hash_password", lambda value: f"hash:{value}")
    monkeypatch.setattr(
        customer_service_module,
        "verify_password",
        lambda encoded, value: encoded == f"hash:{value}",
    )
    suffix = uuid4().hex
    now = datetime.now(UTC)
    user_id = "customer-admin-" + suffix
    email = suffix + "@example.com"
    with engine.begin() as connection:
        connection.execute(
            insert(users).values(
                id=user_id,
                email=email,
                password_hash="unused",
                role="admin",
                disabled=False,
                created_at=now,
                updated_at=now,
            )
        )
    actor = Principal(
        user_id=user_id,
        email=email,
        role="admin",
        method="token",
{{- if .Tenancy}}
        organization_id=None,
{{- end}}
    )
{{- if .Tenancy}}
    tenancy = TenancyService(SQLAlchemyTenancyRepository(engine), lambda: now)
    organization = tenancy.create("Customers " + suffix, actor)
    actor = actor.model_copy(update={"organization_id": organization.id})
    scope = organization.id
{{- else}}
    scope = ""
{{- end}}
    service = CustomerAccountService(SQLAlchemyCustomerRepository(engine), lambda: now)
    registered = service.register(
        scope,
        CustomerRegistration(
            email="Customer-" + suffix + "@Example.com",
            password="correct-password",
            display_name="Database Customer",
        ),
        "127.0.0.1",
        "database-test",
    )
    customer_id = registered.customer.id
    assert service.authenticate(scope, registered.token).id == customer_id

    with pytest.raises(CustomerError) as duplicate:
        service.register(
            scope,
            CustomerRegistration(
                email=registered.customer.email.upper(),
                password="correct-password",
                display_name="Duplicate",
            ),
            "127.0.0.1",
            "database-test",
        )
    assert duplicate.value.kind == CustomerErrorKind.CONFLICT
{{- if .Tenancy}}
    with pytest.raises(CustomerError) as hidden:
        service.authenticate("missing-" + suffix, registered.token)
    assert hidden.value.kind == CustomerErrorKind.INVALID_CREDENTIALS
{{- end}}

    current = service.authenticate(scope, registered.token)
    profiled = service.update_profile(
        current,
        CustomerProfileUpdate(display_name="Updated Customer", version="1"),
        "127.0.0.1",
        "database-test",
    )
    assert profiled.version == "2"
    with pytest.raises(CustomerError) as stale:
        service.update_profile(
            current,
            CustomerProfileUpdate(display_name="Stale", version="1"),
            "127.0.0.1",
            "database-test",
        )
    assert stale.value.kind == CustomerErrorKind.CONFLICT

    changed = service.change_password(
        service.authenticate(scope, registered.token),
        CustomerPasswordChange(
            current_password="correct-password",
            new_password="replacement-password",
            version="2",
        ),
        "127.0.0.1",
        "database-test",
    )
    assert changed.version == "3"
    with pytest.raises(CustomerError):
        service.authenticate(scope, registered.token)
    login = service.login(
        scope,
        CustomerLogin(email=changed.email, password="replacement-password"),
        "127.0.0.1",
        "database-test",
    )

    missing_actor = actor.model_copy(update={"user_id": "missing-" + suffix})
    with pytest.raises(CustomerError) as failed_audit:
        service.suspend(customer_id, CustomerTransition(version="3"), missing_actor)
    assert failed_audit.value.kind in {CustomerErrorKind.CONFLICT, CustomerErrorKind.STORAGE}
    assert service.authenticate(scope, login.token).status == CustomerStatus.ACTIVE

    suspended = service.suspend(customer_id, CustomerTransition(version="3"), actor)
    assert suspended.status == CustomerStatus.SUSPENDED
    with pytest.raises(CustomerError):
        service.authenticate(scope, login.token)
    active = service.reactivate(customer_id, CustomerTransition(version="4"), actor)
    assert active.status == CustomerStatus.ACTIVE
{{- if .Tenancy}}
    with engine.begin() as connection:
        connection.execute(
            update(organizations)
            .where(organizations.c.id == organization.id)
            .values(status="inactive", deactivated_at=now, updated_at=now)
        )
    with pytest.raises(CustomerError) as inactive_login:
        service.login(
            organization.id,
            CustomerLogin(email=active.email, password="replacement-password"),
            "127.0.0.1",
            "database-test",
        )
    assert inactive_login.value.kind == CustomerErrorKind.INVALID_CREDENTIALS
    with pytest.raises(CustomerError) as inactive_registration:
        service.register(
            organization.id,
            CustomerRegistration(
                email="inactive-" + suffix + "@example.com",
                password="correct-password",
                display_name="Inactive Organization",
            ),
            "127.0.0.1",
            "database-test",
        )
    assert inactive_registration.value.kind == CustomerErrorKind.CONFLICT
    with engine.begin() as connection:
        connection.execute(
            update(organizations)
            .where(organizations.c.id == organization.id)
            .values(status="active", deactivated_at=None, updated_at=now)
        )
{{- end}}
    closing_login = service.login(
        scope,
        CustomerLogin(email=active.email, password="replacement-password"),
        "127.0.0.1",
        "database-test",
    )
    closed = service.close(
        service.authenticate(scope, closing_login.token),
        CustomerTransition(version="5"),
        "127.0.0.1",
        "database-test",
    )
    assert closed.status == CustomerStatus.CLOSED

    permission_codes = ["customers:accounts:read", "customers:accounts:manage"]
    with engine.connect() as connection:
        audit_count = connection.scalar(
            select(func.count())
            .select_from(audit_events)
            .where(audit_events.c.target == customer_id)
        )
        grants = set(
            connection.execute(
                select(role_permissions.c.role_code, role_permissions.c.permission_code).where(
                    role_permissions.c.permission_code.in_(permission_codes)
                )
            ).all()
        )
        session_count = connection.scalar(
            select(func.count())
            .select_from(customer_sessions)
            .where(customer_sessions.c.customer_id == customer_id)
        )
    assert audit_count == 8
    assert session_count == 0
    assert grants == {
        ("admin", "customers:accounts:read"),
        ("admin", "customers:accounts:manage"),
    }

{{- if .Tenancy}}
    other = tenancy.create(
        "Other customers " + suffix, actor.model_copy(update={"organization_id": None})
    )
    other_actor = actor.model_copy(update={"organization_id": other.id})
    with pytest.raises(CustomerError) as hidden_admin:
        service.get(customer_id, other_actor)
    assert hidden_admin.value.kind == CustomerErrorKind.NOT_FOUND
{{- end}}

    with engine.begin() as connection:
        connection.execute(delete(customer_accounts).where(customer_accounts.c.id == customer_id))
        connection.execute(delete(audit_events).where(audit_events.c.user_id == user_id))
{{- if .Tenancy}}
        connection.execute(
            delete(organization_memberships).where(
                organization_memberships.c.organization_id.in_([organization.id, other.id])
            )
        )
        connection.execute(
            delete(organizations).where(organizations.c.id.in_([organization.id, other.id]))
        )
{{- end}}
        connection.execute(delete(users).where(users.c.id == user_id))


def test_repository_contract_without_external_services(monkeypatch: pytest.MonkeyPatch) -> None:
    engine = create_engine(
        "sqlite://",
        connect_args={"check_same_thread": False},
        poolclass=StaticPool,
    )
    try:
        with engine.connect() as connection:
            connection.exec_driver_sql("PRAGMA foreign_keys=ON")
        upgrade_database(engine)
        _repository_contract(engine, monkeypatch)
    finally:
        engine.dispose()


def test_configured_database_migration_and_repository_contract(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    database_url = os.getenv("TEST_DATABASE_URL")
    if database_url is None:
        pytest.skip("TEST_DATABASE_URL is not configured")
    engine = create_database_engine(database_url)
    try:
        upgrade_database(engine)
        _repository_contract(engine, monkeypatch)
    finally:
        engine.dispose()
