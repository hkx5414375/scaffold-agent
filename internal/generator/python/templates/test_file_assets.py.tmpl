def test_expected_and_unexpected_failures_use_safe_categories() -> None:
    repository = MemoryRepository()
    blobs = MemoryBlobStore()
    service = FileAssetService(repository, blobs, lambda: NOW)

    with pytest.raises(FileAssetError) as empty_content:
        service.upload("report.txt", "text/plain", cast(BinaryIO, None), _actor())
    assert empty_content.value.kind == FileAssetErrorKind.INVALID

    repository.failure = FileAssetError(FileAssetErrorKind.INVALID, "known")
    with pytest.raises(FileAssetError) as expected:
        service.upload("report.txt", "text/plain", io.BytesIO(b"hello"), _actor())
    assert expected.value.kind == FileAssetErrorKind.INVALID

    repository.failure = RuntimeError("database secret")
    with pytest.raises(FileAssetError) as unexpected:
        service.upload("report.txt", "text/plain", io.BytesIO(b"hello"), _actor())
    assert unexpected.value.kind == FileAssetErrorKind.STORAGE
    assert "database secret" not in unexpected.value.message

    repository.failure = FileAssetConflict()
    blobs.delete_failure = OSError("cleanup detail")
    with pytest.raises(FileAssetError) as cleanup:
        service.upload("report.txt", "text/plain", io.BytesIO(b"hello"), _actor())
    assert cleanup.value.kind == FileAssetErrorKind.CONFLICT

    repository.failure = None
    blobs.delete_failure = None
    uploaded = service.upload("report.txt", "text/plain", io.BytesIO(b"hello"), _actor())
    blobs.delete_failure = FileAssetError(FileAssetErrorKind.STORAGE, "known")
    repository.restore_failure = RuntimeError("restore detail")
    with pytest.raises(FileAssetError) as delete_failure:
        service.delete(uploaded.id, _actor())
    assert delete_failure.value.kind == FileAssetErrorKind.STORAGE

    missing = FileAssetService(MemoryRepository(), MemoryBlobStore(), lambda: NOW)
    with pytest.raises(FileAssetError) as not_found:
        missing.delete("missing", _actor())
    assert not_found.value.kind == FileAssetErrorKind.NOT_FOUND
    with pytest.raises(FileAssetError) as invalid_actor:
        missing.get("missing", _actor().model_copy(update={"user_id": ""}))
    assert invalid_actor.value.kind == FileAssetErrorKind.INVALID
