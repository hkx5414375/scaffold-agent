    return Principal(
        user_id="user-1",
        email="person@example.com",
        role="admin",
        method="token",
{{- if .Tenancy}}
        organization_id=organization_id,
{{- end}}
    )


def test_upload_get_open_list_and_delete() -> None:
    repository = MemoryRepository()
    blobs = MemoryBlobStore()
    service = FileAssetService(repository, blobs, lambda: NOW)
    uploaded = service.upload(" report.txt ", " Text/Plain ", io.BytesIO(b"hello"), _actor())

    assert uploaded.name == "report.txt"
    assert uploaded.media_type == "text/plain"
    assert uploaded.size == 5
    assert uploaded.sha256 == hashlib.sha256(b"hello").hexdigest()
    assert service.get(uploaded.id, _actor()) == uploaded
    assert service.list("", 20, _actor()).items == [uploaded]
    opened = service.open(uploaded.id, _actor())
    assert opened.content.read() == b"hello"
    opened.content.close()
    service.delete(uploaded.id, _actor())
    with pytest.raises(FileAssetError) as missing:
        service.get(uploaded.id, _actor())
    assert missing.value.kind == FileAssetErrorKind.NOT_FOUND


def test_upload_and_delete_compensate_cross_resource_failures() -> None:
    repository = MemoryRepository()
    blobs = MemoryBlobStore()
    service = FileAssetService(repository, blobs, lambda: NOW)
    repository.failure = FileAssetConflict()
    with pytest.raises(FileAssetError) as conflict:
        service.upload("report.txt", "text/plain", io.BytesIO(b"hello"), _actor())
    assert conflict.value.kind == FileAssetErrorKind.CONFLICT
    assert blobs.values == {}

    repository.failure = None
    uploaded = service.upload("report.txt", "text/plain", io.BytesIO(b"hello"), _actor())
    blobs.delete_failure = OSError("disk detail")
    with pytest.raises(FileAssetError) as storage:
        service.delete(uploaded.id, _actor())
    assert storage.value.kind == FileAssetErrorKind.STORAGE
    assert repository.restored
    assert service.get(uploaded.id, _actor()) == uploaded


@pytest.mark.parametrize(
    ("name", "media_type"),
    [
        ("", "text/plain"),
        ("../secret", "text/plain"),
        ("report.txt", "text/*"),
        ("report.txt", "invalid"),
    ],
)
def test_invalid_metadata_is_rejected(name: str, media_type: str) -> None:
    service = FileAssetService(MemoryRepository(), MemoryBlobStore(), lambda: NOW)
    with pytest.raises(FileAssetError) as failure:
        service.upload(name, media_type, io.BytesIO(b"hello"), _actor())
    assert failure.value.kind == FileAssetErrorKind.INVALID


def test_scope_cursor_and_limit_are_enforced() -> None:
    service = FileAssetService(MemoryRepository(), MemoryBlobStore(), lambda: NOW)
