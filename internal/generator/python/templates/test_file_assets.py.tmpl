NOW = datetime(2026, 9, 1, tzinfo=UTC)


class MemoryRepository:
    def __init__(self) -> None:
        self.records: dict[str, FileAssetRecord] = {}
        self.failure: Exception | None = None
        self.restore_failure: Exception | None = None
        self.restored = False

    def create(self, asset: FileAssetRecord, audit: AuditEvent) -> None:
        assert audit.action == "files:create"
        if self.failure is not None:
            raise self.failure
        self.records[asset.id] = asset

    def get(self, organization_id: str, asset_id: str) -> FileAssetRecord | None:
        record = self.records.get(asset_id)
        if record is None or record.status != "active":
            return None
        if (record.organization_id or "") != organization_id:
            return None
        return record

    def list(self, organization_id: str, cursor: str, limit: int) -> PageResult:
        records = [
            record
            for record in self.records.values()
            if (record.organization_id or "") == organization_id
            and record.status == "active"
            and record.id > cursor
        ]
        records.sort(key=lambda record: record.id)
        next_cursor = records[limit - 1].id if len(records) > limit else ""
        return PageResult(records[:limit], next_cursor)

    def mark_deleted(
        self,
        organization_id: str,
        asset_id: str,
        deleted_at: datetime,
        audit: AuditEvent,
    ) -> FileAssetRecord:
        assert audit.action == "files:delete"
        record = self.get(organization_id, asset_id)
        if record is None:
            raise FileAssetNotFound()
        self.records[asset_id] = replace(
            record,
            status="deleted",
            updated_at=deleted_at,
            deleted_at=deleted_at,
        )
        return record

    def restore(self, organization_id: str, asset_id: str) -> None:
        if self.restore_failure is not None:
            raise self.restore_failure
        record = self.records.get(asset_id)
        if record is None or (record.organization_id or "") != organization_id:
            raise FileAssetNotFound()
        self.records[asset_id] = replace(record, status="active", deleted_at=None)
        self.restored = True


class MemoryBlobStore:
    def __init__(self) -> None:
        self.values: dict[str, bytes] = {}
        self.delete_failure: Exception | None = None

    def write(self, key: str, source: BinaryIO, maximum_bytes: int) -> WriteResult:
        content = source.read()
        if len(content) > maximum_bytes:
            raise FileAssetError(FileAssetErrorKind.TOO_LARGE, "file exceeds the maximum size")
        self.values[key] = content
        return WriteResult(len(content), hashlib.sha256(content).hexdigest())

    def open(self, key: str) -> io.BytesIO:
        return io.BytesIO(self.values[key])

    def delete(self, key: str) -> None:
        if self.delete_failure is not None:
            raise self.delete_failure
        self.values.pop(key, None)


