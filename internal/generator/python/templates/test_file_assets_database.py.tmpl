"""File metadata contracts for SQLite and the selected database."""

import io
import os
from datetime import UTC, datetime
from uuid import uuid4

import pytest
from sqlalchemy import create_engine, delete, insert, select
from sqlalchemy.engine import Engine
from sqlalchemy.pool import StaticPool
from test_file_assets import MemoryBlobStore

from {{.PackageName}}.database import create_database_engine
from {{.PackageName}}.files.models import file_assets
from {{.PackageName}}.files.repository import SQLAlchemyFileAssetRepository
from {{.PackageName}}.files.service import FileAssetService
from {{.PackageName}}.identity.models import (
    Principal,
    audit_events,
    role_permissions,
    roles,
    users,
)
from {{.PackageName}}.migrations import upgrade_database
{{- if .Tenancy}}
from {{.PackageName}}.tenancy.models import organization_memberships, organizations
from {{.PackageName}}.tenancy.repository import SQLAlchemyTenancyRepository
from {{.PackageName}}.tenancy.service import TenancyService
{{- end}}


def _repository_contract(engine: Engine) -> None:
    suffix = uuid4().hex
    now = datetime.now(UTC)
    organization_id: str | None = None
    user_id = "files-user-" + suffix
    with engine.begin() as connection:
        if connection.execute(select(roles.c.code).where(roles.c.code == "admin")).first() is None:
            connection.execute(insert(roles).values(code="admin", display_name="Administrator"))
        connection.execute(
            insert(users).values(
                id=user_id,
                email=suffix + "-files@example.com",
                password_hash="unused",
                role="admin",
                disabled=False,
                created_at=now,
                updated_at=now,
            )
        )
    identity = Principal(
        user_id=user_id,
        email=suffix + "-files@example.com",
        role="admin",
        method="token",
    )
{{- if .Tenancy}}
    organization_id = (
        TenancyService(SQLAlchemyTenancyRepository(engine), lambda: now)
        .create("Files " + suffix, identity)
        .id
    )
    actor = identity.model_copy(update={"organization_id": organization_id})
{{- else}}
    actor = identity
{{- end}}
    repository = SQLAlchemyFileAssetRepository(engine)
    service = FileAssetService(repository, MemoryBlobStore(), lambda: now)
    first = service.upload("first.txt", "text/plain", io.BytesIO(b"first"), actor)
    second = service.upload("second.txt", "text/plain", io.BytesIO(b"second"), actor)
    page = service.list("", 1, actor)
    assert len(page.items) == 1
    assert page.next_cursor
    assert service.list(page.next_cursor, 1, actor).items[0].id in {first.id, second.id}
{{- if .Tenancy}}
    assert repository.get("foreign-organization", first.id) is None
{{- else}}
    assert repository.get("ignored", first.id) is not None
{{- end}}
    service.delete(first.id, actor)
    assert repository.get(organization_id or "", first.id) is None

    with engine.connect() as connection:
        actions = (
            connection.execute(
                select(audit_events.c.action).where(audit_events.c.target == first.id)
            )
            .scalars()
            .all()
        )
        permitted_roles = set(
            connection.execute(
                select(role_permissions.c.role_code).where(
                    role_permissions.c.permission_code == "files:read"
                )
            ).scalars()
        )
    assert sorted(actions) == ["files:create", "files:delete"]
    assert permitted_roles == {"admin", "user"}

    with engine.begin() as connection:
        connection.execute(delete(file_assets).where(file_assets.c.id.in_([first.id, second.id])))
        connection.execute(
            delete(audit_events).where(audit_events.c.target.in_([first.id, second.id]))
        )
{{- if .Tenancy}}
        connection.execute(
            delete(organization_memberships).where(
                organization_memberships.c.organization_id == organization_id
            )
        )
        connection.execute(delete(organizations).where(organizations.c.id == organization_id))
{{- end}}
        connection.execute(delete(users).where(users.c.id == user_id))


def test_repository_contract_without_external_services() -> None:
    engine = create_engine(
        "sqlite://",
        connect_args={"check_same_thread": False},
        poolclass=StaticPool,
    )
    try:
        upgrade_database(engine)
        _repository_contract(engine)
    finally:
        engine.dispose()


def test_configured_database_migration_and_repository_contract() -> None:
    database_url = os.getenv("TEST_DATABASE_URL")
    if database_url is None:
        pytest.skip("TEST_DATABASE_URL is not configured")
    engine = create_database_engine(database_url)
    try:
        upgrade_database(engine)
        _repository_contract(engine)
    finally:
        engine.dispose()
