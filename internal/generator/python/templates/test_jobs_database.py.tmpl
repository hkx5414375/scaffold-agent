"""Durable job repository contracts for SQLite and the selected database."""

import os
from datetime import UTC, datetime, timedelta
from uuid import uuid4

import pytest
from sqlalchemy import create_engine, delete{{if .Tenancy}}, insert{{end}}, select
from sqlalchemy.engine import Engine
from sqlalchemy.pool import StaticPool

from {{.PackageName}}.database import create_database_engine
{{- if .Tenancy}}
from {{.PackageName}}.identity.models import Principal, audit_events, roles, users
{{- end}}
from {{.PackageName}}.jobs.models import background_jobs
from {{.PackageName}}.jobs.repository import SQLAlchemyJobRepository
from {{.PackageName}}.jobs.service import JobError, JobErrorKind, JobService
from {{.PackageName}}.migrations import upgrade_database
{{- if .Tenancy}}
from {{.PackageName}}.tenancy.models import organization_memberships, organizations
from {{.PackageName}}.tenancy.repository import SQLAlchemyTenancyRepository
from {{.PackageName}}.tenancy.service import TenancyService
{{- end}}


def _repository_contract(engine: Engine) -> None:
    suffix = uuid4().hex
    clock = [datetime.now(UTC)]
    organization_id: str | None = None
{{- if .Tenancy}}
    user_id = "jobs-user-" + suffix
    with engine.begin() as connection:
        if connection.execute(select(roles.c.code).where(roles.c.code == "admin")).first() is None:
            connection.execute(insert(roles).values(code="admin", display_name="Administrator"))
        connection.execute(
            insert(users).values(
                id=user_id,
                email=suffix + "-jobs@example.com",
                password_hash="unused",
                role="admin",
                disabled=False,
                created_at=clock[0],
                updated_at=clock[0],
            )
        )
    actor = Principal(
        user_id=user_id,
        email=suffix + "-jobs@example.com",
        role="admin",
        method="token",
    )
    organization_id = (
        TenancyService(SQLAlchemyTenancyRepository(engine), lambda: clock[0])
        .create("Jobs " + suffix, actor)
        .id
    )
{{- end}}
    service = JobService(SQLAlchemyJobRepository(engine), lambda: clock[0])

    first = service.enqueue(
        organization_id,
        "system.noop",
        {"ok": True},
        "request-1-" + suffix,
        priority=10,
        max_attempts=3,
    )
    duplicate = service.enqueue(
        organization_id,
        "system.noop",
        {"different": True},
        "request-1-" + suffix,
        priority=10,
        max_attempts=3,
    )
    assert duplicate.id == first.id
    leased = service.lease_next("worker-1", timedelta(seconds=30))
    assert leased.id == first.id
    assert leased.attempts == 1
    with pytest.raises(JobError) as wrong_worker:
        service.complete(leased.id, "worker-2")
    assert wrong_worker.value.kind == JobErrorKind.LEASE_LOST
    service.fail(leased, "worker-1", RuntimeError("temporary secret"))
    clock[0] += timedelta(seconds=6)
    retried = service.lease_next("worker-2", timedelta(seconds=30))
    assert retried.attempts == 2
    service.complete(retried.id, "worker-2")

    expiring = service.enqueue(
        organization_id,
        "system.noop",
        {},
        "request-2-" + suffix,
        max_attempts=2,
    )
    old_lease = service.lease_next("worker-old", timedelta(seconds=1))
    assert old_lease.id == expiring.id
    clock[0] += timedelta(seconds=2)
    reclaimed = service.lease_next("worker-new", timedelta(seconds=30))
    assert reclaimed.id == expiring.id
    with pytest.raises(JobError) as stale:
        service.extend_lease(old_lease.id, "worker-old", timedelta(seconds=30))
    assert stale.value.kind == JobErrorKind.LEASE_LOST
    service.complete(reclaimed.id, "worker-new")

    with engine.connect() as connection:
        statuses = (
            connection.execute(
                select(background_jobs.c.status).where(
                    background_jobs.c.id.in_([first.id, expiring.id])
                )
            )
            .scalars()
            .all()
        )
    assert statuses == ["succeeded", "succeeded"]

    with engine.begin() as connection:
        connection.execute(
            delete(background_jobs).where(background_jobs.c.id.in_([first.id, expiring.id]))
        )
{{- if .Tenancy}}
        connection.execute(
            delete(organization_memberships).where(
                organization_memberships.c.organization_id == organization_id
            )
        )
        connection.execute(delete(audit_events).where(audit_events.c.user_id == user_id))
        connection.execute(delete(organizations).where(organizations.c.id == organization_id))
        connection.execute(delete(users).where(users.c.id == user_id))
{{- end}}


def test_repository_contract_without_external_services() -> None:
    engine = create_engine(
        "sqlite://",
        connect_args={"check_same_thread": False},
        poolclass=StaticPool,
    )
    try:
        upgrade_database(engine)
        _repository_contract(engine)
    finally:
        engine.dispose()


def test_configured_database_migration_and_repository_contract() -> None:
    database_url = os.getenv("TEST_DATABASE_URL")
    if database_url is None:
        pytest.skip("TEST_DATABASE_URL is not configured")
    engine = create_database_engine(database_url)
    try:
        upgrade_database(engine)
        _repository_contract(engine)
    finally:
        engine.dispose()
