"""Password verifier security regression tests."""

import pytest

from {{.PackageName}}.errors import IdentityError
from {{.PackageName}}.identity.passwords import hash_password, verify_password


def test_password_round_trip_and_wrong_secret() -> None:
    encoded = hash_password("a sufficiently long password")

    assert verify_password(encoded, "a sufficiently long password")
    assert not verify_password(encoded, "a different long password")
    assert "a sufficiently long password" not in encoded


def test_password_rejects_bad_input_and_unbounded_parameters() -> None:
    with pytest.raises(IdentityError):
        hash_password("short")

    assert not verify_password("not-a-verifier", "password")
    assert not verify_password("pbkdf2-sha256$999999999$AA$AA", "password")
    assert not verify_password("pbkdf2-sha256$600000$%%%$%%%", "password")
    assert not verify_password("pbkdf2-sha256$600000$AA$AA", "x" * 1025)
