"""Organization lifecycle use-case and HTTP contract tests."""

from datetime import UTC, datetime

import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient

from {{.PackageName}}.errors import (
    IdentityError,
    IdentityErrorKind,
    install_error_handlers,
)
from {{.PackageName}}.identity.models import AuditEvent, Principal
from {{.PackageName}}.tenancy.lifecycle_http import (
    install_error_handlers as install_lifecycle_errors,
)
from {{.PackageName}}.tenancy.lifecycle_http import router
from {{.PackageName}}.tenancy.lifecycle_repository import (
    LifecycleConflict,
    LifecycleForbidden,
    LifecycleNotFound,
)
from {{.PackageName}}.tenancy.lifecycle_service import (
    LifecycleError,
    LifecycleErrorKind,
    TenancyLifecycleService,
)
from {{.PackageName}}.tenancy.models import Organization

NOW = datetime(2026, 9, 1, tzinfo=UTC)
OWNER = Principal(user_id="owner-1", email="owner@example.com", role="admin", method="token")
ORGANIZATION = Organization(
    id="organization-1",
    name="Acme",
    role="admin",
    created_at=NOW,
    owner_user_id="owner-1",
    is_owner=True,
    status="active",
    updated_at=NOW,
)


class MemoryRepository:
    def __init__(self) -> None:
        self.failure: Exception | None = None
        self.audit: AuditEvent | None = None

    def rename_organization(
        self,
        organization_id: str,
        name: str,
        actor_id: str,
        updated_at: datetime,
        audit: AuditEvent,
    ) -> Organization:
        del organization_id, actor_id
        self._raise_failure()
        self.audit = audit
        return ORGANIZATION.model_copy(update={"name": name, "updated_at": updated_at})

    def transfer_ownership(
        self,
        organization_id: str,
        actor_id: str,
        target_user_id: str,
        updated_at: datetime,
        audit: AuditEvent,
    ) -> Organization:
        del organization_id, actor_id
        self._raise_failure()
        self.audit = audit
        return ORGANIZATION.model_copy(
            update={
                "owner_user_id": target_user_id,
                "is_owner": False,
                "updated_at": updated_at,
            }
        )

    def set_organization_active(
        self,
        organization_id: str,
        actor_id: str,
        active: bool,
        updated_at: datetime,
        audit: AuditEvent,
    ) -> Organization:
        del organization_id, actor_id
        self._raise_failure()
        self.audit = audit
        return ORGANIZATION.model_copy(
            update={
                "status": "active" if active else "inactive",
                "updated_at": updated_at,
                "deactivated_at": None if active else updated_at,
            }
        )

    def _raise_failure(self) -> None:
        if self.failure is not None:
            raise self.failure


def test_lifecycle_service_normalizes_inputs_and_builds_audits() -> None:
    repository = MemoryRepository()
    service = TenancyLifecycleService(repository, lambda: NOW)

    assert service.rename(" organization-1 ", " Renamed ", OWNER).name == "Renamed"
    assert repository.audit is not None
    assert repository.audit.action == "tenancy.organization.rename"
    transferred = service.transfer_ownership("organization-1", "member-1", OWNER)
    assert transferred.owner_user_id == "member-1"
    assert not transferred.is_owner
    assert service.deactivate("organization-1", OWNER).status == "inactive"
    assert service.reactivate("organization-1", OWNER).status == "active"


def test_lifecycle_service_exposes_stable_failures() -> None:
    repository = MemoryRepository()
    service = TenancyLifecycleService(repository, lambda: NOW)

    for failure, expected in (
        (LifecycleNotFound(), LifecycleErrorKind.NOT_FOUND),
        (LifecycleForbidden(), LifecycleErrorKind.FORBIDDEN),
        (LifecycleConflict(), LifecycleErrorKind.CONFLICT),
    ):
        repository.failure = failure
        with pytest.raises(LifecycleError) as raised:
            service.deactivate("organization-1", OWNER)
        assert raised.value.kind == expected

    repository.failure = None
    with pytest.raises(LifecycleError) as bad_name:
        service.rename("organization-1", "bad\nname", OWNER)
    with pytest.raises(LifecycleError) as same_owner:
        service.transfer_ownership("organization-1", "owner-1", OWNER)
    with pytest.raises(IdentityError):
        service.reactivate("organization-1", OWNER.model_copy(update={"user_id": ""}))
    assert bad_name.value.kind == LifecycleErrorKind.INVALID_INPUT
    assert same_owner.value.kind == LifecycleErrorKind.INVALID_INPUT


class HttpIdentityService:
    def authenticate(self, session_token: str, bearer_token: str) -> Principal:
        del session_token
        if bearer_token != "owner-secret":
            raise IdentityError(IdentityErrorKind.INVALID_CREDENTIALS, "authentication is required")
        return OWNER


class HttpLifecycleService:
    def rename(self, organization_id: str, name: str, actor: Principal) -> Organization:
        del organization_id, actor
        if name == "conflict":
            raise LifecycleError(LifecycleErrorKind.CONFLICT, "state conflicts")
        return ORGANIZATION.model_copy(update={"name": name})

    def transfer_ownership(
        self,
        organization_id: str,
        target_user_id: str,
        actor: Principal,
    ) -> Organization:
        del organization_id, actor
        return ORGANIZATION.model_copy(update={"owner_user_id": target_user_id, "is_owner": False})

    def deactivate(self, organization_id: str, actor: Principal) -> Organization:
        del organization_id, actor
        return ORGANIZATION.model_copy(update={"status": "inactive", "deactivated_at": NOW})

    def reactivate(self, organization_id: str, actor: Principal) -> Organization:
        del organization_id, actor
        return ORGANIZATION


def test_http_lifecycle_contract_and_error_mapping() -> None:
    application = FastAPI()
    application.state.identity_service = HttpIdentityService()
    application.state.tenancy_lifecycle_service = HttpLifecycleService()
    install_error_handlers(application)
    install_lifecycle_errors(application)
    application.include_router(router)
    client = TestClient(application, headers={"Authorization": "Bearer owner-secret"})

    renamed = client.patch("/api/v1/organizations/organization-1", json={"name": "Renamed"})
    transferred = client.post(
        "/api/v1/organizations/organization-1/ownership-transfers",
        json={"target_user_id": "member-1"},
    )
    deactivated = client.post("/api/v1/organizations/organization-1/deactivation")
    reactivated = client.post("/api/v1/organizations/organization-1/reactivation")
    conflict = client.patch(
        "/api/v1/organizations/organization-1",
        json={"name": "conflict"},
    )

    assert renamed.json()["name"] == "Renamed"
    assert transferred.json()["owner_user_id"] == "member-1"
    assert deactivated.json()["status"] == "inactive"
    assert reactivated.json()["status"] == "active"
    assert conflict.status_code == 409
    assert conflict.json()["code"] == "tenancy.lifecycle.conflict"
