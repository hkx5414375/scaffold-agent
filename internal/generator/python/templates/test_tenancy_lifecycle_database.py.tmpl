"""Organization lifecycle repository contracts for SQLite and the selected database."""

import os
from datetime import UTC, datetime
from uuid import uuid4

import pytest
from sqlalchemy import create_engine, delete, insert, select
from sqlalchemy.engine import Engine
from sqlalchemy.pool import StaticPool

from {{.PackageName}}.database import create_database_engine
from {{.PackageName}}.errors import IdentityError
from {{.PackageName}}.identity.models import Principal, audit_events, roles, users
from {{.PackageName}}.migrations import upgrade_database
from {{.PackageName}}.tenancy.lifecycle_repository import SQLAlchemyTenancyLifecycleRepository
from {{.PackageName}}.tenancy.lifecycle_service import (
    LifecycleError,
    LifecycleErrorKind,
    TenancyLifecycleService,
)
from {{.PackageName}}.tenancy.member_models import organization_invitations
from {{.PackageName}}.tenancy.member_repository import SQLAlchemyTenancyMemberRepository
from {{.PackageName}}.tenancy.member_service import TenancyMemberService
from {{.PackageName}}.tenancy.models import organization_memberships, organizations
from {{.PackageName}}.tenancy.repository import SQLAlchemyTenancyRepository
from {{.PackageName}}.tenancy.service import TenancyService


def _seed_user(engine: Engine, user_id: str, email: str, now: datetime) -> None:
    with engine.begin() as connection:
        for code, display_name in (("admin", "Administrator"), ("user", "User")):
            if connection.execute(select(roles.c.code).where(roles.c.code == code)).first() is None:
                connection.execute(insert(roles).values(code=code, display_name=display_name))
        connection.execute(
            insert(users).values(
                id=user_id,
                email=email,
                password_hash="unused",
                role="admin",
                disabled=False,
                created_at=now,
                updated_at=now,
            )
        )


def _actor(user_id: str, email: str) -> Principal:
    return Principal(user_id=user_id, email=email, role="admin", method="token")


def _repository_contract(engine: Engine) -> None:
    suffix = uuid4().hex
    owner_id = "owner-" + suffix
    member_id = "member-" + suffix
    owner_email = suffix + "-owner@example.com"
    member_email = suffix + "-member@example.com"
    now = datetime.now(UTC)
    _seed_user(engine, owner_id, owner_email, now)
    _seed_user(engine, member_id, member_email, now)
    owner = _actor(owner_id, owner_email)
    member = _actor(member_id, member_email)
    tenancy = TenancyService(SQLAlchemyTenancyRepository(engine), lambda: now)
    organization = tenancy.create("Lifecycle " + suffix, owner)
    assert organization.owner_user_id == owner_id
    assert organization.is_owner
    assert organization.status == "active"

    scoped_owner = owner.model_copy(update={"organization_id": organization.id})
    members = TenancyMemberService(
        SQLAlchemyTenancyMemberRepository(engine),
        lambda: now,
        lambda: "lifecycle-invitation-" + suffix,
    )
    invitation = members.invite(member_email, "user", scoped_owner)
    members.accept(invitation.acceptance_token, member)
    lifecycle = TenancyLifecycleService(SQLAlchemyTenancyLifecycleRepository(engine), lambda: now)

    with pytest.raises(LifecycleError) as non_admin_rename:
        lifecycle.rename(organization.id, "Forbidden", member)
    assert non_admin_rename.value.kind == LifecycleErrorKind.FORBIDDEN
    renamed = lifecycle.rename(organization.id, "Renamed " + suffix, owner)
    assert renamed.name == "Renamed " + suffix
    transferred = lifecycle.transfer_ownership(organization.id, member_id, owner)
    assert transferred.owner_user_id == member_id
    assert not transferred.is_owner
    membership_page = members.list(scoped_owner)
    new_owner = next(item for item in membership_page.items if item.user_id == member_id)
    assert new_owner.role == "admin"
    assert new_owner.is_owner

    with pytest.raises(LifecycleError) as previous_owner:
        lifecycle.deactivate(organization.id, owner)
    assert previous_owner.value.kind == LifecycleErrorKind.FORBIDDEN
    scoped_member = tenancy.authorize(
        member,
        organization.id,
        "tenancy:members:read",
        "127.0.0.1",
        "contract",
    )
    inactive = lifecycle.deactivate(organization.id, member)
    assert inactive.status == "inactive"
    assert inactive.deactivated_at == now
    assert tenancy.list(member).items[0].status == "inactive"
    with pytest.raises(IdentityError):
        tenancy.authorize(
            member,
            organization.id,
            "tenancy:members:read",
            "127.0.0.1",
            "contract",
        )
    assert scoped_member.organization_id == organization.id
    with engine.connect() as connection:
        assert connection.execute(
            select(organization_memberships.c.user_id).where(
                organization_memberships.c.organization_id == organization.id
            )
        ).all()

    active = lifecycle.reactivate(organization.id, member)
    assert active.status == "active"
    assert active.deactivated_at is None
    assert (
        tenancy.authorize(
            member,
            organization.id,
            "tenancy:members:read",
            "127.0.0.1",
            "contract",
        ).organization_id
        == organization.id
    )
    with pytest.raises(LifecycleError) as repeated:
        lifecycle.reactivate(organization.id, member)
    assert repeated.value.kind == LifecycleErrorKind.CONFLICT

    with engine.connect() as connection:
        audit_rows = connection.execute(
            select(audit_events.c.action, audit_events.c.outcome).where(
                audit_events.c.user_id.in_([owner_id, member_id])
            )
        ).all()
    lifecycle_audits = [row for row in audit_rows if row.action.startswith("tenancy.organization.")]
    assert any(row.outcome == "succeeded" for row in lifecycle_audits)
    assert any(row.outcome == "denied" for row in lifecycle_audits)

    with engine.begin() as connection:
        connection.execute(
            delete(organization_invitations).where(
                organization_invitations.c.organization_id == organization.id
            )
        )
        connection.execute(
            delete(organization_memberships).where(
                organization_memberships.c.organization_id == organization.id
            )
        )
        connection.execute(
            delete(audit_events).where(audit_events.c.user_id.in_([owner_id, member_id]))
        )
        connection.execute(delete(organizations).where(organizations.c.id == organization.id))
        connection.execute(delete(users).where(users.c.id.in_([owner_id, member_id])))


def test_repository_contract_without_external_services() -> None:
    engine = create_engine(
        "sqlite://",
        connect_args={"check_same_thread": False},
        poolclass=StaticPool,
    )
    try:
        upgrade_database(engine)
        _repository_contract(engine)
    finally:
        engine.dispose()


def test_configured_database_migration_and_repository_contract() -> None:
    database_url = os.getenv("TEST_DATABASE_URL")
    if database_url is None:
        pytest.skip("TEST_DATABASE_URL is not configured")
    engine = create_database_engine(database_url)
    try:
        upgrade_database(engine)
        _repository_contract(engine)
    finally:
        engine.dispose()
