{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaffold-agent.dev/schema/v1alpha1/manifest.schema.json",
  "title": "Scaffold Agent Ownership Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "blueprint_hash", "capability_lock", "files"],
  "properties": {
    "api_version": { "const": "scaffold-agent.io/manifest/v1alpha1" },
    "blueprint_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capability_lock": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/semver" }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": { "pattern": "^\\.scaffold-agent(?:/|$)" }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "hash"],
        "properties": {
          "owner": { "$ref": "#/$defs/resourceName" },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "resourceName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
