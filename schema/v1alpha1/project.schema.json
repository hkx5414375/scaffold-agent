{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaffold-agent.dev/schema/v1alpha1/project.schema.json",
  "title": "Scaffold Agent Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "scaffold-agent.io/v1alpha1" },
    "kind": { "const": "Project" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/resourceName" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stack", "database", "auth"],
      "properties": {
        "stack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend"],
          "properties": {
            "backend": { "enum": ["go", "java", "python"] },
            "admin_ui": { "enum": ["none", "element-plus"] },
            "storefront": { "enum": ["none", "nuxt"] }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine"],
          "properties": { "engine": { "enum": ["postgresql", "mysql"] } }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modes"],
          "properties": {
            "modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["session", "token"] }
            }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "$ref": "#/$defs/resourceName" },
              "version": { "$ref": "#/$defs/semver" },
              "config": { "type": "object" }
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/resourceName" },
              "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
              "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } },
              "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
              "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
              "acceptance": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resourceName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
              "type": { "enum": ["string", "text", "bool", "int64", "decimal", "money", "date", "time", "datetime", "json", "ulid", "enum"] },
              "required": { "type": "boolean" },
              "unique": { "type": "boolean" }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "states"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "states": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$" },
        "description": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/resourceName" },
        "type": { "enum": ["list", "create", "edit", "detail", "dashboard", "storefront"] }
      }
    }
  }
}
